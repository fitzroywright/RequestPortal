{
  "applicationId": "RequestPortal",
  "displayName": "Request Portal",
  "version": "1.2.5",
  "description": "Public request intake, document collection, staff review, and requester communications.",
  "requirements": [
    {
      "id": "public-url",
      "displayName": "Public Service URL",
      "kind": "Configuration",
      "required": true,
      "purpose": "Canonical externally reachable Request Portal URL used by Control Plane health monitoring.",
      "configurationKey": "Aegis:PublicUrl",
      "isConfigured": false
    },
    {
      "id": "database-connection",
      "displayName": "PostgreSQL connection credential",
      "kind": "Secret",
      "required": true,
      "purpose": "Provides the Request Portal PostgreSQL connection string through Common.Secrets.",
      "secretName": "ConnectionStrings:RequestPortal",
      "isConfigured": false,
      "sensitive": true
    },
    {
      "id": "storage-provider",
      "displayName": "Document storage provider",
      "kind": "Configuration",
      "required": true,
      "purpose": "Selects the Common.Storage target used for Request Portal documents and storage-backed request features.",
      "configurationKey": "Storage:Provider",
      "isConfigured": false,
      "example": "LocalFolder | NetworkFolder | SharePoint"
    },
    {
      "id": "storage-local-root",
      "displayName": "Local storage root",
      "kind": "Configuration",
      "required": false,
      "purpose": "Defines the local Common.Storage root when Storage:Provider is LocalFolder.",
      "configurationKey": "Storage:Local:RootPath",
      "isConfigured": false
    },
    {
      "id": "storage-network-root",
      "displayName": "Network folder storage root",
      "kind": "Configuration",
      "required": false,
      "purpose": "Defines the UNC or mounted SMB/NFS Common.Storage root when Storage:Provider is NetworkFolder.",
      "configurationKey": "Storage:NetworkFolder:RootPath",
      "isConfigured": false
    },
    {
      "id": "storage-sharepoint-tenant",
      "displayName": "SharePoint tenant ID",
      "kind": "Configuration",
      "required": false,
      "purpose": "Identifies the Microsoft 365 tenant used by Common.Storage SharePoint storage.",
      "configurationKey": "Storage:SharePoint:TenantId",
      "isConfigured": false
    },
    {
      "id": "storage-sharepoint-client",
      "displayName": "SharePoint application client ID",
      "kind": "Configuration",
      "required": false,
      "purpose": "Identifies the Entra application used by Common.Storage SharePoint storage.",
      "configurationKey": "Storage:SharePoint:ClientId",
      "isConfigured": false
    },
    {
      "id": "storage-sharepoint-site-id",
      "displayName": "SharePoint site ID",
      "kind": "Configuration",
      "required": false,
      "purpose": "Uses the stable SharePoint site identifier directly, matching the FFP Manager Graph storage model.",
      "configurationKey": "Storage:SharePoint:SiteId",
      "isConfigured": false
    },
    {
      "id": "storage-sharepoint-host",
      "displayName": "SharePoint host",
      "kind": "Configuration",
      "required": false,
      "purpose": "Identifies the SharePoint Online host containing Request Portal document storage.",
      "configurationKey": "Storage:SharePoint:HostName",
      "isConfigured": false
    },
    {
      "id": "storage-sharepoint-site",
      "displayName": "SharePoint site path",
      "kind": "Configuration",
      "required": false,
      "purpose": "Selects the SharePoint site used by Common.Storage. Empty selects the host root site.",
      "configurationKey": "Storage:SharePoint:SitePath",
      "isConfigured": false
    },
    {
      "id": "storage-sharepoint-drive",
      "displayName": "SharePoint document library",
      "kind": "Configuration",
      "required": false,
      "purpose": "Selects the SharePoint drive/document library by DriveId or DriveName.",
      "configurationKey": "Storage:SharePoint:DriveName",
      "isConfigured": false
    },
    {
      "id": "storage-sharepoint-root",
      "displayName": "SharePoint storage root folder",
      "kind": "Configuration",
      "required": false,
      "purpose": "Defines the folder below the selected SharePoint document library reserved for Request Portal.",
      "configurationKey": "Storage:SharePoint:RootFolder",
      "isConfigured": false
    },
    {
      "id": "storage-sharepoint-client-secret",
      "displayName": "SharePoint storage client secret",
      "kind": "Secret",
      "required": false,
      "purpose": "Authenticates Common.Storage to Microsoft Graph when SharePoint is selected.",
      "secretName": "storage/sharepoint/client-secret",
      "isConfigured": false,
      "sensitive": true
    },
    {
      "id": "data-protection-keys",
      "displayName": "Data Protection key path",
      "kind": "Configuration",
      "required": true,
      "purpose": "Persists ASP.NET Core Data Protection keys outside the application deployment directory.",
      "configurationKey": "Security:DataProtectionKeysPath",
      "isConfigured": false
    },
    {
      "id": "allowed-hosts",
      "displayName": "Allowed application hosts",
      "kind": "Configuration",
      "required": true,
      "purpose": "Restricts accepted production host names instead of allowing wildcard hosts.",
      "configurationKey": "AllowedHosts",
      "isConfigured": false
    },
    {
      "id": "staff-oidc-enabled",
      "displayName": "FFP Staff OIDC enabled",
      "kind": "Configuration",
      "required": true,
      "purpose": "Enables the FFP staff OIDC authentication surface in production.",
      "configurationKey": "Authentication:StaffOidc:Enabled",
      "isConfigured": false
    },
    {
      "id": "staff-oidc-authority",
      "displayName": "FFP Staff OIDC authority",
      "kind": "ExternalService",
      "required": true,
      "purpose": "Defines the standards-compliant OIDC provider used for FFP staff authentication.",
      "configurationKey": "Authentication:StaffOidc:Authority",
      "isConfigured": false
    },
    {
      "id": "staff-oidc-client-id",
      "displayName": "FFP Staff OIDC client ID",
      "kind": "Configuration",
      "required": true,
      "purpose": "Identifies Request Portal to the FFP staff OIDC provider.",
      "configurationKey": "Authentication:StaffOidc:ClientId",
      "isConfigured": false
    },
    {
      "id": "staff-oidc-client-secret",
      "displayName": "FFP Staff OIDC client secret",
      "kind": "Secret",
      "required": true,
      "purpose": "Provides the OIDC confidential-client credential through Common.Secrets.",
      "secretName": "Authentication:StaffOidc:ClientSecret",
      "isConfigured": false,
      "sensitive": true
    },
    {
      "id": "staff-reviewer-groups",
      "displayName": "FFP staff reviewer group mappings",
      "kind": "Configuration",
      "required": true,
      "purpose": "Names the identity-provider groups that Common.Security maps to reviewer permissions.",
      "configurationKey": "Authentication:ActiveDirectory:ReviewerGroups",
      "isConfigured": false
    },
    {
      "id": "staff-administrator-groups",
      "displayName": "FFP staff administrator group mappings",
      "kind": "Configuration",
      "required": true,
      "purpose": "Names the identity-provider groups that Common.Security maps to administrator permissions.",
      "configurationKey": "Authentication:ActiveDirectory:AdministratorGroups",
      "isConfigured": false
    },
    {
      "id": "storage-malware-scanner",
      "displayName": "Upload malware scanner",
      "kind": "ExternalService",
      "required": true,
      "purpose": "Requires malware scanning to be enabled and identifies the scanning endpoint used for uploaded documents.",
      "configurationKey": "Uploads:MalwareScanning:Host",
      "isConfigured": false
    },
    {
      "id": "external-representative-provider",
      "displayName": "Representative external identity provider",
      "kind": "ExternalService",
      "required": true,
      "purpose": "Requires at least one commissioned external identity provider for portal representatives.",
      "isConfigured": false
    },
    {
      "id": "google-client-id",
      "displayName": "Google representative sign-in client ID",
      "kind": "Configuration",
      "required": false,
      "purpose": "Identifies Request Portal to Google when Google representative sign-in is commissioned.",
      "configurationKey": "Authentication:Google:ClientId",
      "isConfigured": false
    },
    {
      "id": "google-client-secret",
      "displayName": "Google representative sign-in client secret",
      "kind": "Secret",
      "required": false,
      "purpose": "Provides the Google confidential-client credential through Common.Secrets.",
      "secretName": "Authentication:Google:ClientSecret",
      "isConfigured": false,
      "sensitive": true
    },
    {
      "id": "microsoft-client-id",
      "displayName": "Microsoft representative sign-in client ID",
      "kind": "Configuration",
      "required": false,
      "purpose": "Identifies Request Portal to Microsoft when Microsoft representative sign-in is commissioned.",
      "configurationKey": "Authentication:Microsoft:ClientId",
      "isConfigured": false
    },
    {
      "id": "microsoft-client-secret",
      "displayName": "Microsoft representative sign-in client secret",
      "kind": "Secret",
      "required": false,
      "purpose": "Provides the Microsoft confidential-client credential through Common.Secrets.",
      "secretName": "Authentication:Microsoft:ClientSecret",
      "isConfigured": false,
      "sensitive": true
    },
    {
      "id": "facebook-app-id",
      "displayName": "Facebook representative sign-in app ID",
      "kind": "Configuration",
      "required": false,
      "purpose": "Identifies Request Portal to Facebook when Facebook representative sign-in is commissioned.",
      "configurationKey": "Authentication:Facebook:AppId",
      "isConfigured": false
    },
    {
      "id": "facebook-app-secret",
      "displayName": "Facebook representative sign-in app secret",
      "kind": "Secret",
      "required": false,
      "purpose": "Provides the Facebook application secret through Common.Secrets.",
      "secretName": "Authentication:Facebook:AppSecret",
      "isConfigured": false,
      "sensitive": true
    },
    {
      "id": "yahoo-client-id",
      "displayName": "Yahoo representative sign-in client ID",
      "kind": "Configuration",
      "required": false,
      "purpose": "Identifies Request Portal to Yahoo when Yahoo representative sign-in is commissioned.",
      "configurationKey": "Authentication:Yahoo:ClientId",
      "isConfigured": false
    },
    {
      "id": "yahoo-client-secret",
      "displayName": "Yahoo representative sign-in client secret",
      "kind": "Secret",
      "required": false,
      "purpose": "Provides the Yahoo confidential-client credential through Common.Secrets.",
      "secretName": "Authentication:Yahoo:ClientSecret",
      "isConfigured": false,
      "sensitive": true
    },
    {
      "id": "apple-client-id",
      "displayName": "Apple representative sign-in Services ID",
      "kind": "Configuration",
      "required": false,
      "purpose": "Identifies Request Portal to Sign in with Apple when Apple representative sign-in is commissioned.",
      "configurationKey": "Authentication:Apple:ClientId",
      "isConfigured": false
    },
    {
      "id": "apple-client-secret",
      "displayName": "Apple representative sign-in client secret",
      "kind": "Secret",
      "required": false,
      "purpose": "Provides the signed Apple client-secret JWT through Common.Secrets.",
      "secretName": "Authentication:Apple:ClientSecret",
      "isConfigured": false,
      "sensitive": true
    },
    {
      "id": "notifications-enabled",
      "displayName": "Notifications enabled",
      "kind": "Configuration",
      "required": true,
      "purpose": "Enables production portal notifications.",
      "configurationKey": "Notifications:Enabled",
      "isConfigured": false
    },
    {
      "id": "smtp-host",
      "displayName": "Notification SMTP host",
      "kind": "ExternalService",
      "required": false,
      "purpose": "Defines the optional SMTP endpoint used by Common.Messaging for portal notifications.",
      "configurationKey": "Notifications:SmtpHost",
      "isConfigured": false
    },
    {
      "id": "smtp-from",
      "displayName": "Notification sender address",
      "kind": "Configuration",
      "required": false,
      "purpose": "Defines the sender address when SMTP delivery is used.",
      "configurationKey": "Notifications:FromAddress",
      "isConfigured": false
    },
    {
      "id": "smtp-password",
      "displayName": "Notification SMTP credential",
      "kind": "Secret",
      "required": false,
      "purpose": "Provides the SMTP credential through Common.Secrets when required by the configured SMTP server.",
      "secretName": "Notifications:SmtpPassword",
      "isConfigured": false,
      "sensitive": true
    },
    {
      "id": "graph-tenant",
      "displayName": "Microsoft Graph tenant ID",
      "kind": "Configuration",
      "required": false,
      "purpose": "Identifies the Microsoft 365 tenant used by Common.Messaging Graph Email.",
      "configurationKey": "Messaging:MicrosoftGraph:TenantId",
      "isConfigured": false
    },
    {
      "id": "graph-client",
      "displayName": "Microsoft Graph client ID",
      "kind": "Configuration",
      "required": false,
      "purpose": "Identifies the Entra application used for Common.Messaging Graph Email delivery.",
      "configurationKey": "Messaging:MicrosoftGraph:ClientId",
      "isConfigured": false
    },
    {
      "id": "graph-client-secret",
      "displayName": "Microsoft Graph client secret",
      "kind": "Secret",
      "required": false,
      "purpose": "Authenticates Graph Email through Common.Secrets.",
      "secretName": "messaging/msgraph/client-secret",
      "isConfigured": false,
      "sensitive": true
    },
    {
      "id": "graph-email-enabled",
      "displayName": "Microsoft Graph Email channel",
      "kind": "Configuration",
      "required": false,
      "purpose": "Enables Common.Messaging Graph Email delivery.",
      "configurationKey": "Messaging:MicrosoftGraph:Email:Enabled",
      "isConfigured": false
    },
    {
      "id": "graph-email-sender",
      "displayName": "Microsoft Graph Email sender",
      "kind": "Configuration",
      "required": false,
      "purpose": "Selects the sender mailbox for Graph Email.",
      "configurationKey": "Messaging:MicrosoftGraph:Email:SenderUpn",
      "isConfigured": false
    },
    {
      "id": "graph-teams-enabled",
      "displayName": "Microsoft Graph Teams channel",
      "kind": "Configuration",
      "required": false,
      "purpose": "Enables Common.Messaging delegated Teams direct-message delivery.",
      "configurationKey": "Messaging:MicrosoftGraph:Teams:Enabled",
      "isConfigured": false
    },
    {
      "id": "graph-teams-sender",
      "displayName": "Microsoft Graph Teams sender",
      "kind": "Configuration",
      "required": false,
      "purpose": "Selects the delegated service user for Teams direct messages.",
      "configurationKey": "Messaging:MicrosoftGraph:Teams:SenderUpn",
      "isConfigured": false
    },
    {
      "id": "graph-teams-token",
      "displayName": "Microsoft Graph Teams delegated token",
      "kind": "Secret",
      "required": false,
      "purpose": "Provides the delegated Teams token through Common.Secrets.",
      "secretName": "messaging/msgraph/teams/delegated-access-token",
      "isConfigured": false,
      "sensitive": true
    },
    {
      "id": "messaging-queue",
      "displayName": "Durable messaging queue path",
      "kind": "Configuration",
      "required": true,
      "purpose": "Defines durable external-delivery queue storage for Common.Messaging.",
      "configurationKey": "Messaging:DurableQueuePath",
      "isConfigured": false
    },
    {
      "id": "site-id",
      "displayName": "Site ID",
      "kind": "Configuration",
      "required": true,
      "purpose": "Identifies the deployment site represented by this Request Portal instance.",
      "configurationKey": "Site:Id",
      "isConfigured": false
    },
    {
      "id": "ffp-manager-integration-enabled",
      "displayName": "FFP Manager integration enabled",
      "kind": "Configuration",
      "required": false,
      "purpose": "Enables the commissioned Application integration adapter when FFP Manager connectivity is ready.",
      "configurationKey": "FfpManagerIntegration:Enabled",
      "isConfigured": false
    },
    {
      "id": "ffp-manager-integration-url",
      "displayName": "FFP Manager bridge URL",
      "kind": "ExternalService",
      "required": false,
      "purpose": "Defines the HTTPS bridge endpoint used when FFP Manager integration is enabled.",
      "configurationKey": "FfpManagerIntegration:BaseUrl",
      "isConfigured": false
    },
    {
      "id": "ffp-manager-integration-secret",
      "displayName": "FFP Manager bridge shared secret",
      "kind": "Secret",
      "required": false,
      "purpose": "Authenticates Request Portal to the bridge through Common.Secrets when the integration is enabled.",
      "secretName": "FfpManagerIntegration:SharedSecret",
      "isConfigured": false,
      "sensitive": true
    },
    {
      "id": "capstone-enabled",
      "displayName": "Capstone delivery confirmation workflow",
      "kind": "Configuration",
      "required": false,
      "purpose": "Controls recipient delivery confirmation, discrepancy reporting, and return initiation after FFP Manager delivery synchronization.",
      "configurationKey": "Capstone:Enabled",
      "isConfigured": false
    }
  ],
  "runbookReference": "docs/RUNBOOK.md",
  "diagnostics": {
    "baseUrl": null,
    "healthPath": "/health",
    "diagnosticsRunPath": "/api/engineering/diagnostics/diagnostic-level/run",
    "diagnosticsRunsPath": "/api/engineering/diagnostics/diagnostic-level/runs",
    "supportsRemoteDiagnostics": true,
    "supportsOperationalTelemetry": true,
    "authenticationScheme": "DiagnosticLevel-HMAC-SHA256",
    "secretName": "diagnostics/machine/RequestPortal",
    "supportedLevels": [
      5,
      4,
      3,
      2,
      1
    ]
  },
  "module": "RequestPortal.Web"
}
