{
  "applicationId": "RequestPortal",
  "displayName": "Request Portal",
  "version": "1.2.0",
  "description": "Public request intake, document collection, staff review, and requester communications.",
  "requirements": [
    {"id":"database-connection","displayName":"PostgreSQL connection credential","kind":"Secret","required":true,"purpose":"Provides the Request Portal PostgreSQL connection string through Common.Secrets/OpenBao.","secretName":"ConnectionStrings:RequestPortal","isConfigured":false,"sensitive":true},
    {"id":"storage-root","displayName":"Document storage root","kind":"Configuration","required":true,"purpose":"Defines durable document storage used through Common.Storage.","configurationKey":"Storage:Local:RootPath","isConfigured":false},
    {"id":"data-protection-keys","displayName":"Data Protection key path","kind":"Configuration","required":true,"purpose":"Persists ASP.NET Core Data Protection keys outside the application deployment directory.","configurationKey":"Security:DataProtectionKeysPath","isConfigured":false},
    {"id":"openbao-address","displayName":"OpenBao address","kind":"ExternalService","required":true,"purpose":"Identifies the OpenBao service used by Common.Secrets.","configurationKey":"CommonSecrets:OpenBao:Address","isConfigured":false},
    {"id":"openbao-role","displayName":"OpenBao workload role","kind":"Secret","required":true,"purpose":"Provides the workload authentication material used by Common.Secrets to access OpenBao.","secretName":"CommonSecrets:OpenBao:RoleId","isConfigured":false,"sensitive":true},
    {"id":"allowed-hosts","displayName":"Allowed application hosts","kind":"Configuration","required":true,"purpose":"Restricts accepted production host names instead of allowing wildcard hosts.","configurationKey":"AllowedHosts","isConfigured":false},
    {"id":"staff-oidc-enabled","displayName":"FFP Staff OIDC enabled","kind":"Configuration","required":true,"purpose":"Enables the FFP staff OIDC authentication surface in production.","configurationKey":"Authentication:StaffOidc:Enabled","isConfigured":false},
    {"id":"staff-oidc-authority","displayName":"FFP Staff OIDC authority","kind":"ExternalService","required":true,"purpose":"Defines the standards-compliant OIDC provider used for FFP staff authentication.","configurationKey":"Authentication:StaffOidc:Authority","isConfigured":false},
    {"id":"staff-oidc-client-id","displayName":"FFP Staff OIDC client ID","kind":"Configuration","required":true,"purpose":"Identifies Request Portal to the FFP staff OIDC provider.","configurationKey":"Authentication:StaffOidc:ClientId","isConfigured":false},
    {"id":"staff-oidc-client-secret","displayName":"FFP Staff OIDC client secret","kind":"Secret","required":true,"purpose":"Provides the OIDC confidential-client credential through Common.Secrets/OpenBao.","secretName":"Authentication:StaffOidc:ClientSecret","isConfigured":false,"sensitive":true},
    {"id":"staff-reviewer-groups","displayName":"FFP staff reviewer group mappings","kind":"Configuration","required":true,"purpose":"Names the identity-provider groups that Common.Security maps to reviewer permissions.","configurationKey":"Authentication:ActiveDirectory:ReviewerGroups","isConfigured":false},
    {"id":"staff-administrator-groups","displayName":"FFP staff administrator group mappings","kind":"Configuration","required":true,"purpose":"Names the identity-provider groups that Common.Security maps to administrator permissions.","configurationKey":"Authentication:ActiveDirectory:AdministratorGroups","isConfigured":false},
    {"id":"storage-malware-scanner","displayName":"Upload malware scanner","kind":"ExternalService","required":true,"purpose":"Requires malware scanning to be enabled and identifies the scanning endpoint used for uploaded documents.","configurationKey":"Uploads:MalwareScanning:Host","isConfigured":false},
    {"id":"external-representative-provider","displayName":"Representative external identity provider","kind":"ExternalService","required":true,"purpose":"Requires at least one commissioned external identity provider for portal representatives.","isConfigured":false},
    {"id":"notifications-enabled","displayName":"Notifications enabled","kind":"Configuration","required":true,"purpose":"Enables production portal notifications.","configurationKey":"Notifications:Enabled","isConfigured":false},
    {"id":"smtp-host","displayName":"Notification SMTP host","kind":"ExternalService","required":true,"purpose":"Defines the SMTP endpoint used by Common.Messaging for portal notifications.","configurationKey":"Notifications:SmtpHost","isConfigured":false},
    {"id":"smtp-from","displayName":"Notification sender address","kind":"Configuration","required":true,"purpose":"Defines the sender address for portal notification messages.","configurationKey":"Notifications:FromAddress","isConfigured":false},
    {"id":"smtp-password","displayName":"Notification SMTP credential","kind":"Secret","required":false,"purpose":"Provides the SMTP credential through Common.Secrets/OpenBao when required by the configured SMTP server.","secretName":"Notifications:SmtpPassword","isConfigured":false,"sensitive":true},
    {"id":"messaging-queue","displayName":"Durable messaging queue path","kind":"Configuration","required":true,"purpose":"Defines durable external-delivery queue storage for Common.Messaging.","configurationKey":"Messaging:DurableQueuePath","isConfigured":false},
    {"id":"site-id","displayName":"Site ID","kind":"Configuration","required":true,"purpose":"Identifies the deployment site represented by this Request Portal instance.","configurationKey":"Site:Id","isConfigured":false}
  ]
}
