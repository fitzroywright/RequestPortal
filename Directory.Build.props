<Project>
  <PropertyGroup>
    <TargetFramework>net11.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <AnalysisLevel>latest</AnalysisLevel>
    <LangVersion>latest</LangVersion>
    <InvariantGlobalization>false</InvariantGlobalization>
    <DefaultItemExcludes>$(DefaultItemExcludes);src/**</DefaultItemExcludes>
    <CommonRoot Condition="'$(CommonRoot)' == ''">$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)../Common'))</CommonRoot>
    <CommonSecurityRoot Condition="'$(CommonSecurityRoot)' == '' and Exists('$(CommonRoot)/Common.Security/Common.Security.Hosting/Common.Security.Hosting.csproj')">$(CommonRoot)/Common.Security</CommonSecurityRoot>
    <CommonSecurityRoot Condition="'$(CommonSecurityRoot)' == '' and Exists('$(MSBuildThisFileDirectory)../Common.Security/Common.Security.Hosting/Common.Security.Hosting.csproj')">$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)../Common.Security'))</CommonSecurityRoot>
    <CommonSecurityRoot Condition="'$(CommonSecurityRoot)' == ''">$(CommonRoot)/Common.Security</CommonSecurityRoot>
  </PropertyGroup>
</Project>
