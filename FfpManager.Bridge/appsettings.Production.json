{
  "Bridge": {
    "ServiceIdentity": "FfpManager.Bridge",
    "Gateway": "Sql",
    "RequestPortalBaseUrl": "",
    "SharedSecretSecretName": "FfpManagerIntegration:SharedSecret",
    "SqlConnectionStringSecretName": "FfpManagerBridge:SqlConnectionString",
    "EnableOutboxDispatch": true,
    "OutboxDispatchIntervalSeconds": 5,
    "OutboxBatchSize": 20,
    "OutboxLockSeconds": 60,
    "OutboxMaxAttempts": 10,
    "OutboxRetryInitialSeconds": 5,
    "OutboxRetryMaxSeconds": 900,
    "OutboxStaleAfterMinutes": 15,
    "SqlTarget": "Production"
  },
  "AllowedHosts": "",
  "CommonSecrets": {
    "Mode": "Production",
    "WorkloadName": "FfpManager.Bridge",
    "EnvironmentName": "Production"
  }
}
