{
  "Demo": {
    "Enabled": false,
    "EnsureDatabase": false,
    "RecreateOnModelMismatch": false
  },
  "Organizations": {
    "RenewalWarningDays": [ 60, 30, 7 ]
  },
  "CommonSecrets": {
    "Mode": "Production",
    "WorkloadName": "RequestPortal",
    "EnvironmentName": "Production",
    "ProviderOrder": [ "OpenBao" ],
    "OpenBao": {
      "Enabled": true,
      "MountPath": "secret",
      "BasePath": "requestportal",
      "AuthMountPath": "approle",
      "SecretIdEnvironmentVariable": "REQUESTPORTAL_OPENBAO_SECRET_ID",
      "ClearSecretIdEnvironmentVariableAfterRead": true,
      "RequireSecretIdFileInProduction": false,
      "RequireHttps": true,
      "RenewTokens": true,
      "RevokeTokenOnDispose": true,
      "SecretCacheTtl": "00:05:00"
    }
  },
  "CommonMessaging": {
    "Durability": {
      "Provider": "PostgreSql",
      "ConnectionStringName": "RequestPortal",
      "QueueName": "requestportal"
    }
  },
  "Uploads": {
    "MaxBytes": 26214400
  },
  "Notifications": {
    "SmsEnabled": false,
    "WhatsAppEnabled": false,
    "PasswordSecretName": "Notifications:SmtpPassword",
    "SmsEndpointSecretName": "messaging/sms/endpoint",
    "SmsApiTokenSecretName": "messaging/sms/api-token",
    "WhatsAppEndpointSecretName": "messaging/whatsapp/endpoint",
    "WhatsAppApiTokenSecretName": "messaging/whatsapp/api-token"
  },
  "Authentication": {
    "StaffOidc": {
      "Enabled": false,
      "ClientId": "request-portal",
      "CallbackPath": "/signin-ffp-staff",
      "RequireHttpsMetadata": true,
      "UserNameClaim": "preferred_username",
      "DisplayNameClaim": "name",
      "EmailClaim": "email",
      "GroupClaimTypes": [ "groups", "group", "memberOf" ]
    }
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
    }
  }
}
