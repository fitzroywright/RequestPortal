@page
@model RequestPortal.Web.Pages.IndexModel
@{
    ViewData["Title"] = "Request Portal";
}

<section class="service-hero">
    <div class="shell service-hero-grid">
        <div>
            <div class="service-kicker">Food For The Poor Jamaica</div>
            <h1>Request assistance and follow its progress.</h1>
            <p>Approved organizations can submit assistance requests, provide supporting documents, and follow each request through review and fulfilment.</p>
            @if (User.Identity?.IsAuthenticated == true)
            {
                <a class="button service-primary-action" asp-page="/Dashboard/Index">Continue to your requests</a>
            }
            else
            {
                <a class="button service-primary-action" asp-page="/Account/Login">Register or sign in</a>
            }
        </div>
        <aside class="service-help-panel" aria-label="Before you start">
            <h2>Before you start</h2>
            <p>Requests are submitted on behalf of an approved organization. Representatives must sign in as themselves and have approved membership in that organization.</p>
            <a asp-page="/Organizations/Index">Organization access and membership</a>
        </aside>
    </div>
</section>

<section class="service-section">
    <div class="shell">
        <div class="service-section-heading">
            <h2>How it works</h2>
            <p>Three clear steps. Your request remains attached to the organization you are authorized to represent.</p>
        </div>
        <ol class="service-steps">
            <li>
                <strong>1</strong>
                <div><h3>Confirm organization access</h3><p>Register an organization or request membership in an existing approved organization.</p></div>
            </li>
            <li>
                <strong>2</strong>
                <div><h3>Submit the request</h3><p>Enter the assistance details and upload any supporting documents required for review.</p></div>
            </li>
            <li>
                <strong>3</strong>
                <div><h3>Track the outcome</h3><p>See requests for more information, decisions, and fulfilment updates from your account.</p></div>
            </li>
        </ol>
    </div>
</section>

<section class="service-section service-section-muted">
    <div class="shell service-access-grid">
        <div>
            <h2>Representative access</h2>
            <p>Use your own account. The portal records which organizations you are approved to represent and keeps requests separated by organization.</p>
            <a class="service-text-link" asp-page="/Organizations/Index">Manage organization access</a>
        </div>
        <div>
            <h2>Food For The Poor staff</h2>
            <p>Staff use the separate staff sign-in for review, administration, fulfilment, reporting, and operational work.</p>
            <a class="service-text-link" asp-page="/Account/StaffLogin">Staff sign in</a>
        </div>
    </div>
</section>
