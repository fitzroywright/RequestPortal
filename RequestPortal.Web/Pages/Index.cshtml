<script>
(() => {
    const dropdown = document.querySelector('[data-provider-dropdown]');
    if (!dropdown) return;

    const trigger = dropdown.querySelector('[data-provider-trigger]');
    const menu = dropdown.querySelector('[data-provider-menu]');
    const form = dropdown.closest('[data-provider-form]');
    const input = form?.querySelector('[data-provider-input]');
    const options = [...dropdown.querySelectorAll('[data-provider-option]')];

    const iconMarkup = option => option.querySelector('.provider-logo')?.outerHTML || '';

    const close = () => {
        menu.hidden = true;
        trigger.setAttribute('aria-expanded', 'false');
    };

    trigger.addEventListener('click', event => {
        event.stopPropagation();
        const opening = menu.hidden;
        menu.hidden = !opening;
        trigger.setAttribute('aria-expanded', opening ? 'true' : 'false');
    });

    options.forEach(option => {
        option.addEventListener('click', () => {
            const provider = option.dataset.provider;
            input.value = provider;
            const current = trigger.querySelector('.provider-dropdown-current');
            current.innerHTML = iconMarkup(option) + '<span data-provider-name>' + provider + '</span>';
            options.forEach(item => item.setAttribute('aria-selected', item === option ? 'true' : 'false'));
            close();
            trigger.focus();
        });
    });

    document.addEventListener('click', event => {
        if (!dropdown.contains(event.target)) close();
    });

    document.addEventListener('keydown', event => {
        if (event.key === 'Escape') close();
    });
})();
</script>

<script>
(() => {
    const slides = [
        ['Disaster Relief','/img/carousel/disaster.jpg'],
        ['Housing','/img/carousel/Splash01.jpg'],
        ['Health Care','/img/carousel/Splash02.jpg'],
        ['Agriculture','/img/carousel/Splash03.jpg'],
        ['School Construction','/img/carousel/Splash04.jpg'],
        ['Missions','/img/carousel/Splash05.jpg'],
        ['Education','/img/carousel/Splash06.jpg'],
        ['Fishing Villages','/img/carousel/Splash07.jpg'],
        ['Hurricane Relief','/img/carousel/Splash08.jpg'],
        ['Income Generating Projects','/img/carousel/Splash09.jpg'],
        ['Prison Ministry','/img/carousel/Splash10.jpg'],
        ['Water Projects','/img/carousel/Splash11.jpg'],
        ['Community Support','/img/carousel/Splash12.jpg'],
        ['Development','/img/carousel/Splash13.jpg'],
        ['Partnerships','/img/carousel/Splash14.jpg']
    ];

    (window.requestPortalCarouselExtraSlides || []).forEach(slide => {
        if (Array.isArray(slide) && slide.length >= 4) slides.push([slide[0], slide[3]]);
    });

    const root = document.querySelector('[data-relief-carousel]');
    if (!root || slides.length === 0) return;

    const image = root.querySelector('[data-carousel-image]');
    const dots = root.querySelector('[data-carousel-dots]');
    let index = 0;
    let timer;

    slides.forEach((slide, i) => {
        const button = document.createElement('button');
        button.type = 'button';
        button.className = 'public-carousel-dot';
        button.setAttribute('aria-label', 'Show ' + slide[0] + ' slide');
        button.addEventListener('click', () => {
            show(i);
            restart();
        });
        dots.appendChild(button);
    });

    const dotButtons = [...dots.querySelectorAll('.public-carousel-dot')];

    function show(next) {
        index = (next + slides.length) % slides.length;
        image.style.backgroundImage = "url('" + slides[index][1] + "')";
        dotButtons.forEach((button, i) => button.classList.toggle('active', i === index));
    }

    function restart() {
        clearInterval(timer);
        timer = setInterval(() => show(index + 1), 7000);
    }

    root.querySelector('[data-carousel-prev]').addEventListener('click', () => {
        show(index - 1);
        restart();
    });
    root.querySelector('[data-carousel-next]').addEventListener('click', () => {
        show(index + 1);
        restart();
    });
    root.addEventListener('mouseenter', () => clearInterval(timer));
    root.addEventListener('mouseleave', restart);

    show(0);
    restart();
})();
</script>
