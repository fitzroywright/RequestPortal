@page
@model RequestPortal.Web.Pages.IndexModel
@{
    ViewData["Title"] = "Relief Portal";
}

<div class="startup-splash" data-startup-splash aria-hidden="true">
    <div class="startup-splash-image" data-startup-splash-image></div>
    <div class="startup-splash-fog"></div>
    <div class="startup-splash-vignette"></div>
    <div class="startup-splash-content">
        <img class="startup-splash-logo" src="https://foodforthepoor.org/wp-content/uploads/fftp-logo-img-media.png" alt="Food For The Poor" />
        <div class="startup-splash-kicker" data-startup-splash-kicker>Disaster Relief</div>
        <h1 data-startup-splash-title>Standing with Jamaica</h1>
        <p data-startup-splash-text>Responding today. Rebuilding tomorrow. Together we bring hope.</p>
        <div class="startup-splash-scripture">“As often as you did it for one of the least of my brothers and sisters, you did it for me.”</div>
        <div class="startup-splash-scripture-ref">Matthew 25:40</div>
        <div class="startup-splash-progress" aria-hidden="true"><span></span></div>
        <div class="startup-splash-tagline">A brighter tomorrow is possible</div>
    </div>
</div>
<style>
    .startup-splash {
        position: fixed;
        inset: 0;
        z-index: 9999;
        overflow: hidden;
        background: #071421;
        color: #fff;
        opacity: 1;
        transition: opacity .85s ease;
    }
    .startup-splash.is-hidden { opacity: 0; pointer-events: none; }
    .startup-splash.is-removed { display: none; }
    .startup-splash-image {
        position: absolute;
        inset: -2%;
        background-position: center;
        background-size: cover;
        transform: scale(1.04);
        filter: brightness(.45) saturate(.76) contrast(1.08) sepia(.08) hue-rotate(170deg);
    }
    .startup-splash-fog {
        position: absolute;
        inset: 0;
        background:
            radial-gradient(circle at 78% 38%, rgba(244,156,52,.18), transparent 25%),
            linear-gradient(180deg, rgba(5,14,24,.48), rgba(8,18,29,.78)),
            linear-gradient(90deg, rgba(7,17,28,.84) 0%, rgba(14,28,41,.52) 48%, rgba(8,18,30,.72) 100%);
        backdrop-filter: blur(1.5px);
    }
    .startup-splash-vignette {
        position: absolute;
        inset: 0;
        box-shadow: inset 0 0 180px 70px rgba(1,7,13,.72);
        background: linear-gradient(0deg, rgba(5,13,22,.78) 0%, transparent 38%);
    }
    .startup-splash-content {
        position: relative;
        z-index: 2;
        width: min(760px, calc(100% - 48px));
        margin: 0 auto;
        min-height: 100vh;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        text-align: center;
        padding: 48px 0;
        text-shadow: 0 3px 18px rgba(0,0,0,.68);
    }
    .startup-splash-logo {
        width: min(320px, 64vw);
        max-height: 150px;
        object-fit: contain;
        margin-bottom: 28px;
        filter: drop-shadow(0 8px 24px rgba(0,0,0,.45));
    }
    .startup-splash-kicker {
        color: #f49b2f;
        font-size: .8rem;
        font-weight: 800;
        letter-spacing: .18em;
        text-transform: uppercase;
        margin-bottom: 9px;
    }
    .startup-splash-content h1 {
        margin: 0 0 12px;
        max-width: 720px;
        font-size: clamp(2.5rem, 6vw, 5.6rem);
        line-height: .98;
        letter-spacing: -.035em;
    }
    .startup-splash-content > p {
        max-width: 650px;
        margin: 0 0 30px;
        font-size: clamp(1rem, 2vw, 1.32rem);
        line-height: 1.55;
        color: #e7edf2;
    }
    .startup-splash-scripture {
        max-width: 620px;
        font-family: Georgia, "Times New Roman", serif;
        font-size: clamp(1rem, 2vw, 1.25rem);
        line-height: 1.45;
        color: #f5f6f7;
    }
    .startup-splash-scripture-ref {
        margin-top: 8px;
        font-size: .74rem;
        font-weight: 800;
        letter-spacing: .22em;
        text-transform: uppercase;
        color: #d6dde3;
    }
    .startup-splash-progress {
        width: min(300px, 66vw);
        height: 3px;
        margin: 42px auto 12px;
        background: rgba(255,255,255,.3);
        overflow: hidden;
    }
    .startup-splash-progress span {
        display: block;
        width: 0;
        height: 100%;
        background: #f49b2f;
        animation: startupSplashProgress 7s linear forwards;
    }
    .startup-splash-tagline {
        font-size: .72rem;
        font-weight: 800;
        letter-spacing: .24em;
        text-transform: uppercase;
        color: #dce3e9;
    }
    @@keyframes startupSplashProgress { to { width: 100%; } }
    @@media (max-width: 640px) {
        .startup-splash-content { width: min(92vw, 560px); }
        .startup-splash-logo { width: min(260px, 70vw); }
    }
    @@media (prefers-reduced-motion: reduce) {
        .startup-splash { transition: none; }
        .startup-splash-progress span { animation: none; width: 100%; }
    }
</style>

@{
    bool homeIsFfpStaff =
        User.Identity?.IsAuthenticated == true &&
        User.HasClaim(
            RequestPortal.Web.Security.StaffOidcOptions.StaffSurfaceClaim,
            RequestPortal.Web.Security.StaffOidcOptions.StaffSurfaceValue);
}

<section class="home-dashboard">
    <div class="shell home-dashboard-grid">
        <aside class="home-featured-wrap">
            <img class="home-featured-holder" src="~/img/leaningwoman.webp" alt="" aria-hidden="true" />
            <div class="home-featured-project">
                <div class="home-featured-titlebar">Featured Project</div>
                <div class="home-featured-image" style="background-image:url('/img/carousel/Splash01.jpg')" aria-hidden="true"></div>
                <div class="home-featured-copy">
                    <strong>Safer Homes, Stronger Communities</strong>
                    <p>Support for home construction and repairs helps families live in safer, healthier environments across Jamaica.</p>
                    <a asp-page="/Requests/Index">View Project →</a>
                </div>
            </div>
        </aside>

        <section class="relief-carousel home-hero" data-relief-carousel>
            <div class="relief-carousel-stage">
                <div class="relief-carousel-image" data-carousel-image aria-hidden="true"></div>
                <div class="relief-carousel-shade"></div>
                <button class="relief-carousel-arrow relief-carousel-prev" type="button" data-carousel-prev aria-label="Previous slide">‹</button>
                <button class="relief-carousel-arrow relief-carousel-next" type="button" data-carousel-next aria-label="Next slide">›</button>
                <div class="relief-carousel-copy home-hero-copy">
                    <div class="eyebrow" data-carousel-kicker>Community Support</div>
                    <h1 data-carousel-title>Building brighter futures together</h1>
                    <p data-carousel-text>Partnering with communities across Jamaica for lasting, positive change.</p>
                </div>
                <div class="relief-carousel-thumbs" data-carousel-thumbs aria-label="Relief programme slides"></div>
            </div>
        </section>

        <aside class="home-welcome">
            @if (User.Identity?.IsAuthenticated == true)
            {
                <h1>Welcome Back, @Model.FirstName!</h1>
            }
            else
            {
                <h1>Welcome</h1>
            }
            <p>What would you like to do today?</p>

            <div class="home-quick-grid">
                @if (User.Identity?.IsAuthenticated == true && !homeIsFfpStaff)
                {
                    <a class="home-quick-card home-quick-project" asp-page="/Requests/Create" asp-route-kind="Project">
                        <img class="home-card-worker" data-project-worker src="~/img/legacy/worker01.webp" alt="" aria-hidden="true" />
                        <strong>New Project Request</strong>
                        <small>Submit a project request.</small>
                        <b>→</b>
                    </a>
                    <a class="home-quick-card" asp-page="/Requests/Create" asp-route-kind="GoodsAndServices"><strong>Goods &amp; Services Request</strong><small>Request products, equipment, or services.</small><b>→</b></a>
                    <a class="home-quick-card" asp-page="/Requests/Index"><strong>My Requests</strong><small>View the status of your submitted requests.</small><b>→</b></a>
                    <a class="home-quick-card home-quick-messages" asp-page="/Messages/Inbox">
                        <div class="home-message-title">
                            <strong>Messages</strong>
                            <img class="home-card-baby" src="~/img/legacy/leave-comment.webp" alt="" aria-hidden="true" />
                        </div>
                        <small>Check for updates and respond to messages.</small>
                        <b>→</b>
                    </a>
                }
                else if (homeIsFfpStaff)
                {
                    <a class="home-quick-card" asp-page="/Staff/Index"><strong>Staff requests</strong><small>Open the internal request queue.</small><b>→</b></a>
                    <a class="home-quick-card" asp-page="/Staff/Operations"><strong>Action Queues</strong><small>Review work requiring attention.</small><b>→</b></a>
                }
                else
                {
                    <div class="home-signin-card">
                        <div class="home-signin-heading">
                            <span class="home-signin-icon" aria-hidden="true">↗</span>
                            <div>
                                <strong>Sign in to Request Portal</strong>
                                <small>Submit a request, follow its progress, and continue conversations with FFP.</small>
                            </div>
                        </div>

                        <form method="post"
                              asp-page="/Account/Login"
                              asp-page-handler="External"
                              class="home-signin-form"
                              data-provider-form>
                            <input type="hidden" name="returnUrl" value="/Dashboard" />
                            <input type="hidden" name="provider" value="Google" data-provider-input />
                            <label>Sign in with</label>
                            <div class="home-signin-provider-row">
                                <div class="provider-dropdown" data-provider-dropdown>
                                    <button class="provider-dropdown-trigger"
                                            type="button"
                                            aria-haspopup="listbox"
                                            aria-expanded="false"
                                            data-provider-trigger>
                                        <span class="provider-dropdown-current">
                                            <span class="provider-logo provider-logo-google" aria-hidden="true">
                                                <svg viewBox="0 0 24 24"><path fill="#4285F4" d="M21.35 12.27c0-.71-.06-1.39-.18-2.05H12v3.88h5.24a4.48 4.48 0 0 1-1.94 2.94v2.44h3.14c1.84-1.69 2.91-4.18 2.91-7.21Z"/><path fill="#34A853" d="M12 21.84c2.63 0 4.84-.87 6.45-2.36l-3.14-2.44c-.87.58-1.98.93-3.31.93-2.54 0-4.7-1.72-5.47-4.03H3.28v2.52A9.74 9.74 0 0 0 12 21.84Z"/><path fill="#FBBC05" d="M6.53 13.94A5.86 5.86 0 0 1 6.22 12c0-.67.12-1.33.31-1.94V7.54H3.28A9.82 9.82 0 0 0 2.25 12c0 1.61.39 3.13 1.03 4.46l3.25-2.52Z"/><path fill="#EA4335" d="M12 6.03c1.43 0 2.72.49 3.73 1.45l2.8-2.8C16.84 3.04 14.63 2.16 12 2.16a9.74 9.74 0 0 0-8.72 5.38l3.25 2.52C7.3 7.75 9.46 6.03 12 6.03Z"/></svg>
                                            </span>
                                            <span data-provider-name>Google</span>
                                        </span>
                                        <span class="provider-dropdown-chevron" aria-hidden="true">▾</span>
                                    </button>
                                    <div class="provider-dropdown-menu" role="listbox" hidden data-provider-menu>
                                        <button type="button" role="option" aria-selected="true" data-provider-option data-provider="Google">
                                            <span class="provider-logo provider-logo-google" aria-hidden="true">
                                                <svg viewBox="0 0 24 24"><path fill="#4285F4" d="M21.35 12.27c0-.71-.06-1.39-.18-2.05H12v3.88h5.24a4.48 4.48 0 0 1-1.94 2.94v2.44h3.14c1.84-1.69 2.91-4.18 2.91-7.21Z"/><path fill="#34A853" d="M12 21.84c2.63 0 4.84-.87 6.45-2.36l-3.14-2.44c-.87.58-1.98.93-3.31.93-2.54 0-4.7-1.72-5.47-4.03H3.28v2.52A9.74 9.74 0 0 0 12 21.84Z"/><path fill="#FBBC05" d="M6.53 13.94A5.86 5.86 0 0 1 6.22 12c0-.67.12-1.33.31-1.94V7.54H3.28A9.82 9.82 0 0 0 2.25 12c0 1.61.39 3.13 1.03 4.46l3.25-2.52Z"/><path fill="#EA4335" d="M12 6.03c1.43 0 2.72.49 3.73 1.45l2.8-2.8C16.84 3.04 14.63 2.16 12 2.16a9.74 9.74 0 0 0-8.72 5.38l3.25 2.52C7.3 7.75 9.46 6.03 12 6.03Z"/></svg>
                                            </span>
                                            <span>Google</span>
                                            <span class="provider-check" aria-hidden="true">✓</span>
                                        </button>
                                        <button type="button" role="option" aria-selected="false" data-provider-option data-provider="Facebook">
                                            <span class="provider-logo provider-logo-facebook" aria-hidden="true">f</span>
                                            <span>Facebook</span>
                                            <span class="provider-check" aria-hidden="true">✓</span>
                                        </button>
                                        <button type="button" role="option" aria-selected="false" data-provider-option data-provider="Yahoo">
                                            <span class="provider-logo provider-logo-yahoo" aria-hidden="true">Y!</span>
                                            <span>Yahoo</span>
                                            <span class="provider-check" aria-hidden="true">✓</span>
                                        </button>
                                        <button type="button" role="option" aria-selected="false" data-provider-option data-provider="Microsoft">
                                            <span class="provider-logo provider-logo-microsoft" aria-hidden="true"><span></span><span></span><span></span><span></span></span>
                                            <span>Microsoft</span>
                                            <span class="provider-check" aria-hidden="true">✓</span>
                                        </button>
                                        <button type="button" role="option" aria-selected="false" data-provider-option data-provider="Apple">
                                            <span class="provider-logo provider-logo-apple" aria-hidden="true">●</span>
                                            <span>Apple</span>
                                            <span class="provider-check" aria-hidden="true">✓</span>
                                        </button>
                                    </div>
                                </div>
                                <button class="button home-signin-submit" type="submit">Continue</button>
                            </div>
                        </form>

                        <div class="home-signin-divider"><span>FFP team member?</span></div>

                        <a class="home-staff-signin" asp-page="/Account/StaffLogin">
                            <span>
                                <strong>FFP User Sign In</strong>
                                <small>Use your Food For The Poor staff account.</small>
                            </span>
                            <b aria-hidden="true">→</b>
                        </a>
                    </div>
                }
            </div>
        </aside>
    </div>
</section>

<style>
    .home-signin-card {
        grid-column: 1 / -1;
        padding: 20px;
        border: 1px solid #d8dee3;
        border-radius: 14px;
        background:
            radial-gradient(circle at 100% 0, rgba(244,155,47,.12), transparent 34%),
            linear-gradient(145deg, #ffffff 0%, #f7f9fa 100%);
        box-shadow: 0 14px 34px rgba(25,39,52,.10);
    }
    .home-signin-heading {
        display: flex;
        align-items: flex-start;
        gap: 12px;
        padding-bottom: 16px;
        border-bottom: 1px solid #e3e7ea;
    }
    .home-signin-heading strong {
        display: block;
        font-size: 1.08rem;
        color: #172735;
    }
    .home-signin-heading small {
        display: block;
        margin-top: 4px;
        line-height: 1.45;
        color: #5d6871;
    }
    .home-signin-icon {
        display: grid;
        place-items: center;
        width: 38px;
        height: 38px;
        flex: 0 0 38px;
        border-radius: 10px;
        background: #172735;
        color: #fff;
        font-size: 1.15rem;
        font-weight: 800;
    }
    .home-signin-form {
        padding: 17px 0 4px;
    }
    .home-signin-form label {
        display: block;
        margin-bottom: 7px;
        color: #34434f;
        font-size: .78rem;
        font-weight: 800;
        letter-spacing: .04em;
        text-transform: uppercase;
    }
    .home-signin-provider-row {
        display: grid;
        grid-template-columns: minmax(0,1fr) auto;
        gap: 9px;
    }
    .provider-dropdown {
        position: relative;
        min-width: 0;
    }
    .provider-dropdown-trigger {
        width: 100%;
        min-height: 42px;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 14px;
        border: 1px solid #b7c0c7;
        border-radius: 4px;
        background: linear-gradient(#ffffff, #f3f4f5);
        padding: 0 10px 0 12px;
        color: #172735;
        font: inherit;
        cursor: pointer;
        box-shadow: inset 0 1px 0 rgba(255,255,255,.85);
    }
    .provider-dropdown-trigger:hover,
    .provider-dropdown-trigger[aria-expanded="true"] {
        border-color: #7f8c96;
        background: #fff;
    }
    .provider-dropdown-current,
    .provider-dropdown-menu button {
        display: flex;
        align-items: center;
        gap: 10px;
    }
    .provider-dropdown-chevron {
        border-left: 1px solid #d1d6da;
        padding-left: 10px;
        color: #56636d;
        font-size: .78rem;
    }
    .provider-dropdown-menu {
        position: absolute;
        z-index: 30;
        top: calc(100% + 4px);
        left: 0;
        right: 0;
        padding: 4px;
        border: 1px solid #aeb8c0;
        border-radius: 4px;
        background: #fff;
        box-shadow: 0 10px 26px rgba(25,39,52,.18);
    }
    .provider-dropdown-menu button {
        width: 100%;
        min-height: 38px;
        border: 0;
        border-radius: 2px;
        background: transparent;
        padding: 7px 9px;
        color: #172735;
        font: inherit;
        text-align: left;
        cursor: pointer;
    }
    .provider-dropdown-menu button:hover,
    .provider-dropdown-menu button:focus {
        outline: none;
        background: #e9f2fb;
    }
    .provider-dropdown-menu button[aria-selected="true"] {
        background: #eef4fa;
    }
    .provider-check {
        margin-left: auto;
        color: #185abd;
        visibility: hidden;
    }
    .provider-dropdown-menu button[aria-selected="true"] .provider-check {
        visibility: visible;
    }
    .provider-logo {
        width: 21px;
        height: 21px;
        flex: 0 0 21px;
        display: inline-grid;
        place-items: center;
        font-size: .82rem;
        font-weight: 800;
        line-height: 1;
    }
    .provider-logo svg {
        width: 19px;
        height: 19px;
        display: block;
    }
    .provider-logo-facebook {
        border-radius: 50%;
        background: #1877f2;
        color: #fff;
        font-family: Arial, sans-serif;
        font-size: 1rem;
    }
    .provider-logo-yahoo {
        color: #6001d2;
        font-family: Arial, sans-serif;
        font-size: .72rem;
    }
    .provider-logo-microsoft {
        grid-template-columns: 1fr 1fr;
        grid-template-rows: 1fr 1fr;
        gap: 1px;
    }
    .provider-logo-microsoft span:nth-child(1) { background: #f25022; }
    .provider-logo-microsoft span:nth-child(2) { background: #7fba00; }
    .provider-logo-microsoft span:nth-child(3) { background: #00a4ef; }
    .provider-logo-microsoft span:nth-child(4) { background: #ffb900; }
    .provider-logo-apple {
        color: #111;
        font-size: .78rem;
    }
    .home-signin-submit {
        min-width: 104px;
        border-radius: 9px;
    }
    .home-signin-divider {
        display: flex;
        align-items: center;
        gap: 10px;
        margin: 15px 0 10px;
        color: #7a858e;
        font-size: .74rem;
        font-weight: 700;
    }
    .home-signin-divider::before,
    .home-signin-divider::after {
        content: "";
        flex: 1;
        height: 1px;
        background: #dde2e6;
    }
    .home-staff-signin {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 16px;
        padding: 11px 12px;
        border: 1px solid #d7dde1;
        border-radius: 10px;
        background: rgba(255,255,255,.72);
        color: #243746;
        text-decoration: none;
    }
    .home-staff-signin:hover {
        border-color: #b45b09;
        background: #fff;
    }
    .home-staff-signin strong,
    .home-staff-signin small {
        display: block;
    }
    .home-staff-signin small {
        margin-top: 2px;
        color: #69747c;
    }
    .home-staff-signin b {
        color: #b45b09;
        font-size: 1.15rem;
    }
    @@media (max-width: 560px) {
        .home-signin-provider-row {
            grid-template-columns: 1fr;
        }
        .home-signin-submit {
            width: 100%;
        }
    }
</style>

