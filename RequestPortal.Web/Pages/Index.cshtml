@page
@model RequestPortal.Web.Pages.IndexModel
@{
    ViewData["Title"] = "Request Portal";
}

<main class="service-home">
    <section class="service-hero">
        <div class="shell service-hero-grid">
            <div class="service-hero-copy">
                <p class="service-label">Food For The Poor Jamaica</p>
                <h1>Request assistance through your organization.</h1>
                <p class="service-lead">Use this portal to register or join an organization, submit an assistance request with supporting documents, and follow its progress.</p>

                @if (User.Identity?.IsAuthenticated == true)
                {
                    <a class="button service-primary-action" asp-page="/Dashboard/Index">Continue to my requests</a>
                }
                else
                {
                    <a class="button service-primary-action" asp-page="/Account/Login">Register or sign in</a>
                }

                <p class="service-staff-link"><a asp-page="/Account/StaffLogin">Food For The Poor staff sign in</a></p>
            </div>

            <aside class="service-notice" aria-labelledby="service-notice-title">
                <h2 id="service-notice-title">Before you start</h2>
                <p>Assistance requests are submitted on behalf of approved organizations. Representatives sign in as themselves and may act only for organizations where their membership is approved.</p>
                <p>If your organization is not yet registered, you can begin that process after signing in.</p>
            </aside>
        </div>
    </section>

    <section class="service-process" aria-labelledby="service-process-title">
        <div class="shell">
            <div class="service-section-heading">
                <p class="service-label">How it works</p>
                <h2 id="service-process-title">Three clear steps</h2>
            </div>
            <ol class="service-steps">
                <li>
                    <span class="service-step-number">1</span>
                    <div>
                        <h3>Register or join an organization</h3>
                        <p>Register a new organization or request membership in an organization already approved in the portal.</p>
                    </div>
                </li>
                <li>
                    <span class="service-step-number">2</span>
                    <div>
                        <h3>Submit the request</h3>
                        <p>Enter the request details and provide the supporting documents required for review.</p>
                    </div>
                </li>
                <li>
                    <span class="service-step-number">3</span>
                    <div>
                        <h3>Follow its progress</h3>
                        <p>Use your account to see review activity, requests for more information, decisions and fulfilment status.</p>
                    </div>
                </li>
            </ol>
        </div>
    </section>

    <section class="service-help" aria-labelledby="service-help-title">
        <div class="shell service-help-grid">
            <div>
                <h2 id="service-help-title">What you will need</h2>
                <p>Your own sign-in account, the organization you represent, request details, and any documents required for that request.</p>
            </div>
            @if (User.Identity?.IsAuthenticated == true)
            {
                <div class="service-account-links">
                    <a asp-page="/Organizations/Index">My organizations</a>
                    <a asp-page="/Dashboard/Index">My requests</a>
                </div>
            }
        </div>
    </section>
</main>
