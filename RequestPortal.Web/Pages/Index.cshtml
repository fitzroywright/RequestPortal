@page
@model RequestPortal.Web.Pages.IndexModel
@{
    ViewData["Title"] = "Request Portal";
}

<section class="public-home">
    <section class="public-hero relief-carousel" data-relief-carousel>
        <div class="public-hero-image" data-carousel-image aria-hidden="true"></div>
        <div class="public-hero-shade"></div>

        <button class="public-hero-arrow public-hero-prev" type="button" data-carousel-prev aria-label="Previous slide">‹</button>
        <button class="public-hero-arrow public-hero-next" type="button" data-carousel-next aria-label="Next slide">›</button>

        <div class="shell public-hero-shell">
            <div class="public-hero-copy">
                <span class="public-accent-line" aria-hidden="true"></span>
                <h1>Supporting Stronger<br />Communities in Jamaica</h1>
                <p>
                    The Food For The Poor Jamaica Request Portal makes it easy for individuals and organizations
                    to submit requests, track progress and stay connected with our team.
                </p>
                <a class="public-secondary-action" href="https://www.foodforthepoorja.org/" target="_blank" rel="noopener noreferrer">
                    Learn more about our work <span aria-hidden="true">→</span>
                </a>
            </div>

            @if (User.Identity?.IsAuthenticated == true)
            {
                <aside class="public-signedin-card">
                    <span class="public-signedin-label">Welcome back</span>
                    <h2>@Model.FirstName</h2>
                    <p>Continue to your request workspace to review requests, messages and organization activity.</p>
                    <a class="public-primary-action public-card-action" asp-page="/Dashboard/Index">Open Request Workspace <span aria-hidden="true">→</span></a>
                </aside>
            }
            else
            {
                <aside class="home-signin-card public-signin-card">
                    <div class="home-signin-heading">
                        <span class="home-signin-icon" aria-hidden="true">↗</span>
                        <div>
                            <strong>Sign in to Request Portal</strong>
                            <small>Submit a request, follow its progress, and continue conversations with FFP.</small>
                        </div>
                    </div>

                    <form method="post"
                          asp-page="/Account/Login"
                          asp-page-handler="External"
                          class="home-signin-form"
                          data-provider-form>
                        <input type="hidden" name="returnUrl" value="/Dashboard" />
                        <input type="hidden" name="provider" value="Google" data-provider-input />
                        <label>Sign in with</label>
                        <div class="home-signin-provider-row">
                            <div class="provider-dropdown" data-provider-dropdown>
                                <button class="provider-dropdown-trigger"
                                        type="button"
                                        aria-haspopup="listbox"
                                        aria-expanded="false"
                                        data-provider-trigger>
                                    <span class="provider-dropdown-current">
                                        <span class="provider-logo provider-logo-google" aria-hidden="true">
                                            <svg viewBox="0 0 24 24"><path fill="#4285F4" d="M21.35 12.27c0-.71-.06-1.39-.18-2.05H12v3.88h5.24a4.48 4.48 0 0 1-1.94 2.94v2.44h3.14c1.84-1.69 2.91-4.18 2.91-7.21Z"/><path fill="#34A853" d="M12 21.84c2.63 0 4.84-.87 6.45-2.36l-3.14-2.44c-.87.58-1.98.93-3.31.93-2.54 0-4.7-1.72-5.47-4.03H3.28v2.52A9.74 9.74 0 0 0 12 21.84Z"/><path fill="#FBBC05" d="M6.53 13.94A5.86 5.86 0 0 1 6.22 12c0-.67.12-1.33.31-1.94V7.54H3.28A9.82 9.82 0 0 0 2.25 12c0 1.61.39 3.13 1.03 4.46l3.25-2.52Z"/><path fill="#EA4335" d="M12 6.03c1.43 0 2.72.49 3.73 1.45l2.8-2.8C16.84 3.04 14.63 2.16 12 2.16a9.74 9.74 0 0 0-8.72 5.38l3.25 2.52C7.3 7.75 9.46 6.03 12 6.03Z"/></svg>
                                        </span>
                                        <span data-provider-name>Google</span>
                                    </span>
                                    <span class="provider-dropdown-chevron" aria-hidden="true">▾</span>
                                </button>
                                <div class="provider-dropdown-menu" role="listbox" hidden data-provider-menu>
                                    <button type="button" role="option" aria-selected="true" data-provider-option data-provider="Google">
                                        <span class="provider-logo provider-logo-google" aria-hidden="true">
                                            <svg viewBox="0 0 24 24"><path fill="#4285F4" d="M21.35 12.27c0-.71-.06-1.39-.18-2.05H12v3.88h5.24a4.48 4.48 0 0 1-1.94 2.94v2.44h3.14c1.84-1.69 2.91-4.18 2.91-7.21Z"/><path fill="#34A853" d="M12 21.84c2.63 0 4.84-.87 6.45-2.36l-3.14-2.44c-.87.58-1.98.93-3.31.93-2.54 0-4.7-1.72-5.47-4.03H3.28v2.52A9.74 9.74 0 0 0 12 21.84Z"/><path fill="#FBBC05" d="M6.53 13.94A5.86 5.86 0 0 1 6.22 12c0-.67.12-1.33.31-1.94V7.54H3.28A9.82 9.82 0 0 0 2.25 12c0 1.61.39 3.13 1.03 4.46l3.25-2.52Z"/><path fill="#EA4335" d="M12 6.03c1.43 0 2.72.49 3.73 1.45l2.8-2.8C16.84 3.04 14.63 2.16 12 2.16a9.74 9.74 0 0 0-8.72 5.38l3.25 2.52C7.3 7.75 9.46 6.03 12 6.03Z"/></svg>
                                        </span>
                                        <span>Google</span>
                                        <span class="provider-check" aria-hidden="true">✓</span>
                                    </button>
                                    <button type="button" role="option" aria-selected="false" data-provider-option data-provider="Facebook">
                                        <span class="provider-logo provider-logo-facebook" aria-hidden="true">f</span>
                                        <span>Facebook</span>
                                        <span class="provider-check" aria-hidden="true">✓</span>
                                    </button>
                                    <button type="button" role="option" aria-selected="false" data-provider-option data-provider="Yahoo">
                                        <span class="provider-logo provider-logo-yahoo" aria-hidden="true">Y!</span>
                                        <span>Yahoo</span>
                                        <span class="provider-check" aria-hidden="true">✓</span>
                                    </button>
                                    <button type="button" role="option" aria-selected="false" data-provider-option data-provider="Microsoft">
                                        <span class="provider-logo provider-logo-microsoft" aria-hidden="true"><span></span><span></span><span></span><span></span></span>
                                        <span>Microsoft</span>
                                        <span class="provider-check" aria-hidden="true">✓</span>
                                    </button>
                                    <button type="button" role="option" aria-selected="false" data-provider-option data-provider="Apple">
                                        <span class="provider-logo provider-logo-apple" aria-hidden="true">●</span>
                                        <span>Apple</span>
                                        <span class="provider-check" aria-hidden="true">✓</span>
                                    </button>
                                </div>
                            </div>
                            <button class="button home-signin-submit" type="submit">Continue</button>
                        </div>
                    </form>

                    <div class="home-signin-divider"><span>FFP team member?</span></div>

                    <a class="home-staff-signin" asp-page="/Account/StaffLogin">
                        <span class="home-staff-signin-logo-wrap">
                            <img src="https://foodforthepoor.org/wp-content/uploads/fftp-logo-img-media.png"
                                 alt=""
                                 class="home-staff-signin-logo" />
                        </span>
                        <span class="home-staff-signin-copy">
                            <strong>FFP User Sign In</strong>
                            <small>Use your Food For The Poor staff account.</small>
                        </span>
                        <b aria-hidden="true">→</b>
                    </a>
                </aside>
            }
        </div>

        <div class="public-carousel-dots" data-carousel-dots aria-label="Programme slides"></div>
    </section>

    <section class="public-help-section">
        <div class="shell">
            <span class="public-section-line" aria-hidden="true"></span>
            <h2>How the Request Portal Helps</h2>
            <p class="public-section-intro">A simple and secure way to connect people, resources and opportunities.</p>

            <div class="public-help-grid">
                <article class="public-help-card">
                    <span class="public-help-icon orange" aria-hidden="true">▤</span>
                    <div>
                        <h3>Submit a Request</h3>
                        <p>Request support for community projects, goods and services or programme assistance.</p>
                    </div>
                </article>
                <article class="public-help-card">
                    <span class="public-help-icon blue" aria-hidden="true">⌕</span>
                    <div>
                        <h3>Track Progress</h3>
                        <p>Stay informed on the status of your requests with real-time updates.</p>
                    </div>
                </article>
                <article class="public-help-card">
                    <span class="public-help-icon green" aria-hidden="true">▣</span>
                    <div>
                        <h3>Communicate Securely</h3>
                        <p>Exchange messages with our team through a secure and centralized inbox.</p>
                    </div>
                </article>
                <article class="public-help-card">
                    <span class="public-help-icon gold" aria-hidden="true">♟</span>
                    <div>
                        <h3>For Individuals and Organizations</h3>
                        <p>Whether you’re an individual, community member or organization, we’re here to support you.</p>
                    </div>
                </article>
            </div>
        </div>
    </section>

    <section class="public-impact-section">
        <div class="shell public-impact-grid">
            <div class="public-impact-copy">
                <span class="public-section-line" aria-hidden="true"></span>
                <h2>Together We Make a Difference</h2>
                <p>
                    Food For The Poor Jamaica works with communities across the island to reduce poverty, improve lives
                    and create lasting change through housing, education, healthcare and sustainable development.
                </p>
                <a class="public-outline-action" href="https://www.foodforthepoorja.org/" target="_blank" rel="noopener noreferrer">
                    Learn more about our work <span aria-hidden="true">→</span>
                </a>
            </div>

            <div class="public-impact-item">
                <span class="public-impact-icon orange" aria-hidden="true">⌂</span>
                <strong>Stronger<br />Communities</strong>
                <small>Through housing, education and support programmes.</small>
            </div>
            <div class="public-impact-item">
                <span class="public-impact-icon blue" aria-hidden="true">●●●</span>
                <strong>Brighter<br />Futures</strong>
                <small>Investing in people, children and families.</small>
            </div>
            <div class="public-impact-item">
                <span class="public-impact-icon green" aria-hidden="true">◆</span>
                <strong>Sustainable<br />Development</strong>
                <small>Building resilient communities for tomorrow.</small>
            </div>

            <a class="public-featured-project" asp-page="/FeaturedProject">
                <div class="public-featured-image" style="background-image:url('/img/carousel/Splash01.jpg')" aria-hidden="true"></div>
                <div class="public-featured-overlay">
                    <span>Featured Project</span>
                    <strong>Safer Homes, Stronger Communities</strong>
                    <small>View project →</small>
                </div>
            </a>
        </div>
    </section>
</section>

<style>
    .public-home {
        --home-navy: #062d50;
        --home-navy-deep: #042744;
        --home-orange: #f36c21;
        --home-text: #0e2c4d;
        --home-muted: #52677f;
        --home-border: #dce5ec;
        background: #fff;
        color: var(--home-text);
    }

    .public-hero {
        position: relative;
        min-height: 520px;
        overflow: hidden;
        background: var(--home-navy);
    }
    .public-hero-image,
    .public-hero-shade {
        position: absolute;
        inset: 0;
    }
    .public-hero-image {
        background-position: center;
        background-size: cover;
        transition: opacity .35s ease;
    }
    .public-hero-shade {
        background:
            linear-gradient(90deg, rgba(2,25,45,.88) 0%, rgba(2,25,45,.70) 37%, rgba(2,25,45,.18) 65%, rgba(2,25,45,.08) 100%),
            linear-gradient(180deg, rgba(3,27,49,.05), rgba(3,27,49,.24));
    }
    .public-hero-shell {
        position: relative;
        z-index: 3;
        min-height: 520px;
        display: grid;
        grid-template-columns: minmax(0, 1fr) minmax(330px, 390px);
        gap: clamp(30px, 5vw, 80px);
        align-items: center;
        padding-top: 34px;
        padding-bottom: 34px;
    }
    .public-hero-copy {
        max-width: 660px;
        color: #fff;
        text-shadow: 0 2px 12px rgba(0,0,0,.28);
    }
    .public-accent-line,
    .public-section-line {
        display: block;
        width: 44px;
        height: 4px;
        border-radius: 3px;
        background: var(--home-orange);
        margin-bottom: 20px;
    }
    .public-hero-copy h1 {
        margin: 0;
        color: #fff;
        font-size: clamp(2.35rem, 4.2vw, 4.3rem);
        line-height: 1.04;
        letter-spacing: -.035em;
    }
    .public-hero-copy p {
        max-width: 650px;
        margin: 18px 0 24px;
        color: #f4f7fa;
        font-size: clamp(1rem, 1.45vw, 1.22rem);
        line-height: 1.55;
    }
    .public-primary-action,
    .public-secondary-action,
    .public-outline-action {
        display: inline-flex;
        align-items: center;
        gap: 12px;
        text-decoration: none;
        font-weight: 800;
    }
    .public-primary-action {
        padding: 14px 24px;
        border-radius: 999px;
        background: var(--home-orange);
        color: #fff;
        box-shadow: 0 9px 24px rgba(244,108,33,.25);
    }
    .public-primary-action:hover {
        background: #dd5b16;
        color: #fff;
    }
    .public-secondary-action {
        display: flex;
        width: fit-content;
        margin-top: 17px;
        color: #fff;
        font-size: .94rem;
    }
    .public-secondary-action:hover { color: #fff; text-decoration: underline; }
    .public-card-action { margin-top: 12px; }

    .public-signin-card,
    .public-signedin-card {
        justify-self: end;
        width: min(100%, 390px);
    }
    .public-signedin-card {
        box-sizing: border-box;
        padding: 26px;
        border-radius: 16px;
        background: rgba(255,255,255,.96);
        box-shadow: 0 20px 52px rgba(3,22,39,.28);
        color: var(--home-text);
    }
    .public-signedin-label {
        color: var(--home-orange);
        font-size: .78rem;
        font-weight: 800;
        letter-spacing: .08em;
        text-transform: uppercase;
    }
    .public-signedin-card h2 { margin: 6px 0 8px; }
    .public-signedin-card p { margin: 0; color: var(--home-muted); line-height: 1.5; }

    .public-hero-arrow {
        position: absolute;
        z-index: 5;
        top: 50%;
        transform: translateY(-50%);
        width: 42px;
        height: 58px;
        border: 0;
        background: transparent;
        color: rgba(255,255,255,.95);
        font-size: 3rem;
        line-height: 1;
        cursor: pointer;
        text-shadow: 0 3px 12px rgba(0,0,0,.45);
    }
    .public-hero-prev { left: 12px; }
    .public-hero-next { right: 12px; }
    .public-carousel-dots {
        position: absolute;
        z-index: 5;
        left: 50%;
        bottom: 17px;
        transform: translateX(-50%);
        display: flex;
        gap: 8px;
    }
    .public-carousel-dot {
        width: 10px;
        height: 10px;
        padding: 0;
        border: 0;
        border-radius: 50%;
        background: rgba(255,255,255,.78);
        cursor: pointer;
    }
    .public-carousel-dot.active { background: var(--home-orange); }

    .public-help-section {
        padding: 38px 0 30px;
        background: linear-gradient(180deg, #f8fbfd, #f1f7fb);
    }
    .public-help-section h2,
    .public-impact-section h2 {
        margin: 0;
        color: var(--home-text);
        font-size: clamp(1.75rem, 2.6vw, 2.35rem);
        letter-spacing: -.025em;
    }
    .public-section-line { margin-bottom: 12px; }
    .public-section-intro {
        margin: 5px 0 22px;
        color: var(--home-muted);
        font-size: 1rem;
    }
    .public-help-grid {
        display: grid;
        grid-template-columns: repeat(4, minmax(0, 1fr));
        gap: 16px;
    }
    .public-help-card {
        display: grid;
        grid-template-columns: 62px minmax(0, 1fr);
        gap: 16px;
        min-height: 126px;
        box-sizing: border-box;
        padding: 18px;
        border: 1px solid var(--home-border);
        border-radius: 10px;
        background: #fff;
        box-shadow: 0 8px 22px rgba(17,43,66,.04);
    }
    .public-help-card h3 {
        margin: 4px 0 7px;
        color: var(--home-text);
        font-size: 1rem;
    }
    .public-help-card p {
        margin: 0;
        color: var(--home-muted);
        font-size: .88rem;
        line-height: 1.45;
    }
    .public-help-icon {
        display: grid;
        place-items: center;
        width: 58px;
        height: 58px;
        border-radius: 12px;
        font-size: 1.65rem;
        font-weight: 800;
    }
    .public-help-icon.orange { background: #fff0e7; color: #f36c21; }
    .public-help-icon.blue { background: #e7f3ff; color: #1767b1; }
    .public-help-icon.green { background: #e7f7f1; color: #19956d; }
    .public-help-icon.gold { background: #fff5d9; color: #a76b00; }

    .public-impact-section {
        padding: 24px 0 30px;
        background: linear-gradient(90deg, #fffdf7, #fffaf0);
        border-top: 1px solid #f0e8dc;
    }
    .public-impact-grid {
        display: grid;
        grid-template-columns: 1.45fr .65fr .65fr .65fr 1.2fr;
        gap: 0;
        align-items: stretch;
    }
    .public-impact-copy {
        padding: 10px 28px 10px 0;
    }
    .public-impact-copy p {
        margin: 8px 0 16px;
        max-width: 530px;
        color: var(--home-muted);
        line-height: 1.5;
    }
    .public-outline-action {
        padding: 10px 18px;
        border: 1.5px solid var(--home-orange);
        border-radius: 999px;
        color: var(--home-orange);
        font-size: .88rem;
    }
    .public-outline-action:hover {
        background: var(--home-orange);
        color: #fff;
    }
    .public-impact-item {
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        gap: 8px;
        padding: 18px;
        border-left: 1px solid #eadfce;
        text-align: center;
    }
    .public-impact-item strong {
        color: var(--home-text);
        font-size: 1rem;
        line-height: 1.15;
    }
    .public-impact-item small {
        color: var(--home-muted);
        line-height: 1.35;
    }
    .public-impact-icon {
        min-height: 42px;
        display: grid;
        place-items: center;
        font-size: 2.1rem;
        font-weight: 900;
        letter-spacing: -5px;
    }
    .public-impact-icon.orange { color: var(--home-orange); }
    .public-impact-icon.blue { color: #2677c9; }
    .public-impact-icon.green { color: #25936d; }

    .public-featured-project {
        position: relative;
        min-height: 196px;
        margin-left: 22px;
        overflow: hidden;
        border-radius: 12px;
        color: #fff;
        text-decoration: none;
        box-shadow: 0 12px 28px rgba(27,46,65,.12);
    }
    .public-featured-image {
        position: absolute;
        inset: 0;
        background-size: cover;
        background-position: center;
        transition: transform .25s ease;
    }
    .public-featured-project:hover .public-featured-image { transform: scale(1.03); }
    .public-featured-overlay {
        position: absolute;
        inset: 0;
        display: flex;
        flex-direction: column;
        justify-content: flex-end;
        gap: 5px;
        padding: 20px;
        background: linear-gradient(180deg, transparent 28%, rgba(2,28,51,.84) 100%);
        box-sizing: border-box;
    }
    .public-featured-overlay span {
        color: #ffc28c;
        font-size: .72rem;
        font-weight: 800;
        letter-spacing: .08em;
        text-transform: uppercase;
    }
    .public-featured-overlay strong { font-size: 1.05rem; }
    .public-featured-overlay small { font-weight: 700; color: #fff; }

    .home-signin-card {
        box-sizing: border-box;
        padding: 18px;
        border: 1px solid rgba(216,222,227,.9);
        border-radius: 14px;
        background:
            radial-gradient(circle at 100% 0, rgba(244,155,47,.12), transparent 34%),
            linear-gradient(145deg, rgba(255,255,255,.99) 0%, rgba(247,249,250,.98) 100%);
        box-shadow: 0 20px 52px rgba(3,22,39,.28);
    }
    .home-signin-heading {
        display: flex;
        align-items: flex-start;
        gap: 12px;
        padding-bottom: 16px;
        border-bottom: 1px solid #e3e7ea;
    }
    .home-signin-heading strong {
        display: block;
        font-size: 1.08rem;
        color: #172735;
    }
    .home-signin-heading small {
        display: block;
        margin-top: 4px;
        line-height: 1.45;
        color: #5d6871;
    }
    .home-signin-icon {
        display: grid;
        place-items: center;
        width: 38px;
        height: 38px;
        flex: 0 0 38px;
        border-radius: 10px;
        background: #172735;
        color: #fff;
        font-size: 1.15rem;
        font-weight: 800;
    }
    .home-signin-form { padding: 17px 0 4px; }
    .home-signin-form label {
        display: block;
        margin-bottom: 7px;
        color: #34434f;
        font-size: .78rem;
        font-weight: 800;
        letter-spacing: .04em;
        text-transform: uppercase;
    }
    .home-signin-provider-row {
        display: grid;
        grid-template-columns: minmax(0,1fr) auto;
        gap: 9px;
    }
    .provider-dropdown { position: relative; min-width: 0; }
    .provider-dropdown-trigger {
        width: 100%;
        min-height: 42px;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 14px;
        border: 1px solid #b7c0c7;
        border-radius: 4px;
        background: linear-gradient(#ffffff, #f3f4f5);
        padding: 0 10px 0 12px;
        color: #172735;
        font: inherit;
        cursor: pointer;
        box-shadow: inset 0 1px 0 rgba(255,255,255,.85);
    }
    .provider-dropdown-trigger:hover,
    .provider-dropdown-trigger[aria-expanded="true"] { border-color: #7f8c96; background: #fff; }
    .provider-dropdown-current,
    .provider-dropdown-menu button { display: flex; align-items: center; gap: 10px; }
    .provider-dropdown-chevron {
        border-left: 1px solid #d1d6da;
        padding-left: 10px;
        color: #56636d;
        font-size: .78rem;
    }
    .provider-dropdown-menu {
        position: absolute;
        z-index: 30;
        top: calc(100% + 4px);
        left: 0;
        right: 0;
        padding: 4px;
        border: 1px solid #aeb8c0;
        border-radius: 4px;
        background: #fff;
        box-shadow: 0 10px 26px rgba(25,39,52,.18);
    }
    .provider-dropdown-menu button {
        width: 100%;
        min-height: 38px;
        border: 0;
        border-radius: 2px;
        background: transparent;
