@page
@model RequestPortal.Web.Pages.Administration.StaffModel
@using Common.Security.Abstractions
@using Common.Security.Models
@using RequestPortal.Common.Security
@using RequestPortal.Web.Pages.Administration
@{ ViewData["Title"] = Model.Selected is null ? "Staff & Roles" : "Staff details"; }
@section Styles { <link rel="stylesheet" href="~/css/staff-administration.css" asp-append-version="true"/> }
<section class="section staff-administration"><div class="shell">
<div class="eyebrow">Administration</div><h1>@ViewData["Title"]</h1>
@if (!ViewData.ModelState.IsValid) { <div asp-validation-summary="All" class="flash error" role="alert"></div> }
@if (Model.Selected is { } staff)
{
<a class="staff-back" asp-page="Staff">← Staff &amp; Roles</a>
<form method="post" class="staff-details" data-staff-access>
<input type="hidden" asp-for="Id"/><input type="hidden" asp-for="Version"/><input type="hidden" name="Confirmed" value="false"/>
<div class="staff-details-grid">
<section class="card staff-information" aria-labelledby="staff-information-title">
<h2 id="staff-information-title">Staff Information</h2>
<div class="staff-fields"><div class="field"><label asp-for="DisplayName">Staff name</label><input asp-for="DisplayName" maxlength="200" required/></div>
<div class="field"><label asp-for="Email">Contact email</label><input asp-for="Email" type="email" maxlength="256"/></div></div>
<dl class="staff-facts"><div><dt>Account status</dt><dd><span class="staff-status">@StaffModel.StatusLabel(staff.Account.Status)</span></dd></div>
<div><dt>Authentication provider</dt><dd>@(staff.Account.ProviderKind switch { AuthenticationProviderKind.EntraId => "Microsoft Entra ID", AuthenticationProviderKind.ActiveDirectory => "Active Directory", AuthenticationProviderKind.External => "Staff identity provider", AuthenticationProviderKind.Mock => "Demo identity", _ => "Local account" })</dd></div>
<div><dt>Date registered</dt><dd>@StaffModel.DisplayTime(staff.Registered)</dd></div>
<div><dt>Last sign-in</dt><dd>@(staff.LastSignIn.HasValue ? StaffModel.DisplayTime(staff.LastSignIn) : "Never signed in")</dd></div></dl>
<details class="staff-disclosure" data-authentication-details><summary>Authentication Details</summary>
<dl><dt>Account ID</dt><dd>@staff.Account.Id</dd><dt>Username</dt><dd>@staff.Account.LoginName</dd></dl>
@foreach (var identity in staff.Identities) { <dl><dt>Provider</dt><dd>@identity.Key.ProviderId</dd><dt>Scope</dt><dd>@identity.Key.ScopeId</dd><dt>Provider subject</dt><dd>@identity.Key.SubjectId</dd></dl> }
</details>
</section>
<section class="card staff-access" aria-labelledby="staff-access-title"><h2 id="staff-access-title">Access &amp; Roles</h2>
<fieldset class="staff-role-options"><legend class="sr-only">Assigned roles</legend>
@foreach (var role in Model.Roles) {
<label class="staff-role"><input type="checkbox" name="SelectedRoles" value="@role.Key" checked="@(Model.SelectedRoles.Contains(role.Key))"/><span><strong>@role.Name</strong><small>@(role.Key == PortalRoles.Administrator ? "Manage staff access and administer the portal." : "Review requests and view management dashboards.")</small></span></label>
}
</fieldset>
<div class="staff-permission-summary"><h3>Effective access</h3><p>@Model.PermissionSummary</p></div>
<details class="staff-disclosure" data-permission-details><summary>Permission details</summary>
@if (Model.Permissions.Count == 0) { <p>No active permissions.</p> }
else { <ul>@foreach(var permission in Model.Permissions) { <li><code>@permission</code></li> }</ul> }
</details>
</section></div>
<div class="staff-controls"><div class="action-row"><button class="button" name="operation" value="Save">Save Changes</button><a class="button button-outline" asp-page="Staff">Cancel</a></div>
<div class="action-row">
@if (staff.Account.Status == SecurityAccountStatus.Active) {
<button class="button button-outline" name="operation" value="Suspend" data-confirm="Suspend access for this staff member? They will need to be activated before signing in again.">Suspend</button>
} else { <button class="button button-outline" name="operation" value="Activate">Activate</button> }
@if (staff.Account.Status != SecurityAccountStatus.Disabled) {
<button class="button button-outline staff-danger" name="operation" value="Revoke" data-confirm="Revoke this staff member’s access and remove their staff roles?">Revoke Access</button>
}
</div></div>
</form>
<details class="card staff-audit staff-disclosure" data-audit-history><summary>Audit History</summary>
<div class="staff-table-scroll"><table><thead><tr><th>When (Jamaica)</th><th>Actor</th><th>Action</th><th>Role changes</th></tr></thead><tbody>
@foreach (var entry in Model.History) { <tr><td><time title="@entry.Time">@StaffModel.DisplayAuditTime(entry.Time)</time></td><td>@(entry.Actor.StartsWith("offline:",StringComparison.Ordinal)?"Provisioning · "+entry.Actor[8..]:entry.Actor)</td><td>@StaffModel.ActionLabel(entry.Action)@if(!string.IsNullOrWhiteSpace(entry.Detail)) { <details><summary>Details</summary><p>@entry.Detail</p></details> }</td><td>
@if (entry.PreviousRoles is not null) { <span>@(entry.PreviousRoles.Length==0?"No roles":string.Join(", ",entry.PreviousRoles)) → @(entry.NewRoles?.Length>0?string.Join(", ",entry.NewRoles):"No roles")</span> }
else { <details><summary>Details</summary><p>@entry.Action</p></details> }
</td></tr> }
</tbody></table></div></details>
}
else
{
@if (!Model.Provisioned) { <p class="flash">Initial administrator provisioning has not been recorded. See the administrator provisioning runbook.</p> }
<form method="get" class="staff-directory-form" data-staff-directory-filters>
<input type="hidden" name="Sort" value="@(Model.Sort ?? "name")"/>
<div class="card staff-table-scroll staff-directory-scroll" role="region" aria-label="Staff directory, scroll to view more staff and columns" tabindex="0"><table class="staff-directory-table"><thead><tr>
<th scope="col" class="staff-name-header"><div class="staff-header-inline"><a class="staff-header-sort" asp-page="Staff" asp-route-Search="@Model.Search" asp-route-Status="@Model.Status" asp-route-Role="@Model.Role" asp-route-Sort="name">Name</a><input asp-for="Search" type="search" aria-label="Search staff by name, username, email or provider" placeholder="Search staff…" autocomplete="off"/></div></th>
<th scope="col"><a class="staff-header-sort" asp-page="Staff" asp-route-Search="@Model.Search" asp-route-Status="@Model.Status" asp-route-Role="@Model.Role" asp-route-Sort="username">Username</a></th>
<th scope="col"><a class="staff-header-sort" asp-page="Staff" asp-route-Search="@Model.Search" asp-route-Status="@Model.Status" asp-route-Role="@Model.Role" asp-route-Sort="email">Email</a></th>
<th scope="col" class="staff-status-header"><select asp-for="Status" aria-label="Filter by account status"><option value="">All statuses</option>@foreach(var status in Enum.GetValues<SecurityAccountStatus>()) { <option value="@status">@StaffModel.StatusLabel(status)</option> }</select></th>
<th scope="col" class="staff-role-header"><select asp-for="Role" aria-label="Filter by staff role"><option value="">All roles</option>@foreach(var role in Model.Roles) { <option value="@role.Key">@role.Name</option> }</select></th>
<th scope="col"><a class="staff-header-sort" asp-page="Staff" asp-route-Search="@Model.Search" asp-route-Status="@Model.Status" asp-route-Role="@Model.Role" asp-route-Sort="last">Last sign-in</a></th>
<th scope="col"><a class="staff-header-sort" asp-page="Staff" asp-route-Search="@Model.Search" asp-route-Status="@Model.Status" asp-route-Role="@Model.Role" asp-route-Sort="registered">Registered</a></th>
<th scope="col" class="staff-add-header"><a class="button button-small" asp-page="AddStaff">Add Staff</a></th>
</tr></thead><tbody>
@foreach(var entry in Model.Entries) {
<tr><td><a asp-page="Staff" asp-route-Id="@entry.Account.Id">@entry.Account.DisplayName</a></td><td>@entry.Account.LoginName</td><td>@entry.Email</td><td>@StaffModel.StatusLabel(entry.Account.Status)</td><td>@string.Join(", ",entry.Roles.Where(x=>x==PortalRoles.Administrator||x==PortalRoles.Reviewer))</td><td>@(entry.LastSignIn.HasValue ? StaffModel.DisplayTime(entry.LastSignIn) : "Never signed in")</td><td>@StaffModel.DisplayTime(entry.Registered)</td><td><a class="button button-small @(entry.Account.Status == SecurityAccountStatus.PendingAccess ? "staff-review-access" : "button-outline")" asp-page="Staff" asp-route-Id="@entry.Account.Id" aria-label="@(entry.Account.Status == SecurityAccountStatus.PendingAccess ? "Review access for " : "Manage ")@entry.Account.DisplayName">@(entry.Account.Status == SecurityAccountStatus.PendingAccess ? "Review access" : "Manage")</a></td></tr>
}
</tbody></table>@if (Model.Entries.Count == 0) { <p>No staff match these filters.</p> }</div></form>

}
</div></section>
@section Scripts { <script src="~/js/staff-administration.js" asp-append-version="true"></script> }
