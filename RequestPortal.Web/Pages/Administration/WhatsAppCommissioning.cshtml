@page
@model RequestPortal.Web.Pages.Administration.WhatsAppCommissioningModel
@{ ViewData["Title"] = "WhatsApp commissioning test"; }
<h1>WhatsApp commissioning test</h1>
<p>This administrator-only facility sends one approved <strong>hello_world / en_US</strong> template using the configured Meta test sender. General WhatsApp notifications remain disabled. It never contacts applicants automatically.</p>
@if (Model.Alert is not null) { <p role="alert">@Model.Alert</p> }
<form method="post" asp-page-handler="Check"><button type="submit">Check sender, token permission and template</button></form>
@if (Model.Readiness is { } ready)
{
    <dl>
        <dt>Ready for recipient authorization</dt><dd>@ready.Ready</dd>
        <dt>Check stage</dt><dd>@ready.Stage</dd>
        <dt>Meta Phone Number ID</dt><dd>@ready.PhoneNumberId</dd>
        <dt>Graph API</dt><dd>@ready.ApiVersion</dd>
        <dt>Token source</dt><dd>OpenBao / @ready.TokenReference</dd>
        <dt>Messaging permission confirmed</dt><dd>@ready.MessagingPermissionConfirmed</dd>
        <dt>hello_world / en_US approved</dt><dd>@ready.TemplateApproved</dd>
        <dt>HTTP / Meta error / subcode</dt><dd>@ready.HttpStatus / @ready.ErrorCode / @ready.ErrorSubcode</dd>
    </dl>
}
@if (Model.Test is not { } test)
{
    @if (Model.OperationId is not null)
    {
        <p>Operation status is unavailable. Refresh this operation before authorizing any replacement test; an earlier send may already have been accepted.</p>
        <a asp-page="/Administration/WhatsAppCommissioning" asp-route-OperationId="@Model.OperationId">Refresh operation status</a>
    }
    else
    {
    <h2>Authorize a verified test recipient</h2>
    <p>First verify this recipient in Meta's API Setup test-recipient list. Enter the E.164 number twice, including + and country code. This step authorizes a recipient for ten minutes and does not send.</p>
    <form method="post" asp-page-handler="Authorize" autocomplete="off">
        <label asp-for="Recipient">Verified test recipient</label><input asp-for="Recipient" type="password" autocomplete="new-password" maxlength="16" required />
        <label asp-for="RepeatRecipient">Repeat recipient</label><input asp-for="RepeatRecipient" type="password" autocomplete="new-password" maxlength="16" required />
        <label><input asp-for="VerifiedInMeta" /> I confirm this recipient is verified in Meta's test-recipient list.</label>
        <label><input asp-for="AuthorizeRecipient" /> I explicitly authorize this recipient for one hello_world test.</label>
        <button type="submit">Authorize recipient only</button>
    </form>
    }
}
else
{
    <h2>Test operation @test.Id</h2>
    <dl>
        <dt>State</dt><dd>@test.State</dd>
        <dt>Authorized / expires UTC</dt><dd>@test.AuthorizedUtc.ToString("u") / @test.ExpiresUtc.ToString("u")</dd>
        <dt>Attempted / recorded UTC</dt><dd>@test.AttemptedUtc?.ToString("u") / @test.CompletedUtc?.ToString("u")</dd>
        <dt>HTTP / Meta error / subcode</dt><dd>@test.HttpStatus / @test.ErrorCode / @test.ErrorSubcode</dd>
        <dt>Message ID SHA-256 fingerprint</dt><dd>@test.MessageIdFingerprint</dd>
    </dl>
    @if (test.State == "Authorized")
    {
        <form method="post" asp-page-handler="Send">
            <input type="hidden" asp-for="OperationId" />
            <label asp-for="Confirmation">To explicitly authorize the send, type SEND HELLO_WORLD</label>
            <input asp-for="Confirmation" autocomplete="off" required />
            <button type="submit">Send hello_world once to the authorized recipient</button>
        </form>
    }
    else
    {
        <p>This authorization cannot be sent again. Accepted means Meta accepted the request; delivery requires a delivered or read webhook receipt. Attempted or Unknown may represent an accepted send and must not be retried blindly.</p>
    }
    <h3>Correlated delivery receipts</h3>
    @if (test.Delivery.Count == 0) { <p>No processed delivery-status receipt has been correlated yet.</p> }
    else
    {
        <table><thead><tr><th>Status</th><th>Recorded UTC</th><th>Numeric errors</th></tr></thead><tbody>
        @foreach (var delivery in test.Delivery) { <tr><td>@delivery.State</td><td>@delivery.RecordedUtc?.ToString("u")</td><td>@string.Join(", ", delivery.ErrorCodes)</td></tr> }
        </tbody></table>
    }
    <a asp-page="/Administration/WhatsAppCommissioning" asp-route-OperationId="@test.Id">Refresh status without sending</a>
}
