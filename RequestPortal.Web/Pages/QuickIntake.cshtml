@page
@model RequestPortal.Web.Pages.QuickIntakeModel
@{
    ViewData["Title"] = "Quick Intake";
}

<section class="quick-intake-page">
    <div class="quick-intake-shell">
        @if (!string.IsNullOrWhiteSpace(Model.RequestReference))
        {
            <section class="quick-intake-card quick-intake-complete" role="status">
                <div class="quick-intake-complete-icon" aria-hidden="true">✓</div>
                <h1>Request received</h1>
                <p>Your request has been sent to Food For The Poor Jamaica.</p>
                <div class="quick-intake-reference">
                    <span>Request reference</span>
                    <strong>@Model.RequestReference</strong>
                </div>
                @if (!string.IsNullOrWhiteSpace(Model.AttachmentWarning))
                {
                    <p class="quick-intake-errors" role="alert">@Model.AttachmentWarning</p>
                }
                <p class="quick-intake-muted">We may use <strong>@Model.Telephone</strong> to contact you about this request.</p>
                <a class="quick-intake-primary" asp-page="/Index">Return to Request Portal</a>
            </section>
        }
        else
        {
            <section class="quick-intake-card">
                <header class="quick-intake-header">
                    <div>
                        <h1>Quick Intake Form</h1>
                        <p>@(User.Identity?.IsAuthenticated == true ? "Your request will be linked to your account." : "No account needed.") All fields are required except secondary phone number, Email and supporting attachments.</p>
                    </div>
                </header>

                <form method="post" enctype="multipart/form-data" class="quick-intake-form" id="quickIntakeForm">
                    @Html.AntiForgeryToken()
                    <div asp-validation-summary="ModelOnly" class="quick-intake-errors"></div>
                    <input asp-for="Input.Website" class="quick-intake-trap" tabindex="-1" autocomplete="off" aria-hidden="true" />

                    <h2>Personal Information</h2>
                    <div class="quick-intake-row">
                        <label><span>First Name <b>*</b></span><input asp-for="Input.FirstName" autocomplete="given-name" /><span asp-validation-for="Input.FirstName"></span></label>
                        <label><span>Last Name <b>*</b></span><input asp-for="Input.LastName" autocomplete="family-name" /><span asp-validation-for="Input.LastName"></span></label>
                    </div>
                    <div class="quick-intake-row">
                        <label><span>Date Of Birth <b>*</b></span><input asp-for="Input.DateOfBirth" type="date" /><span asp-validation-for="Input.DateOfBirth"></span></label>
                        <label><span>Gender <b>*</b></span>
                            <select asp-for="Input.Gender"><option value="">Select</option><option>Male</option><option>Female</option><option>Prefer not to Say</option></select>
                            <span asp-validation-for="Input.Gender"></span>
                        </label>
                    </div>
                    <label><span>Marital Status <b>*</b></span>
                        <select asp-for="Input.MaritalStatus"><option value="">Select</option><option>Single</option><option>Married</option><option>Divorced</option><option>Widowed</option></select>
                        <span asp-validation-for="Input.MaritalStatus"></span>
                    </label>

                    <h2>Contact & Address</h2>
                    <div class="quick-intake-row">
                        <label><span>Telephone <b>*</b></span><input asp-for="Input.Telephone" type="tel" inputmode="tel" autocomplete="tel" /><span asp-validation-for="Input.Telephone"></span></label>
                        <label><span>Secondary Phone Number <em>(Optional)</em></span><input asp-for="Input.SecondaryTelephone" type="tel" inputmode="tel" autocomplete="section-secondary tel" maxlength="40" /><span asp-validation-for="Input.SecondaryTelephone"></span></label>
                    </div>
                    <div class="quick-intake-row">
                        <label><span>Email <em>(Optional)</em></span><input asp-for="Input.Email" type="email" autocomplete="email" /><span asp-validation-for="Input.Email"></span></label>
                    </div>
                    <label><span>Address <b>*</b></span><input asp-for="Input.StreetAddress" autocomplete="street-address" /><span asp-validation-for="Input.StreetAddress"></span></label>
                    <div class="quick-intake-row">
                        <label><span>Community/District <b>*</b></span><input asp-for="Input.CommunityDistrict" autocomplete="address-level2" /><span asp-validation-for="Input.CommunityDistrict"></span></label>
                        <label><span>Parish <b>*</b></span>
                            <select asp-for="Input.Parish">
                                <option value="">Select parish</option>
                                <option>Kingston</option><option>St. Andrew</option><option>St. Catherine</option><option>Clarendon</option>
                                <option>Manchester</option><option>St. Elizabeth</option><option>Westmoreland</option><option>Hanover</option>
                                <option>St. James</option><option>Trelawny</option><option>St. Ann</option><option>St. Mary</option>
                                <option>Portland</option><option>St. Thomas</option>
                            </select>
                            <span asp-validation-for="Input.Parish"></span>
                        </label>
                    </div>

                    <h2>Household & Economic Information</h2>
                    <div class="quick-intake-row">
                        <label><span>Employment Status <b>*</b></span>
                            <select asp-for="Input.EmploymentStatus"><option value="">Select</option><option>Employed</option><option>Self Employed</option><option>Unemployed</option><option>Student</option></select>
                            <span asp-validation-for="Input.EmploymentStatus"></span>
                        </label>
                        <label><span>Monthly Income <b>*</b></span><input asp-for="Input.MonthlyIncome" type="number" min="0" step="0.01" inputmode="decimal" /><span asp-validation-for="Input.MonthlyIncome"></span></label>
                    </div>
                    <label><span>Do you have any children under 18 years of age that live with you full time? <b>*</b></span>
                        <select asp-for="Input.HasChildrenUnder18LivingFullTime"><option value="">Select</option><option>Yes</option><option>No</option></select>
                        <span asp-validation-for="Input.HasChildrenUnder18LivingFullTime"></span>
                    </label>
                    <label><span>Do you have a disability or serious medical condition? <b>*</b></span>
                        <select asp-for="Input.HasDisabilityOrSeriousMedicalCondition"><option value="">Select</option><option>Yes</option><option>No</option></select>
                        <span asp-validation-for="Input.HasDisabilityOrSeriousMedicalCondition"></span>
                    </label>

                    <fieldset class="choice-group">
                        <legend>Are you a victim of any of the following? <b>*</b></legend>
                        <p>Select all that apply, or select None of the Above.</p>
                        @foreach (string circumstance in RequestPortal.Application.Requests.QuickIntakeVictimCircumstances.Options)
                        {
                            <label class="check-option"><input type="checkbox" name="Input.VictimCircumstances" value="@circumstance" checked="@Model.Input.VictimCircumstances.Contains(circumstance)" /><span>@circumstance</span></label>
                        }
                        <span asp-validation-for="Input.VictimCircumstances"></span>
                    </fieldset>

                    <h2>Current Assistance</h2>
                    <fieldset class="choice-group">
                        <legend>Do you currently participate in any of the following programs? Select all that apply. <b>*</b></legend>
                        @foreach (string program in RequestPortal.Application.Requests.ProfileIntakeChoices.Programs)
                        {
                            <label class="check-option"><input type="checkbox" name="Input.AssistancePrograms" value="@program" checked="@Model.Input.AssistancePrograms.Contains(program)" /><span>@program</span></label>
                        }
                        <span asp-validation-for="Input.AssistancePrograms"></span>
                    </fieldset>

                    <h2>What do you need help with today? <b>*</b></h2>
                    <div class="help-grid">
                        @foreach (var item in new[] {
                            ("Food", "Food Package, Backyard Garden, etc."),
                            ("Housing", "Homeless, needs repairs, etc."),
                            ("Earn an Income", "Starting a business, just released from prison, etc."),
                            ("Education", "Scholarship, band camp, etc."),
                            ("Health", "Wheelchair, medical supplies, etc."),
                            ("Water & Hygiene", "Water tank, toiletries, etc.")
                        })
                        {
                            <label class="help-card">
                                <input type="radio" asp-for="Input.HelpCategory" value="@item.Item1" />
                                <span><strong>@item.Item1</strong><small>@item.Item2</small></span>
                            </label>
                        }
                    </div>
                    <span asp-validation-for="Input.HelpCategory"></span>

                    <details class="quick-intake-attachments">
                        <summary>📎 Attach photos or documents (optional)</summary>
                        <div class="quick-intake-attachment-body">
                            <p>Photos and PDF documents can help us understand your request. You may submit without attachments. Up to 5 files, 10 MB each.</p>
                            <div class="quick-intake-upload-actions">
                            <div class="quick-intake-file-picker">
                                <label for="Attachments" class="quick-intake-camera-button">
                                    <svg viewBox="0 0 24 24" width="23" height="23" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 16V3m0 0L7 8m5-5 5 5"/><path d="M4 15v4a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2v-4"/></svg>
                                    <span>Add photos or documents</span>
                                </label>
                                <input asp-for="Attachments" type="file" multiple accept="image/jpeg,image/png,application/pdf" class="quick-intake-camera-input" aria-label="Choose photos or documents" />
                                <span id="quickIntakeFileSelection" class="quick-intake-muted" aria-live="polite">JPG, PNG or PDF</span>
                            </div>
                            <div class="quick-intake-camera">
                                <label for="CameraPhotos" class="quick-intake-camera-button">
                                    <svg viewBox="0 0 24 24" width="23" height="23" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M14 4h-4l-2 3H4a2 2 0 0 0-2 2v9a2 2 0 0 0 2 2h16a2 2 0 0 0 2-2V9a2 2 0 0 0-2-2h-4l-2-3Z"/><circle cx="12" cy="13" r="3"/></svg>
                                    <span>Take a photo</span>
                                </label>
                                <input asp-for="CameraPhotos" type="file" accept="image/*" capture="environment" class="quick-intake-camera-input" aria-label="Take a photo with your camera" />
                                <span id="quickIntakeCameraSelection" class="quick-intake-muted" aria-live="polite">Use your phone or tablet camera</span>
                            </div>
                            </div>
                            <span asp-validation-for="Attachments"></span>
                        </div>
                    </details>
                    <button class="quick-intake-primary" id="quickIntakeSubmit" type="submit"><span id="quickIntakeSubmitLabel">Submit</span><span class="quick-intake-spinner" aria-hidden="true"></span></button>
                    <p id="quickIntakeSubmitStatus" class="quick-intake-submit-status" role="status" aria-live="polite" hidden>Submitting your request. Please wait…</p>
                    <progress id="quickIntakeProgress" max="100" value="0" hidden style="width:100%"></progress>
                    <button id="quickIntakeRetry" type="button" hidden class="quick-intake-primary">Retry upload</button>
                    <div id="quickIntakeResult" role="status" aria-live="polite" hidden></div>
                </form>
            </section>
        }
    </div>
</section>

<style>
.quick-intake-page{min-height:100vh;padding:18px 12px 38px;background:linear-gradient(180deg,#f3f7fa,#fff);color:#14324d}
.quick-intake-shell{width:min(100%,760px);margin:auto}.quick-intake-card{background:#fff;border:1px solid #dbe5ec;border-radius:16px;box-shadow:0 14px 36px rgba(13,49,78,.1);overflow:hidden}
.quick-intake-header{padding:22px;border-bottom:1px solid #e7eef3;background:#fffaf4}.quick-intake-header h1{margin:0;color:#0b2d57;font-size:1.8rem}.quick-intake-header p{margin:6px 0 0;color:#5b6f83}
.quick-intake-form{display:grid;gap:14px;padding:20px 22px 24px}.quick-intake-form h2{margin:10px 0 0;color:#0b2d57;font-size:1rem;border-bottom:1px solid #e6edf2;padding-bottom:6px}
.quick-intake-row{display:grid;grid-template-columns:1fr 1fr;gap:14px}.quick-intake-form label{display:grid;gap:6px;font-size:.88rem;font-weight:800;color:#173b60}
.quick-intake-form b{color:#c92f2f}.quick-intake-form em{font-style:normal;font-weight:600;color:#6f7d89}.quick-intake-form input,.quick-intake-form select{width:100%;box-sizing:border-box;min-height:48px;padding:10px 12px;border:1px solid #cbd8e2;border-radius:9px;background:#fff;color:#0e2c4d;font:inherit;font-weight:500}
.quick-intake-form input:focus,.quick-intake-form select:focus{border-color:#f36c21;outline:3px solid rgba(243,108,33,.12)}
.choice-group{border:1px solid #dbe5ec;border-radius:10px;padding:12px}.choice-group legend{padding:0 6px;font-weight:800;font-size:.88rem;color:#173b60}.check-option{grid-template-columns:auto 1fr!important;align-items:center!important;gap:8px!important;margin:7px 0}.check-option input{width:18px;height:18px;min-height:18px}
.help-grid{display:grid;grid-template-columns:1fr 1fr;gap:10px}.help-card{grid-template-columns:auto 1fr!important;align-items:start!important;padding:12px;border:1px solid #dbe5ec;border-radius:10px;cursor:pointer}.help-card:has(input:checked){border-color:#f36c21;background:#fff7f1}.help-card input{width:18px;height:18px;min-height:18px;margin-top:2px}.help-card strong,.help-card small{display:block}.help-card small{margin-top:3px;color:#65788b;font-weight:500;line-height:1.35}
.quick-intake-attachments{border:1px solid #dbe5ec;border-radius:10px;overflow:hidden}.quick-intake-attachments summary{padding:12px 14px;cursor:pointer;font-size:.9rem;font-weight:800;color:#173b60}.quick-intake-attachments summary:focus-visible{outline:3px solid #f36c21}.quick-intake-attachment-body{padding:0 14px 14px;display:grid;gap:12px}.quick-intake-attachment-body p{font-size:.85rem;color:#5b6f83;margin:0}.quick-intake-primary{min-height:52px;border:0;border-radius:9px;background:#f36c21;color:#fff;font:inherit;font-weight:900;cursor:pointer}.quick-intake-errors,.field-validation-error{color:#a32920;font-size:.82rem}.quick-intake-trap{position:absolute!important;left:-10000px!important;width:1px!important;height:1px!important}
.quick-intake-upload-actions{display:grid;grid-template-columns:minmax(0,1fr) minmax(0,1fr);gap:12px;align-items:start}.quick-intake-camera,.quick-intake-file-picker{display:grid;gap:7px;min-width:0}.quick-intake-upload-actions .quick-intake-camera-button{min-height:60px;text-align:center;line-height:1.2}.quick-intake-upload-actions .quick-intake-muted{font-size:.78rem;overflow-wrap:anywhere}.quick-intake-camera-button{display:flex!important;align-items:center;justify-content:center;gap:10px;min-height:52px;padding:8px 14px;border:1px solid #cbd8e2;border-radius:10px;background:#edf5fb;color:#173b60;cursor:pointer;font-weight:800}.quick-intake-camera-button:hover{background:#e0effa}.quick-intake-form input.quick-intake-camera-input{position:absolute;width:1px;height:1px;min-height:0;padding:0;opacity:0;overflow:hidden}.quick-intake-camera:focus-within .quick-intake-camera-button,.quick-intake-file-picker:focus-within .quick-intake-camera-button{outline:3px solid rgba(243,108,33,.35)}.quick-intake-submit-status{text-align:center;color:#173b60;font-size:.9rem;font-weight:700;margin:0}.quick-intake-primary:disabled{opacity:.8;cursor:wait}.quick-intake-spinner{display:none;width:17px;height:17px;border:2px solid rgba(255,255,255,.5);border-top-color:white;border-radius:50%;animation:quick-intake-spin .8s linear infinite;margin-left:9px;vertical-align:middle}.quick-intake-primary:disabled .quick-intake-spinner{display:inline-block}@@keyframes quick-intake-spin{to{transform:rotate(360deg)}}
.quick-intake-complete{padding:30px 24px;text-align:center}.quick-intake-complete-icon{display:grid;place-items:center;width:58px;height:58px;margin:0 auto 14px;border-radius:50%;background:#eaf8ef;color:#21834c;font-size:1.7rem;font-weight:900}.quick-intake-reference{display:grid;gap:3px;margin:20px 0;padding:16px;border:1px solid #dce7ee;border-radius:12px;background:#f7fafc}.quick-intake-reference strong{font-size:1.4rem}.quick-intake-muted{color:#617488}
@@media(max-width:620px){.quick-intake-page{padding:8px}.quick-intake-card{border-radius:12px}.quick-intake-form{padding:16px}.quick-intake-row,.help-grid{grid-template-columns:1fr}.quick-intake-form input,.quick-intake-form select{font-size:16px}}
</style>

<script>
(() => {
    const form = document.getElementById('quickIntakeForm');
    if (!form) return;
    for (const field of ['Input.VictimCircumstances', 'Input.AssistancePrograms']) {
        const boxes = Array.from(form.querySelectorAll('input[type="checkbox"]')).filter(box => box.name === field);
        boxes.forEach(box => box.addEventListener('change', () => {
            if (!box.checked) return;
            if (box.value === 'None of the Above') boxes.filter(other => other !== box).forEach(other => other.checked = false);
            else boxes.filter(other => other.value === 'None of the Above').forEach(other => other.checked = false);
        }));
    }
    const button = document.getElementById('quickIntakeSubmit');
    const label = document.getElementById('quickIntakeSubmitLabel');
    const status = document.getElementById('quickIntakeSubmitStatus');
    const filesInput = document.getElementById('Attachments');
    const fileSelection = document.getElementById('quickIntakeFileSelection');
    if (filesInput && fileSelection) {
        filesInput.addEventListener('change', () => {
            const files = Array.from(filesInput.files || []);
            fileSelection.textContent = files.length
                ? (files.length === 1 ? 'Selected: ' + files[0].name : files.length + ' files selected')
                : 'JPG, PNG or PDF';
        });
    }
    const camera = document.getElementById('CameraPhotos');
    const selection = document.getElementById('quickIntakeCameraSelection');
    if (camera && selection) {
        camera.addEventListener('change', () => {
            const count = camera.files?.length || 0;
            selection.textContent = count ? (count === 1 ? 'Photo ready: ' + camera.files[0].name : count + ' photos ready') : 'Use your phone or tablet camera';
        });
    }
    const progress = document.getElementById('quickIntakeProgress');
    const retry = document.getElementById('quickIntakeRetry');
    const resultBox = document.getElementById('quickIntakeResult');
    const key = 'quickIntakeSubmissionId';
    const uuid = () => crypto.randomUUID();
    let submissionId = sessionStorage.getItem(key) || uuid();
    sessionStorage.setItem(key, submissionId);
    let saved = null;
    let nextFile = 0;
    let busy = false;
    const attachments = () => [
        ...Array.from(document.getElementById('Attachments')?.files || []),
        ...Array.from(camera?.files || [])
    ];
    const token = form.querySelector('input[name="__RequestVerificationToken"]')?.value;
    const request = (handler, data, onProgress) => new Promise((resolve, reject) => {
        const xhr = new XMLHttpRequest();
        xhr.open('POST', form.action.split('?')[0] + '?handler=' + handler);
        xhr.setRequestHeader('RequestVerificationToken', token);
        xhr.responseType = 'json';
        xhr.onload = () => xhr.status >= 200 && xhr.status < 300
            ? resolve(xhr.response)
            : reject(new Error(xhr.response?.error || 'The server could not complete this step.'));
        xhr.onerror = () => reject(new Error('Connection lost. Please retry.'));
        xhr.ontimeout = () => reject(new Error('The request timed out. Please retry.'));
        xhr.timeout = 120000;
        if (onProgress) xhr.upload.onprogress = event => {
            if (event.lengthComputable) onProgress(Math.round(100 * event.loaded / event.total));
        };
        xhr.send(data);
    });
    const setBusy = value => {
        busy = value;
        button.disabled = value;
        button.setAttribute('aria-busy', String(value));
        label.textContent = value ? 'Submitting…' : 'Submit';
    };
    async function submitStages() {
        if (busy) return;
        setBusy(true);
        retry.hidden = true;
        resultBox.hidden = true;
        try {
            const files = attachments();
            if (files.length > 5 || files.some(f => f.size > 10 * 1024 * 1024 || f.size === 0))
                throw new Error('Choose up to 5 files, each between 1 byte and 10 MB.');
            if (!saved) {
                status.hidden = false;
                status.textContent = 'Saving your request information…';
                const data = new FormData(form);
                data.delete('Attachments');
                data.delete('CameraPhotos');
                data.append('SubmissionId', submissionId);
                saved = await request('Start', data);
            }
            progress.hidden = files.length === 0;
            for (; nextFile < files.length; nextFile++) {
                status.textContent = 'Uploading attachment ' + (nextFile + 1) + ' of ' + files.length + '…';
                progress.value = 0;
                const data = new FormData();
                data.append('SubmissionId', submissionId);
                data.append('RequestId', saved.requestId);
                data.append('AttachmentIndex', String(nextFile));
                data.append('AttachmentFile', files[nextFile], files[nextFile].name);
                await request('Upload', data, percent => { progress.value = percent; });
            }
            status.hidden = true;
            progress.hidden = true;
            form.hidden = true;
            resultBox.hidden = false;
            resultBox.innerHTML = '';
            const heading = document.createElement('h2');
            heading.textContent = 'Request received';
            const reference = document.createElement('p');
            reference.textContent = 'Your request reference: ' + saved.reference;
            resultBox.append(heading, reference);
            form.parentNode.appendChild(resultBox);
            sessionStorage.removeItem(key);
        } catch (error) {
            status.hidden = false;
            status.textContent = saved
                ? 'Your request information is saved. An attachment could not be uploaded: ' + error.message
                : 'Your request could not be confirmed: ' + error.message;
            retry.hidden = !saved;
            label.textContent = 'Retry submission';
        } finally {
            setBusy(false);
        }
    }
    form.addEventListener('submit', event => {
        event.preventDefault();
        if (busy || !form.checkValidity()) return;
        submitStages();
    });
    retry.addEventListener('click', submitStages);
})();
</script>

<script src="~/js/intake-exclusive-none.js" asp-append-version="true" defer></script>
