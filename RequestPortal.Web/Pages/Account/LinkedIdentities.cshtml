@page
@model RequestPortal.Web.Pages.Account.LinkedIdentitiesModel
@{ViewData["Title"]="Sign-in methods";}
<section class="section"><div class="shell"><div class="card">
<h1>Sign-in methods</h1><p>Link another provider while signed in to your existing account. A matching email address does not link accounts.</p>
@if(TempData["Error"] is string error){<p role="alert">@error</p>}
@foreach(var identity in Model.Identities){<form method="post" asp-page-handler="Unlink"><strong>@identity.Key.ProviderId</strong>
<input type="hidden" name="providerId" value="@identity.Key.ProviderId"/><input type="hidden" name="scopeId" value="@identity.Key.ScopeId"/><input type="hidden" name="subjectId" value="@identity.Key.SubjectId"/>
<button class="button button-outline" type="submit" disabled="@(Model.Identities.Count<=1)">Unlink and sign out</button></form>}
@foreach(var provider in Model.Providers){<form method="post" asp-page-handler="Link"><input type="hidden" name="provider" value="@provider"/><button class="button" type="submit">Link @provider</button></form>}
<a asp-page="/Account/Profile">Back to profile</a></div></div></section>
