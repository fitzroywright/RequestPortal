@page
@model RequestPortal.Web.Pages.Account.NotificationsModel
@using RequestPortal.Application.Notifications
@using RequestPortal.Domain.Notifications
@{
    ViewData["Title"] = "Notifications";
    NotificationPreferenceView? email = Model.FindPreference(NotificationChannel.Email);
    NotificationPreferenceView? whatsapp = Model.FindPreference(NotificationChannel.WhatsApp);
}

<section class="section">
    <div class="shell">
        <div class="section-heading">
            <div class="eyebrow" style="color:#b45b09">Communication preferences</div>
            <h1>Notifications</h1>
            <p>Choose how Request Portal should contact you about organization approvals, membership changes and request status updates.</p>
        </div>

        <div asp-validation-summary="ModelOnly" class="validation"></div>

        <div class="grid-2">
            <article class="card">
                <h2>Email</h2>
                @if (Model.EmailAvailable)
                {
                    <p class="muted">Email delivery is commissioned in this environment.</p>
                    <form method="post" asp-page-handler="Save">
                        <input type="hidden" name="Input.Channel" value="Email" />
                        <label for="emailDestination">Email address</label>
                        <input id="emailDestination" name="Input.Destination" value="@(email?.Destination ?? Model.DefaultEmail)" maxlength="500" required />
                        <label class="check-row">
                            <input type="checkbox" name="Input.Enabled" value="true" @(email?.Enabled != false ? "checked" : null) />
                            <span>Send email notifications</span>
                        </label>
                        <button class="button button-small" type="submit">Save email preference</button>
                    </form>
                }
                else
                {
                    <p><strong>Not commissioned</strong></p>
                    <p class="muted">Email delivery is unavailable in this environment.</p>
                }
            </article>

            <article class="card">
                <h2>WhatsApp</h2>
                @if (Model.WhatsAppAvailable)
                {
                    <form method="post" asp-page-handler="Save">
                        <input type="hidden" name="Input.Channel" value="WhatsApp" />
                        <label for="whatsappDestination">WhatsApp number</label>
                        <input id="whatsappDestination" name="Input.Destination" value="@(whatsapp?.Destination ?? string.Empty)" maxlength="500" required />
                        <label class="check-row"><input type="checkbox" name="Input.Enabled" value="true" @(whatsapp?.Enabled == true ? "checked" : null) /><span>Send WhatsApp notifications</span></label>
                        <button class="button button-small" type="submit">Save WhatsApp preference</button>
                    </form>
                }
                else
                {
                    <p><strong>Not commissioned</strong></p>
                    <p class="muted">WhatsApp will remain unavailable until a real provider is commissioned and verified.</p>
                }
            </article>
        </div>
    </div>
</section>


<section class="section section-muted">
    <div class="shell">
        <div class="section-heading">
            <h2>Organization manager notifications</h2>
            <p>Choose which organization-wide events you want to receive for each organization you administer. These settings are independent for each organization.</p>
        </div>

        @if (Model.OrganizationSubscriptions.Count == 0)
        {
            <div class="card">
                <p class="muted">You do not currently administer any approved organizations.</p>
            </div>
        }
        else
        {
            <div class="grid-2">
            @foreach (OrganizationNotificationSubscriptionView subscription in Model.OrganizationSubscriptions)
            {
                <article class="card">
                    <h3>@subscription.OrganizationName</h3>
                    <p class="muted">Role: @subscription.Role</p>
                    <form method="post" asp-page-handler="Organization">
                        <input type="hidden" name="OrganizationInput.MembershipId" value="@subscription.MembershipId" />
                        <label class="check-row">
                            <input type="checkbox"
                                   name="OrganizationInput.ReceiveOrganizationNotifications"
                                   value="true"
                                   @(subscription.ReceiveOrganizationNotifications ? "checked" : null) />
                            <span>Organization notices and registration events</span>
                        </label>
                        <label class="check-row">
                            <input type="checkbox"
                                   name="OrganizationInput.ReceiveRequestNotifications"
                                   value="true"
                                   @(subscription.ReceiveRequestNotifications ? "checked" : null) />
                            <span>Request submissions and status changes</span>
                        </label>
                        <label class="check-row">
                            <input type="checkbox"
                                   name="OrganizationInput.ReceiveMembershipNotifications"
                                   value="true"
                                   @(subscription.ReceiveMembershipNotifications ? "checked" : null) />
                            <span>Representative membership events</span>
                        </label>
                        <button class="button button-small" type="submit">Save organization settings</button>
                    </form>
                </article>
            }
            </div>
        }
    </div>
</section>

<section class="section section-muted">
    <div class="shell">
        <div class="section-heading">
            <h2>Recent notification history</h2>
            <p>This history shows what the portal attempted to send and whether delivery succeeded, failed, dead-lettered or was intentionally skipped.</p>
        </div>

        @if (Model.History.Count == 0)
        {
            <div class="card"><p>No notifications have been recorded for your account yet.</p></div>
        }
        else
        {
            <div class="table-wrap">
                <table>
                    <thead><tr><th>Created</th><th>Channel</th><th>Subject</th><th>Status</th><th>Destination</th></tr></thead>
                    <tbody>
                    @foreach (NotificationHistoryView item in Model.History)
                    {
                        <tr><td>@item.CreatedUtc.ToString("yyyy-MM-dd HH:mm 'UTC'")</td><td>@item.Channel</td><td>@item.Subject</td><td>@item.Status</td><td>@item.Destination</td></tr>
                    }
                    </tbody>
                </table>
            </div>
        }
    </div>
</section>
