@page
@model RequestPortal.Web.Pages.Account.AccessDeniedModel
@{
    ViewData["Title"] = "Access Denied";
}

<section class="section">
    <div class="shell">
        <section class="card" style="max-width:760px;margin:0 auto">
            <div class="eyebrow" style="color:#b45b09">Authorization</div>
            <h1>Access denied</h1>
            <p class="muted">Your identity is authenticated, but your current Request Portal role or organization membership does not permit this operation.</p>
            <a class="button" asp-page="/Dashboard/Index">Return to dashboard</a>
        </section>
    </div>
</section>
