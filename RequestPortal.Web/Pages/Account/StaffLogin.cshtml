@page
@model RequestPortal.Web.Pages.Account.StaffLoginModel
@{
    ViewData["Title"] = "FFP Staff Sign In";
}

<div class="login-shell">
    <section class="login-intro">
        <div class="eyebrow">FFP internal staff</div>
        <h1>Redirecting to FFP Staff Authentication.</h1>
        <p>Request Portal never asks for or receives your FFP Active Directory password.</p>
        <p class="muted">Use your normal FFP username at the staff authentication service, for example <strong>FWright</strong>.</p>
        <a class="button button-secondary" asp-page="/Account/Login">Representative sign in</a>
    </section>
</div>
