@page
@model RequestPortal.Web.Pages.Account.ProfileModel
@using RequestPortal.Application.Notifications
@using RequestPortal.Domain.Notifications
@{
    ViewData["Title"] = "My Profile";
    ViewData["HideFooter"] = true;
    NotificationPreferenceView? email = Model.FindPreference(NotificationChannel.Email);
    NotificationPreferenceView? whatsapp = Model.FindPreference(NotificationChannel.WhatsApp);
}

<section class="profile-workspace">
    <div class="shell profile-workspace-shell">
        <header class="profile-titlebar">
            <div>
                <div class="eyebrow request-eyebrow">My account</div>
                <h1>Profile</h1>
                <p>Your personal details, organization memberships and notification preferences in one place.</p>
            </div>
            <a class="button button-small button-outline" asp-page="/Dashboard/Index">Back to requests</a>
        </header>

        <div asp-validation-summary="ModelOnly" class="validation profile-validation"></div>

        <div class="profile-dashboard">
            <section class="profile-panel profile-personal">
                <div class="profile-panel-title">
                    <strong>Personal &amp; contact</strong>
                    <small>Your Request Portal identity</small>
                </div>

                <div class="profile-photo-row">
                    <img class="profile-photo-preview"
                         src="/api/users/@Model.UserId/avatar?v=@DateTimeOffset.UtcNow.ToUnixTimeSeconds()"
                         alt="Profile photo" />
                    <div class="profile-photo-copy">
                        <strong>Profile photo</strong>
                        <small>Optional. PNG or JPEG, up to 5 MB.</small>
                        <form method="post" asp-page-handler="Photo" enctype="multipart/form-data" class="profile-photo-actions">
                            <input asp-for="ProfilePhoto" type="file" accept="image/png,image/jpeg" />
                            <button class="button button-small" type="submit">Upload photo</button>
                        </form>
                        <span asp-validation-for="ProfilePhoto" class="validation"></span>
                        @if (Model.HasProfilePhoto)
                        {
                            <form method="post" asp-page-handler="RemovePhoto" class="profile-photo-remove">
                                <button class="button button-small button-outline" type="submit">Remove photo</button>
                            </form>
                        }
                    </div>
                </div>

                <form method="post" asp-page-handler="Profile" class="profile-compact-form individual-intake-form">
                    <input type="hidden" asp-for="ReturnUrl" />

                    <div class="profile-intake-section">
                        <div class="profile-intake-heading">
                            <strong>Identity &amp; contact</strong>
                            <small>Required for individual assistance requests.</small>
                        </div>

                        <div class="grid-2">
                            <div class="field">
                                <label asp-for="ProfileInput.DisplayName">Full name</label>
                                <input asp-for="ProfileInput.DisplayName" />
                                <span asp-validation-for="ProfileInput.DisplayName" class="validation"></span>
                            </div>
                            <div class="field profile-dob-field">
                                <label asp-for="ProfileInput.DateOfBirth">Date of birth</label>
                                <div class="profile-dob-row">
                                    <input asp-for="ProfileInput.DateOfBirth" type="date" id="profile-date-of-birth" />
                                    <span id="profile-age" class="profile-age-chip">Age —</span>
                                </div>
                                <small id="profile-age-warning" class="profile-age-warning" hidden></small>
                                <span asp-validation-for="ProfileInput.DateOfBirth" class="validation"></span>
                            </div>
                            <div class="field">
                                <label asp-for="ProfileInput.Gender">Gender</label>
                                <select asp-for="ProfileInput.Gender">
                                    <option value="">Select gender</option>
                                    <option>Female</option>
                                    <option>Male</option>
                                    <option>Other</option>
                                    <option>Prefer not to say</option>
                                </select>
                                <span asp-validation-for="ProfileInput.Gender" class="validation"></span>
                            </div>
                            <div class="field">
                                <label asp-for="ProfileInput.NationalIdTrn">National ID / TRN</label>
                                <input asp-for="ProfileInput.NationalIdTrn" />
                                <span asp-validation-for="ProfileInput.NationalIdTrn" class="validation"></span>
                            </div>
                            <div class="field">
                                <label asp-for="ProfileInput.MaritalStatus">Marital status</label>
                                <select asp-for="ProfileInput.MaritalStatus">
                                    <option value="">Select marital status</option>
                                    <option>Single</option>
                                    <option>Married</option>
                                    <option>Common-law</option>
                                    <option>Separated</option>
                                    <option>Divorced</option>
                                    <option>Widowed</option>
                                </select>
                                <span asp-validation-for="ProfileInput.MaritalStatus" class="validation"></span>
                            </div>
                            <div class="field">
                                <label asp-for="ProfileInput.Email">Email</label>
                                <input asp-for="ProfileInput.Email" type="email" />
                                <span asp-validation-for="ProfileInput.Email" class="validation"></span>
                            </div>
                            <div class="field">
                                <label asp-for="ProfileInput.PhoneNumber">Primary telephone</label>
                                <input asp-for="ProfileInput.PhoneNumber" type="tel" />
                                <span asp-validation-for="ProfileInput.PhoneNumber" class="validation"></span>
                            </div>
                            <div class="field">
                                <label asp-for="ProfileInput.AlternativePhoneNumber">Alternative telephone</label>
                                <input asp-for="ProfileInput.AlternativePhoneNumber" type="tel" />
                                <span asp-validation-for="ProfileInput.AlternativePhoneNumber" class="validation"></span>
                            </div>
                        </div>
                    </div>

                    <div class="profile-intake-section">
                        <div class="profile-intake-heading">
                            <strong>Home address</strong>
                        </div>
                        <div class="field">
                            <label asp-for="ProfileInput.HomeAddress">Address line 1</label>
                            <input asp-for="ProfileInput.HomeAddress" />
                            <span asp-validation-for="ProfileInput.HomeAddress" class="validation"></span>
                        </div>
                        <div class="grid-2">
                            <div class="field">
                                <label asp-for="ProfileInput.HomeAddressLine2">Address line 2</label>
                                <input asp-for="ProfileInput.HomeAddressLine2" />
                                <span asp-validation-for="ProfileInput.HomeAddressLine2" class="validation"></span>
                            </div>
                            <div class="field">
                                <label asp-for="ProfileInput.Town">Town</label>
                                <input asp-for="ProfileInput.Town" />
                                <span asp-validation-for="ProfileInput.Town" class="validation"></span>
                            </div>
                        </div>
                        <div class="grid-2">
                            <div class="field">
                                <label asp-for="ProfileInput.Parish">Parish</label>
                                <select asp-for="ProfileInput.Parish">
                                    <option value="">Select parish</option>
                                    <option>Kingston</option>
                                    <option>St. Andrew</option>
                                    <option>St. Catherine</option>
                                    <option>Clarendon</option>
                                    <option>Manchester</option>
                                    <option>St. Elizabeth</option>
                                    <option>Westmoreland</option>
                                    <option>Hanover</option>
                                    <option>St. James</option>
                                    <option>Trelawny</option>
                                    <option>St. Ann</option>
                                    <option>St. Mary</option>
                                    <option>Portland</option>
                                    <option>St. Thomas</option>
                                </select>
                                <span asp-validation-for="ProfileInput.Parish" class="validation"></span>
                            </div>
                            <div class="field">
                                <label asp-for="ProfileInput.DistrictArea">District / area</label>
                                <input asp-for="ProfileInput.DistrictArea" />
                                <span asp-validation-for="ProfileInput.DistrictArea" class="validation"></span>
                            </div>
                        </div>
                    </div>

                    <div class="profile-intake-section">
                        <div class="profile-intake-heading">
                            <strong>Employment &amp; household</strong>
                        </div>
                        <div class="grid-2">
                            <div class="field">
                                <label asp-for="ProfileInput.EmploymentStatus">Employment status</label>
                                <select asp-for="ProfileInput.EmploymentStatus">
                                    <option value="">Select status</option>
                                    <option>Employed</option>
                                    <option>Self-employed</option>
                                    <option>Unemployed</option>
                                    <option>Student</option>
                                    <option>Retired</option>
                                    <option>Unable to work</option>
                                    <option>Other</option>
                                </select>
                                <span asp-validation-for="ProfileInput.EmploymentStatus" class="validation"></span>
                            </div>
                            <div class="field">
                                <label asp-for="ProfileInput.EmployerInstitution">Employer / institution</label>
                                <input asp-for="ProfileInput.EmployerInstitution" />
                                <span asp-validation-for="ProfileInput.EmployerInstitution" class="validation"></span>
                            </div>
                            <div class="field">
                                <label asp-for="ProfileInput.MonthlyHouseholdIncome">Monthly household income</label>
                                <input asp-for="ProfileInput.MonthlyHouseholdIncome" type="number" min="0" step="0.01" />
                                <span asp-validation-for="ProfileInput.MonthlyHouseholdIncome" class="validation"></span>
                            </div>
                            <div class="field">
                                <label asp-for="ProfileInput.HouseholdSize">Persons in household</label>
                                <input asp-for="ProfileInput.HouseholdSize" type="number" min="1" />
                                <span asp-validation-for="ProfileInput.HouseholdSize" class="validation"></span>
                            </div>
                            <div class="field">
                                <label asp-for="ProfileInput.NumberOfDependants">Number of dependants</label>
                                <input asp-for="ProfileInput.NumberOfDependants" type="number" min="0" />
                                <span asp-validation-for="ProfileInput.NumberOfDependants" class="validation"></span>
                            </div>
                            <div class="field">
                                <label asp-for="ProfileInput.ChildrenUnder18">Children under 18</label>
                                <input asp-for="ProfileInput.ChildrenUnder18" type="number" min="0" />
                                <span asp-validation-for="ProfileInput.ChildrenUnder18" class="validation"></span>
                            </div>
                            <div class="field">
                                <label asp-for="ProfileInput.HousingSituation">Housing situation</label>
                                <select asp-for="ProfileInput.HousingSituation">
                                    <option value="">Select housing situation</option>
                                    <option>Own home</option>
                                    <option>Rent</option>
                                    <option>Family / shared home</option>
                                    <option>Informal / squatting</option>
                                    <option>Temporary accommodation</option>
                                    <option>Homeless</option>
                                    <option>Other</option>
                                </select>
                                <span asp-validation-for="ProfileInput.HousingSituation" class="validation"></span>
                            </div>
                            <div class="field">
                                <label asp-for="ProfileInput.ReferralSource">Referral source</label>
                                <select asp-for="ProfileInput.ReferralSource">
                                    <option value="">Select referral source</option>
                                    <option>Food For The Poor staff</option>
                                    <option>Government agency</option>
                                    <option>Church / Faith-based organization</option>
                                    <option>Community organization</option>
                                    <option>School / Educational institution</option>
                                    <option>Health facility</option>
                                    <option>NGO / Charity</option>
                                    <option>Family / Friend</option>
                                    <option>Previous applicant / beneficiary</option>
                                    <option>Social media</option>
                                    <option>Food For The Poor website</option>
                                    <option>Walk-in</option>
                                    <option>Other</option>
                                </select>
                                <span asp-validation-for="ProfileInput.ReferralSource" class="validation"></span>
                            </div>
                        </div>
                        <div class="field">
                            <label asp-for="ProfileInput.HouseholdLivingSituation">Household / living situation</label>
                            <textarea asp-for="ProfileInput.HouseholdLivingSituation" rows="4"
                                      placeholder="Briefly describe the household and living situation."></textarea>
                            <span asp-validation-for="ProfileInput.HouseholdLivingSituation" class="validation"></span>
                        </div>
                    </div>

                    <div class="profile-readonly-row">
                        <span>Registered identity</span>
                        <strong>@Model.RegisteredIdentity</strong>
                    </div>
                    <button class="button button-small" type="submit">Save individual profile</button>
                </form>
            </section>

            <section class="profile-panel profile-membership">
                <div class="profile-panel-title">
                    <strong>Organization membership</strong>
                    <small>@Model.Organizations.Count current membership(s)</small>
                </div>

                <div class="profile-membership-list">
                    @if (Model.Organizations.Count == 0)
                    {
                        <p class="profile-empty">No organization memberships yet.</p>
                    }
                    else
                    {
                        @foreach (OrganizationSummary organization in Model.Organizations)
                        {
                            <div class="profile-membership-row">
                                <div>
                                    <strong>@organization.Name</strong>
                                    <small>@organization.CountryCode · @organization.Role</small>
                                </div>
                                <span class="status status-@organization.MembershipStatus">@organization.MembershipStatus</span>
                            </div>
                        }
                    }
                </div>

                @if (Model.PendingInvitations.Count > 0)
                {
                    <div class="profile-membership-invitations">
                        <strong>Pending invitations</strong>
                        @foreach (var invitation in Model.PendingInvitations)
                        {
                            <div class="profile-membership-row">
                                <div>
                                    <strong>@invitation.OrganizationName</strong>
                                    <small>Invitation sent to @invitation.Email · expires @invitation.ExpiresUtc.ToLocalTime().ToString("g")</small>
                                </div>
                                <span class="status status-Pending">Pending</span>
                            </div>
                        }
                        <small class="muted">Use the secure invitation link sent to your email address to accept membership.</small>
                    </div>
                }

                <div class="profile-membership-actions">
                    @if (Model.RegistrationCountries.Count > 0)
                    {
                        <form method="post" asp-page-handler="RegisterOrganization" class="profile-register-form">
                            <input asp-for="Registration.Name" placeholder="New organization name" />
                            <select asp-for="Registration.CountryCode">
                                @foreach (var country in Model.RegistrationCountries)
                                {
                                    <option value="@country.CountryCode">@country.DisplayName</option>
                                }
                            </select>
                            <button class="button button-small button-outline" type="submit">Register organization</button>
                        </form>
                    }
                </div>
            </section>

            <section class="profile-panel profile-notifications">
                <div class="profile-panel-title">
                    <strong>Notification preferences</strong>
                    <small>Default email is your registered email address</small>
                </div>

                <form method="post" asp-page-handler="Preference" class="profile-notification-row">
                    <input type="hidden" name="Preference.Channel" value="Email" />
                    <div>
                        <strong>Email</strong>
                        <input name="Preference.Destination"
                               value="@(email?.Destination ?? Model.ProfileInput.Email)"
                               type="email"
                               maxlength="500"
                               aria-label="Notification email" />
                    </div>
                    <label class="profile-toggle">
                        <input type="checkbox"
                               name="Preference.Enabled"
                               value="true"
                               @(email?.Enabled != false ? "checked" : null)
                               disabled="@(!Model.EmailAvailable)" />
                        <span>Enabled</span>
                    </label>
                    <button class="button button-small button-outline"
                            type="submit"
                            disabled="@(!Model.EmailAvailable)">Save</button>
                </form>

                <form method="post" asp-page-handler="Preference" class="profile-notification-row">
                    <input type="hidden" name="Preference.Channel" value="WhatsApp" />
                    <div>
                        <strong>WhatsApp</strong>
                        <input name="Preference.Destination"
                               value="@(whatsapp?.Destination ?? Model.ProfileInput.PhoneNumber)"
                               type="tel"
                               maxlength="500"
                               aria-label="WhatsApp number" />
                    </div>
                    <label class="profile-toggle">
                        <input type="checkbox"
                               name="Preference.Enabled"
                               value="true"
                               @(whatsapp?.Enabled == true ? "checked" : null)
                               disabled="@(!Model.WhatsAppAvailable)" />
                        <span>@(Model.WhatsAppAvailable ? "Enabled" : "Unavailable")</span>
                    </label>
                    <button class="button button-small button-outline"
                            type="submit"
                            disabled="@(!Model.WhatsAppAvailable)">Save</button>
                </form>

                <div class="profile-org-notifications">
                    <strong>Organization manager notifications</strong>
                    @if (Model.OrganizationSubscriptions.Count == 0)
                    {
                        <small>No administrator notification settings are available.</small>
                    }
                    else
                    {
                        @foreach (OrganizationNotificationSubscriptionView subscription in Model.OrganizationSubscriptions)
                        {
                            <form method="post" asp-page-handler="OrganizationSubscription" class="profile-org-notification-row">
                                <input type="hidden" name="OrganizationInput.MembershipId" value="@subscription.MembershipId" />
                                <span title="@subscription.OrganizationName">@subscription.OrganizationName</span>
                                <label><input type="checkbox" name="OrganizationInput.ReceiveAllOrganizationActivity" value="true" @(subscription.ReceiveOrganizationNotifications && subscription.ReceiveRequestNotifications && subscription.ReceiveMembershipNotifications ? "checked" : null) /> Notify me about all organization activity</label>
                                <button class="button button-small button-outline" type="submit">Save</button>
                            </form>
                        }
                    }
                </div>
            </section>
        </div>
    </div>
</section>

<style>
.individual-intake-form{display:grid;gap:16px}.profile-intake-section{display:grid;gap:10px;padding-top:4px}.profile-intake-section+.profile-intake-section{padding-top:14px;border-top:1px solid #e2e7ea}.profile-intake-heading{display:flex;align-items:baseline;justify-content:space-between;gap:12px}.profile-intake-heading strong{color:#18364d}.profile-intake-heading small{color:#68757f}
</style>

<script id="profile-age-script">
(() => {
    const dob = document.getElementById('profile-date-of-birth');
    const age = document.getElementById('profile-age');
    const warning = document.getElementById('profile-age-warning');
    if (!dob || !age || !warning) return;

    const refreshAge = () => {
        if (!dob.value) {
            age.textContent = 'Age —';
            warning.hidden = true;
            warning.textContent = '';
            return;
        }

        const birth = new Date(dob.value + 'T00:00:00');
        const today = new Date();
        let years = today.getFullYear() - birth.getFullYear();
        const monthDelta = today.getMonth() - birth.getMonth();

        if (monthDelta < 0 || (monthDelta === 0 && today.getDate() < birth.getDate())) {
            years--;
        }

        age.textContent = years >= 0 ? 'Age ' + years : 'Invalid date';

        let message = '';
        if (years < 0) {
            message = 'Date of birth cannot be in the future.';
        } else if (years < 18) {
            message = 'Age is under 18. Confirm the date of birth is correct.';
        } else if (years > 100) {
            message = 'Age is unusually high. Confirm the date of birth is correct.';
        }

        warning.textContent = message;
        warning.hidden = !message;
    };

    dob.addEventListener('change', refreshAge);
    refreshAge();
})();
</script>


<style>
.profile-photo-row{display:grid;grid-template-columns:88px minmax(0,1fr);gap:14px;align-items:start;padding:14px;border-bottom:1px solid #e1e6ea;background:#fbfcfd}
.profile-photo-preview{width:88px;height:88px;border-radius:50%;object-fit:cover;border:1px solid #cfd7df;background:#e7edf2}
.profile-photo-copy{display:grid;gap:5px;min-width:0}
.profile-photo-copy>small{color:#667384}
.profile-photo-actions{display:flex;align-items:center;gap:8px;flex-wrap:wrap;margin-top:4px}
.profile-photo-actions input[type=file]{max-width:360px}
.profile-photo-remove{margin-top:2px}
@@media(max-width:620px){.profile-photo-row{grid-template-columns:68px minmax(0,1fr)}.profile-photo-preview{width:68px;height:68px}.profile-photo-actions{align-items:stretch;flex-direction:column}.profile-photo-actions .button{align-self:start}}
</style>