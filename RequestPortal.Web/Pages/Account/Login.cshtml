@page
@model RequestPortal.Web.Pages.Account.LoginModel
@{
    ViewData["Title"] = "Representative Sign In";
}

<div class="login-shell">
    <section class="login-intro">
        <div class="eyebrow">Organization representatives</div>
        <h1>Sign in to the Request Portal</h1>
        <p>
            Organization representatives sign in as themselves using one of the external identity providers shown here.
            Your approved organization memberships determine which organizations you may represent and which requests you may view or submit.
        </p>
        <p class="login-intro-note">
            Use the social or personal account you registered with the portal.
        </p>
    </section>
    <section class="login-panel login-panel-illustrated">
        <div class="login-art login-art-builders" aria-hidden="true">
            <img src="/img/legacy/builder2.webp" alt="" />
        </div>
        <div class="login-art login-art-worker" aria-hidden="true">
            <img src="/img/worker03.webp" alt="" />
        </div>
        <div class="login-art login-art-help" aria-hidden="true">
            <img src="/img/callus2.jpg" alt="" />
        </div>

        <div class="login-panel-content">
            <div class="login-panel-heading">
                <div>
                    <h2>Choose a sign-in method</h2>
                    <p class="muted">Applicants and organization representatives can use any configured provider below.</p>
                </div>
                <div class="login-help-cue">
                    <strong>Need help?</strong>
                    <span>FFP is here to assist.</span>
                </div>
            </div>

        @foreach (RequestPortal.Web.Pages.Account.LoginModel.ExternalProviderOption provider in Model.ExternalProviders)
        {
            <form method="post" asp-page-handler="External">
                <input type="hidden" name="provider" value="@provider.Name" />
                <input type="hidden" name="returnUrl" value="@Model.ReturnUrl" />
                <button class="button provider-button @(provider.IsConfigured ? string.Empty : "provider-button-disabled")"
                        type="submit"
                        disabled="@(!provider.IsConfigured)"
                        aria-disabled="@(!provider.IsConfigured)">
                    <span class="provider-button-content">
                        @switch (provider.Name)
                        {
                            case "Google":
                                <span class="provider-icon provider-icon-google" aria-hidden="true"><svg viewBox="0 0 24 24" role="img"><path fill="#4285F4" d="M21.35 12.27c0-.71-.06-1.39-.18-2.05H12v3.88h5.24a4.48 4.48 0 0 1-1.94 2.94v2.44h3.14c1.84-1.69 2.91-4.18 2.91-7.21Z"/><path fill="#34A853" d="M12 21.84c2.63 0 4.84-.87 6.45-2.36l-3.14-2.44c-.87.58-1.98.93-3.31.93-2.54 0-4.7-1.72-5.47-4.03H3.28v2.52A9.74 9.74 0 0 0 12 21.84Z"/><path fill="#FBBC05" d="M6.53 13.94A5.86 5.86 0 0 1 6.22 12c0-.67.12-1.33.31-1.94V7.54H3.28A9.82 9.82 0 0 0 2.25 12c0 1.61.39 3.13 1.03 4.46l3.25-2.52Z"/><path fill="#EA4335" d="M12 6.03c1.43 0 2.72.49 3.73 1.45l2.8-2.8C16.84 3.04 14.63 2.16 12 2.16a9.74 9.74 0 0 0-8.72 5.38l3.25 2.52C7.3 7.75 9.46 6.03 12 6.03Z"/></svg></span>
                                break;
                            case "Facebook":
                                <span class="provider-icon provider-icon-facebook" aria-hidden="true">f</span>
                                break;
                            case "Yahoo":
                                <span class="provider-icon provider-icon-yahoo" aria-hidden="true">Y!</span>
                                break;
                            case "Microsoft":
                                <span class="provider-icon provider-icon-microsoft" aria-hidden="true">
                                    <svg viewBox="0 0 24 24" role="img">
                                        <rect x="2" y="2" width="9" height="9" fill="#f25022"/>
                                        <rect x="13" y="2" width="9" height="9" fill="#7fba00"/>
                                        <rect x="2" y="13" width="9" height="9" fill="#00a4ef"/>
                                        <rect x="13" y="13" width="9" height="9" fill="#ffb900"/>
                                    </svg>
                                </span>
                                break;
                            case "Apple":
                                <span class="provider-icon provider-icon-apple" aria-hidden="true"><svg viewBox="0 0 24 24" role="img"><path fill="currentColor" d="M16.77 12.73c.02 2.2 1.93 2.93 1.95 2.94-.02.05-.3 1.03-.99 2.04-.59.88-1.21 1.75-2.18 1.77-.95.02-1.26-.57-2.35-.57-1.1 0-1.45.55-2.35.59-.94.03-1.66-.95-2.26-1.83-1.23-1.78-2.17-5.02-.91-7.22.63-1.1 1.67-1.8 2.8-1.82.88-.02 1.72.61 2.35.61.62 0 1.79-.75 3.02-.64.52.02 1.98.21 2.92 1.58-.08.05-1.74 1.02-1.72 3.05Zm-1.98-5.38c.5-.6.83-1.43.74-2.26-.72.03-1.59.48-2.1 1.08-.46.53-.86 1.38-.75 2.19.8.06 1.61-.41 2.11-1.01Z"/></svg></span>
                                break;
                        }
                        <span>Continue with @provider.Name</span>
                    </span>
                    @if (!provider.IsConfigured)
                    {
                        <span class="provider-state">Not configured</span>
                    }
                </button>
            </form>
        }


        <div class="ffp-staff-signin-footer">
            <div class="ffp-staff-signin-identity">
                <img src="https://foodforthepoor.org/wp-content/uploads/fftp-logo-img-media.png"
                     alt="Food For The Poor" />
                <div>
                    <strong>Food For The Poor User Sign In</strong>
                    <p>
                        This option is only for Food For The Poor staff and other authorized FFP users with an internal organization account.
                    </p>
                </div>
            </div>
            <a class="button button-outline ffp-staff-signin-button" asp-page="/Account/StaffLogin">
                FFP User Sign In
            </a>
        </div>

        @if (Model.DemoEnabled)
        {
            <div class="divider">Demo personas</div>
            <form method="post" asp-page-handler="Demo" style="margin-bottom:10px">
                <input type="hidden" name="persona" value="representative" />
                <input type="hidden" name="returnUrl" value="@Model.ReturnUrl" />
                <button class="button" style="width:100%" type="submit">Demo representative · Michael</button>
            </form>
            <form method="post" asp-page-handler="Demo" style="margin-bottom:10px">
                <input type="hidden" name="persona" value="admin" />
                <input type="hidden" name="returnUrl" value="@Model.ReturnUrl" />
                <button class="button button-outline" style="width:100%" type="submit">Demo organization admin · Grace</button>
            </form>
            <form method="post" asp-page-handler="Demo">
                <input type="hidden" name="persona" value="pending" />
                <input type="hidden" name="returnUrl" value="@Model.ReturnUrl" />
                <button class="button button-outline" style="width:100%" type="submit">Demo new representative · Keisha</button>
            </form>
        }

        @if (!string.IsNullOrWhiteSpace(Model.ErrorMessage))
        {
            <div class="flash error">@Model.ErrorMessage</div>
        }
        </div>
    </section>
</div>
