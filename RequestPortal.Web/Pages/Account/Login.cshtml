@page
@model RequestPortal.Web.Pages.Account.LoginModel
@{
    ViewData["Title"] = "Representative Sign In";
}

<div class="login-shell">
    <section class="login-intro">
        <div class="eyebrow">Organization representatives</div>
        <h1>Welcome back.</h1>
        <p>
            Sign in as yourself. Your organization memberships determine which organizations you may represent
            and which requests you may view or submit.
        </p>
        <p>
            FFP internal staff should use the separate staff sign-in with their FFP Active Directory credentials.
        </p>
        <a class="button button-secondary" asp-page="/Account/StaffLogin">FFP staff sign in</a>
    </section>
    <section class="login-panel">
        <h2>Representative sign in</h2>
        <p class="muted">Use one of the available external identity providers.</p>

        @foreach (RequestPortal.Web.Pages.Account.LoginModel.ExternalProviderOption provider in Model.ExternalProviders)
        {
            <form method="post" asp-page-handler="External">
                <input type="hidden" name="provider" value="@provider.Name" />
                <input type="hidden" name="returnUrl" value="@Model.ReturnUrl" />
                <button class="button provider-button @(provider.IsConfigured ? string.Empty : "provider-button-disabled")"
                        type="submit"
                        disabled="@(!provider.IsConfigured)"
                        aria-disabled="@(!provider.IsConfigured)">
                    <span class="provider-button-content">
                        @switch (provider.Name)
                        {
                            case "Google":
                                <span class="provider-icon provider-icon-google" aria-hidden="true">G</span>
                                break;
                            case "Facebook":
                                <span class="provider-icon provider-icon-facebook" aria-hidden="true">f</span>
                                break;
                            case "Yahoo":
                                <span class="provider-icon provider-icon-yahoo" aria-hidden="true">Y!</span>
                                break;
                            case "Microsoft":
                                <span class="provider-icon provider-icon-microsoft" aria-hidden="true">
                                    <span></span><span></span><span></span><span></span>
                                </span>
                                break;
                            case "Apple":
                                <span class="provider-icon provider-icon-apple" aria-hidden="true">●</span>
                                break;
                        }
                        <span>Continue with @provider.Name</span>
                    </span>
                    @if (!provider.IsConfigured)
                    {
                        <span class="provider-state">Not configured</span>
                    }
                </button>
            </form>
        }

        @if (Model.DemoEnabled)
        {
            <div class="divider">Demo personas</div>
            <form method="post" asp-page-handler="Demo" style="margin-bottom:10px">
                <input type="hidden" name="persona" value="representative" />
                <input type="hidden" name="returnUrl" value="@Model.ReturnUrl" />
                <button class="button" style="width:100%" type="submit">Demo representative · Michael</button>
            </form>
            <form method="post" asp-page-handler="Demo" style="margin-bottom:10px">
                <input type="hidden" name="persona" value="admin" />
                <input type="hidden" name="returnUrl" value="@Model.ReturnUrl" />
                <button class="button button-outline" style="width:100%" type="submit">Demo organization admin · Grace</button>
            </form>
            <form method="post" asp-page-handler="Demo">
                <input type="hidden" name="persona" value="pending" />
                <input type="hidden" name="returnUrl" value="@Model.ReturnUrl" />
                <button class="button button-outline" style="width:100%" type="submit">Demo new representative · Keisha</button>
            </form>
        }

        @if (!string.IsNullOrWhiteSpace(Model.ErrorMessage))
        {
            <div class="flash error">@Model.ErrorMessage</div>
        }
    </section>
</div>
