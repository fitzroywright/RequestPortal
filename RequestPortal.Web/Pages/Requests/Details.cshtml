@page "{id:guid}"
@model RequestPortal.Web.Pages.Requests.DetailsModel
@using RequestPortal.Application.Documents
@using RequestPortal.Application.ReferenceData
@using RequestPortal.Application.Requests
@using RequestPortal.Domain.Documents
@using RequestPortal.Domain.Requests
@{
    ViewData["Title"] = "Request Details";
}

<section class="operational-page">
    <div class="shell">
        @if (Model.Request is null)
        {
            <section class="operational-panel"><h1>Request not found</h1></section>
        }
        else
        {
            <header class="workspace-titlebar">
                <div class="section-heading" style="margin-bottom:0">
                    <div class="eyebrow" style="color:#b45b09">@Model.Request.OrganizationName</div>
                    <h1>Request # @Model.Request.PublicReference</h1>
                    <p>@Model.Request.Summary</p>
                </div>
                <div class="action-row">
                    <a class="button button-outline" href="#conversation">Conversation</a>
                    <span class="status status-@Model.Request.Status">@RequestStatusPresentation.Label(Model.Request.Status)</span>
                </div>
            </header>

            <section class="operational-panel request-progress" aria-label="Request progress">
                <span><strong>Completed</strong> @(string.Join(" · ", Model.Request.History.Reverse().Where(item => item.Status != Model.Request.Status).Select(item => RequestStatusPresentation.Label(item.Status)).Distinct().DefaultIfEmpty("None yet")))</span>
                <span aria-current="step"><strong>Current</strong> @RequestStatusPresentation.Label(Model.Request.Status)</span>
                <span><strong>Next</strong> @RequestStatusPresentation.Next(Model.Request.Status)</span>
            </section>

            <section id="conversation" class="operational-panel request-messages-card">
                <div class="panel-titlebar">
                    <div>
                        <strong>Messages about this request</strong>
                        <small class="muted">All messages connected to @Model.Request.PublicReference are kept with this request.</small>
                    </div>
                    <a asp-page="/Messages/Inbox">All messages</a>
                </div>

                <div asp-validation-summary="ModelOnly" class="validation"></div>

                @{
                    var requestMessages = Model.MessageThreads
                        .SelectMany(thread => thread.Messages.Select(message => new { Thread = thread, Message = message }))
                        .OrderBy(item => item.Message.SentUtc)
                        .ToArray();

                    var replyThread = Model.MessageThreads
                        .Where(thread => !thread.ClosedUtc.HasValue)
                        .OrderByDescending(thread => thread.Messages.LastOrDefault()?.SentUtc ?? DateTimeOffset.MinValue)
                        .FirstOrDefault();
                }

                <div class="request-conversation-history request-message-list">
                    @if (requestMessages.Length == 0)
                    {
                        <div class="workspace-empty compact">
                            <p>No messages have been received for this request yet.</p>
                        </div>
                    }
                    else
                    {
                        @foreach (var item in requestMessages)
                        {
                            <article class="request-message-item @(item.Message.IsMine ? "is-mine" : "is-received")">
                                <div class="request-message-meta">
                                    <strong>@item.Message.SenderName</strong>
                                    <time>@item.Message.SentUtc.ToLocalTime().ToString("MMM d, yyyy h:mm tt")</time>
                                </div>
                                <p>@item.Message.Body</p>
                                @foreach (var attachment in item.Message.Attachments)
                                {
                                    <a asp-page="/Messages/Thread"
                                       asp-page-handler="Attachment"
                                       asp-route-id="@item.Thread.ThreadId"
                                       asp-route-documentId="@attachment.DocumentId">📎 @attachment.FileName</a>
                                }
                            </article>
                        }
                    }
                </div>

                @if (Model.CanStartRequestConversation || replyThread is not null)
                {
                    bool startingNewMessage = requestMessages.Length == 0 || replyThread is null;

                    <form method="post"
                          enctype="multipart/form-data"
                          asp-page-handler="Reply"
                          class="request-reply-form request-detail-reply">
                        <input type="hidden" name="id" value="@Model.Request.Id" />
                        @if (replyThread is not null)
                        {
                            <input type="hidden" name="ReplyThreadId" value="@replyThread.ThreadId" />
                        }

                        <label for="request-reply-box">
                            <strong>@(startingNewMessage ? "New Message" : "Reply")</strong>
                        </label>
                        <div class="request-reply-box">
                            <textarea id="request-reply-box"
                                      name="Reply"
                                      rows="4"
                                      maxlength="10000"
                                      required
                                      placeholder="@(startingNewMessage ? "Type a new message about this request..." : "Type your reply here...")"
                                      aria-label="@(startingNewMessage ? "New message about this request" : "Reply to messages about this request")">@Model.Reply</textarea>
                            <label class="reply-paperclip" title="Attach a file">
                                📎
                                <input name="ReplyAttachment" type="file" aria-label="Attach a file" />
                            </label>
                        </div>
                        <div class="request-attachment-hint">You can attach a supporting file to this message.</div>
                        <span asp-validation-for="Reply" class="validation"></span>
                        <div class="action-row">
                            <button class="button button-small" type="submit">@(startingNewMessage ? "New Message" : "Send reply")</button>
                        </div>
                    </form>
                }
            </section>

            <div class="portal-workspace-grid" style="grid-template-columns:minmax(0,2fr) minmax(260px,.75fr);">
                <div>
                    @if (Model.ProjectProposal is not null)
                    {
                        <section class="operational-panel">
                            <div class="action-row" style="justify-content:space-between;align-items:center">
                                <div>
                                    <div class="eyebrow" style="color:#b45b09">Project proposal</div>
                                    <h2>@Model.ProjectProposal.Title</h2>
                                    <p class="muted">Version @Model.ProjectProposal.Version · updated @Model.ProjectProposal.UpdatedUtc.ToString("u")</p>
                                </div>
                                @if (Model.ProjectProposal.CanEdit)
                                {
                                    <a class="button" asp-page="/Requests/Proposal" asp-route-id="@Model.Request.Id">Edit proposal</a>
                                }
                            </div>
                            <article class="proposal-document">@Html.Raw(Model.ProjectProposal.RichContentHtml)</article>
                        </section>

                        @if (Model.ProjectPlanning is not null)
                        {
                            <section class="operational-panel" style="margin-top:10px">
                                <h2>Project budget</h2>
                                <div class="table-wrap">
                                    <table>
                                        <thead><tr><th>Description</th><th>Qty</th><th>Unit cost</th><th>Total</th><th>FFP requested</th><th>Organization</th><th>Other funding</th></tr></thead>
                                        <tbody>
                                        @foreach (ProjectBudgetItemDetail item in Model.ProjectPlanning.Budget)
                                        {
                                            <tr>
                                                <td>@item.Description</td>
                                                <td>@item.Quantity</td>
                                                <td>@item.UnitCost.ToString("N2")</td>
                                                <td>@item.TotalCost.ToString("N2")</td>
                                                <td>@item.FfpRequested.ToString("N2")</td>
                                                <td>@item.OrganizationContribution.ToString("N2")</td>
                                                <td>@item.OtherFunding.ToString("N2")</td>
                                            </tr>
                                        }
                                        </tbody>
                                        <tfoot>
                                            <tr>
                                                <th colspan="3">Totals</th>
                                                <th>@Model.ProjectPlanning.TotalCost.ToString("N2")</th>
                                                <th>@Model.ProjectPlanning.TotalFfpRequested.ToString("N2")</th>
                                                <th>@Model.ProjectPlanning.TotalOrganizationContribution.ToString("N2")</th>
                                                <th>@Model.ProjectPlanning.TotalOtherFunding.ToString("N2")</th>
                                            </tr>
                                        </tfoot>
                                    </table>
                                </div>
                            </section>

                            <section class="operational-panel" style="margin-top:10px">
                                <h2>Implementation milestones</h2>
                                <div class="table-wrap">
                                    <table>
                                        <thead><tr><th>#</th><th>Milestone</th><th>Expected outcome</th><th>Target date</th></tr></thead>
                                        <tbody>
                                        @foreach (ProjectMilestoneDetail milestone in Model.ProjectPlanning.Milestones)
                                        {
                                            <tr>
                                                <td>@milestone.Sequence</td>
                                                <td>@milestone.Title</td>
                                                <td>@milestone.ExpectedOutcome</td>
                                                <td>@milestone.TargetDate.ToString("yyyy-MM-dd")</td>
                                            </tr>
                                        }
                                        </tbody>
                                    </table>
                                </div>
                            </section>
                        }
                    }
                    else
                    {
                        <section class="operational-panel">
                            <h2>Requested items</h2>
                            @if (Model.Request.Items.Count == 0)
                            {
                                <p class="muted">No items have been added yet.</p>
                            }
                            else
                            {
                                <div class="table-wrap">
                                    <table>
                                        <thead><tr><th>Item / Service</th><th>Description / Specification</th><th>Quantity</th><th>Unit</th><th>Notes</th></tr></thead>
                                        <tbody>
                                        @foreach (RequestItemDetail item in Model.Request.Items)
                                        {
                                            <tr>
                                                <td>@item.ItemName</td>
                                                <td>@item.Description</td>
                                                <td>@item.Quantity</td>
                                                <td>@Model.UnitName(item.UnitOfMeasureId)</td>
                                                <td>@(item.Notes ?? "—")</td>
                                            </tr>
                                        }
                                        </tbody>
                                    </table>
                                </div>
                            }

                            @if (Model.Request.Status == "Draft")
                            {
                                <hr style="border:0;border-top:1px solid #dde3e8;margin:26px 0" />
                                <h3>Add line item</h3>
                                <form method="post" asp-page-handler="AddItem" class="form-grid">
                                    <input type="hidden" name="id" value="@Model.Request.Id" />
                                    <div class="field">
                                        <label asp-for="Item.ItemName">Item / Service</label>
                                        <input asp-for="Item.ItemName" placeholder="e.g. School bags" />
                                        <span asp-validation-for="Item.ItemName" class="validation"></span>
                                    </div>
                                    <div class="field">
                                        <label asp-for="Item.Description">Description / Specification</label>
                                        <input asp-for="Item.Description" placeholder="Size, model, service scope or other specification" />
                                        <span asp-validation-for="Item.Description" class="validation"></span>
                                    </div>
                                    <div class="grid-2">
                                        <div class="field">
                                            <label asp-for="Item.Quantity"></label>
                                            <input asp-for="Item.Quantity" type="number" step="0.001" min="0.001" />
                                            <span asp-validation-for="Item.Quantity" class="validation"></span>
                                        </div>
                                        <div class="field">
                                            <label asp-for="Item.UnitOfMeasureId">Unit of measure</label>
                                            <select asp-for="Item.UnitOfMeasureId">
                                                @foreach (UnitOfMeasureOption unit in Model.UnitsOfMeasure)
                                                {
                                                    <option value="@unit.Id">@unit.Name (@unit.Code)</option>
                                                }
                                            </select>
                                            <span asp-validation-for="Item.UnitOfMeasureId" class="validation"></span>
                                        </div>
                                    </div>
                                    <div class="field">
                                        <label asp-for="Item.Notes">Notes</label>
                                        <input asp-for="Item.Notes" />
                                    </div>
                                    <button class="button button-outline" type="submit">Add item</button>
                                </form>

                                <form method="post" asp-page-handler="Submit" style="margin-top:18px">
                                    <input type="hidden" name="id" value="@Model.Request.Id" />
                                    <button class="button" type="submit" @(Model.Request.Items.Count == 0 ? "disabled" : null)>Submit request to FFP</button>
                                </form>
                            }
                        </section>
                    }

                    @if (Model.Request.Status == "MoreInformationRequired")
                    {
                        <section class="operational-panel" style="margin-top:10px">
                            <div class="flash error">
                                FFP requested additional information. The latest request from FFP appears in the status history. Add any supporting documents below, then send your response here.
                            </div>
                            @if (Model.ProjectProposal is not null)
                            {
                                <a class="button button-outline" asp-page="/Requests/Proposal" asp-route-id="@Model.Request.Id">Update project proposal</a>
                            }
                            <form method="post" asp-page-handler="InformationResponse" class="form-grid" style="margin-top:18px">
                                <input type="hidden" name="id" value="@Model.Request.Id" />
                                <div class="field">
                                    <label asp-for="InformationResponse.Message">Response to FFP</label>
                                    <textarea asp-for="InformationResponse.Message" rows="5" placeholder="Provide the information requested by FFP."></textarea>
                                    <span asp-validation-for="InformationResponse.Message" class="validation"></span>
                                </div>
                                @if (Model.Documents.Count > 0)
                                {
                                    <fieldset class="field" style="border:1px solid #dde3e8;padding:14px">
                                        <legend style="font-weight:700">Include supporting documents</legend>
                                        @foreach (DocumentSummary document in Model.Documents)
                                        {
                                            <label style="display:flex;gap:8px;align-items:center;font-weight:500">
                                                <input type="checkbox" name="InformationResponse.DocumentIds" value="@document.Id" />
                                                <span>@document.OriginalFileName <small class="muted">(@document.DocumentType)</small></span>
                                            </label>
                                        }
                                    </fieldset>
                                }
                                <button class="button" type="submit">Send response to FFP</button>
                            </form>
                        </section>
                    }


                    @if (Model.Deliveries.Count > 0)
                    {
                        <section class="operational-panel" style="margin-top:10px">
                            <h2>Delivery / Proof of Delivery</h2>
                            <div class="table-wrap"><table>
                                <thead><tr><th>Reference</th><th>Recipient</th><th>Status</th><th>Acknowledged</th><th>Evidence</th><th>Notes</th></tr></thead>
                                <tbody>
                                @foreach (RequestPortal.Application.Delivery.DeliveryView delivery in Model.Deliveries)
                                {
                                    <tr>
                                        <td>@delivery.DocumentReference</td>
                                        <td>@delivery.RecipientName</td>
                                        <td><strong>@delivery.Status</strong></td>
                                        <td>@(delivery.AcknowledgedUtc?.ToLocalTime().ToString("g") ?? "Awaiting acknowledgement")</td>
                                        <td>@(delivery.EvidenceDocumentId.HasValue ? "Attached" : "—")</td>
                                        <td>@(delivery.Notes ?? "—")</td>
                                    </tr>
                                }
                                </tbody>
                            </table></div>
                        </section>
                    }

                    <section class="operational-panel" style="margin-top:10px">
                        <h2>Supporting documents</h2>
                        @if (Model.DocumentsUnavailable)
                        {
                            <div class="flash error" role="alert">Document storage is temporarily unavailable. Your request and conversation are still available. Reference: @HttpContext.TraceIdentifier</div>
                        }
                        @if (Model.Documents.Count == 0)
                        {
                            <p class="muted">No supporting documents have been uploaded.</p>
                        }
                        else
                        {
                            <div class="table-wrap">
                                <table>
                                    <thead><tr><th>File</th><th>Type</th><th>Uploaded UTC</th><th></th></tr></thead>
                                    <tbody>
                                    @foreach (DocumentSummary document in Model.Documents)
                                    {
                                        <tr>
                                            <td>@document.OriginalFileName</td>
                                            <td>@document.DocumentType</td>
                                            <td>@document.UploadedUtc.ToString("u")</td>
                                            <td><a asp-page-handler="Download" asp-route-id="@Model.Request.Id" asp-route-documentId="@document.Id">Download</a></td>
                                        </tr>
                                    }
                                    </tbody>
                                </table>
                            </div>
                        }

                        @if (Model.Request.Status == "Draft" || Model.Request.Status == "MoreInformationRequired")
                        {
                            <form method="post" enctype="multipart/form-data" asp-page-handler="UploadDocument" class="form-grid" style="margin-top:1rem">
                                <input type="hidden" name="id" value="@Model.Request.Id" />
                                <div class="field">
                                    <label asp-for="Document.DocumentType">Document type</label>
                                    <select asp-for="Document.DocumentType" asp-items="Html.GetEnumSelectList<DocumentType>()"></select>
                                </div>
                                <div class="field">
                                    <label asp-for="Document.File">File</label>
                                    <input asp-for="Document.File" type="file" />
                                    <span asp-validation-for="Document.File" class="validation"></span>
                                </div>
                                <button class="button button-outline" type="submit">Upload document</button>
                            </form>
                        }
                    </section>

                    

                    @if (Model.Request.Status == "Draft" || Model.Request.Status == "Submitted" || Model.Request.Status == "MoreInformationRequired")
                    {
                        <section class="operational-panel" style="margin-top:10px">
                            <h2>Cancel request</h2>
                            <p class="muted">Cancellation is permanent and is recorded in the request history.</p>
                            <form method="post" asp-page-handler="Cancel" class="form-grid">
                                <input type="hidden" name="id" value="@Model.Request.Id" />
                                <div class="field">
                                    <label asp-for="Cancellation.Reason">Reason</label>
                                    <textarea asp-for="Cancellation.Reason" rows="3"></textarea>
                                    <span asp-validation-for="Cancellation.Reason" class="validation"></span>
                                </div>
                                <button class="button button-outline" type="submit">Cancel request</button>
                            </form>
                        </section>
                    }
                </div>

                <aside class="request-detail-side">
                    <section class="operational-panel request-status-card">
                        <div class="panel-titlebar">
                            <strong>Status history</strong>
                        </div>
                    <div class="timeline">
                        @foreach (RequestHistoryDetail history in Model.Request.History)
                        {
                            <div class="timeline-item">
                                <strong>@RequestStatusPresentation.Label(history.Status)</strong>
                                @if (!string.IsNullOrWhiteSpace(history.Reason))
                                {
                                    <span>@history.Reason</span>
                                }
                                <small>@history.ChangedUtc.ToLocalTime().ToString("f")</small>
                            </div>
                        }
                    </div>
                    </section>
                </aside>
            </div>
        }
    </div>
</section>

<style>
    .request-progress { display:flex; flex-wrap:wrap; gap:12px; margin-bottom:10px; }
    .request-progress span { display:flex; flex-direction:column; flex:1; min-width:170px; }
    .request-progress [aria-current] { border-left:4px solid #d46b08; padding-left:8px; }
    .request-reply-form { padding:8px; }
    .request-reply-box { position:relative; }
    .request-reply-box textarea { width:100%; padding-right:45px; box-sizing:border-box; }
    .reply-paperclip { position:absolute; right:8px; bottom:12px; cursor:pointer; font-size:20px; }
    .reply-paperclip input { position:absolute; inset:0; width:28px; opacity:0; cursor:pointer; }
    .request-conversation { border-bottom:1px solid #dde3e8; padding:8px; }
    .request-conversation-history { max-height:350px; overflow:auto; }
    .request-conversation-history time { font-size:.75rem; color:#53616b; }
    .request-message-list { background:#fff; border-top:1px solid #e3e7ea; border-bottom:1px solid #e3e7ea; }
    .request-message-item { padding:10px 12px; border-bottom:1px solid #edf0f2; }
    .request-message-item:last-child { border-bottom:0; }
    .request-message-item.is-mine { background:#f7fafc; }
    .request-message-meta { display:flex; justify-content:space-between; gap:12px; align-items:baseline; }
    .request-message-item p { margin:5px 0 0; white-space:pre-wrap; line-height:1.45; }
    .request-detail-reply { border-top:0; background:#fafbfc; }
    .request-detail-reply > label { display:block; margin-bottom:6px; }
    .request-attachment-hint { margin-top:5px; color:#6b7780; font-size:.78rem; }
    .proposal-document {
        margin-top: 18px;
        background: #fff;
        border: 1px solid #e0e4e7;
        padding: 16px 20px;
        font-family: Georgia, 'Times New Roman', serif;
        line-height: 1.65;
        overflow-wrap: anywhere;
    }

    .proposal-document table {
        width: 100%;
        border-collapse: collapse;
        margin: 16px 0;
    }

    .proposal-document th, .proposal-document td {
        border: 1px solid #8b949c;
        padding: 8px;
    }

    .proposal-document img {
        max-width: 100%;
        height: auto;
    }
</style>
