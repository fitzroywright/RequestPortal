@page "{id:guid}"
@model RequestPortal.Web.Pages.Requests.DetailsModel
@using RequestPortal.Application.Documents
@using RequestPortal.Application.Delivery
@using RequestPortal.Application.ReferenceData
@using RequestPortal.Application.Requests
@using RequestPortal.Domain.Documents
@using RequestPortal.Domain.Requests
@{
    ViewData["Title"] = "Request Details";
}

<section class="mock-request-detail">
    <div class="mock-request-shell">
        @if (Model.Request is null)
        {
            <section class="mock-panel"><div class="mock-panel-head"><strong>Request not found</strong></div></section>
        }
        else
        {
            var requestMessages = Model.MessageThreads
                    .SelectMany(thread => thread.Messages.Select(message => new { Thread = thread, Message = message }))
                    .OrderByDescending(item => item.Message.SentUtc)
                    .ToArray();

                var replyThread = Model.MessageThreads
                    .Where(thread => !thread.ClosedUtc.HasValue)
                    .OrderByDescending(thread => thread.Messages.LastOrDefault()?.SentUtc ?? DateTimeOffset.MinValue)
                    .FirstOrDefault();

                string categoryDisplay = !string.IsNullOrWhiteSpace(Model.DetailMeta.Subcategory)
                    ? Model.DetailMeta.Subcategory
                    : !string.IsNullOrWhiteSpace(Model.DetailMeta.Category)
                        ? Model.DetailMeta.Category
                        : "—";

                string locationDisplay = !string.IsNullOrWhiteSpace(Model.DetailMeta.Location)
                    ? Model.DetailMeta.Location
                    : !string.IsNullOrWhiteSpace(Model.RequesterCard.Parish)
                        ? Model.RequesterCard.Parish
                        : "—";

            string submittedByContext = Model.DetailMeta.IsIndividualRequest
                ? "Individual"
                : Model.Request.OrganizationName;

            <header class="mock-request-header">
                <div class="mock-request-heading">
                    <a class="mock-back-link" asp-page="/Requests/Index">‹&nbsp; Back to My Requests</a>
                    <div class="mock-title-row">
                        <h1>@Model.Request.PublicReference</h1>
                        <span class="mock-status-pill">@RequestStatusPresentation.Label(Model.Request.Status)</span>
                    </div>
                    <h2>@(Model.DetailMeta.Category ?? Model.Request.Summary)</h2>
                    <p>
                        @(Model.DetailMeta.SubmittedUtc.HasValue
                            ? $"Submitted on {Model.DetailMeta.SubmittedUtc.Value.ToLocalTime():d MMM yyyy 'at' h:mm tt}"
                            : $"Created on {Model.DetailMeta.CreatedUtc.ToLocalTime():d MMM yyyy 'at' h:mm tt}")
                        by @Model.DetailMeta.SubmittedByName (@submittedByContext)
                    </p>
                </div>
                <div class="mock-header-actions">
                    @if (Model.Request.Status == "Draft" || Model.Request.Status == "MoreInformationRequired")
                    {
                        <a class="mock-action-button mock-action-edit" href="#items">✎&nbsp; Edit Request</a>
                    }
                    @if (Model.Request.Status == "Draft" || Model.Request.Status == "Submitted" || Model.Request.Status == "MoreInformationRequired")
                    {
                        <a class="mock-action-button mock-action-cancel" href="#cancel-request">Cancel Request</a>
                    }
                </div>
            </header>

            <nav class="mock-tabs" aria-label="Request detail sections">
                <a class="is-active" href="#summary">Overview</a>
                <a href="#items">Items (@Model.Request.Items.Count)</a>
                @if (Model.Request.Status is "Approved" or "PendingFulfilment" or "Fulfilled" or "Closed" || Model.Deliveries.Count > 0)
                {
                    <a href="#delivery">Delivery</a>
                }
                <a href="#messages">Messages (@requestMessages.Length)</a>
                <a href="#files">Files (@Model.Documents.Count)</a>
                <a href="#history">History (@Model.Request.History.Count)</a>
            </nav>

            <div class="mock-detail-grid">
                <main class="mock-detail-main">
                    <section id="summary" class="mock-panel">
                        <div class="mock-panel-head">
                            <div class="mock-panel-title"><span class="mock-panel-icon"><svg viewBox="0 0 24 24" aria-hidden="true"><rect x="5" y="3" width="14" height="18" rx="1.5"/><path d="M9 7h6M9 11h6M9 15h4"/></svg></span><strong>Request Summary</strong></div>
                            @if (Model.Request.Status == "Draft" || Model.Request.Status == "MoreInformationRequired")
                            {
                                <a class="mock-mini-button" href="#items">Edit</a>
                            }
                        </div>
                        <div class="mock-summary-content">
                            <dl class="mock-summary-list">
                                <div><dt>Request ID</dt><dd>@Model.Request.PublicReference</dd></div>
                                <div><dt>Status</dt><dd><span class="mock-inline-status">@RequestStatusPresentation.Label(Model.Request.Status)</span></dd></div>
                                <div><dt>Request Type</dt><dd>@Model.DetailMeta.RequestType</dd></div>
                                <div><dt>Category</dt><dd>@categoryDisplay</dd></div>
                                <div><dt>Priority</dt><dd><span class="mock-priority">@Model.DetailMeta.Priority</span></dd></div>
                                <div><dt>Submitted</dt><dd>@(Model.DetailMeta.SubmittedUtc?.ToLocalTime().ToString("d MMM yyyy, h:mm tt") ?? "Not submitted")</dd></div>
                                <div><dt>Last Updated</dt><dd>@Model.DetailMeta.LastUpdatedUtc.ToLocalTime().ToString("d MMM yyyy, h:mm tt")</dd></div>
                                <div><dt>Country</dt><dd>@(Model.RelatedCard.Country ?? "Jamaica")</dd></div>
                                <div><dt>Location / Parish</dt><dd>@locationDisplay</dd></div>
                                <div><dt>Beneficiary</dt><dd>@Model.RequesterCard.Name @(Model.DetailMeta.IsIndividualRequest ? "(Self)" : "")</dd></div>
                                <div><dt>Number of People</dt><dd>@(Model.RequesterCard.HouseholdSize?.ToString() ?? "—")</dd></div>
                            </dl>

                            <div class="mock-summary-description">
                                <h3>Description</h3>
                                <p>@Model.Request.Summary</p>
                                <hr />
                                <h3>Additional Details</h3>
                                <dl>
                                    <div><dt>Employment Status</dt><dd>@(Model.RequesterCard.EmploymentStatus ?? "—")</dd></div>
                                    <div><dt>Household Income</dt><dd>@(Model.RequesterCard.MonthlyHouseholdIncome.HasValue ? $"J$ {Model.RequesterCard.MonthlyHouseholdIncome.Value:N0}" : "—")</dd></div>
                                    <div><dt>Housing Situation</dt><dd>@(Model.RequesterCard.HousingSituation ?? "—")</dd></div>
                                    <div><dt>Parish / Area</dt><dd>@string.Join(" / ", new[] { Model.RequesterCard.Parish, Model.RequesterCard.DistrictArea }.Where(x => !string.IsNullOrWhiteSpace(x)))</dd></div>
                                    <div><dt>Contact Phone</dt><dd>@(Model.RequesterCard.Phone ?? "—")</dd></div>
                                    <div><dt>Alternative Phone</dt><dd>@(Model.RequesterCard.AlternativePhone ?? "—")</dd></div>
                                    <div><dt>Email</dt><dd>@(Model.RequesterCard.Email ?? "—")</dd></div>
                                </dl>
                            </div>
                        </div>
                    </section>

                    <section id="items" class="mock-panel">
                        <div class="mock-panel-head">
                            <div class="mock-panel-title"><span class="mock-panel-icon"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M6 4h12v16H6z"/><path d="M9 8h6M9 12h6M9 16h4"/></svg></span><strong>Requested Items (@Model.Request.Items.Count)</strong></div>
                        </div>
                        @if (Model.ProjectProposal is not null)
                        {
                            <div class="mock-project-body">
                                <h3>@Model.ProjectProposal.Title</h3>
                                <article class="proposal-document">@Html.Raw(Model.ProjectProposal.RichContentHtml)</article>
                            </div>
                        }
                        else if (Model.Request.Items.Count == 0)
                        {
                            <div class="mock-empty">No requested items have been added.</div>
                        }
                        else
                        {
                            <div class="mock-table-wrap">
                                <table class="mock-table">
                                    <thead><tr><th>Item</th><th>Quantity</th><th>Unit</th><th>Description</th></tr></thead>
                                    <tbody>
                                    @foreach (RequestItemDetail item in Model.Request.Items)
                                    {
                                        <tr>
                                            <td>@item.ItemName</td>
                                            <td>@item.Quantity</td>
                                            <td>@Model.UnitName(item.UnitOfMeasureId)</td>
                                            <td>@item.Description</td>
                                        </tr>
                                    }
                                    </tbody>
                                </table>
                            </div>
                        }

                        @if (Model.Request.Status == "Draft")
                        {
                            <details class="mock-edit-details">
                                <summary>Add requested item</summary>
                                <form method="post" asp-page-handler="AddItem" class="mock-form-grid">
                                    <input type="hidden" name="id" value="@Model.Request.Id" />
                                    <label>Item / Service<input asp-for="Item.ItemName" /></label>
                                    <label>Description<input asp-for="Item.Description" /></label>
                                    <div class="mock-form-row">
                                        <label>Quantity<input asp-for="Item.Quantity" type="number" step="0.001" min="0.001" /></label>
                                        <label>Unit<select asp-for="Item.UnitOfMeasureId">@foreach (UnitOfMeasureOption unit in Model.UnitsOfMeasure){<option value="@unit.Id">@unit.Name (@unit.Code)</option>}</select></label>
                                    </div>
                                    <label>Notes<input asp-for="Item.Notes" /></label>
                                    <button class="mock-blue-button" type="submit">Add Item</button>
                                </form>
                            </details>
                        }
                    </section>

                    @if (Model.Request.Status is "Approved" or "PendingFulfilment" or "Fulfilled" or "Closed" || Model.Deliveries.Count > 0)
                    {
                        <section id="delivery" class="mock-panel">
                            <div class="mock-panel-head">
                                <div class="mock-panel-title">
                                    <span class="mock-panel-icon">✓</span>
                                    <strong>Delivery</strong>
                                </div>
                            </div>
                            <div class="capstone-delivery-list">
                                @if (Model.Deliveries.Count == 0)
                                {
                                    <div class="mock-empty">No delivery has been recorded yet. Delivery information will appear here when Food For The Poor prepares the assistance for delivery.</div>
                                }
                                @foreach (DeliveryView delivery in Model.Deliveries)
                                {
                                    DeliveryLineSnapshot[] lines = RequestPortal.Web.Pages.Requests.DetailsModel.ReadDeliveryLines(delivery.SnapshotJson);
                                    <article class="capstone-delivery">
                                        <div class="capstone-delivery-summary">
                                            <div>
                                                <strong>@delivery.DocumentReference</strong>
                                                <span>@(delivery.RecipientConfirmedUtc.HasValue ? "Receipt confirmed" : "Confirmation required")</span>
                                            </div>
                                            <small>@delivery.CreatedUtc.ToLocalTime().ToString("d MMM yyyy, h:mm tt")</small>
                                        </div>

                                        <div class="mock-table-wrap capstone-table-wrap">
                                            <table class="mock-table">
                                                <thead><tr><th>Item</th><th>Expected</th><th>Received</th></tr></thead>
                                                <tbody>
                                                @if (delivery.RecipientConfirmedUtc.HasValue)
                                                {
                                                    foreach (RecipientConfirmedLine line in delivery.ConfirmedLines ?? Array.Empty<RecipientConfirmedLine>())
                                                    {
                                                        <tr>
                                                            <td>@line.Description</td>
                                                            <td>@line.ExpectedQuantity @(line.UnitOfMeasure ?? "")</td>
                                                            <td>@line.ReceivedQuantity @(line.UnitOfMeasure ?? "")</td>
                                                        </tr>
                                                    }
                                                }
                                                else
                                                {
                                                    for (int i = 0; i < lines.Length; i++)
                                                    {
                                                        <tr>
                                                            <td>@lines[i].Description</td>
                                                            <td>@lines[i].Quantity @(lines[i].UnitOfMeasure ?? "")</td>
                                                            <td>Awaiting confirmation</td>
                                                        </tr>
                                                    }
                                                }
                                                </tbody>
                                            </table>
                                        </div>

                                        @if (!delivery.RecipientConfirmedUtc.HasValue)
                                        {
                                            <form method="post" asp-page-handler="ConfirmReceipt" class="capstone-form">
                                                <input type="hidden" name="id" value="@Model.Request.Id" />
                                                <input type="hidden" name="ConfirmationDeliveryId" value="@delivery.Id" />
                                                <h3>Confirm what you received</h3>
                                                @for (int i = 0; i < lines.Length; i++)
                                                {
                                                    <label class="capstone-quantity-row">
                                                        <span>@lines[i].Description</span>
                                                        <input type="number"
                                                               name="ReceivedQuantities"
                                                               min="0"
                                                               max="@lines[i].Quantity"
                                                               step="0.001"
                                                               value="@lines[i].Quantity"
                                                               required />
                                                        <small>@(lines[i].UnitOfMeasure ?? "unit")</small>
                                                    </label>
                                                }
                                                <div class="capstone-problem-grid">
                                                    <label>
                                                        Delivery problem
                                                        <select name="DeliveryProblemType">
                                                            <option value="">No additional problem</option>
                                                            <option value="MissingItem">Missing item</option>
                                                            <option value="IncorrectItem">Incorrect item</option>
                                                            <option value="IncorrectQuantity">Incorrect quantity</option>
                                                            <option value="DamagedItem">Damaged item</option>
                                                            <option value="Other">Other</option>
                                                        </select>
                                                    </label>
                                                    <label>
                                                        Details
                                                        <textarea name="DeliveryProblemDetail" rows="2" maxlength="2000" placeholder="Describe any delivery problem."></textarea>
                                                    </label>
                                                </div>
                                                <button class="mock-blue-button" type="submit">Confirm receipt</button>
                                            </form>
                                        }
                                        else
                                        {
                                            @if ((delivery.Discrepancies?.Count ?? 0) > 0)
                                            {
                                                <div class="capstone-notice">
                                                    <strong>Delivery difference reported</strong>
                                                    <span>Food For The Poor has been notified through the existing request workflow.</span>
                                                </div>
                                            }

                                            @if (delivery.ReturnsPermitted)
                                            {
                                                <details class="capstone-return">
                                                    <summary>Request a return</summary>
                                                    <form method="post" asp-page-handler="InitiateReturn" class="capstone-form">
                                                        <input type="hidden" name="id" value="@Model.Request.Id" />
                                                        <input type="hidden" name="ReturnDeliveryId" value="@delivery.Id" />
                                                        <label>
                                                            Item
                                                            <select name="ReturnItemDescription" required>
                                                                <option value="">Choose item</option>
                                                                @foreach (RecipientConfirmedLine line in delivery.ConfirmedLines ?? Array.Empty<RecipientConfirmedLine>())
                                                                {
                                                                    if (line.ReceivedQuantity > 0)
                                                                    {
                                                                        <option value="@line.Description">@line.Description</option>
                                                                    }
                                                                }
                                                            </select>
                                                        </label>
                                                        <label>
                                                            Quantity
                                                            <input type="number" name="ReturnQuantity" min="0.001" step="0.001" required />
                                                        </label>
                                                        <label>
                                                            Reason
                                                            <textarea name="ReturnReason" rows="3" maxlength="2000" required></textarea>
                                                        </label>
                                                        <button class="mock-blue-button" type="submit">Submit return request</button>
                                                    </form>
                                                </details>
                                            }
                                        }

                                        @{
                                            DeliveryReturnView[] deliveryReturns = Model.DeliveryReturns
                                                .Where(item => item.DeliveryId == delivery.Id)
                                                .ToArray();
                                        }
                                        @if (deliveryReturns.Length > 0)
                                        {
                                            <div class="capstone-return-status">
                                                <strong>Return status</strong>
                                                @foreach (DeliveryReturnView item in deliveryReturns)
                                                {
                                                    <div>
                                                        <span>@item.ItemDescription · @item.Quantity</span>
                                                        <b>@item.Status</b>
                                                        @if (!string.IsNullOrWhiteSpace(item.StatusDetail))
                                                        {
                                                            <small>@item.StatusDetail</small>
                                                        }
                                                    </div>
                                                }
                                            </div>
                                        }
                                    </article>
                                }
                            </div>
                        </section>
                    }

                    <section id="messages" class="mock-panel mock-messages-panel">
                        <div class="mock-panel-head">
                            <div class="mock-panel-title"><span class="mock-panel-icon"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 5h16v11H8l-4 4V5z"/><path d="M8 9h8M8 12h5"/></svg></span><strong>Messages (@requestMessages.Length)</strong></div>
                        </div>
                        <div class="mock-message-list">
                            @if (requestMessages.Length == 0)
                            {
                                <div class="mock-empty">No messages have been received for this request yet.</div>
                            }
                            else
                            {
                                @foreach (var item in requestMessages.Take(5))
                                {
                                    <article class="mock-message-row">
                                        <div class="mock-avatar @(item.Message.IsMine ? "is-requester" : "is-staff")">@(item.Message.SenderName.Length > 0 ? item.Message.SenderName.Substring(0,1).ToUpperInvariant() : "M")</div>
                                        <div class="mock-message-copy">
                                            <div class="mock-message-meta"><strong>@item.Message.SenderName</strong><span>@item.Message.SentUtc.ToLocalTime().ToString("d MMM yyyy, h:mm tt")</span><span class="mock-message-more">•••</span></div>
                                            <p>@item.Message.Body</p>
                                            @foreach (var attachment in item.Message.Attachments)
                                            {
                                                <a class="mock-attachment-link" target="_blank" rel="noopener" asp-page="/Documents/Preview" asp-route-threadId="@item.Thread.ThreadId" asp-route-documentId="@attachment.DocumentId">📎 @attachment.FileName</a>
                                            }
                                        </div>
                                    </article>
                                }
                            }
                        </div>
                        @if (!Model.RequestConversationReadOnly)
                        {
                            bool startingNewMessage = requestMessages.Length == 0 || replyThread is null;
                            <form id="message-composer" method="post" enctype="multipart/form-data" asp-page-handler="Reply" class="mock-message-composer">
                                <input type="hidden" name="id" value="@Model.Request.Id" />
                                @if (replyThread is not null){<input type="hidden" name="ReplyThreadId" value="@replyThread.ThreadId" />}
                                <textarea name="Reply" rows="3" maxlength="10000" required placeholder="@(startingNewMessage ? "Type a new message..." : "Type your reply...")">@Model.Reply</textarea>
                                <span asp-validation-for="Reply" class="validation"></span>
                                <div asp-validation-summary="ModelOnly" class="validation"></div>
                                <div class="mock-composer-actions">
                                    <div class="mock-attachment-picker">
                                        <label class="mock-attach-button">📎 Attach<input id="reply-attachment" name="ReplyAttachment" type="file" /></label>
                                        <span id="reply-attachment-name" class="mock-attachment-name">No file selected</span>
                                    </div>
                                    <button class="mock-blue-button" type="submit">Send</button>
                                </div>
                            </form>
                        }
                        else
                        {
                            <div class="mock-readonly">@Model.RequestConversationReadOnlyReason</div>
                        }
                    </section>

                    @if (Model.Request.Status == "MoreInformationRequired")
                    {
                        <section class="mock-panel">
                            <div class="mock-panel-head"><div class="mock-panel-title"><strong>Additional Information Required</strong></div></div>
                            <form method="post" asp-page-handler="InformationResponse" class="mock-form-grid mock-panel-body">
                                <input type="hidden" name="id" value="@Model.Request.Id" />
                                <label>Response to FFP<textarea asp-for="InformationResponse.Message" rows="4"></textarea></label>
                                <button class="mock-blue-button" type="submit">Send Response</button>
                            </form>
                        </section>
                    }

                    @if (Model.Request.Status == "Draft")
                    {
                        <form method="post" asp-page-handler="Submit" class="mock-submit-row">
                            <input type="hidden" name="id" value="@Model.Request.Id" />
                            <button class="mock-blue-button" type="submit" @(Model.Request.Items.Count == 0 && Model.ProjectProposal is null ? "disabled" : null)>Submit Request to FFP</button>
                        </form>
                    }

                    @if (Model.Request.Status == "Draft" || Model.Request.Status == "Submitted" || Model.Request.Status == "MoreInformationRequired")
                    {
                        <section id="cancel-request" class="mock-panel mock-cancel-panel">
                            <div class="mock-panel-head"><div class="mock-panel-title"><strong>Cancel Request</strong></div></div>
                            <form method="post" asp-page-handler="Cancel" class="mock-cancel-form">
                                <input type="hidden" name="id" value="@Model.Request.Id" />
                                <p>Cancellation is permanent and is recorded in the request history.</p>
                                <label>Reason<textarea asp-for="Cancellation.Reason" rows="3"></textarea></label>
                                <button class="mock-action-button mock-action-cancel" type="submit">Cancel Request</button>
                            </form>
                        </section>
                    }
                </main>

                <aside class="mock-detail-side">
                    <section class="mock-panel">
                        <div class="mock-panel-head">
                            <div class="mock-panel-title"><span class="mock-panel-icon"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M8 3h8l1 3h2v14H5V6h2l1-3z"/><path d="M9 10h6M9 14h6"/></svg></span><strong>Current Status</strong></div>
                            <span class="mock-status-pill">@RequestStatusPresentation.Label(Model.Request.Status)</span>
                        </div>
                        <div class="mock-status-steps" id="history">
                            @{
                                string[] statusSteps = { "Submitted", "Under Review", "More Information Required", "Approved", "In Progress", "Completed", "Closed" };
                                string currentLabel = RequestStatusPresentation.Label(Model.Request.Status);
                            }
                            @for (int i = 0; i < statusSteps.Length; i++)
                            {
                                bool active = string.Equals(statusSteps[i], currentLabel, StringComparison.OrdinalIgnoreCase) || (Model.Request.Status == "Submitted" && i == 0);
                                <div class="mock-status-step @(active ? "is-active" : null)">
                                    <span class="mock-status-node"></span>
                                    <div><strong>@statusSteps[i]</strong>@if(active){<small>@Model.DetailMeta.LastUpdatedUtc.ToLocalTime().ToString("d MMM yyyy, h:mm tt")</small>}</div>
                                </div>
                            }
                        </div>
                        <div class="mock-status-footer">
                            <div><span>Last Updated</span><strong>@Model.DetailMeta.LastUpdatedUtc.ToLocalTime().ToString("d MMM yyyy, h:mm tt")</strong></div>
                            <div><span>Updated By</span><strong>@Model.DetailMeta.SubmittedByName</strong></div>
                        </div>
                    </section>

                    <section class="mock-panel">
                        <div class="mock-panel-head"><div class="mock-panel-title"><span class="mock-panel-icon"><svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="8" r="4"/><path d="M4 21c0-4 3-7 8-7s8 3 8 7"/></svg></span><strong>Requester Information</strong></div></div>
                        <dl class="mock-side-list">
                            <div><dt>Name</dt><dd>@Model.RequesterCard.Name</dd></div>
                            <div><dt>Date of Birth</dt><dd>@(Model.RequesterCard.DateOfBirth?.ToString("dd MMM yyyy") ?? "—")</dd></div>
                            <div><dt>National ID / TRN</dt><dd>@(Model.RequesterCard.NationalIdTrn ?? "—")</dd></div>
                            <div><dt>Phone</dt><dd>@(Model.RequesterCard.Phone ?? "—")</dd></div>
                            <div><dt>Email</dt><dd>@(Model.RequesterCard.Email ?? "—")</dd></div>
                            <div><dt>Address</dt><dd>@(Model.RequesterCard.Address ?? "—")<br />@string.Join(", ", new[] { Model.RequesterCard.DistrictArea, Model.RequesterCard.Parish }.Where(x => !string.IsNullOrWhiteSpace(x)))</dd></div>
                            <div><dt>Household Size</dt><dd>@(Model.RequesterCard.HouseholdSize?.ToString() ?? "—")</dd></div>
                            <div><dt>Employment</dt><dd>@(Model.RequesterCard.EmploymentStatus ?? "—")</dd></div>
                        </dl>
                    </section>

                    <section class="mock-panel">
                        <div class="mock-panel-head"><div class="mock-panel-title"><span class="mock-panel-icon"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M3 5h3l2 10h10l2-7H7"/><circle cx="10" cy="19" r="1.5"/><circle cx="18" cy="19" r="1.5"/></svg></span><strong>Related Information</strong></div></div>
                        <dl class="mock-related-list">
                            <div><dt>▧&nbsp; Organization</dt><dd>@Model.RelatedCard.Organization</dd></div>
                            <div><dt>♟&nbsp; Assigned To</dt><dd>—</dd></div>
                            <div><dt>⌘&nbsp; FFP Reference</dt><dd>@(Model.RelatedCard.FfpReference ?? "—")</dd></div>
                            <div><dt>↗&nbsp; External Links</dt><dd>—</dd></div>
                        </dl>
                    </section>

                    <section id="files" class="mock-panel">
                        <div class="mock-panel-head"><div class="mock-panel-title"><span class="mock-panel-icon"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M8 12.5 14.5 6a3 3 0 0 1 4.2 4.2L10 19a5 5 0 0 1-7-7l9-9"/></svg></span><strong>Files (@Model.Documents.Count)</strong></div></div>
                        <div class="mock-files-list">
                            @if (Model.Documents.Count == 0)
                            {
                                <div class="mock-empty">No files uploaded.</div>
                            }
                            else
                            {
                                @foreach (DocumentSummary document in Model.Documents)
                                {
                                    <div class="mock-file-row"><span class="mock-file-icon">▧</span><a target="_blank" rel="noopener" asp-page="/Documents/Preview" asp-route-requestId="@Model.Request.Id" asp-route-documentId="@document.Id">@document.OriginalFileName</a><time>@document.UploadedUtc.ToLocalTime().ToString("d MMM yyyy, h:mm tt")</time></div>
                                }
                            }
                        </div>
                        @if (Model.Request.Status == "Draft" || Model.Request.Status == "MoreInformationRequired")
                        {
                            <details class="mock-upload-details">
                                <summary>Upload file</summary>
                                <form method="post" enctype="multipart/form-data" asp-page-handler="UploadDocument" class="mock-form-grid">
                                    <input type="hidden" name="id" value="@Model.Request.Id" />
                                    <label>
                                        Document type
                                        <select asp-for="Document.DocumentType">
                                            @foreach (DocumentType documentType in Enum.GetValues<DocumentType>().Where(value => value is not DocumentType.MessageAttachment and not DocumentType.DeliveryEvidence))
                                            {
                                                <option value="@documentType">@documentType</option>
                                            }
                                        </select>
                                    </label>
                                    <label>
                                        File
                                        <input asp-for="Document.File" type="file" />
                                        <span asp-validation-for="Document.File" class="text-danger"></span>
                                    </label>
                                    <button class="mock-blue-button" type="submit">Upload</button>
                                </form>
                            </details>
                        }
                    </section>
                </aside>
            </div>
        }
    </div>
</section>

