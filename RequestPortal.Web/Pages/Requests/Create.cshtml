@page
@model RequestPortal.Web.Pages.Requests.CreateModel
@using RequestPortal.Application.ReferenceData
@using RequestPortal.Domain.Requests
@{
    ViewData["Title"] = "New Request";
}

<section class="new-request-page">
    <div class="shell">
        <form method="post" enctype="multipart/form-data" id="new-request-form">
            <div asp-validation-summary="ModelOnly" class="validation request-validation"></div>

            @if (Model.Organizations.Count == 0)
            {
                <section class="request-empty-state">
                    <h1>New Request</h1>
                    <p>Your request context could not be loaded. Please refresh the page or contact FFP if the problem continues.</p>
                </section>
            }
            else
            {
                <header class="request-topbar">
                    <div>
                        <div class="eyebrow request-eyebrow">New request</div>
                        <h1>Request application</h1>
                    </div>
                    <div class="request-submit-actions">
                        <button class="button button-outline" type="button" id="review-request">Review</button>
                        <button class="button" type="submit">Submit Request</button>
                    </div>
                </header>

                <section class="request-common-layout" aria-label="Request application details">
                    <section class="request-mini-card request-classification-card">
                        <div class="request-mini-card-title">Request Classification</div>
                        <div class="request-mini-card-body classification-grid">
                            <div class="field">
                                <label asp-for="Input.Category">Category</label>
                                <select asp-for="Input.Category">
                                    <option value="">Select category</option>
                                    @foreach (RequestCategoryOption category in Model.Categories)
                                    {
                                        <option value="@category.Name">@category.Name</option>
                                    }
                                </select>
                            </div>
                            <div class="field">
                                <label asp-for="Input.Subcategory">Subcategory</label>
                                <input asp-for="Input.Subcategory" />
                            </div>
                            <div class="field">
                                <label asp-for="Input.ProgramCategory">Program</label>
                                <select asp-for="Input.ProgramCategory">
                                    <option value="">Select program</option>
                                    @foreach (ProgramClassificationOption program in Model.Programs)
                                    {
                                        <option value="@program.Name">@program.Name</option>
                                    }
                                </select>
                            </div>
                        </div>
                    </section>

                    <section class="request-mini-card request-address-card">
                        <div class="request-mini-card-title" style="display:flex;align-items:center;justify-content:space-between;gap:12px;">
                            <span>Request Location</span>
                        </div>
                        <div class="request-mini-card-body address-grid">
                            <div class="field request-address-field">
                                <label asp-for="Input.Address">Address</label>
                                <input asp-for="Input.Address" placeholder="Street, district or community" />
                            </div>
                            <div class="field">
                                <label asp-for="Input.Town">Town</label>
                                <input asp-for="Input.Town"
                                       id="request-town"
                                       list="request-town-options"
                                       autocomplete="off"
                                       placeholder="Start typing a town" />
                                <datalist id="request-town-options"></datalist>
                            </div>
                            <div class="field request-parish-field">
                                <label asp-for="Input.Parish">Parish</label>
                                <select asp-for="Input.Parish" id="request-parish">
                                    <option value="">Select parish</option>
                                    <option>Kingston</option>
                                    <option>St. Andrew</option>
                                    <option>St. Thomas</option>
                                    <option>Portland</option>
                                    <option>St. Mary</option>
                                    <option>St. Ann</option>
                                    <option>Trelawny</option>
                                    <option>St. James</option>
                                    <option>Hanover</option>
                                    <option>Westmoreland</option>
                                    <option>St. Elizabeth</option>
                                    <option>Manchester</option>
                                    <option>Clarendon</option>
                                    <option>St. Catherine</option>
                                </select>
                            </div>
                        </div>
                        <footer class="request-mini-card-footer">
                            <button class="button button-outline button-small" type="button" id="use-location">Use device location</button>
                            <input asp-for="Input.Location" type="hidden" />
                            <input asp-for="Input.Latitude" type="hidden" />
                            <input asp-for="Input.Longitude" type="hidden" />
                            <small id="location-status" class="muted"></small>
                        </footer>
                    </section>

                    <section class="request-mini-card request-summary-card">
                        <div class="request-mini-card-title" style="display:flex;align-items:center;justify-content:space-between;gap:12px;">
                            <span>Request Summary</span>
                            <a id="edit-profile-link"
                               class="request-profile-link"
                               href="#">Edit profile</a>
                        </div>
                        <div class="request-mini-card-body request-summary-grid">
                            <div class="requester-field requester-org">
                                <span class="requester-label">Requesting as</span>
                                <select asp-for="Input.OrganizationId" id="requester-select">
                                    @foreach (var organization in Model.Organizations)
                                    {
                                        <option value="@organization.Id"
                                                data-name="@organization.Name"
                                                data-role="@organization.Role"
                                                data-complete="@organization.ProfileComplete.ToString().ToLowerInvariant()"
                                                data-missing="@organization.MissingProfileFields"
                                                data-individual="@organization.IsIndividualContext.ToString().ToLowerInvariant()">
                                            @organization.Name
                                        </option>
                                    }
                                </select>
                                <span asp-validation-for="Input.OrganizationId" class="validation"></span>
                            </div>
                            <div class="field request-priority-field">
                                <label asp-for="Input.Priority">Priority</label>
                                <select asp-for="Input.Priority" asp-items="Html.GetEnumSelectList<RequestPriority>()"></select>
                            </div>

                            <div class="field request-summary-field">
                                <label asp-for="Input.Summary">Request summary</label>
                                <input asp-for="Input.Summary" placeholder="A short title or one-line summary of the need" />
                                <span asp-validation-for="Input.Summary" class="validation"></span>
                            </div>
                        </div>
                    </section>
                </section>

                <section id="profile-warning" class="profile-warning" hidden>
                    <strong>Complete Your Profile</strong>
                    <span id="profile-warning-text"></span>
                    <a id="complete-profile-link" class="button button-small" href="#">Complete profile</a>
                </section>

                <section class="request-type-row" aria-label="Request type">
                    <span class="request-type-label">Request type</span>
                    <label class="request-type-option">
                        <input asp-for="Input.Kind" type="radio" value="@RequestKind.Project" />
                        <span>Project</span>
                    </label>
                    <label class="request-type-option">
                        <input asp-for="Input.Kind" type="radio" value="@RequestKind.GoodsAndServices" />
                        <span>Goods &amp; Services</span>
                    </label>
                </section>

                <main class="request-workspace">
                    <section id="project-workspace" class="request-mode-panel">
                        <div class="workspace-heading">
                            <div>
                                <h2>Project description</h2>
                                <p>Write the proposal here and attach supporting records below.</p>
                            </div>
                            <div class="field compact-title-field">
                                <label asp-for="Project.Title">Proposal title</label>
                                <input asp-for="Project.Title" />
                            </div>
                        </div>

                        <div class="rich-editor-shell">
                            <div class="rich-editor-toolbar" role="toolbar" aria-label="Project description formatting">
                                <button type="button" data-command="undo" title="Undo" aria-label="Undo">↶</button>
                                <button type="button" data-command="redo" title="Redo" aria-label="Redo">↷</button>
                                <span class="rich-editor-toolbar-separator" aria-hidden="true"></span>
                                <button type="button" data-command="bold" title="Bold" aria-label="Bold"><strong>B</strong></button>
                                <button type="button" data-command="italic" title="Italic" aria-label="Italic"><em>I</em></button>
                                <span class="rich-editor-toolbar-separator" aria-hidden="true"></span>
                                <button type="button" class="editor-icon-button" data-block="p" title="Paragraph" aria-label="Paragraph">
                                    <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M8 4h9a4 4 0 0 1 0 8h-2v8h-2V6h-2v14H9v-8H8a4 4 0 1 1 0-8Zm0 2a2 2 0 1 0 0 4h1V6H8Zm7 0v4h2a2 2 0 1 0 0-4h-2Z"/></svg>
                                </button>
                                <button type="button" class="editor-icon-button" data-block="h2" title="Heading" aria-label="Heading">
                                    <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 5h2v6h8V5h2v14h-2v-6H6v6H4V5Zm14 8h5v2h-3v1h2a1 1 0 0 1 1 1v3h-5v-2h3v-1h-2a1 1 0 0 1-1-1v-3Z"/></svg>
                                </button>
                                <button type="button" class="editor-icon-button" data-command="insertUnorderedList" title="Bulleted list" aria-label="Bulleted list">
                                    <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 6a1.5 1.5 0 1 1-3 0 1.5 1.5 0 0 1 3 0Zm2-1h15v2H7V5ZM5 12a1.5 1.5 0 1 1-3 0 1.5 1.5 0 0 1 3 0Zm2-1h15v2H7v-2Zm-2 7a1.5 1.5 0 1 1-3 0 1.5 1.5 0 0 1 3 0Zm2-1h15v2H7v-2Z"/></svg>
                                </button>
                                <button type="button" class="editor-icon-button" data-command="insertOrderedList" title="Numbered list" aria-label="Numbered list">
                                    <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M3 4h2v4H3V6H2V5h1V4Zm-1 7h3v1l-2 2h2v1H2v-1l2-2H2v-1Zm0 6h3v1l-1 1 1 1v1H2v-1h2l-1-1 1-1H2v-1Zm6-12h14v2H8V5Zm0 6h14v2H8v-2Zm0 6h14v2H8v-2Z"/></svg>
                                </button>
                                <button type="button" class="editor-icon-button" id="insert-table" title="Insert table" aria-label="Insert table">
                                    <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M3 4h18v16H3V4Zm2 2v3h4V6H5Zm6 0v3h4V6h-4Zm6 0v3h2V6h-2ZM5 11v3h4v-3H5Zm6 0v3h4v-3h-4Zm6 0v3h2v-3h-2ZM5 16v2h4v-2H5Zm6 0v2h4v-2h-4Zm6 0v2h2v-2h-2Z"/></svg>
                                </button>
                            </div>
                            <div id="project-editor"
                                 class="rich-project-editor"
                                 contenteditable="true"
                                 role="textbox"
                                 aria-multiline="true"
                                 aria-label="Project description">@Model.Project.RichContentHtml</div>
                            <input asp-for="Project.RichContentHtml" type="hidden" id="project-html" />
                            <span asp-validation-for="Project.RichContentHtml" class="validation"></span>
                        </div>

                        <div class="project-bottom-grid">
                            <section class="supporting-documents">
                                <div class="workspace-subheading">
                                    <h3>Supporting documents</h3>
                                    <span class="muted">Check a category when you are providing documents for it.</span>
                                </div>

                                <div class="document-category-list">
                                    <label class="document-category">
                                        <span><input asp-for="SupportingDocuments.HasEvidence" class="doc-check" data-files="evidence-files" /> Evidence / Supporting Evidence</span>
                                        <input asp-for="SupportingDocuments.EvidenceFiles" id="evidence-files" type="file" multiple />
                                    </label>
                                    <label class="document-category">
                                        <span><input asp-for="SupportingDocuments.HasEligibilityDocuments" class="doc-check" data-files="eligibility-files" /> Eligibility Documents</span>
                                        <input asp-for="SupportingDocuments.EligibilityFiles" id="eligibility-files" type="file" multiple />
                                    </label>
                                    <label class="document-category">
                                        <span><input asp-for="SupportingDocuments.HasRegistrationMaterial" class="doc-check" data-files="registration-files" /> Registration Certificate / Registration Material</span>
                                        <input asp-for="SupportingDocuments.RegistrationFiles" id="registration-files" type="file" multiple />
                                    </label>
                                    <label class="document-category">
                                        <span><input asp-for="SupportingDocuments.HasBudgetDocumentation" class="doc-check" data-files="budget-files" /> Budget / Budget Documentation</span>
                                        <input asp-for="SupportingDocuments.BudgetFiles" id="budget-files" type="file" multiple />
                                    </label>
                                    <label class="document-category">
                                        <span><input asp-for="SupportingDocuments.HasProjectSchedule" class="doc-check" data-files="schedule-files" /> Milestones / Project Schedule</span>
                                        <input asp-for="SupportingDocuments.ScheduleFiles" id="schedule-files" type="file" multiple />
                                    </label>
                                    <label class="document-category">
                                        <span><input asp-for="SupportingDocuments.HasAdditionalDocuments" class="doc-check" data-files="additional-files" /> Follow-up / Additional Supporting Documents</span>
                                        <input asp-for="SupportingDocuments.AdditionalFiles" id="additional-files" type="file" multiple />
                                    </label>
                                </div>
                                <span asp-validation-for="SupportingDocuments" class="validation"></span>
                            </section>

                            <section class="field circumstances-field">
                                <label asp-for="Input.Circumstances">Additional context</label>
                                <textarea asp-for="Input.Circumstances" rows="8" placeholder="Optional context that does not belong in the proposal itself."></textarea>
                            </section>
                        </div>
                    </section>

                    <section id="goods-workspace" class="request-mode-panel" hidden>
                        <div class="workspace-heading">
                            <div>
                                <h2>Requested goods &amp; services</h2>
                                <p>Add each requested item or service as a separate row.</p>
                            </div>
                            <button class="button button-outline button-small" type="button" id="add-item-row">Add row</button>
                        </div>

                        <div class="goods-grid-wrap">
                            <table class="goods-grid" id="goods-grid">
                                <thead>
                                    <tr>
                                        <th class="goods-row-number-head">#</th>
                                        <th>Item / Service</th>
                                        <th>Description / Specification</th>
                                        <th>Quantity</th>
                                        <th>Unit</th>
                                        <th>Notes</th>
                                        <th><span class="sr-only">Actions</span></th>
                                    </tr>
                                </thead>
                                <tbody id="goods-rows">
                                    @if (Model.Items.Count == 0)
                                    {
                                        <tr data-item-row>
                                            <td class="goods-row-number">1</td>
                                            <td><input name="Items[0].ItemName" aria-label="Item or service" /></td>
                                            <td><input name="Items[0].Description" aria-label="Description or specification" /></td>
                                            <td><input name="Items[0].Quantity" type="number" min="0.001" step="0.001" value="1" aria-label="Quantity" /></td>
                                            <td>
                                                <select name="Items[0].UnitOfMeasureId" aria-label="Unit">
                                                    <option value="">Select</option>
                                                    @foreach (UnitOfMeasureOption unit in Model.UnitsOfMeasure)
                                                    {
                                                        <option value="@unit.Id">@unit.Name (@unit.Code)</option>
                                                    }
                                                </select>
                                            </td>
                                            <td><input name="Items[0].Notes" aria-label="Notes" /></td>
                                            <td><button class="icon-button remove-item" type="button" aria-label="Remove row">×</button></td>
                                        </tr>
                                    }
                                    else
                                    {
                                        @for (int index = 0; index < Model.Items.Count; index++)
                                        {
                                            <tr data-item-row>
                                                <td class="goods-row-number">@(index + 1)</td>
                                                <td><input asp-for="Items[index].ItemName" aria-label="Item or service" /></td>
                                                <td><input asp-for="Items[index].Description" aria-label="Description or specification" /></td>
                                                <td><input asp-for="Items[index].Quantity" type="number" min="0.001" step="0.001" aria-label="Quantity" /></td>
                                                <td>
                                                    <select asp-for="Items[index].UnitOfMeasureId" aria-label="Unit">
                                                        <option value="">Select</option>
                                                        @foreach (UnitOfMeasureOption unit in Model.UnitsOfMeasure)
                                                        {
                                                            <option value="@unit.Id">@unit.Name (@unit.Code)</option>
                                                        }
                                                    </select>
                                                </td>
                                                <td><input asp-for="Items[index].Notes" aria-label="Notes" /></td>
                                                <td><button class="icon-button remove-item" type="button" aria-label="Remove row">×</button></td>
                                            </tr>
                                        }
                                    }
                                </tbody>
                            </table>
                        </div>
                        <span asp-validation-for="Items" class="validation"></span>

                        <div class="field goods-context">
                            <label asp-for="Input.Circumstances">Relevant supporting information</label>
                            <textarea asp-for="Input.Circumstances" rows="4" placeholder="Optional delivery, use, beneficiary or service context."></textarea>
                        </div>
                    </section>
                </main>

                <section id="review-panel" class="request-review" hidden aria-live="polite">
                    <div class="workspace-heading">
                        <div>
                            <h2>Review request</h2>
                            <p>Confirm the requester, request type, content and attachments before submitting.</p>
                        </div>
                        <button class="button button-outline button-small" type="button" id="close-review">Back to editing</button>
                    </div>
                    <dl class="review-list">
                        <div><dt>Requesting as</dt><dd id="review-requester"></dd></div>
                        <div><dt>Submitted by</dt><dd>@Model.SubmittedByName</dd></div>
                        <div><dt>Request type</dt><dd id="review-type"></dd></div>
                        <div><dt>Summary</dt><dd id="review-summary"></dd></div>
                        <div><dt>Request content</dt><dd id="review-content"></dd></div>
                        <div><dt>Attachments</dt><dd id="review-files"></dd></div>
                    </dl>
                    <div class="request-submit-actions review-submit">
                        <button class="button" type="submit">Submit Request</button>
                    </div>
                </section>

                <footer class="request-sticky-submit">
                    <span id="sticky-profile-state" class="request-profile-state"></span>
                    <div class="request-submit-actions">
                        <button class="button button-outline" type="button" id="review-request-bottom">Review</button>
                        <button class="button" type="submit">Submit Request</button>
                    </div>
                </footer>
            }
        </form>
    </div>
</section>

<template id="goods-row-template">
    <tr data-item-row>
        <td class="goods-row-number"></td>
        <td><input data-field="ItemName" aria-label="Item or service" /></td>
        <td><input data-field="Description" aria-label="Description or specification" /></td>
        <td><input data-field="Quantity" type="number" min="0.001" step="0.001" value="1" aria-label="Quantity" /></td>
        <td>
            <select data-field="UnitOfMeasureId" aria-label="Unit">
                <option value="">Select</option>
                @foreach (UnitOfMeasureOption unit in Model.UnitsOfMeasure)
                {
                    <option value="@unit.Id">@unit.Name (@unit.Code)</option>
                }
            </select>
        </td>
        <td><input data-field="Notes" aria-label="Notes" /></td>
        <td><button class="icon-button remove-item" type="button" aria-label="Remove row">×</button></td>
    </tr>
</template>

<script>
(() => {
    const form = document.getElementById('new-request-form');
    if (!form) return;

    const requester = document.getElementById('requester-select');
    const profileStatus = document.getElementById('profile-status');
    const profileWarning = document.getElementById('profile-warning');
    const profileWarningText = document.getElementById('profile-warning-text');
    const editProfile = document.getElementById('edit-profile-link');
    const completeProfile = document.getElementById('complete-profile-link');
    const stickyProfileState = document.getElementById('sticky-profile-state');
    const projectPanel = document.getElementById('project-workspace');
    const goodsPanel = document.getElementById('goods-workspace');
    const projectEditor = document.getElementById('project-editor');
    const projectHtml = document.getElementById('project-html');
    const reviewPanel = document.getElementById('review-panel');
    const rows = document.getElementById('goods-rows');
    const rowTemplate = document.getElementById('goods-row-template');

    function updateProfile() {
        if (!requester || !requester.selectedOptions.length) return;
        const option = requester.selectedOptions[0];
        const complete = option.dataset.complete === 'true';
        const individual = option.dataset.individual === 'true';
        const id = option.value;
        const profileUrl = individual
            ? '/Account/Profile?returnUrl=' + encodeURIComponent('/Requests/Create')
            : '/Organizations/Profile/' + encodeURIComponent(id) + '?returnUrl=' + encodeURIComponent('/Requests/Create');
        if (profileStatus) {
            profileStatus.textContent = complete ? 'Complete' : 'Incomplete';
            profileStatus.className = 'status ' + (complete ? 'status-Approved' : 'status-rejected');
        }
        profileWarning.hidden = complete;
        profileWarningText.textContent = complete
            ? ''
            : ' Missing: ' + (option.dataset.missing || (individual ? 'required personal information' : 'required organization information')) + '.';
        editProfile.href = profileUrl;
        completeProfile.href = profileUrl;
        stickyProfileState.textContent = complete ? 'Profile complete' : 'Profile incomplete — complete it before submission';
        stickyProfileState.classList.toggle('is-incomplete', !complete);
        stickyProfileState.classList.toggle('is-complete', complete);
    }

    function updateMode() {
        const selected = form.querySelector('input[name="Input.Kind"]:checked');
        const project = !selected || selected.value === 'Project';
        projectPanel.hidden = !project;
        goodsPanel.hidden = project;
        projectPanel.querySelectorAll('input,select,textarea,button').forEach(control => {
            if (control.type !== 'button') control.disabled = !project;
        });
        goodsPanel.querySelectorAll('input,select,textarea,button').forEach(control => {
            if (control.type !== 'button') control.disabled = project;
        });
        if (projectEditor && project) projectHtml.value = projectEditor.innerHTML;
    }

    function syncEditor() {
        if (projectEditor && projectHtml) projectHtml.value = projectEditor.innerHTML;
    }

    form.querySelectorAll('[data-command]').forEach(button => {
        button.addEventListener('click', () => {
            projectEditor.focus();
            document.execCommand(button.dataset.command, false);
            syncEditor();
        });
    });

    form.querySelectorAll('[data-block]').forEach(button => {
        button.addEventListener('click', () => {
            projectEditor.focus();
            document.execCommand('formatBlock', false, button.dataset.block);
            syncEditor();
        });
    });

    document.getElementById('insert-table')?.addEventListener('click', () => {
        projectEditor.focus();
        document.execCommand('insertHTML', false, '<table><tbody><tr><th>Heading</th><th>Heading</th></tr><tr><td>Value</td><td>Value</td></tr></tbody></table><p><br></p>');
        syncEditor();
    });

    projectEditor?.addEventListener('input', syncEditor);

    function renumberRows() {
        rows?.querySelectorAll('[data-item-row]').forEach((row, index) => {
            const rowNumber = row.querySelector('.goods-row-number');
            if (rowNumber) rowNumber.textContent = String(index + 1);

            row.querySelectorAll('input,select,textarea').forEach(control => {
                const field = control.dataset.field || control.name?.replace(/^Items\[\d+\]\./, '');
                if (!field) return;
                control.dataset.field = field;
                control.name = 'Items[' + index + '].' + field;
            });
        });
    }

    document.getElementById('add-item-row')?.addEventListener('click', () => {
        const fragment = rowTemplate.content.cloneNode(true);
        rows.appendChild(fragment);
        renumberRows();
        rows.lastElementChild?.querySelector('input')?.focus();
    });

    rows?.addEventListener('click', event => {
        const button = event.target.closest('.remove-item');
        if (!button) return;
        const allRows = rows.querySelectorAll('[data-item-row]');
        if (allRows.length === 1) {
            allRows[0].querySelectorAll('input').forEach(input => input.value = input.type === 'number' ? '1' : '');
            allRows[0].querySelectorAll('select').forEach(select => select.selectedIndex = 0);
            return;
        }
        button.closest('[data-item-row]')?.remove();
        renumberRows();
    });

    document.getElementById('goods-grid')?.addEventListener('keydown', event => {
        if (event.key !== 'Enter' || event.shiftKey || event.ctrlKey || event.altKey) return;

        const control = event.target.closest('input,select');
        if (!control || control.closest('button')) return;

        const currentRow = control.closest('[data-item-row]');
        const currentCell = control.closest('td');
        if (!currentRow || !currentCell) return;

        event.preventDefault();

        const rowList = Array.from(rows.querySelectorAll('[data-item-row]'));
        const rowIndex = rowList.indexOf(currentRow);
        const cellIndex = Array.from(currentRow.children).indexOf(currentCell);

        if (rowIndex === rowList.length - 1) {
            const fragment = rowTemplate.content.cloneNode(true);
            rows.appendChild(fragment);
            renumberRows();
        }

        const nextRow = rows.querySelectorAll('[data-item-row]')[rowIndex + 1];
        const nextCell = nextRow?.children[cellIndex];
        nextCell?.querySelector('input,select')?.focus();
    });

    document.querySelectorAll('.doc-check').forEach(check => {
        const fileInput = document.getElementById(check.dataset.files);
        const update = () => {
            fileInput.disabled = !check.checked;
            if (!check.checked) fileInput.value = '';
        };
        check.addEventListener('change', update);
        fileInput?.addEventListener('change', () => {
            if (fileInput.files.length > 0) check.checked = true;
            update();
        });
        update();
    });

    function showReview() {
        syncEditor();
        const option = requester?.selectedOptions[0];
        document.getElementById('review-requester').textContent = option?.dataset.name || option?.textContent?.trim() || '';
        const kind = form.querySelector('input[name="Input.Kind"]:checked')?.value || 'Project';
        document.getElementById('review-type').textContent = kind === 'GoodsAndServices' ? 'Goods & Services' : 'Project';
        document.getElementById('review-summary').textContent = document.getElementById('Input_Summary')?.value || '—';

        if (kind === 'GoodsAndServices') {
            const itemCount = rows?.querySelectorAll('[data-item-row]').length || 0;
            document.getElementById('review-content').textContent = itemCount + (itemCount === 1 ? ' requested item/service' : ' requested items/services');
        } else {
            const text = projectEditor?.innerText.trim() || '';
            document.getElementById('review-content').textContent = text ? text.slice(0, 500) + (text.length > 500 ? '…' : '') : 'No project description entered';
        }

        const fileNames = [];
        form.querySelectorAll('input[type="file"]').forEach(input => {
            Array.from(input.files || []).forEach(file => fileNames.push(file.name));
        });
        document.getElementById('review-files').textContent = fileNames.length ? fileNames.join(', ') : 'None';
        reviewPanel.hidden = false;
        reviewPanel.scrollIntoView({ behavior: 'smooth', block: 'start' });
    }

    document.getElementById('review-request')?.addEventListener('click', showReview);
    document.getElementById('review-request-bottom')?.addEventListener('click', showReview);
    document.getElementById('close-review')?.addEventListener('click', () => {
        reviewPanel.hidden = true;
        document.querySelector('.request-workspace')?.scrollIntoView({ behavior: 'smooth', block: 'start' });
    });

    requester?.addEventListener('change', updateProfile);
    form.querySelectorAll('input[name="Input.Kind"]').forEach(input => input.addEventListener('change', updateMode));
    form.addEventListener('submit', () => {
        syncEditor();
        renumberRows();
    });

    const locationButton = document.getElementById('use-location');
    const locationStatus = document.getElementById('location-status');
    const latitude = document.getElementById('Input_Latitude');
    const longitude = document.getElementById('Input_Longitude');
    const parishSelect = document.getElementById('request-parish');
    const townInput = document.getElementById('request-town');
    const townOptions = document.getElementById('request-town-options');

    const jamaicaTowns = {
        'Kingston': ['Kingston', 'Downtown Kingston', 'New Kingston', 'Cross Roads', 'Half Way Tree'],
        'St. Andrew': ['Half Way Tree', 'Constant Spring', 'Papine', 'Liguanea', 'Mona', 'Red Hills', 'Stony Hill', 'Gordon Town', 'Bull Bay'],
        'St. Thomas': ['Morant Bay', 'Yallahs', 'Seaforth', 'Bath', 'Port Morant'],
        'Portland': ['Port Antonio', 'Buff Bay', 'Hope Bay', 'Manchioneal', 'Boston'],
        'St. Mary': ['Port Maria', 'Annotto Bay', 'Highgate', 'Oracabessa', 'Gayle'],
        'St. Ann': ['St. Ann\'s Bay', 'Ocho Rios', 'Brown\'s Town', 'Runaway Bay', 'Claremont', 'Discovery Bay'],
        'Trelawny': ['Falmouth', 'Duncans', 'Wakefield', 'Albert Town', 'Clark\'s Town'],
        'St. James': ['Montego Bay', 'Cambridge', 'Anchovy', 'Maroon Town'],
        'Hanover': ['Lucea', 'Green Island', 'Sandy Bay', 'Hopewell'],
        'Westmoreland': ['Savanna-la-Mar', 'Negril', 'Bluefields', 'Darliston', 'Grange Hill'],
        'St. Elizabeth': ['Black River', 'Santa Cruz', 'Junction', 'Balaclava', 'Malvern'],
        'Manchester': ['Mandeville', 'Christiana', 'Porus', 'Mile Gully', 'May Day'],
        'Clarendon': ['May Pen', 'Chapelton', 'Lionel Town', 'Frankfield', 'Hayes'],
        'St. Catherine': ['Spanish Town', 'Portmore', 'Old Harbour', 'Linstead', 'Ewarton', 'Bog Walk', 'Point Hill']
    };

    function updateTownSuggestions() {
        if (!townOptions) return;
        const selectedParish = parishSelect?.value || '';
        const towns = selectedParish
            ? (jamaicaTowns[selectedParish] || [])
            : Object.values(jamaicaTowns).flat();

        townOptions.replaceChildren(
            ...[...new Set(towns)]
                .sort((left, right) => left.localeCompare(right))
                .map(name => {
                    const option = document.createElement('option');
                    option.value = name;
                    return option;
                })
        );
    }

    parishSelect?.addEventListener('change', updateTownSuggestions);
    updateTownSuggestions();
    locationButton?.addEventListener('click', () => {
        if (!navigator.geolocation) {
            locationStatus.textContent = 'Location services are not available. The typed location will be used.';
            return;
        }
        locationButton.disabled = true;
        locationStatus.textContent = 'Getting location…';
        navigator.geolocation.getCurrentPosition(
            async position => {
                const lat = position.coords.latitude;
                const lon = position.coords.longitude;
                latitude.value = lat.toFixed(6);
                longitude.value = lon.toFixed(6);

                const addressInput = document.getElementById('Input_Address');

                locationStatus.textContent = 'Getting address…';

                try {
                    const response = await fetch(
                        'https://nominatim.openstreetmap.org/reverse?format=jsonv2&addressdetails=1&zoom=18&lat=' +
                        encodeURIComponent(lat) +
                        '&lon=' +
                        encodeURIComponent(lon),
                        {
                            headers: {
                                'Accept': 'application/json'
                            }
                        });

                    if (!response.ok) {
                        throw new Error('Reverse geocoding returned HTTP ' + response.status);
                    }

                    const result = await response.json();
                    const address = result.address || {};

                    const town =
                        address.city ||
                        address.town ||
                        address.village ||
                        address.municipality ||
                        address.suburb ||
                        address.neighbourhood ||
                        '';

                    const parishCandidate =
                        address.county ||
                        address.state_district ||
                        address.state ||
                        '';

                    const parishAliases = {
                        'kingston': 'Kingston',
                        'kingston parish': 'Kingston',
                        'saint andrew': 'St. Andrew',
                        'st andrew': 'St. Andrew',
                        'st. andrew': 'St. Andrew',
                        'saint thomas': 'St. Thomas',
                        'st thomas': 'St. Thomas',
                        'st. thomas': 'St. Thomas',
                        'portland': 'Portland',
                        'saint mary': 'St. Mary',
                        'st mary': 'St. Mary',
                        'st. mary': 'St. Mary',
                        'saint ann': 'St. Ann',
                        'st ann': 'St. Ann',
                        'st. ann': 'St. Ann',
                        'trelawny': 'Trelawny',
                        'saint james': 'St. James',
                        'st james': 'St. James',
                        'st. james': 'St. James',
                        'hanover': 'Hanover',
                        'westmoreland': 'Westmoreland',
                        'saint elizabeth': 'St. Elizabeth',
                        'st elizabeth': 'St. Elizabeth',
                        'st. elizabeth': 'St. Elizabeth',
                        'manchester': 'Manchester',
                        'clarendon': 'Clarendon',
                        'saint catherine': 'St. Catherine',
                        'st catherine': 'St. Catherine',
                        'st. catherine': 'St. Catherine'
                    };

                    const normalizedParish = String(parishCandidate)
                        .toLowerCase()
                        .replace(/\s+parish$/, '')
                        .trim();

                    const parish = parishAliases[normalizedParish] || '';

                    const streetAddress = [
                        address.house_number,
                        address.road
                    ].filter(Boolean).join(' ');

                    const locality = [
                        address.suburb,
                        address.neighbourhood
                    ].filter(Boolean).join(', ');

                    const resolvedAddress =
                        streetAddress ||
                        locality ||
                        addressInput?.value ||
                        '';

                    if (addressInput && resolvedAddress) {
                        addressInput.value = resolvedAddress;
                    }

                    if (townInput && town) {
                        townInput.value = town;
                    }

                    if (parishSelect && parish) {
                        parishSelect.value = parish;
                        updateTownSuggestions();
                    }

                    locationStatus.textContent =
                        resolvedAddress || town || parish
                            ? 'Address populated from device location.'
                            : 'Location captured, but no street address was returned.';
                }
                catch (error) {
                    const parishPoints = [
                        ['Kingston',17.9712,-76.7936],
                        ['St. Andrew',18.0179,-76.8099],
                        ['St. Thomas',17.9700,-76.4330],
                        ['Portland',18.1500,-76.4500],
                        ['St. Mary',18.3167,-76.9000],
                        ['St. Ann',18.3500,-77.2000],
                        ['Trelawny',18.3520,-77.6070],
                        ['St. James',18.4762,-77.8939],
                        ['Hanover',18.4098,-78.1336],
                        ['Westmoreland',18.2350,-78.1336],
                        ['St. Elizabeth',18.0500,-77.7833],
                        ['Manchester',18.0500,-77.5333],
                        ['Clarendon',17.9667,-77.2333],
                        ['St. Catherine',18.0000,-77.0000]
                    ];

                    const nearest = parishPoints
                        .map(item => ({
                            name: item[0],
                            distance:
                                Math.pow(lat - item[1], 2) +
                                Math.pow(lon - item[2], 2)
                        }))
                        .sort((left, right) => left.distance - right.distance)[0];

                    if (parishSelect && nearest) {
                        parishSelect.value = nearest.name;
                        updateTownSuggestions();
                    }

                    locationStatus.textContent =
                        'Device location captured. Parish was estimated; enter or confirm the address and town.';
                }
                finally {
                    locationButton.disabled = false;
                }
            },
            () => {
                locationStatus.textContent = 'Location was unavailable. The typed location will be used.';
                locationButton.disabled = false;
            },
            { enableHighAccuracy: true, timeout: 10000, maximumAge: 300000 });
    });

    updateProfile();
    updateMode();
    syncEditor();
    renumberRows();
})();
</script>
