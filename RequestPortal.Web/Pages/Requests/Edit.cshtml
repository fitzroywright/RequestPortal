@page "{id:guid}"
@model RequestPortal.Web.Pages.Requests.EditModel
@using RequestPortal.Domain.Requests
@{
    ViewData["Title"] = "Edit Request";
    bool kindLocked = Model.Status == RequestStatus.MoreInformationRequired;
}

<section class="edit-request-page">
    <div class="edit-request-shell">
        <header class="edit-request-header">
            <div>
                <a class="edit-back" asp-page="/Requests/Details" asp-route-id="@RouteData.Values["id"]">‹ Back to Request Details</a>
                <h1>Edit Request</h1>
                <p>@Model.PublicReference</p>
            </div>
        </header>

        <form method="post" class="edit-request-card">
            <div asp-validation-summary="ModelOnly" class="validation"></div>

            <div class="edit-grid">
                <label>
                    Request Type
                    <select asp-for="Input.Kind" disabled="@kindLocked">
                        @foreach (RequestKind kind in Enum.GetValues<RequestKind>())
                        {
                            <option value="@kind">@kind</option>
                        }
                    </select>
                    @if (kindLocked)
                    {
                        <input type="hidden" asp-for="Input.Kind" />
                        <small>Request type cannot be changed after submission.</small>
                    }
                    <span asp-validation-for="Input.Kind" class="validation"></span>
                </label>

                <label>
                    Priority
                    <select asp-for="Input.Priority">
                        @foreach (RequestPriority priority in Enum.GetValues<RequestPriority>())
                        {
                            <option value="@priority">@priority</option>
                        }
                    </select>
                    <span asp-validation-for="Input.Priority" class="validation"></span>
                </label>

                <label>
                    Program
                    <select asp-for="Input.ProgramCategory">
                        <option value="">Select program</option>
                        @foreach (var program in Model.Programs)
                        {
                            <option value="@program.Name">@program.Name</option>
                        }
                    </select>
                    <span asp-validation-for="Input.ProgramCategory" class="validation"></span>
                </label>

                <label>
                    Category
                    <select asp-for="Input.Category">
                        <option value="">Select category</option>
                        @foreach (var category in Model.Categories)
                        {
                            <option value="@category.Name">@category.Name</option>
                        }
                    </select>
                    <span asp-validation-for="Input.Category" class="validation"></span>
                </label>

                <label class="span-two">
                    SubCategory
                    <input asp-for="Input.Subcategory" />
                    <span asp-validation-for="Input.Subcategory" class="validation"></span>
                </label>

                <label class="span-two">
                    Summary
                    <textarea asp-for="Input.Summary" rows="4"></textarea>
                    <span asp-validation-for="Input.Summary" class="validation"></span>
                </label>

                <label class="span-two">
                    Location
                    <input asp-for="Input.Location" />
                    <span asp-validation-for="Input.Location" class="validation"></span>
                </label>

                <label class="span-two">
                    Circumstances / Additional Details
                    <textarea asp-for="Input.Circumstances" rows="6"></textarea>
                    <span asp-validation-for="Input.Circumstances" class="validation"></span>
                </label>
            </div>

            @if (Model.Input.Kind == RequestKind.Project)
            {
                <section class="edit-project-section">
                    <div class="edit-project-head">
                        <div>
                            <h2>Project Proposal & Planning</h2>
                            <p>Edit the complete project narrative, structured budget, implementation milestones and outcomes, templates, and revision history.</p>
                        </div>
                        <a class="edit-project-button"
                           asp-page="/Requests/Proposal"
                           asp-route-id="@RouteData.Values["id"]">
                            Edit Full Project
                        </a>
                    </div>
                    <div class="edit-project-note">
                        Supporting project documents remain managed from Request Details so they continue to use the same Common.Storage and retention rules.
                    </div>
                </section>
            }

            @if (Model.Input.Kind == RequestKind.GoodsAndServices)
            {
                <section class="edit-items-section">
                    <div class="edit-items-head">
                        <div>
                            <h2>Requested Items</h2>
                            <p>Edit quantities, descriptions or units, remove items, or add another item.</p>
                        </div>
                        <button id="add-item" class="edit-add-item" type="button">+ Add Item</button>
                    </div>

                    <div asp-validation-for="Items" class="validation"></div>

                    <div id="items-editor">
                        @for (int i = 0; i < Model.Items.Count; i++)
                        {
                            <div class="edit-item-row" data-item-row>
                                <input type="hidden" name="Items[@i].Id" value="@Model.Items[i].Id" />
                                <label>
                                    Item / Service
                                    <input name="Items[@i].ItemName" value="@Model.Items[i].ItemName" maxlength="250" />
                                </label>
                                <label class="item-description">
                                    Description
                                    <input name="Items[@i].Description" value="@Model.Items[i].Description" maxlength="2000" />
                                </label>
                                <label>
                                    Quantity
                                    <input name="Items[@i].Quantity" value="@Model.Items[i].Quantity" type="number" min="0.001" step="0.001" />
                                </label>
                                <label>
                                    Unit
                                    <select name="Items[@i].UnitOfMeasureId">
                                        @foreach (var unit in Model.UnitsOfMeasure)
                                        {
                                            if (unit.Id == Model.Items[i].UnitOfMeasureId)
                                            {
                                                <option value="@unit.Id" selected>@unit.Name (@unit.Code)</option>
                                            }
                                            else
                                            {
                                                <option value="@unit.Id">@unit.Name (@unit.Code)</option>
                                            }
                                        }
                                    </select>
                                </label>
                                <label class="item-notes">
                                    Notes
                                    <input name="Items[@i].Notes" value="@Model.Items[i].Notes" maxlength="2000" />
                                </label>
                                <button class="edit-remove-item" type="button" data-remove-item title="Remove item" aria-label="Remove item">x</button>
                            </div>
                        }
                    </div>
                </section>
            }

            <div class="edit-actions">
                <a class="edit-cancel" asp-page="/Requests/Details" asp-route-id="@RouteData.Values["id"]">Cancel</a>
                <button class="edit-save" type="submit">Save Changes</button>
            </div>
        </form>
    </div>
</section>

<style>
.edit-request-page{background:#f4f7fa;min-height:calc(100vh - 52px);padding:22px 0 40px;color:#172f48}
.edit-request-shell{width:min(980px,calc(100% - 32px));margin:0 auto}
.edit-request-header{margin-bottom:14px}.edit-request-header h1{margin:5px 0 2px;font-size:28px}.edit-request-header p{margin:0;color:#64788c}
.edit-back{color:#0f67c7;text-decoration:none;font-size:13px;font-weight:700}
.edit-request-card{border:1px solid #d4dde6;border-radius:6px;background:#fff;padding:20px;box-shadow:0 1px 2px rgba(18,45,70,.04)}
.edit-grid{display:grid;grid-template-columns:1fr 1fr;gap:14px}
.edit-grid label{display:grid;gap:5px;color:#334c63;font-size:13px;font-weight:700}
.edit-grid input,.edit-grid select,.edit-grid textarea{box-sizing:border-box;width:100%;border:1px solid #b8c7d5;border-radius:4px;padding:9px 10px;font:inherit;background:#fff;color:#172f48}
.edit-grid textarea{resize:vertical}.span-two{grid-column:1/-1}
.edit-grid small{color:#6b7d8e;font-weight:500}
.validation{color:#b42318;font-size:12px}
.edit-project-section,.edit-items-section{margin-top:22px;padding-top:18px;border-top:1px solid #e1e6eb}.edit-project-head{display:flex;align-items:flex-start;justify-content:space-between;gap:16px}.edit-project-head h2{margin:0 0 3px;font-size:18px}.edit-project-head p{margin:0;color:#6b7d8e;font-size:12px;max-width:650px}.edit-project-button{display:inline-flex;align-items:center;justify-content:center;min-height:34px;padding:0 12px;border:1px solid #0c5cb5;border-radius:4px;background:#0f6fd4;color:#fff;font-size:12px;font-weight:700;text-decoration:none;white-space:nowrap}.edit-project-note{margin-top:10px;padding:10px 12px;border:1px solid #dbe4ec;border-radius:4px;background:#f8fafc;color:#5f7183;font-size:12px}.edit-items-section{margin-top:22px;padding-top:18px;border-top:1px solid #e1e6eb}.edit-items-head{display:flex;align-items:flex-start;justify-content:space-between;gap:16px;margin-bottom:12px}.edit-items-head h2{margin:0 0 3px;font-size:18px}.edit-items-head p{margin:0;color:#6b7d8e;font-size:12px}.edit-add-item{min-height:32px;padding:0 11px;border:1px solid #71a9df;border-radius:4px;background:#fff;color:#0d67c5;font-size:12px;font-weight:700;cursor:pointer}.edit-item-row{display:grid;grid-template-columns:1.1fr 1.4fr 110px 160px 1fr 24px;gap:8px;align-items:end;padding:10px 0;border-bottom:1px solid #edf1f4}.edit-item-row label{display:grid;gap:4px;color:#334c63;font-size:12px;font-weight:700}.edit-item-row input,.edit-item-row select{box-sizing:border-box;width:100%;min-height:34px;border:1px solid #b8c7d5;border-radius:4px;padding:7px 8px;font:inherit;background:#fff}.edit-remove-item{align-self:end;width:24px;height:34px;border:0;background:transparent;color:#c62828;font-size:15px;font-weight:900;cursor:pointer}.edit-remove-item:hover{color:#8e0000}.edit-actions{display:flex;justify-content:flex-end;gap:10px;margin-top:18px;padding-top:16px;border-top:1px solid #e1e6eb}
.edit-cancel,.edit-save{display:inline-flex;align-items:center;justify-content:center;min-height:36px;padding:0 14px;border-radius:4px;font-size:13px;font-weight:700;text-decoration:none;cursor:pointer}
.edit-cancel{border:1px solid #b8c7d5;background:#fff;color:#334c63}.edit-save{border:1px solid #0c5cb5;background:#0f6fd4;color:#fff}
@@media(max-width:1000px){.edit-item-row{grid-template-columns:1fr 1fr 100px 150px}.item-notes{grid-column:1/4}.edit-remove-item{grid-column:4}}
@@media(max-width:700px){.edit-grid{grid-template-columns:1fr}.span-two{grid-column:auto}.edit-project-head,.edit-items-head{flex-direction:column}.edit-item-row{grid-template-columns:1fr}.item-description,.item-notes,.edit-remove-item{grid-column:auto}.edit-remove-item{justify-self:end}}
</style>

@if (Model.Input.Kind == RequestKind.GoodsAndServices)
{
<script>
(() => {
    const container = document.getElementById('items-editor');
    const add = document.getElementById('add-item');
    if (!container || !add) return;

    const units = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.UnitsOfMeasure.Select(unit => new { id = unit.Id, text = $"{unit.Name} ({unit.Code})" })));

    function renumber() {
        container.querySelectorAll('[data-item-row]').forEach((row, index) => {
            row.querySelectorAll('[name]').forEach(input => {
                input.name = input.name.replace(/Items\[\d+\]/, `Items[${index}]`);
            });
        });
    }

    container.addEventListener('click', event => {
        const button = event.target.closest('[data-remove-item]');
        if (!button) return;
        const rows = container.querySelectorAll('[data-item-row]');
        if (rows.length <= 1) {
            const row = button.closest('[data-item-row]');
            row.querySelectorAll('input:not([type="hidden"])').forEach(input => input.value = '');
            return;
        }
        button.closest('[data-item-row]').remove();
        renumber();
    });

    add.addEventListener('click', () => {
        const index = container.querySelectorAll('[data-item-row]').length;
        const row = document.createElement('div');
        row.className = 'edit-item-row';
        row.dataset.itemRow = '';
        const options = units.map(unit => `<option value="${unit.id}">${unit.text}</option>`).join('');
        row.innerHTML = `
            <input type="hidden" name="Items[${index}].Id" value="00000000-0000-0000-0000-000000000000" />
            <label>Item / Service<input name="Items[${index}].ItemName" maxlength="250" /></label>
            <label class="item-description">Description<input name="Items[${index}].Description" maxlength="2000" /></label>
            <label>Quantity<input name="Items[${index}].Quantity" value="1" type="number" min="0.001" step="0.001" /></label>
            <label>Unit<select name="Items[${index}].UnitOfMeasureId">${options}</select></label>
            <label class="item-notes">Notes<input name="Items[${index}].Notes" maxlength="2000" /></label>
            <button class="edit-remove-item" type="button" data-remove-item title="Remove item" aria-label="Remove item">x</button>`;
        container.appendChild(row);
    });
})();
</script>
}
