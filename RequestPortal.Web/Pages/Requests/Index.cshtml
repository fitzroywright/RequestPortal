@page
@model RequestPortal.Web.Pages.Requests.IndexModel
@{
    ViewData["Title"] = "Requests";
}

<section class="operational-page">
    <div class="shell">
        <header class="operational-titlebar">
            <div>
                <div class="eyebrow request-eyebrow">Request workspace</div>
                <h1>Assistance requests</h1>
                <p>Personal requests and requests submitted for organizations you are authorized to represent.</p>
            </div>
            <div class="operational-toolbar">
                <a class="button" asp-page="/Requests/Create">New request</a>
                <a class="button button-secondary" asp-page="/Messages/Inbox">Messages</a>
            </div>
        </header>

        <div class="operational-summary-strip">
            <form method="get" class="operational-toolbar">
                <label for="request-code-search">Request code</label>
                <input id="request-code-search" name="query" value="@Model.Query" placeholder="RP-26-18427" maxlength="40" />
                <button class="button button-small" type="submit">Find request</button>
            </form>
            <strong>@Model.Requests.Count</strong>
            <span>request@(Model.Requests.Count == 1 ? "" : "s")</span>
            <span>Use Open to work with the complete request record.</span>
        </div>

        <section class="operational-panel">
            <div class="operational-panel-titlebar">
                <div>
                    <strong>Request queue</strong>
                    <small>Organization, request summary, current status and submission date.</small>
                </div>
                <a asp-page="/Dashboard/Index">Request overview</a>
            </div>

            @if (Model.Requests.Count == 0)
            {
                <div class="workspace-empty">
                    <strong>No requests</strong>
                    <p>You have not created any personal or organization requests yet.</p>
                    <a class="button button-small" asp-page="/Requests/Create">Create request</a>
                </div>
            }
            else
            {
                <div class="operational-table-wrap">
                    <table class="operational-table">
                        <thead>
                            <tr>
                                <th>Reference</th>
                                <th>Organization</th>
                                <th>Summary</th>
                                <th>Status</th>
                                <th>Submitted</th>
                                <th></th>
                            </tr>
                        </thead>
                        <tbody>
                        @foreach (RequestSummary request in Model.Requests)
                        {
                            <tr>
                                <td><strong>@request.PublicReference</strong></td>
                                <td>@request.OrganizationName</td>
                                <td>@request.Summary</td>
                                <td><span class="status status-@request.Status">@request.Status</span></td>
                                <td>@(request.SubmittedUtc?.ToLocalTime().ToString("MMM dd yyyy, h:mm tt") ?? "Not submitted")</td>
                                <td><a asp-page="/Requests/Details" asp-route-id="@request.Id">Open</a></td>
                            </tr>
                        }
                        </tbody>
                    </table>
                </div>
            }
        </section>
    </div>
</section>
