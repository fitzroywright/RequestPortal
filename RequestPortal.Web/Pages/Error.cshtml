@page
@model RequestPortal.Web.Pages.ErrorModel
@{
    ViewData["Title"] = "Something went wrong";
}

<section class="section">
    <div class="shell">
        <section class="card" style="max-width:760px;margin:0 auto">
            <div class="eyebrow" style="color:#b45b09">Request Portal</div>
            <h1>We couldn’t complete that request.</h1>
            <p class="muted">Please return to the Request Portal home page and try again. If the problem continues, contact Food For The Poor for assistance.</p>
            <a class="button" asp-page="/Index">Return to Request Portal</a>
        </section>
    </div>
</section>
