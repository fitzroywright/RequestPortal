@page
@model RequestPortal.Web.Pages.Messages.ArchivedModel
@using RequestPortal.Application.Messages
@{
    ViewData["Title"] = Model.IsStaff ? "Closed Conversations" : "Archived Messages";
}

<section class="operational-page">
    <div class="shell">
        <header class="operational-titlebar">
            <div>
                <div class="eyebrow request-eyebrow">Messages</div>
                <h1>@(Model.IsStaff ? "Closed Conversations" : "Archived Messages")</h1>
                <p>@(Model.IsStaff ? "Closed conversations from the shared FFP Staff mailbox." : "Older conversations that are no longer active.")</p>
            </div>
        </header>

        <div class="outlook-mailbox">
            <aside class="outlook-folder-card">
                <div class="outlook-folder-title">Mailbox</div>
                <nav aria-label="Message folders">
                    <a class="outlook-folder" asp-page="/Messages/Inbox"><span><span class="outlook-folder-icon">▣</span> Inbox</span></a>
                    <a class="outlook-folder outlook-new-message" asp-page="/Messages/New"><span><span class="outlook-folder-icon">✉</span> New Message</span></a>
                    <a class="outlook-folder" asp-page="/Messages/Sent"><span><span class="outlook-folder-icon">↗</span> Sent Items</span></a>
                    @if (Model.IsStaff)
                    {
                        <a class="outlook-folder" asp-page="/Messages/Assigned"><span><span class="outlook-folder-icon">✓</span> Assigned to Me</span></a>
                        <a class="outlook-folder" asp-page="/Messages/Unassigned"><span><span class="outlook-folder-icon">○</span> Unassigned</span></a>
                    }
                    <a class="outlook-folder is-active outlook-archive-link" asp-page="/Messages/Archived"><span><span class="outlook-folder-icon">▤</span> @(Model.IsStaff ? "Closed" : "Archived Messages")</span></a>
                </nav>
            </aside>

            <section class="outlook-message-workspace" aria-label="Archived messages">
                <div class="outlook-workspace-titlebar">
                    <div><strong>Archived Messages</strong><span>@Model.Messages.Count conversations</span></div>
                    <span class="outlook-toolbar-note">Inactive conversations</span>
                </div>
                @if (Model.Messages.Count == 0)
                {
                    <div class="workspace-empty"><strong>No archived messages.</strong><p>Closed conversations will appear here.</p></div>
                }
                else
                {
                    <div class="outlook-message-grid outlook-message-grid-header" aria-hidden="true">
                        <span></span><span>Sender</span><span>Subject / Preview</span><span>Context</span><span>Date</span>
                    </div>
                    @foreach (MailboxMessageView message in Model.Messages)
                    {
                        <a class="outlook-message-grid outlook-message-row outlook-archived-row"
   href="@(message.RequestId.HasValue
       ? Url.Page("/Requests/Details", new { id = message.RequestId.Value }) + "#conversation"
       : Url.Page("/Messages/Thread", new { id = message.ThreadId }))">
                            <span class="outlook-message-state">○</span>
                            <span class="outlook-sender">
                                <strong>@message.SenderName</strong>
                                <small>@message.SenderKind</small>
                            </span>
                            <span class="outlook-subject"><strong>@message.Subject</strong><small>@message.Preview</small></span>
                            <span class="outlook-context">
                                @if (!string.IsNullOrWhiteSpace(message.OrganizationName)) { <small>@message.OrganizationName</small> }
                                @if (!string.IsNullOrWhiteSpace(message.RequestReference)) { <small>@message.RequestReference</small> }
                            </span>
                            <span class="outlook-date">
                                @if (message.HasAttachments) { <span class="outlook-attachment" title="Documents attached to this message" aria-label="Has documents">📎</span> }
                                <time datetime="@message.SentUtc.ToUniversalTime().ToString("O")">@message.SentUtc.ToLocalTime().ToString("MMM d, yyyy h:mm tt")</time>
                            </span>
                        </a>
                    }
                }
            </section>
        </div>
    </div>
</section>
