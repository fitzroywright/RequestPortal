@page
@model RequestPortal.Web.Pages.Messages.InboxModel
@using RequestPortal.Application.Messages
@{
    ViewData["Title"] = Model.IsStaff ? "FFP Staff Messages" : "Messages";
}

<section class="operational-page">
    <div class="shell">
        <header class="operational-titlebar">
            <div>
                <div class="eyebrow request-eyebrow">Messages</div>
                <h1>@(Model.IsStaff ? "FFP Staff Messages" : "Messages")</h1>
                <p>Correspondence, requests and document-linked conversations.</p>
            </div>
            <div class="operational-toolbar">
                <a class="button" asp-page="/Messages/New">New message</a>
            </div>
        </header>

        <div class="outlook-mailbox">
            <aside class="outlook-folder-card">
                <div class="outlook-folder-title">Mailbox</div>
                <nav aria-label="Message folders">
                    <a class="outlook-folder is-active" asp-page="/Messages/Inbox">
                        <span><span class="outlook-folder-icon">▣</span> Inbox</span>
                        @if (Model.UnreadCount > 0) { <strong>@Model.UnreadCount</strong> }
                    </a>
                    <a class="outlook-folder outlook-new-message" asp-page="/Messages/New">
                        <span><span class="outlook-folder-icon">✉</span> New Message</span>
                    </a>
                    <a class="outlook-folder" asp-page="/Messages/Sent">
                        <span><span class="outlook-folder-icon">↗</span> Sent Items</span>
                    </a>
                    <a class="outlook-folder outlook-archive-link" asp-page="/Messages/Archived">
                        <span><span class="outlook-folder-icon">▤</span> Archived Messages</span>
                    </a>
                </nav>
            </aside>

            <section class="outlook-message-workspace" aria-label="Inbox messages">
                <div class="outlook-workspace-titlebar">
                    <div>
                        <strong>Inbox</strong>
                        <span>@Model.Messages.Count messages</span>
                    </div>
                    <span class="outlook-toolbar-note">Newest first</span>
                </div>

                @if (Model.Messages.Count == 0)
                {
                    <div class="workspace-empty">
                        <strong>Your inbox is empty.</strong>
                        <p>New correspondence will appear here.</p>
                    </div>
                }
                else
                {
                    <div class="outlook-message-grid outlook-message-grid-header" aria-hidden="true">
                        <span></span><span>Sender</span><span>Subject / Preview</span><span>Context</span><span>Date</span>
                    </div>
                    @foreach (MailboxMessageView message in Model.Messages)
                    {
                        <a class="outlook-message-grid outlook-message-row @(message.ReadUtc is null ? "outlook-unread" : null)"
                           asp-page="/Messages/Thread" asp-route-id="@message.ThreadId">
                            <span class="outlook-message-state" aria-hidden="true">
                                @(message.ReadUtc is null ? "●" : "○")
                            </span>
                            <span class="outlook-sender">
                                <strong>@message.SenderName</strong>
                                <small>@message.SenderKind</small>
                            </span>
                            <span class="outlook-subject">
                                <strong>@message.Subject</strong>
                                <small>@message.Preview</small>
                            </span>
                            <span class="outlook-context">
                                @if (!string.IsNullOrWhiteSpace(message.OrganizationName)) { <small>@message.OrganizationName</small> }
                                @if (!string.IsNullOrWhiteSpace(message.RequestReference)) { <small>@message.RequestReference</small> }
                            </span>
                            <span class="outlook-date">
                                @if (message.HasAttachments) { <span class="outlook-attachment" title="Documents attached to this message" aria-label="Has documents">📎</span> }
                                <time datetime="@message.SentUtc.ToUniversalTime().ToString("O")">@message.SentUtc.ToLocalTime().ToString("MMM d, yyyy h:mm tt")</time>
                            </span>
                        </a>
                    }
                }
            </section>
        </div>
    </div>
</section>
