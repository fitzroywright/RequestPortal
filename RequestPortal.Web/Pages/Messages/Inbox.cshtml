@page
@model RequestPortal.Web.Pages.Messages.InboxModel
@using RequestPortal.Application.Messages
@{
    ViewData["Title"] = Model.IsStaff ? "FFP Staff Inbox" : "Inbox";
}

<section class="operational-page">
    <div class="shell">
        <header class="operational-titlebar">
            <div>
                <div class="eyebrow request-eyebrow">Correspondence</div>
                <h1>@(Model.IsStaff ? "FFP Staff Inbox" : "Messages")</h1>
                <p>@(Model.IsStaff ? "Shared correspondence from representatives and Request Portal processing." : "Messages from FFP and representatives in your organizations.")</p>
            </div>
            <div class="operational-toolbar">
                <a class="button" asp-page="/Messages/New">New message</a>
                <a class="button button-secondary" asp-page="/Messages/Sent">Sent items</a>
            </div>
        </header>

        <div class="mailbox-shell">
            <nav class="mailbox-folders" aria-label="Mailbox folders">
                <a class="is-active" asp-page="/Messages/Inbox">Inbox <span>@Model.UnreadCount</span></a>
                <a asp-page="/Messages/Sent">Sent</a>
                <a asp-page="/Messages/New">New message</a>
            </nav>

            <section class="mailbox-list" aria-label="Messages">
                @if (Model.Messages.Count == 0)
                {
                    <div class="workspace-empty">
                        <strong>Your inbox is empty</strong>
                        <p>New correspondence will appear here.</p>
                    </div>
                }
                else
                {
                    <div class="mailbox-row mailbox-header" aria-hidden="true">
                        <span>From</span>
                        <span>Subject</span>
                        <span>Context</span>
                        <span>Received</span>
                    </div>
                    @foreach (MailboxMessageView message in Model.Messages)
                    {
                        <article class="mailbox-row @(message.ReadUtc is null ? "message-unread" : null)">
                            <div>
                                <strong>@message.SenderName</strong>
                                @if (message.SenderKind == "FFP Staff")
                                {
                                    <div class="mailbox-meta">FFP Staff</div>
                                }
                            </div>
                            <div class="mailbox-subject">
                                <a asp-page="/Messages/Thread" asp-route-id="@message.ThreadId"><strong>@message.Subject</strong></a>
                                <div class="mailbox-preview">@message.Preview</div>
                            </div>
                            <div class="mailbox-context">
                                @if (!string.IsNullOrWhiteSpace(message.OrganizationName))
                                {
                                    <div>@message.OrganizationName</div>
                                }
                                @if (!string.IsNullOrWhiteSpace(message.RequestReference))
                                {
                                    <div>@message.RequestReference</div>
                                }
                            </div>
                            <time class="mailbox-meta" datetime="@message.SentUtc.ToUniversalTime().ToString("O")">@message.SentUtc.ToLocalTime().ToString("MMM d, h:mm tt")</time>
                        </article>
                    }
                }
            </section>
        </div>
    </div>
</section>
