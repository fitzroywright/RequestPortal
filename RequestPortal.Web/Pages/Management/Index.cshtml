@page
@model RequestPortal.Web.Pages.Management.IndexModel
@using RequestPortal.Application.Management
@using System.Text.Json
@using System.Globalization
@{
    ViewData["Title"] = "Management Dashboard";
    var dashboard = Model.Dashboard;
    int maxStatus = Math.Max(1, dashboard.Statuses.Select(item => item.Count).DefaultIfEmpty().Max());
    var unknown = dashboard.Parishes.FirstOrDefault(item => item.Parish == JamaicaParishes.Unknown);
    var clientData = new {
        parishes = dashboard.Parishes.Select(item => new { name = item.Parish, total = item.Requests, outstanding = item.Outstanding, completed = item.Completed }),
        delivery = dashboard.DeliveryAnalytics.Trend.Select(item => new { label = item.WeekStarting.ToString("MMM d"), delivered = item.Delivered, partial = item.PartiallyDelivered, failed = item.Failed }),
        requests = dashboard.Trend.Select(item => new { label = item.WeekStarting.ToString("MMM d"), received = item.Received, completed = item.Completed })
    };
}
@section Styles {
    <link rel="stylesheet" href="~/lib/leaflet/1.9.4/leaflet.css" />
    <link rel="stylesheet" href="~/css/management-dashboard.css" asp-append-version="true" />
}
<div class="mg-dashboard shell" data-dashboard data-leaflet-url="@Url.Content("~/lib/leaflet/1.9.4/leaflet.js")"
     data-chart-url="@Url.Content("~/lib/chart.js/4.6.1/chart.umd.min.js")"
     data-geography-url="@Url.Content("~/data/jamaica-parishes.528b7394d3b3.geojson")"
     data-requests-url="@Url.Page("/Management/Requests")" data-parish-url="@Url.Page("/Management/Parish")">
    <header class="mg-heading">
        <div><div class="eyebrow">FFP JAMAICA MANAGEMENT</div><h1>Management Dashboard</h1>
            <p>Operational overview of assistance requests, processing, delivery, and geographic reach.</p></div>
        <div class="mg-refresh"><span>Last successful refresh</span><time datetime="@dashboard.GeneratedUtc.ToString("O")">@dashboard.GeneratedUtc.ToLocalTime().ToString("g")</time>
            @if (dashboard.RefreshStatus == "Failed" || dashboard.GeneratedUtc < DateTimeOffset.UtcNow.AddMinutes(-2))
            { <small role="status">Refresh delayed. Showing the last successful snapshot.</small> }
        </div>
    </header>

    <section class="mg-kpis" aria-label="Primary request metrics">
        @foreach (var metric in new[] {
            (Label: "Received today", Key: "today", Icon: "▣", Value: dashboard.Executive.Today, Tone: "blue"),
            (Label: "This week", Key: "week", Icon: "▦", Value: dashboard.Executive.ThisWeek, Tone: "blue"),
            (Label: "This month", Key: "month", Icon: "↗", Value: dashboard.Executive.ThisMonth, Tone: "blue"),
            (Label: "Outstanding", Key: "outstanding", Icon: "◷", Value: dashboard.Executive.Outstanding, Tone: "amber"),
            (Label: "Completed", Key: "completed", Icon: "✓", Value: dashboard.Executive.Completed, Tone: "green") })
        {
            <a class="mg-kpi mg-tone-@metric.Tone" asp-page="/Management/Requests" asp-route-period="@metric.Key">
                <span class="mg-kpi-label">@metric.Label</span><strong>@metric.Value</strong>
            </a>
        }
    </section>

    <div class="mg-geographic-row">
        <section class="mg-section mg-geography" aria-labelledby="service-reach-title">
            <div class="mg-section-heading"><div><h2 id="service-reach-title">Service Reach Across Jamaica</h2><p>Requests received by parish</p></div>
                <button type="button" class="mg-small-button" data-map-reset>Reset to Jamaica</button></div>
            <div class="mg-map-frame">
                <div id="management-parish-map" class="mg-map" aria-label="Interactive Jamaica parish request map" aria-describedby="map-instructions" aria-busy="true"></div>
                <p class="mg-map-loading" data-map-loading role="status">Loading Jamaica map…</p>
            </div>
            <p class="mg-map-message" data-map-message role="status" hidden></p>
            <button class="mg-small-button" type="button" data-map-retry hidden>Retry map</button>
            <p class="mg-sr-only" id="map-instructions">Hover or focus a parish for request totals. Select a parish on the map to open its request list. You can also use the parish filter below.</p>
            <form method="get" asp-page="/Management/Requests" class="mg-parish-filter">
                <label for="management-parish">Parish</label>
                <select id="management-parish" name="parish">
                    <option value="">All parishes</option>
                    @foreach (var name in JamaicaParishes.Names)
                    {
                        var count = dashboard.Parishes.FirstOrDefault(item => item.Parish == name)?.Requests ?? 0;
                        <option value="@name">@name (@count)</option>
                    }
                    <option value="@JamaicaParishes.Unknown">@JamaicaParishes.Unknown (@(unknown?.Requests ?? 0))</option>
                </select>
                <button class="mg-small-button mg-primary" type="submit">View requests</button>
                <button class="mg-small-button" type="button" data-map-clear>Clear selection</button>
            </form>
            <div class="mg-geography-footer"><span data-parish-selection aria-live="polite">All parishes · @dashboard.Parishes.Sum(item => item.Requests) requests</span>
                <a data-parish-details hidden>Communities and requests</a>
                <a asp-page="/Management/Requests" asp-route-parish="@JamaicaParishes.Unknown">Unknown / not provided: @(unknown?.Requests ?? 0)</a></div>
            <noscript><p>Use the parish filter to view requests. JavaScript enables the interactive map.</p></noscript>
        </section>
        <section class="mg-section mg-insights" aria-labelledby="operational-insights-title">
            <h2 id="operational-insights-title">Operational Insights</h2><h3>Needs Attention</h3>
            <div class="mg-attention">
                <a asp-page="/Management/Requests" asp-route-attention="overdue"><strong>@dashboard.Attention.Overdue</strong><span>Overdue</span></a>
                <a asp-page="/Management/Requests" asp-route-attention="stalled"><strong>@dashboard.Attention.Stalled</strong><span>Stalled</span></a>
                <a asp-page="/Management/Requests" asp-route-attention="missing-docs"><strong>@dashboard.Attention.MissingDocuments</strong><span>Missing Documents</span></a>
            </div>
            <dl class="mg-insight-rows">
                <div><dt>Average Processing Time</dt><dd><strong>@dashboard.Performance.AverageProcessingDays d</strong><span>Average time to a processing outcome</span></dd></div>
                <div><dt>Median Processing Time</dt><dd><strong>@dashboard.Performance.MedianProcessingDays d</strong><span>Middle processing time across recorded outcomes</span></dd></div>
                <div><dt>Average Outstanding Age</dt><dd><strong>@dashboard.Performance.AverageOutstandingAgeDays d</strong><span>Time since submission for outstanding requests</span></dd></div>
                <div><dt>Completion Rate</dt><dd><strong>@dashboard.Performance.CompletionRatePercent%</strong><span>Completed requests as a share of submitted requests</span></dd></div>
            </dl>
        </section>
    </div>

    <div class="mg-two-column">
        <section class="mg-section" aria-labelledby="request-status-title"><h2 id="request-status-title">Request Status</h2>
            @foreach (ManagementStatusMetric status in dashboard.Statuses)
            {
                <a class="mg-count-row" asp-page="/Management/Requests" asp-route-status="@status.Key">
                    <span title="@status.Label">@status.Label</span><span class="mg-bar-track" aria-hidden="true"><span style="width:@((status.Count * 100d / maxStatus).ToString("0.##", CultureInfo.InvariantCulture))%"></span></span><strong>@status.Count</strong>
                </a>
            }
        </section>
        <section class="mg-section" aria-labelledby="delivery-summary-title"><h2 id="delivery-summary-title">Delivery / Proof of Delivery</h2>
            <div class="mg-delivery-metrics">
                @foreach (var metric in new[] {
                    (Label: "Awaiting Acknowledgement", Key: "Ready", Value: dashboard.Delivery.AwaitingAcknowledgement, Icon: "◷", Tone: "amber"),
                    (Label: "Delivered", Key: "Delivered", Value: dashboard.Delivery.Delivered, Icon: "✓", Tone: "green"),
                    (Label: "Partially Delivered", Key: "PartiallyDelivered", Value: dashboard.Delivery.PartiallyDelivered, Icon: "◐", Tone: "blue"),
                    (Label: "Failed / Not Delivered", Key: "Failed", Value: dashboard.Delivery.Failed, Icon: "×", Tone: "red") })
                {
                    <a class="mg-delivery-metric mg-tone-@metric.Tone" asp-page="/Management/Deliveries" asp-route-status="@metric.Key"><strong>@metric.Value</strong><span>@metric.Label</span></a>
                }
            </div>
            @if (dashboard.Delivery.PendingFfpManagerSync > 0)
            { <p class="mg-note">@dashboard.Delivery.PendingFfpManagerSync proof-of-delivery confirmation(s) awaiting synchronization back to FFP Manager.</p> }
        </section>
    </div>

    <div class="mg-three-column mg-delivery-breakdowns">
        @foreach (var dimension in new[] {
            (Title: "Delivery by Organization", Column: "Organization", Key: "organization", Rows: dashboard.DeliveryAnalytics.Organizations),
            (Title: "Delivery by Program", Column: "Program", Key: "program", Rows: dashboard.DeliveryAnalytics.Programs),
            (Title: "Delivery by Parish", Column: "Parish", Key: "parish", Rows: dashboard.DeliveryAnalytics.Parishes) })
        {
            <section class="mg-section"><h2>@dimension.Title</h2>
                @if (dimension.Rows.Count == 0) { <p class="mg-empty">No delivery data yet.</p> }
                else
                {
                    <div class="mg-table-scroll" tabindex="0" role="region" aria-label="@dimension.Title"><table><thead><tr><th>@dimension.Column</th><th>Waiting</th><th>Delivered</th><th>Partial</th><th>Failed</th></tr></thead><tbody>
                    @foreach (var row in dimension.Rows)
                    {
                        <tr><th scope="row"><a asp-page="/Management/Deliveries" asp-all-route-data="@(new Dictionary<string, string> { [dimension.Key] = row.Name })">@row.Name</a></th><td>@row.AwaitingAcknowledgement</td><td>@row.Delivered</td><td>@row.PartiallyDelivered</td><td>@row.Failed</td></tr>
                    }
                    </tbody></table></div>
                }
            </section>
        }
    </div>

    <div class="mg-three-column mg-analysis-row">
        <section class="mg-section"><h2>Delivery Outcome Trend</h2>
            <div class="mg-chart" data-chart-kind="delivery"><canvas id="delivery-outcome-chart" role="img" aria-label="Delivered, partially delivered and failed outcomes by reporting week">Reporting values are available in the data table below.</canvas></div>
            @if (!dashboard.DeliveryAnalytics.Trend.Any(point => point.Delivered + point.PartiallyDelivered + point.Failed > 0)) { <p class="mg-note">No delivery outcomes recorded in these periods.</p> }
            <details class="mg-chart-details"><summary>View reporting data</summary><div class="mg-table-scroll"><table><thead><tr><th>Week starting</th><th>Delivered</th><th>Partial</th><th>Failed</th></tr></thead><tbody>
            @foreach (var point in dashboard.DeliveryAnalytics.Trend) { <tr><th scope="row">@point.WeekStarting.ToString("MMM d, yyyy")</th><td>@point.Delivered</td><td>@point.PartiallyDelivered</td><td>@point.Failed</td></tr> }
            </tbody></table></div></details>
        </section>
        @foreach (var dimension in new[] { (Title: "Requests by Category", Key: "category", Rows: dashboard.Categories), (Title: "Requests by Program", Key: "program", Rows: dashboard.Programs) })
        {
            <section class="mg-section"><h2>@dimension.Title</h2>
                @if (dimension.Rows.Count == 0) { <p class="mg-empty">No classifications recorded yet.</p> }
                else
                {
                    int maximum = Math.Max(1, dimension.Rows.Max(item => item.Count));
                    foreach (var item in dimension.Rows)
                    {
                        <a class="mg-count-row mg-dimension-row" asp-page="/Management/Requests" asp-all-route-data="@(new Dictionary<string, string> { [dimension.Key] = item.Name })"><span title="@item.Name">@item.Name</span><span class="mg-bar-track" aria-hidden="true"><span style="width:@((item.Count * 100d / maximum).ToString("0.##", CultureInfo.InvariantCulture))%"></span></span><strong>@item.Count</strong></a>
                    }
                }
            </section>
        }
    </div>

    <section class="mg-section mg-received-trend"><h2>Received vs. Completed</h2>
        <div class="mg-chart" data-chart-kind="requests"><canvas id="received-completed-chart" role="img" aria-label="Received and completed requests by reporting week">Reporting values are available in the data table below.</canvas></div>
        <details class="mg-chart-details"><summary>View reporting data</summary><div class="mg-table-scroll"><table><thead><tr><th>Week starting</th><th>Received</th><th>Completed</th></tr></thead><tbody>
        @foreach (var point in dashboard.Trend) { <tr><th scope="row">@point.WeekStarting.ToString("MMM d, yyyy")</th><td>@point.Received</td><td>@point.Completed</td></tr> }
        </tbody></table></div></details>
    </section>
    <script type="application/json" id="management-dashboard-data">@Html.Raw(JsonSerializer.Serialize(clientData))</script>
</div>
@section Scripts { <script src="~/js/management-dashboard.js" asp-append-version="true" defer></script> }
