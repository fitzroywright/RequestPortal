@page
@model RequestPortal.Web.Pages.Management.IndexModel
@using RequestPortal.Application.Management
@{
    ViewData["Title"] = "Management Dashboard";
    int maxTrend = Math.Max(1, Model.Dashboard.Trend.SelectMany(point => new[] { point.Received, point.Completed }).DefaultIfEmpty(1).Max());
    int maxParish = Math.Max(1, Model.Dashboard.Parishes.Select(item => item.Requests).DefaultIfEmpty(1).Max());
}

<style>
    .management-shell { max-width: 1440px; margin: 0 auto; padding: 28px 24px 56px; }
    .management-head { display:flex; justify-content:space-between; gap:24px; align-items:end; margin-bottom:24px; }
    .management-head h1 { margin:4px 0 6px; }
    .mg-grid-5 { display:grid; grid-template-columns:repeat(5,minmax(0,1fr)); gap:12px; }
    .mg-grid-3 { display:grid; grid-template-columns:repeat(3,minmax(0,1fr)); gap:16px; }
    .mg-grid-2 { display:grid; grid-template-columns:repeat(2,minmax(0,1fr)); gap:16px; }
    .metric-link { text-decoration:none; color:inherit; border:1px solid #dde3e8; background:#fff; padding:18px; display:block; border-radius:8px; min-height:112px; }
    .metric-link:hover { border-color:#b45b09; transform:translateY(-1px); }
    .metric-value { font-size:2rem; font-weight:750; line-height:1; margin-top:10px; }
    .metric-label { font-size:.78rem; text-transform:uppercase; letter-spacing:.08em; color:#5c6873; }
    .mg-panel { border:1px solid #dde3e8; background:#fff; border-radius:8px; padding:20px; }
    .mg-panel h2 { margin-top:0; }
    .status-row,.bar-row { display:grid; grid-template-columns:minmax(130px,1fr) minmax(140px,2fr) 54px; gap:12px; align-items:center; margin:10px 0; }
    .bar-track { height:9px; background:#edf1f4; border-radius:999px; overflow:hidden; }
    .bar-fill { height:100%; background:#b45b09; }
    .attention { display:grid; grid-template-columns:repeat(3,1fr); gap:10px; }
    .attention a { display:block; padding:14px; border:1px solid #ead7c7; background:#fff8f2; border-radius:7px; color:#1c2833; text-decoration:none; }
    .attention strong { display:block; font-size:1.7rem; }
    .performance { display:grid; grid-template-columns:repeat(4,1fr); gap:12px; }
    .performance > div { padding:14px; border-left:3px solid #b45b09; background:#f8fafb; }
    .performance strong { display:block; font-size:1.45rem; }
    .trend-row { display:grid; grid-template-columns:88px 1fr 1fr; gap:10px; align-items:center; margin:9px 0; }
    .trend-bar { display:flex; align-items:center; gap:8px; }
    .trend-bar span:first-child { display:block; height:10px; border-radius:999px; background:#263c57; min-width:2px; }
    .trend-bar.completed span:first-child { background:#b45b09; }
    .jamaica-map { width:100%; min-height:310px; background:#f7f9fa; border:1px solid #e2e7ea; border-radius:8px; }
    .jamaica-map .island { fill:#e8edf0; stroke:#aab5bd; stroke-width:1; }
    .jamaica-map a circle { fill:#b45b09; stroke:#fff; stroke-width:1.5; transition:.15s ease; }
    .jamaica-map a:hover circle { stroke:#263c57; stroke-width:2.5; }
    .jamaica-map text { font-size:3px; fill:#273542; pointer-events:none; }
    .parish-list { display:grid; grid-template-columns:repeat(2,1fr); gap:8px; margin-top:14px; }
    .parish-list a { text-decoration:none; color:inherit; padding:10px 12px; background:#f8fafb; border-radius:6px; display:flex; justify-content:space-between; }
    @@media (max-width: 1050px) { .mg-grid-5 { grid-template-columns:repeat(2,1fr); } .mg-grid-3,.performance { grid-template-columns:repeat(2,1fr); } }
    @@media (max-width: 720px) { .management-head,.mg-grid-2 { display:block; } .mg-grid-3,.performance,.attention,.parish-list { grid-template-columns:1fr; } .mg-panel { margin-top:14px; } }
</style>

<div class="management-shell">
    <div class="management-head">
        <div>
            <div class="eyebrow" style="color:#b45b09">FFP Jamaica management</div>
            <h1>Management Dashboard</h1>
            <div class="muted">Operational view of assistance demand, processing, attention queues and service reach.</div>
        </div>
        <div class="muted">Updated @Model.Dashboard.GeneratedUtc.ToLocalTime().ToString("g")</div>
    </div>

    <section class="mg-grid-5" aria-label="Executive summary">
        <a class="metric-link" asp-page="/Management/Requests" asp-route-period="today"><span class="metric-label">Received today</span><span class="metric-value">@Model.Dashboard.Executive.Today</span></a>
        <a class="metric-link" asp-page="/Management/Requests" asp-route-period="week"><span class="metric-label">This week</span><span class="metric-value">@Model.Dashboard.Executive.ThisWeek</span></a>
        <a class="metric-link" asp-page="/Management/Requests" asp-route-period="month"><span class="metric-label">This month</span><span class="metric-value">@Model.Dashboard.Executive.ThisMonth</span></a>
        <a class="metric-link" asp-page="/Management/Requests" asp-route-period="outstanding"><span class="metric-label">Outstanding</span><span class="metric-value">@Model.Dashboard.Executive.Outstanding</span></a>
        <a class="metric-link" asp-page="/Management/Requests" asp-route-period="completed"><span class="metric-label">Completed</span><span class="metric-value">@Model.Dashboard.Executive.Completed</span></a>
    </section>

    <div class="mg-grid-2" style="margin-top:16px">
        <section class="mg-panel">
            <h2>Request status</h2>
            @foreach (ManagementStatusMetric status in Model.Dashboard.Statuses)
            {
                int maxStatus = Math.Max(1, Model.Dashboard.Statuses.Max(item => item.Count));
                double pct = status.Count * 100d / maxStatus;
                <div class="status-row">
                    <a asp-page="/Management/Requests" asp-route-status="@status.Key">@status.Label</a>
                    <div class="bar-track"><div class="bar-fill" style="width:@pct.ToString("0.0", System.Globalization.CultureInfo.InvariantCulture)%"></div></div>
                    <strong>@status.Count</strong>
                </div>
            }
        </section>

        <section class="mg-panel">
            <h2>Needs attention</h2>
            <div class="attention">
                <a asp-page="/Management/Requests" asp-route-attention="overdue"><strong>@Model.Dashboard.Attention.Overdue</strong><span>Overdue</span></a>
                <a asp-page="/Management/Requests" asp-route-attention="stalled"><strong>@Model.Dashboard.Attention.Stalled</strong><span>Stalled</span></a>
                <a asp-page="/Management/Requests" asp-route-attention="missing-docs"><strong>@Model.Dashboard.Attention.MissingDocuments</strong><span>Missing docs</span></a>
            </div>
            <h2 style="margin-top:22px">Processing performance</h2>
            <div class="performance">
                <div><strong>@Model.Dashboard.Performance.AverageProcessingDays d</strong><span class="muted">Average processing</span></div>
                <div><strong>@Model.Dashboard.Performance.MedianProcessingDays d</strong><span class="muted">Median processing</span></div>
                <div><strong>@Model.Dashboard.Performance.AverageOutstandingAgeDays d</strong><span class="muted">Average outstanding age</span></div>
                <div><strong>@Model.Dashboard.Performance.CompletionRatePercent%</strong><span class="muted">Completion rate</span></div>
            </div>
        </section>
    </div>

    <section class="mg-panel" style="margin-top:16px">
        <h2>Delivery / Proof of Delivery</h2>
        <div class="performance">
            <div><strong>@Model.Dashboard.Delivery.AwaitingAcknowledgement</strong><span class="muted">Awaiting acknowledgement</span></div>
            <div><strong>@Model.Dashboard.Delivery.Delivered</strong><span class="muted">Delivered</span></div>
            <div><strong>@Model.Dashboard.Delivery.PartiallyDelivered</strong><span class="muted">Partially delivered</span></div>
            <div><strong>@Model.Dashboard.Delivery.Failed</strong><span class="muted">Failed / not delivered</span></div>
        </div>
        @if (Model.Dashboard.Delivery.PendingFfpManagerSync > 0)
        {
            <p class="muted" style="margin-bottom:0;margin-top:12px">@Model.Dashboard.Delivery.PendingFfpManagerSync proof-of-delivery confirmation(s) are awaiting synchronization back to FFP Manager.</p>
        }
    </section>

    <div class="mg-grid-3" style="margin-top:16px">
        <section class="mg-panel">
            <h2>Requests by category</h2>
            @if (Model.Dashboard.Categories.Count == 0) { <p class="muted">No categorized requests yet.</p> }
            @foreach (ManagementNamedCount item in Model.Dashboard.Categories)
            {
                <div class="bar-row"><a asp-page="/Management/Requests" asp-route-category="@item.Name">@item.Name</a><div class="bar-track"><div class="bar-fill" style="width:@(item.Count * 100d / Math.Max(1, Model.Dashboard.Categories.Max(x => x.Count))).ToString("0.0", System.Globalization.CultureInfo.InvariantCulture)%"></div></div><strong>@item.Count</strong></div>
            }
        </section>
        <section class="mg-panel">
            <h2>Requests by program</h2>
            @if (Model.Dashboard.Programs.Count == 0) { <p class="muted">No program classifications yet.</p> }
            @foreach (ManagementNamedCount item in Model.Dashboard.Programs)
            {
                <div class="bar-row"><a asp-page="/Management/Requests" asp-route-program="@item.Name">@item.Name</a><div class="bar-track"><div class="bar-fill" style="width:@(item.Count * 100d / Math.Max(1, Model.Dashboard.Programs.Max(x => x.Count))).ToString("0.0", System.Globalization.CultureInfo.InvariantCulture)%"></div></div><strong>@item.Count</strong></div>
            }
        </section>
        <section class="mg-panel">
            <h2>Received vs. completed</h2>
            @foreach (ManagementTrendPoint point in Model.Dashboard.Trend)
            {
                <div class="trend-row">
                    <span class="muted">@point.WeekStarting.ToString("MMM d")</span>
                    <div class="trend-bar" title="Received"><span style="width:@(point.Received * 100d / maxTrend).ToString("0.0", System.Globalization.CultureInfo.InvariantCulture)%"></span><span>@point.Received</span></div>
                    <div class="trend-bar completed" title="Completed"><span style="width:@(point.Completed * 100d / maxTrend).ToString("0.0", System.Globalization.CultureInfo.InvariantCulture)%"></span><span>@point.Completed</span></div>
                </div>
            }
            <p class="muted" style="margin-bottom:0">Navy = received &nbsp; Orange = completed</p>
        </section>
    </div>

    <section class="mg-panel" style="margin-top:16px">
        <div class="action-row" style="justify-content:space-between;align-items:center">
            <div><h2 style="margin-bottom:4px">Service Reach Across Jamaica</h2><div class="muted">Parish heat overlay. Select a parish to drill into communities and requests.</div></div>
            <a class="button button-secondary" asp-page="/Management/Requests">All requests</a>
        </div>
        <div class="mg-grid-2" style="margin-top:14px">
            <svg class="jamaica-map" viewBox="0 0 100 80" role="img" aria-label="Jamaica service reach by parish">
                <path class="island" d="M4,41 C10,32 22,27 35,28 C47,28 58,24 70,27 C80,28 90,34 96,42 C91,48 80,51 69,51 C58,55 47,61 34,60 C23,59 13,54 6,48 Z" />
                @foreach (ParishReachSummary parish in Model.Dashboard.Parishes)
                {
                    double radius = 2.8 + (5.7 * parish.Requests / maxParish);
                    double opacity = 0.35 + (0.6 * parish.Requests / maxParish);
                    <a asp-page="/Management/Parish" asp-route-parish="@parish.Parish">
                        <circle cx="@parish.MapX.ToString("0.0", System.Globalization.CultureInfo.InvariantCulture)" cy="@parish.MapY.ToString("0.0", System.Globalization.CultureInfo.InvariantCulture)" r="@radius.ToString("0.0", System.Globalization.CultureInfo.InvariantCulture)" opacity="@opacity.ToString("0.00", System.Globalization.CultureInfo.InvariantCulture)"><title>@parish.Parish: @parish.Requests requests</title></circle>
                        <text x="@parish.MapX.ToString("0.0", System.Globalization.CultureInfo.InvariantCulture)" y="@((parish.MapY + radius + 3).ToString("0.0", System.Globalization.CultureInfo.InvariantCulture))" text-anchor="middle">@parish.Parish</text>
                    </a>
                }
            </svg>
            <div>
                <div class="parish-list">
                    @foreach (ParishReachSummary parish in Model.Dashboard.Parishes)
                    {
                        <a asp-page="/Management/Parish" asp-route-parish="@parish.Parish"><span>@parish.Parish</span><strong>@parish.Requests</strong></a>
                    }
                </div>
                @if (Model.Dashboard.Parishes.Count == 0)
                {
                    <p class="muted">Service reach will populate as new requests record parish or GPS location data.</p>
                }
            </div>
        </div>
    </section>
</div>
