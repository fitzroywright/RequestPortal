@page
@model RequestPortal.Web.Pages.Management.IndexModel
@using RequestPortal.Application.Management
@{
    ViewData["Title"] = "Management Dashboard";
    int maxTrend = Math.Max(1, Model.Dashboard.Trend.SelectMany(point => new[] { point.Received, point.Completed }).DefaultIfEmpty(1).Max());
    int maxParish = Math.Max(1, Model.Dashboard.Parishes.Select(item => item.Requests).DefaultIfEmpty(1).Max());
}

<style>
    :root {
        --mg-blue:#2f6f9f;
        --mg-teal:#2f7d78;
        --mg-green:#4f7d57;
        --mg-purple:#6f6598;
        --mg-gold:#9b7a35;
        --mg-red:#a94e55;
        --mg-slate:#52697d;
        --mg-ink:#24323f;
        --mg-border:#dce3e8;
        --mg-soft:#f6f8fa;
    }
    .management-shell { max-width:1480px; margin:0 auto; padding:14px 20px 24px; }
    .management-head { display:flex; justify-content:space-between; gap:18px; align-items:end; margin-bottom:10px; }
    .management-head h1 { margin:1px 0 2px; font-size:1.72rem; line-height:1.1; }
    .management-head .muted { font-size:.82rem; }
    .management-eyebrow { color:var(--mg-slate); font-weight:700; letter-spacing:.08em; text-transform:uppercase; font-size:.7rem; }

    .mg-grid-5 { display:grid; grid-template-columns:repeat(5,minmax(0,1fr)); gap:8px; }
    .mg-grid-3 { display:grid; grid-template-columns:repeat(3,minmax(0,1fr)); gap:10px; }
    .mg-grid-2 { display:grid; grid-template-columns:repeat(2,minmax(0,1fr)); gap:10px; }
    .mg-section-gap { margin-top:10px; }

    .metric-link { text-decoration:none; color:inherit; border:1px solid var(--mg-border); background:#fff; padding:10px 12px 9px; display:block; border-radius:7px; min-height:72px; border-top:3px solid var(--metric-color,var(--mg-blue)); transition:.12s ease; }
    .metric-link:hover { box-shadow:0 2px 8px rgba(34,50,63,.08); transform:translateY(-1px); }
    .metric-link:nth-child(1){--metric-color:var(--mg-blue)}
    .metric-link:nth-child(2){--metric-color:var(--mg-teal)}
    .metric-link:nth-child(3){--metric-color:var(--mg-purple)}
    .metric-link:nth-child(4){--metric-color:var(--mg-gold)}
    .metric-link:nth-child(5){--metric-color:var(--mg-green)}
    .metric-value { display:block; font-size:1.65rem; font-weight:760; line-height:1; margin-top:5px; color:var(--metric-color,var(--mg-ink)); }
    .metric-label { font-size:.68rem; text-transform:uppercase; letter-spacing:.07em; color:#61707d; }

    .mg-panel { border:1px solid var(--mg-border); background:#fff; border-radius:7px; padding:12px 14px; }
    .mg-panel h2 { margin:0 0 7px; font-size:1rem; color:var(--mg-ink); }
    .mg-panel .muted { font-size:.78rem; }

    .status-row,.bar-row { display:grid; grid-template-columns:minmax(110px,1fr) minmax(110px,2fr) 34px; gap:8px; align-items:center; margin:5px 0; font-size:.82rem; }
    .status-row a,.bar-row a { color:var(--mg-ink); text-decoration:none; white-space:nowrap; overflow:hidden; text-overflow:ellipsis; }
    .bar-track { height:7px; background:#edf1f4; border-radius:999px; overflow:hidden; }
    .bar-fill { height:100%; background:var(--bar-color,var(--mg-blue)); border-radius:999px; }
    .status-row[data-status="new"]{--bar-color:var(--mg-blue)}
    .status-row[data-status="under-review"]{--bar-color:var(--mg-purple)}
    .status-row[data-status="awaiting-info"]{--bar-color:var(--mg-gold)}
    .status-row[data-status="approved"]{--bar-color:var(--mg-teal)}
    .status-row[data-status="declined"]{--bar-color:var(--mg-red)}
    .status-row[data-status="completed"]{--bar-color:var(--mg-green)}
    .category-row { --bar-color:var(--mg-blue); }
    .program-row { --bar-color:var(--mg-teal); }

    .attention { display:grid; grid-template-columns:repeat(3,1fr); gap:7px; }
    .attention a { display:flex; align-items:center; justify-content:space-between; gap:8px; padding:8px 9px; border:1px solid var(--mg-border); border-left:3px solid var(--attention-color); background:#fbfcfd; border-radius:6px; color:var(--mg-ink); text-decoration:none; min-height:46px; }
    .attention a:nth-child(1){--attention-color:var(--mg-red)}
    .attention a:nth-child(2){--attention-color:var(--mg-gold)}
    .attention a:nth-child(3){--attention-color:var(--mg-purple)}
    .attention strong { font-size:1.25rem; color:var(--attention-color); }
    .attention span { font-size:.75rem; }

    .performance-heading { margin-top:10px !important; }
    .performance { display:grid; grid-template-columns:repeat(4,1fr); gap:7px; }
    .performance > div { padding:7px 8px; border-left:3px solid var(--perf-color); background:var(--mg-soft); min-height:52px; }
    .performance > div:nth-child(1){--perf-color:var(--mg-blue)}
    .performance > div:nth-child(2){--perf-color:var(--mg-purple)}
    .performance > div:nth-child(3){--perf-color:var(--mg-gold)}
    .performance > div:nth-child(4){--perf-color:var(--mg-green)}
    .performance strong { display:block; font-size:1.05rem; line-height:1.15; color:var(--perf-color); }
    .performance span { font-size:.68rem; line-height:1.15; display:block; margin-top:2px; }

    .trend-row { display:grid; grid-template-columns:52px 1fr 1fr; gap:7px; align-items:center; margin:4px 0; font-size:.75rem; }
    .trend-bar { display:flex; align-items:center; gap:5px; }
    .trend-bar span:first-child { display:block; height:7px; border-radius:999px; background:var(--mg-blue); min-width:2px; }
    .trend-bar.completed span:first-child { background:var(--mg-green); }
    .trend-legend { margin:6px 0 0; font-size:.7rem !important; }
    .legend-received { color:var(--mg-blue); font-weight:700; }
    .legend-completed { color:var(--mg-green); font-weight:700; }

    .reach-panel { padding-bottom:10px; }
    .reach-head { display:flex; justify-content:space-between; align-items:center; gap:12px; }
    .reach-head h2 { margin-bottom:1px; }
    .reach-content { display:grid; grid-template-columns:minmax(0,1.45fr) minmax(300px,.55fr); gap:10px; margin-top:8px; align-items:start; }
    .jamaica-map-real { position:relative; height:238px; border:1px solid #dfe6ea; border-radius:7px; background:#f5f8f9; overflow:hidden; }
    .jamaica-map-real img { width:100%; height:100%; display:block; object-fit:contain; object-position:center; filter:saturate(.45) contrast(.96) brightness(1.05); }
    .map-point { position:absolute; transform:translate(-50%,-50%); border-radius:50%; background:var(--mg-teal); color:#fff; border:2px solid rgba(255,255,255,.94); box-shadow:0 1px 5px rgba(20,43,54,.3); display:flex; align-items:center; justify-content:center; text-decoration:none; font-size:.68rem; font-weight:800; transition:.12s ease; z-index:2; }
    .map-point:hover { transform:translate(-50%,-50%) scale(1.12); background:var(--mg-blue); color:#fff; z-index:3; }
    .map-point:focus-visible { outline:3px solid #fff; box-shadow:0 0 0 5px var(--mg-blue); }
    .map-credit { margin:4px 2px 0; font-size:.62rem; color:#74818b; }
    .reach-legend { display:flex; gap:10px; align-items:center; margin-top:4px; font-size:.69rem; color:#63717d; }
    .reach-dot { width:10px; height:10px; border-radius:50%; background:var(--mg-teal); display:inline-block; margin-right:4px; vertical-align:-1px; }
    .parish-list { display:grid; grid-template-columns:repeat(2,1fr); gap:5px; }
    .parish-list a { text-decoration:none; color:inherit; padding:6px 8px; background:#f7f9fa; border-radius:5px; display:flex; justify-content:space-between; font-size:.73rem; border-left:2px solid var(--mg-teal); }
    .parish-list strong { color:var(--mg-teal); }

    .compact-button { padding:6px 10px !important; min-height:auto !important; font-size:.78rem; }

    @@media (max-width: 1050px) {
        .mg-grid-5 { grid-template-columns:repeat(5,minmax(100px,1fr)); overflow-x:auto; }
        .performance { grid-template-columns:repeat(2,1fr); }
        .reach-content { grid-template-columns:1fr 1fr; }
    }
    @@media (max-width: 760px) {
        .management-shell { padding:12px; }
        .management-head,.mg-grid-2,.reach-content { display:block; }
        .mg-grid-5 { grid-template-columns:repeat(2,1fr); overflow:visible; }
        .mg-grid-3,.performance,.attention,.parish-list { grid-template-columns:1fr; }
        .mg-panel { margin-top:9px; }
        .jamaica-map-real { height:230px; margin-bottom:9px; }
    }
</style>

<div class="management-shell">
    <div class="management-head">
        <div>
            <div class="management-eyebrow">FFP Jamaica management</div>
            <h1>Management Dashboard</h1>
            <div class="muted">Assistance demand, processing, attention queues and service reach.</div>
        </div>
        <div class="muted">Updated @Model.Dashboard.GeneratedUtc.ToLocalTime().ToString("g")</div>
    </div>

    <section class="mg-grid-5" aria-label="Executive summary">
        <a class="metric-link" asp-page="/Management/Requests" asp-route-period="today"><span class="metric-label">Received today</span><span class="metric-value">@Model.Dashboard.Executive.Today</span></a>
        <a class="metric-link" asp-page="/Management/Requests" asp-route-period="week"><span class="metric-label">This week</span><span class="metric-value">@Model.Dashboard.Executive.ThisWeek</span></a>
        <a class="metric-link" asp-page="/Management/Requests" asp-route-period="month"><span class="metric-label">This month</span><span class="metric-value">@Model.Dashboard.Executive.ThisMonth</span></a>
        <a class="metric-link" asp-page="/Management/Requests" asp-route-period="outstanding"><span class="metric-label">Outstanding</span><span class="metric-value">@Model.Dashboard.Executive.Outstanding</span></a>
        <a class="metric-link" asp-page="/Management/Requests" asp-route-period="completed"><span class="metric-label">Completed</span><span class="metric-value">@Model.Dashboard.Executive.Completed</span></a>
    </section>

    <div class="mg-grid-2 mg-section-gap">
        <section class="mg-panel">
            <h2>Request status</h2>
            @foreach (ManagementStatusMetric status in Model.Dashboard.Statuses)
            {
                int maxStatus = Math.Max(1, Model.Dashboard.Statuses.Max(item => item.Count));
                double pct = status.Count * 100d / maxStatus;
                <div class="status-row" data-status="@status.Key">
                    <a asp-page="/Management/Requests" asp-route-status="@status.Key">@status.Label</a>
                    <div class="bar-track"><div class="bar-fill" style="width:@pct.ToString("0.0", System.Globalization.CultureInfo.InvariantCulture)%"></div></div>
                    <strong>@status.Count</strong>
                </div>
            }
        </section>

        <section class="mg-panel">
            <h2>Needs attention</h2>
            <div class="attention">
                <a asp-page="/Management/Requests" asp-route-attention="overdue"><strong>@Model.Dashboard.Attention.Overdue</strong><span>Overdue</span></a>
                <a asp-page="/Management/Requests" asp-route-attention="stalled"><strong>@Model.Dashboard.Attention.Stalled</strong><span>Stalled</span></a>
                <a asp-page="/Management/Requests" asp-route-attention="missing-docs"><strong>@Model.Dashboard.Attention.MissingDocuments</strong><span>Missing docs</span></a>
            </div>
            <h2 class="performance-heading">Processing performance</h2>
            <div class="performance">
                <div><strong>@Model.Dashboard.Performance.AverageProcessingDays d</strong><span class="muted">Average processing</span></div>
                <div><strong>@Model.Dashboard.Performance.MedianProcessingDays d</strong><span class="muted">Median processing</span></div>
                <div><strong>@Model.Dashboard.Performance.AverageOutstandingAgeDays d</strong><span class="muted">Outstanding age</span></div>
                <div><strong>@Model.Dashboard.Performance.CompletionRatePercent%</strong><span class="muted">Completion rate</span></div>
            </div>
        </section>
    </div>

    <div class="mg-grid-3 mg-section-gap">
        <section class="mg-panel">
            <h2>Requests by category</h2>
            @if (Model.Dashboard.Categories.Count == 0) { <p class="muted">No categorized requests yet.</p> }
            @foreach (ManagementNamedCount item in Model.Dashboard.Categories)
            {
                <div class="bar-row category-row"><a asp-page="/Management/Requests" asp-route-category="@item.Name">@item.Name</a><div class="bar-track"><div class="bar-fill" style="width:@(item.Count * 100d / Math.Max(1, Model.Dashboard.Categories.Max(x => x.Count))).ToString("0.0", System.Globalization.CultureInfo.InvariantCulture)%"></div></div><strong>@item.Count</strong></div>
            }
        </section>
        <section class="mg-panel">
            <h2>Requests by program</h2>
            @if (Model.Dashboard.Programs.Count == 0) { <p class="muted">No program classifications yet.</p> }
            @foreach (ManagementNamedCount item in Model.Dashboard.Programs)
            {
                <div class="bar-row program-row"><a asp-page="/Management/Requests" asp-route-program="@item.Name">@item.Name</a><div class="bar-track"><div class="bar-fill" style="width:@(item.Count * 100d / Math.Max(1, Model.Dashboard.Programs.Max(x => x.Count))).ToString("0.0", System.Globalization.CultureInfo.InvariantCulture)%"></div></div><strong>@item.Count</strong></div>
            }
        </section>
        <section class="mg-panel">
            <h2>Received vs. completed</h2>
            @foreach (ManagementTrendPoint point in Model.Dashboard.Trend)
            {
                <div class="trend-row">
                    <span class="muted">@point.WeekStarting.ToString("MMM d")</span>
                    <div class="trend-bar" title="Received"><span style="width:@(point.Received * 100d / maxTrend).ToString("0.0", System.Globalization.CultureInfo.InvariantCulture)%"></span><span>@point.Received</span></div>
                    <div class="trend-bar completed" title="Completed"><span style="width:@(point.Completed * 100d / maxTrend).ToString("0.0", System.Globalization.CultureInfo.InvariantCulture)%"></span><span>@point.Completed</span></div>
                </div>
            }
            <p class="muted trend-legend"><span class="legend-received">Blue = received</span> &nbsp; <span class="legend-completed">Green = completed</span></p>
        </section>
    </div>

    <section class="mg-panel reach-panel mg-section-gap">
        <div class="reach-head">
            <div><h2>Service Reach Across Jamaica</h2><div class="muted">Real parish map with Request Portal service intensity. Select a marker or parish to drill into communities and requests.</div></div>
            <a class="button button-secondary compact-button" asp-page="/Management/Requests">All requests</a>
        </div>
        <div class="reach-content">
            <div>
                <div class="jamaica-map-real" role="img" aria-label="Map of Jamaica parishes with Request Portal service reach">
                    <img src="~/img/maps/jamaica-parishes.svg" alt="Map of the parishes of Jamaica" />
                    @foreach (ParishReachSummary parish in Model.Dashboard.Parishes)
                    {
                        double diameter = 18d + (18d * parish.Requests / maxParish);
                        double opacity = 0.62d + (0.34d * parish.Requests / maxParish);
                        <a class="map-point"
                           asp-page="/Management/Parish"
                           asp-route-parish="@parish.Parish"
                           aria-label="@parish.Parish: @parish.Requests requests"
                           title="@parish.Parish — @parish.Requests requests, @parish.Communities communities"
                           style="left:@parish.MapX.ToString("0.0", System.Globalization.CultureInfo.InvariantCulture)%;top:@parish.MapY.ToString("0.0", System.Globalization.CultureInfo.InvariantCulture)%;width:@diameter.ToString("0.0", System.Globalization.CultureInfo.InvariantCulture)px;height:@diameter.ToString("0.0", System.Globalization.CultureInfo.InvariantCulture)px;opacity:@opacity.ToString("0.00", System.Globalization.CultureInfo.InvariantCulture)">@parish.Requests</a>
                    }
                </div>
                <div class="reach-legend"><span><span class="reach-dot"></span>Marker size = request volume</span><span>Click for parish drill-down</span></div>
                <div class="map-credit">Parish map: TUBS / MacedonianBoy, Wikimedia Commons, CC BY-SA 3.0. Cached locally for the offline demo.</div>
            </div>
            <div>
                <div class="parish-list">
                    @foreach (ParishReachSummary parish in Model.Dashboard.Parishes)
                    {
                        <a asp-page="/Management/Parish" asp-route-parish="@parish.Parish"><span>@parish.Parish</span><strong>@parish.Requests</strong></a>
                    }
                </div>
                @if (Model.Dashboard.Parishes.Count == 0)
                {
                    <p class="muted">Service reach will populate as requests record parish or GPS location data.</p>
                }
            </div>
        </div>
    </section>
</div>
