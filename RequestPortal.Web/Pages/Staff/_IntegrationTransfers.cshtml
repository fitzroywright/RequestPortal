@model RequestPortal.Web.Pages.Staff.IntegrationsModel
@using RequestPortal.Domain.Integration
@using Monitor = RequestPortal.Web.Pages.Staff.IntegrationsModel
@{
    var result = Model.Transfers;
    var counts = result.Counts;
}
<div class="integration-workspace">
<aside class="integration-side-rail" aria-label="Integration controls">
<section class="integration-filter-section" aria-labelledby="integration-filter-heading">
    <div class="integration-section-intro"><div><h2 id="integration-filter-heading">Filters</h2></div></div>
<form method="get" class="integration-filters" asp-page="/Staff/Integrations">
    <label class="integration-search">Search<span><svg class="integration-icon" aria-hidden="true"><use href="#integration-search"/></svg><input asp-for="Search" maxlength="200" placeholder="Request #, applicant, TRN" /></span></label>
    <label>Source<select asp-for="Source"><option value="">All Sources</option><option value="QuickIntake">Quick Intake</option><option value="RequestPortal">Request Portal</option></select></label>
    <label>Verification<select asp-for="NotVerified"><option value="false">All verification outcomes</option><option value="true">Not Verified in FFP Manager (Quick Intake only)</option></select></label>
    <input type="hidden" asp-for="ErrorCode" /><label>Status<select asp-for="Status"><option value="">All statuses</option>@foreach(var status in new[] { SynchronizationStatus.Failed,SynchronizationStatus.Pending,SynchronizationStatus.Retrying,SynchronizationStatus.Synchronized,SynchronizationStatus.ReconciliationRequired }) { <option value="@status">@Monitor.StatusLabel(status)</option> }</select></label>
    <label>Date From (UTC)<input asp-for="From" type="date" /></label>
    <label>Sort<select asp-for="Sort"><option value="activity">Newest activity</option><option value="received">Newest received</option><option value="oldest">Oldest received</option><option value="applicant">Applicant</option><option value="status">Status</option><option value="attempt">Last attempt</option></select></label>
    <label>Date Through (UTC)<input asp-for="Through" type="date" /></label>
    <button class="button" type="submit">Apply filters</button><a class="integration-clear" asp-page="/Staff/Integrations">Clear</a>
</form>
</section>
<div class="integration-overview-block">
<div class="integration-section-intro">
    <div>
        <h2>Synchronization overview</h2>
        <p>@Model.ScopeLabel</p>
    </div>
    <span class="integration-result-count">@result.TotalCount.ToString("N0") matching requests</span>
</div>
<div class="integration-summary" role="group" aria-label="Filter transfers by status">
@foreach(var item in new[] { ("failed","Failed",counts.Failed), ("pending","Pending",counts.Pending), ("retrying","Retrying",counts.Retrying), ("synchronized","Synchronized",counts.Synchronized), ("reconciliation","Reconciliation Required",counts.ReconciliationRequired) }) {
    <a class="integration-tile @item.Item1 @(string.Equals(Model.Status, item.Item1 == "reconciliation" ? nameof(SynchronizationStatus.ReconciliationRequired) : item.Item1 == "pending" ? nameof(SynchronizationStatus.NotSent) : item.Item1, StringComparison.OrdinalIgnoreCase) ? "is-selected" : "")" asp-page="/Staff/Integrations" asp-route-Source="@Model.Source" asp-route-NotVerified="@Model.NotVerified" asp-route-Search="@Model.Search" asp-route-Status="@(item.Item1 == "reconciliation" ? nameof(SynchronizationStatus.ReconciliationRequired) : item.Item1 == "pending" ? nameof(SynchronizationStatus.NotSent) : item.Item1)" asp-route-From="@(Model.From?.ToString("yyyy-MM-dd"))" asp-route-Through="@(Model.Through?.ToString("yyyy-MM-dd"))" asp-route-Sort="@Model.Sort" asp-route-PageNumber="1" aria-label="Show @item.Item2 transfers: @item.Item3"><svg class="integration-icon" aria-hidden="true"><use href="#integration-@item.Item1"/></svg><span><strong class="integration-tile-label">@item.Item2</strong><b class="integration-tile-count">@item.Item3</b></span><span class="integration-tile-affordance" aria-hidden="true">›</span></a>
}
</div>
</div>
<details class="integration-artifact-recovery integration-batch-disclosure">
    <summary id="artifact-recovery-heading">Batch Update</summary>
    <div class="integration-batch-body">
        <div class="integration-section-intro">
            <div>
                <h2>Accept applications without documents</h2>
                <p>Manual, one-time approval. Each application is independently verified in FFP Manager.</p>
            </div>
            @if (Model.CanOperate)
            {
                <span class="integration-result-count">@Model.ArtifactRecoveryCandidateCount.ToString("N0") eligible</span>
            }
            else
            {
                <span class="integration-result-count">Restricted</span>
            }
        </div>
        @if (!Model.CanOperate)
        {
            <p class="integration-correction-note">Manual recovery requires the Manage Security permission. Contact an authorized administrator.</p>
        }
        else if (Model.ArtifactRecoveryCandidateCount == 0)
        {
            <p class="integration-correction-note">No eligible Failed / Artifacts records currently have incomplete document acknowledgement.</p>
        }
        else
        {
            <p>Each application is verified in FFP Manager (JMDB01 / FFPJM). Supporting documents are <strong>not uploaded or marked as transferred</strong>. Missing or conflicting applications remain failed. Results are audited.</p>
            <form method="post" asp-page-handler="RecoverArtifactsOnce" class="integration-artifact-recovery-form">
                <label>Type <strong>SKIP DOCUMENTS ONCE</strong> to confirm:
                    <input name="ArtifactRecoveryConfirmation" required autocomplete="off" placeholder="SKIP DOCUMENTS ONCE" />
                </label>
                <button type="submit" class="button button-small">Run one-time application-only recovery</button>
            </form>
            <small>This action is manual only and applies to the current eligible batch. It does not enable automatic document skipping.</small>
        }
    </div>
</details>
</aside>
<main class="integration-workspace-main" aria-label="Transfer records workspace">
@if (result.VerifiedCount.HasValue)
{
    var knownCodes = new[] {
        ("VALIDATION_PRIMARY_TELEPHONE", "Primary telephone"),
        ("VALIDATION_SECONDARY_TELEPHONE", "Secondary telephone"),
        ("VALIDATION_DATE_OF_BIRTH", "Date of birth"),
        ("VALIDATION_APPLICANT_EMAIL", "Email"),
        ("VALIDATION_EMPLOYMENT_STATUS", "Employment"),
        ("VALIDATION_PARISH", "Parish")
    };
    var otherValidations = result.NotVerifiedErrorCodes
        .Where(entry => !knownCodes.Any(known => known.Item1 == entry.Key)).Sum(entry => entry.Value);
    <section class="integration-corrections" aria-labelledby="integration-corrections-heading">
        <div class="integration-section-intro">
            <div>
                <h2 id="integration-corrections-heading">Quick Intake correction queue</h2>
                <p>Select a validation category to locate requests requiring manual source-data correction.</p>
            </div>
            <span class="integration-corrections-count">@result.NotVerifiedErrorCodes.Values.Sum().ToString("N0") validation failures</span>
        </div>
        <div class="integration-correction-grid">
            @foreach (var (code, title) in knownCodes)
            {
                var count = result.NotVerifiedErrorCodes.GetValueOrDefault(code);
                <a class="integration-correction-option @(Model.ErrorCode == code ? "is-selected" : "")"
                   asp-page="/Staff/Integrations" asp-route-Source="QuickIntake" asp-route-NotVerified="true"
                   asp-route-ErrorCode="@code" asp-route-From="@(Model.From?.ToString("yyyy-MM-dd"))"
                   asp-route-Through="@(Model.Through?.ToString("yyyy-MM-dd"))">
                    <span>@title</span><strong>@count.ToString("N0")</strong>
                </a>
            }
            @if (otherValidations > 0)
            {
                <div class="integration-correction-option integration-other-validations"><span>Other validation</span><strong>@otherValidations.ToString("N0")</strong></div>
            }
        </div>
        <p class="integration-correction-note">Correct source data in a request's diagnostics, then explicitly retry. Saving alone does not submit to FFP Manager.</p>
        <details class="integration-breakdown">
            <summary>View complete unverified synchronization breakdown</summary>
            <div class="integration-breakdown-grid">
                <span>Verified in FFP Manager <strong>@result.VerifiedCount.Value.ToString("N0")</strong></span>
                @foreach (var category in new[] { "Failed", "Reconciliation Required", "Pending", "Retrying", "Missing Integration Link", "Synchronized — verification incomplete", "Other" })
                {
                    <span>@category <strong>@result.NotVerifiedBreakdown.GetValueOrDefault(category).ToString("N0")</strong></span>
                }
            </div>
        </details>
    </section>
}

@if (!string.IsNullOrEmpty(Model.ErrorCode))
{
    <p>Validation filter: <strong>@Model.ErrorCode</strong> · <a asp-page="/Staff/Integrations" asp-route-Source="QuickIntake" asp-route-NotVerified="true" asp-route-From="@(Model.From?.ToString("yyyy-MM-dd"))" asp-route-Through="@(Model.Through?.ToString("yyyy-MM-dd"))">Clear validation filter</a></p>
}
<div class="integration-grid" role="table" aria-label="Integration diagnostics" aria-colcount="8">
    <div class="integration-columns integration-grid-header" role="row">
        <span role="columnheader" aria-label="Expand diagnostics"></span><span role="columnheader">Request / Applicant</span><span role="columnheader">Source / Target</span><span role="columnheader">Status</span><span role="columnheader">Error / Explanation</span><span role="columnheader">Last Activity (UTC)</span><span role="columnheader">FFP Manager</span><span role="columnheader">Actions</span>
    </div>
    <div class="integration-rows" tabindex="0" aria-label="Scrollable integration records">
        <div role="rowgroup">
        @foreach(var item in result.Items) {
            bool expanded = Model.Selected?.Transfer.RequestId == item.RequestId;
            string panelId = "diagnostics-" + item.RequestId;
            string statusClass = Monitor.StatusClass(item.Status);
            <div class="integration-record @statusClass @(expanded ? "is-expanded" : "")" data-record="@item.RequestId">
                <div class="integration-columns integration-data-row" role="row">
                    <span role="cell" class="integration-expander"><a class="integration-expand" asp-page="/Staff/Integrations" asp-all-route-data="Model.DetailRoutes(item.RequestId)" asp-fragment="@panelId" data-diagnostics-url="@Url.Page("/Staff/Integrations", "Diagnostics", new { requestId = item.RequestId, Model.Source, Model.NotVerified, Model.Search, Model.Status, Model.From, Model.Through, Model.Sort, Model.PageNumber })" aria-expanded="@expanded.ToString().ToLowerInvariant()" aria-controls="@panelId" aria-label="Diagnostics for @item.PublicReference"><svg class="integration-icon" aria-hidden="true"><use href="#integration-chevron"/></svg></a></span>
                    <span role="cell" data-label="Request / Applicant" class="integration-applicant"><a asp-page="/Staff/Review" asp-route-id="@item.RequestId"><strong>@item.PublicReference</strong></a><span>@item.ApplicantName</span></span>
                    <span role="cell" data-label="Source / Target">@item.Source<span>@item.Target</span></span>
                    <span role="cell" data-label="Status"><span class="integration-status @statusClass"><svg class="integration-icon" aria-hidden="true"><use href="#integration-@statusClass"/></svg>@Monitor.StatusLabel(item.Status)</span></span>
                    <span role="cell" data-label="Error / Explanation" class="integration-explanation">@if(item.ErrorCode is not null) { <strong>@Monitor.DiagnosticTitle(item)</strong><span>@Monitor.DiagnosticDescription(item)</span> } else { <span>@(item.Explanation ?? (item.Status == SynchronizationStatus.Synchronized ? (item.VerifiedInFfpManager ? "Verified in FFP Manager." : "Synchronized status recorded; verification incomplete.") : "No error was recorded."))</span> }</span>
                    <span role="cell" data-label="Last Activity (UTC)">@Monitor.LastActivity(item).ToString("MMM dd, yyyy HH:mm:ss'Z'")<span>@Monitor.StatusLabel(item.Status)</span></span>
                    <span role="cell" data-label="FFP Manager">@(item.ApplicationNumber ?? "Not verified")<span>@item.ApplicationId</span>@if(item.DocumentsOmitted) { <span class="integration-documents-omitted">Documents skipped — application only</span> }</span>
                    <span role="cell" data-label="Actions" class="integration-row-actions">
                        @if(Model.CanOperate && Monitor.CanRetry(item)) {
                            <form method="post" asp-page-handler="Retry" asp-all-route-data="Model.Routes(result.Page)"><input type="hidden" name="linkId" value="@item.LinkId"/><input type="hidden" name="RequestId" value="@item.RequestId"/><button class="button button-small" type="submit" title="Verify destination and retry">Retry</button></form>
                        } else if(Model.CanOperate && item.Status == SynchronizationStatus.ReconciliationRequired) {
                            <form method="post" asp-page-handler="Reconcile" asp-all-route-data="Model.Routes(result.Page)"><input type="hidden" name="RequestId" value="@item.RequestId"/><button class="button button-small button-outline" type="submit">Recheck</button></form>
                        }
                        <a class="button button-small button-outline" asp-page="/Staff/Integrations" asp-all-route-data="Model.DetailRoutes(item.RequestId)" asp-fragment="@panelId" data-view-diagnostics>View</a>
                        <details class="integration-more-menu"><summary class="integration-more" aria-label="More actions for @item.PublicReference" title="More actions">⋮</summary><div class="integration-more-options">
                            @if (Model.CanOperate && item.CanUpdateFields) {
                                <a asp-page="/Staff/Integrations" asp-page-handler="FieldPreview" asp-all-route-data="Model.DetailRoutes(item.RequestId)">Update FFP Manager Fields</a>
                            }
                            <a asp-page="/Staff/Review" asp-route-id="@item.RequestId">Open original request</a>
                            <button type="button" data-system-toggle aria-expanded="false" aria-controls="integration-operations">System diagnostics</button>
                        </div></details>
                    </span>
                </div>
                <div role="row" class="integration-diagnostic-row" id="@panelId" hidden="@(!expanded)">
                    <div role="cell" aria-colspan="8" class="integration-diagnostic-content">@if(expanded) { <partial name="_IntegrationDiagnostics" model="Model" /> }</div>
                </div>
            </div>
        }
        @if(result.Items.Count == 0) { <div class="integration-empty"><p role="status">No matching transfers.</p><button type="button" class="button button-small button-outline" data-system-toggle aria-expanded="false" aria-controls="integration-operations">System diagnostics</button></div> }
        </div>
        <section id="integration-operations" class="integration-operations" hidden aria-label="System diagnostics"><partial name="_IntegrationOperations" model="Model" /></section>
    </div>
    @if(result.TotalPages > 1) {
        <nav class="integration-paging" aria-label="Transfer pages"><span>Showing @((result.Page-1)*result.PageSize+1)–@(Math.Min(result.Page*result.PageSize,result.TotalCount)) of @result.TotalCount transfers · Page @result.Page of @result.TotalPages</span>
        @if(result.Page>1) { <a asp-page="/Staff/Integrations" asp-all-route-data="Model.Routes(result.Page-1)">Previous</a> }
        @if(result.Page<result.TotalPages) { <a asp-page="/Staff/Integrations" asp-all-route-data="Model.Routes(result.Page+1)">Next</a> }</nav>
    }
</div>
</main>
</div>
<p class="integration-announcement" role="status" aria-live="polite"></p>
