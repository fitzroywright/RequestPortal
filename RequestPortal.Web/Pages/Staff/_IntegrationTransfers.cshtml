@model RequestPortal.Web.Pages.Staff.IntegrationsModel
@using RequestPortal.Domain.Integration
@using Monitor = RequestPortal.Web.Pages.Staff.IntegrationsModel
@{
    var result = Model.Transfers;
    var counts = result.Counts;
}
<dl class="integration-summary" aria-label="Transfer summary for the search and date range">
@foreach(var item in new[] { ("failed","Failed",counts.Failed), ("pending","Pending",counts.Pending), ("retrying","Retrying",counts.Retrying), ("synchronized","Synchronized",counts.Synchronized), ("reconciliation","Reconciliation Required",counts.ReconciliationRequired) }) {
    <div class="integration-tile @item.Item1"><svg class="integration-icon" aria-hidden="true"><use href="#integration-@item.Item1"/></svg><div><dt>@item.Item2</dt><dd>@item.Item3</dd></div></div>
}
</dl>
<form method="get" class="integration-filters" asp-page="/Staff/Integrations">
    <label class="integration-search">Search<span><svg class="integration-icon" aria-hidden="true"><use href="#integration-search"/></svg><input asp-for="Search" maxlength="200" placeholder="Request #, applicant name, TRN, or FFP Manager #" /></span></label>
    <label>Status<select asp-for="Status"><option value="">All statuses</option>@foreach(var status in new[] { SynchronizationStatus.Failed,SynchronizationStatus.Pending,SynchronizationStatus.Retrying,SynchronizationStatus.Synchronized,SynchronizationStatus.ReconciliationRequired }) { <option value="@status">@Monitor.StatusLabel(status)</option> }</select></label>
    <label>Date From (UTC)<input asp-for="From" type="date" /></label>
    <label>Date Through (UTC)<input asp-for="Through" type="date" /></label>
    <label>Sort<select asp-for="Sort"><option value="activity">Newest activity</option><option value="received">Newest received</option><option value="oldest">Oldest received</option><option value="applicant">Applicant</option><option value="status">Status</option><option value="attempt">Last attempt</option></select></label>
    <button class="button" type="submit">Apply filters</button><a class="integration-clear" asp-page="/Staff/Integrations">Clear</a>
</form>
<div class="integration-grid" role="table" aria-label="Integration diagnostics" aria-colcount="8">
    <div class="integration-columns integration-grid-header" role="row">
        <span role="columnheader" aria-label="Expand diagnostics"></span><span role="columnheader">Request / Applicant</span><span role="columnheader">Source / Target</span><span role="columnheader">Status</span><span role="columnheader">Error / Explanation</span><span role="columnheader">Last Activity (UTC)</span><span role="columnheader">FFP Manager</span><span role="columnheader">Actions</span>
    </div>
    <div class="integration-rows" tabindex="0" aria-label="Scrollable integration records">
        <div role="rowgroup">
        @foreach(var item in result.Items.Concat(Model.Selected is { } selected && !result.Items.Any(row => row.RequestId == selected.Transfer.RequestId) ? new[] { selected.Transfer } : Array.Empty<RequestPortal.Application.Integration.IntegrationTransferRow>())) {
            bool expanded = Model.Selected?.Transfer.RequestId == item.RequestId;
            string panelId = "diagnostics-" + item.RequestId;
            string statusClass = Monitor.StatusClass(item.Status);
            <div class="integration-record @statusClass @(expanded ? "is-expanded" : "")" data-record="@item.RequestId">
                <div class="integration-columns integration-data-row" role="row">
                    <span role="cell" class="integration-expander"><a class="integration-expand" asp-page="/Staff/Integrations" asp-all-route-data="Model.DetailRoutes(item.RequestId)" asp-fragment="@panelId" data-diagnostics-url="@Url.Page("/Staff/Integrations", "Diagnostics", new { requestId = item.RequestId, Model.Search, Model.Status, Model.From, Model.Through, Model.Sort, Model.PageNumber })" aria-expanded="@expanded.ToString().ToLowerInvariant()" aria-controls="@panelId" aria-label="Diagnostics for @item.PublicReference"><svg class="integration-icon" aria-hidden="true"><use href="#integration-chevron"/></svg></a></span>
                    <span role="cell" data-label="Request / Applicant" class="integration-applicant"><a asp-page="/Staff/Review" asp-route-id="@item.RequestId"><strong>@item.PublicReference</strong></a><span>@item.ApplicantName</span></span>
                    <span role="cell" data-label="Source / Target">@item.Source<span>@item.Target</span></span>
                    <span role="cell" data-label="Status"><span class="integration-status @statusClass"><svg class="integration-icon" aria-hidden="true"><use href="#integration-@statusClass"/></svg>@Monitor.StatusLabel(item.Status)</span></span>
                    <span role="cell" data-label="Error / Explanation" class="integration-explanation">@if(item.ErrorCode is not null) { <strong>@Monitor.DiagnosticTitle(item)</strong><span>@Monitor.DiagnosticDescription(item)</span> } else { <span>@(item.Explanation ?? (item.Status == SynchronizationStatus.Synchronized ? "Synchronized successfully. Request and applicant data are up to date in FFP Manager." : "No error was recorded."))</span> }</span>
                    <span role="cell" data-label="Last Activity (UTC)">@Monitor.LastActivity(item).ToString("MMM dd, yyyy HH:mm:ss'Z'")<span>@Monitor.StatusLabel(item.Status)</span></span>
                    <span role="cell" data-label="FFP Manager">@(item.ApplicationNumber ?? "Not verified")<span>@item.ApplicationId</span></span>
                    <span role="cell" data-label="Actions" class="integration-row-actions">
                        @if(Model.CanOperate && Monitor.CanRetry(item)) {
                            <form method="post" asp-page-handler="Retry" asp-all-route-data="Model.Routes(result.Page)"><input type="hidden" name="linkId" value="@item.LinkId"/><input type="hidden" name="RequestId" value="@item.RequestId"/><button class="button button-small" type="submit" title="Verify destination and retry">Retry</button></form>
                        } else if(Model.CanOperate && item.Status == SynchronizationStatus.ReconciliationRequired) {
                            <form method="post" asp-page-handler="Reconcile" asp-all-route-data="Model.Routes(result.Page)"><input type="hidden" name="RequestId" value="@item.RequestId"/><button class="button button-small button-outline" type="submit">Recheck</button></form>
                        }
                        <a class="button button-small button-outline" asp-page="/Staff/Integrations" asp-all-route-data="Model.DetailRoutes(item.RequestId)" asp-fragment="@panelId" data-view-diagnostics>View</a>
                        <details class="integration-more-menu"><summary class="integration-more" aria-label="More actions for @item.PublicReference" title="More actions">⋮</summary><div class="integration-more-options"><a asp-page="/Staff/Review" asp-route-id="@item.RequestId">Open original request</a><button type="button" data-system-toggle aria-expanded="false" aria-controls="integration-operations">System diagnostics</button></div></details>
                    </span>
                </div>
                <div role="row" class="integration-diagnostic-row" id="@panelId" hidden="@(!expanded)">
                    <div role="cell" aria-colspan="8" class="integration-diagnostic-content">@if(expanded) { <partial name="_IntegrationDiagnostics" model="Model" /> }</div>
                </div>
            </div>
        }
        @if(result.Items.Count == 0) { <div class="integration-empty"><p role="status">No matching transfers.</p><button type="button" class="button button-small button-outline" data-system-toggle aria-expanded="false" aria-controls="integration-operations">System diagnostics</button></div> }
        </div>
        <section id="integration-operations" class="integration-operations" hidden aria-label="System diagnostics"><partial name="_IntegrationOperations" model="Model" /></section>
    </div>
    @if(result.TotalPages > 1) {
        <nav class="integration-paging" aria-label="Transfer pages"><span>Showing @((result.Page-1)*result.PageSize+1)–@(Math.Min(result.Page*result.PageSize,result.TotalCount)) of @result.TotalCount transfers · Page @result.Page of @result.TotalPages</span>
        @if(result.Page>1) { <a asp-page="/Staff/Integrations" asp-all-route-data="Model.Routes(result.Page-1)">Previous</a> }
        @if(result.Page<result.TotalPages) { <a asp-page="/Staff/Integrations" asp-all-route-data="Model.Routes(result.Page+1)">Next</a> }</nav>
    }
</div>
<p class="integration-announcement" role="status" aria-live="polite"></p>
