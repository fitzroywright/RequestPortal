@page
@model RequestPortal.Web.Pages.Staff.ReportsModel
@using RequestPortal.Application.Reporting
@using RequestPortal.Domain.Requests
@{
    ViewData["Title"] = "Request Reports";
    ViewData["BodyClass"] = "staff-reports-page";
    string? fromDateRoute = Model.FromDate?.ToString("yyyy-MM-dd");
    string? toDateRoute = Model.ToDate?.ToString("yyyy-MM-dd");
}

@section Styles { <link rel="stylesheet" href="~/css/staff-reports.css" asp-append-version="true" /> }
<section class="section staff-reports">
    <div class="shell">
        <div class="section-heading">
            <div class="eyebrow" style="color:#b45b09">FFP internal</div>
            <h1>Request reports & search</h1>
            <p>Search the complete request portfolio, filter operational data, and export the current result set.</p>
        </div>

        <form method="get" class="reports-filters">
                <div class="reports-filter-group">
                    <div class="field">
                        <label asp-for="Search">Search</label>
                        <input asp-for="Search" placeholder="Reference, organization or request summary" />
                    </div>
                    <div class="field">
                        <label asp-for="Status">Status</label>
                        <select asp-for="Status">
                            <option value="">All statuses</option>
                            @foreach (RequestStatus status in Enum.GetValues<RequestStatus>())
                            {
                                <option value="@status">@status</option>
                            }
                        </select>
                    </div>
                    <div class="field">
                        <label asp-for="CountryCode">Country</label>
                        <input asp-for="CountryCode" maxlength="2" placeholder="JM" />
                    </div>
                </div>

                <div class="reports-filter-group">
                    <div class="field">
                        <label asp-for="Category">Category</label>
                        <input asp-for="Category" placeholder="Education" />
                    </div>
                    <div class="field">
                        <label asp-for="Priority">Priority</label>
                        <select asp-for="Priority">
                            <option value="">All priorities</option>
                            @foreach (RequestPriority priority in Enum.GetValues<RequestPriority>())
                            {
                                <option value="@priority">@priority</option>
                            }
                        </select>
                    </div>

                </div>

                <div class="reports-filter-group">
                    <div class="field">
                        <label asp-for="FromDate">From date</label>
                        <input asp-for="FromDate" type="date" />
                    </div>
                    <div class="field">
                        <label asp-for="ToDate">To date</label>
                        <input asp-for="ToDate" type="date" />
                    </div>
                </div>
                    <div class="action-row reports-filter-actions">
                        <button class="button" type="submit">Apply Filters</button>
                        <a class="button button-outline" asp-page="/Staff/Reports">Clear</a>
                    </div>
        </form>

        <dl class="reports-summary" aria-label="Report summary">
            <div><dt>Total</dt><dd>@Model.Report.Total</dd></div>
            <div><dt>Submitted</dt><dd>@Model.Report.Submitted</dd></div>
            <div><dt>Approved / Fulfilled</dt><dd>@(Model.Report.Approved + Model.Report.Fulfilled)</dd></div>
        </dl>

        <section class="reports-results">
            <div class="reports-results-toolbar">
                <div>
                    <h2>Results</h2>
                    <p class="muted">Page @Model.Report.Page of @Model.Report.TotalPages. @Model.Report.Total matching requests.</p>
                </div>
                <div class="action-row reports-exports">
                    <a class="button button-outline"
                       asp-page-handler="Export"
                       asp-route-Search="@Model.Search"
                       asp-route-Status="@Model.Status"
                       asp-route-CountryCode="@Model.CountryCode"
                       asp-route-Category="@Model.Category"
                       asp-route-Priority="@Model.Priority"
                       asp-route-FromDate="@fromDateRoute"
                       asp-route-ToDate="@toDateRoute">Export CSV</a>
                    <a class="button button-secondary"
                       asp-page-handler="ExportXlsx"
                       asp-route-Search="@Model.Search"
                       asp-route-Status="@Model.Status"
                       asp-route-CountryCode="@Model.CountryCode"
                       asp-route-Category="@Model.Category"
                       asp-route-Priority="@Model.Priority"
                       asp-route-FromDate="@fromDateRoute"
                       asp-route-ToDate="@toDateRoute">Export Excel</a>
                    <a class="button button-secondary"
                       asp-page-handler="Pdf"
                       asp-route-Search="@Model.Search"
                       asp-route-Status="@Model.Status"
                       asp-route-CountryCode="@Model.CountryCode"
                       asp-route-Category="@Model.Category"
                       asp-route-Priority="@Model.Priority"
                       asp-route-FromDate="@fromDateRoute"
                       asp-route-ToDate="@toDateRoute">Download PDF</a>
                    <a class="button button-secondary"
                       asp-page-handler="Print"
                       target="_blank"
                       asp-route-Search="@Model.Search"
                       asp-route-Status="@Model.Status"
                       asp-route-CountryCode="@Model.CountryCode"
                       asp-route-Category="@Model.Category"
                       asp-route-Priority="@Model.Priority"
                       asp-route-FromDate="@fromDateRoute"
                       asp-route-ToDate="@toDateRoute">Print / Save PDF</a>
                </div>
            </div>

            @if (Model.Report.Rows.Count == 0)
            {
                <p class="muted">No requests match the selected filters.</p>
            }
            else
            {
                <div class="table-wrap">
                    <table>
                        <thead>
                            <tr>
                                <th>Reference</th>
                                <th>Organization</th>
                                <th>Country</th>
                                <th>Type</th>
                                <th>Category</th>
                                <th>Priority</th>
                                <th>Status</th>
                                <th>Created</th>
                                <th></th>
                            </tr>
                        </thead>
                        <tbody>
                        @foreach (RequestReportRow row in Model.Report.Rows)
                        {
                            <tr>
                                <td><strong>@row.Reference</strong><br /><span class="muted">@row.Summary</span></td>
                                <td>@row.Organization</td>
                                <td>@row.CountryCode</td>
                                <td>@row.Kind</td>
                                <td>@row.Category</td>
                                <td>@row.Priority</td>
                                <td><span class="status status-@row.Status">@row.Status</span></td>
                                <td>@row.CreatedUtc.ToString("u")</td>
                                <td><a asp-page="/Staff/Review" asp-route-id="@row.Id">Open</a></td>
                            </tr>
                        }
                        </tbody>
                    </table>
                </div>

                @if (Model.Report.TotalPages > 1)
                {
                    <div class="action-row reports-pagination" aria-label="Report pages">
                        @if (Model.Report.Page > 1)
                        {
                            <a class="button button-outline"
                               asp-route-PageNumber="@(Model.Report.Page - 1)"
                               asp-route-Search="@Model.Search"
                               asp-route-Status="@Model.Status"
                               asp-route-CountryCode="@Model.CountryCode"
                               asp-route-Category="@Model.Category"
                               asp-route-Priority="@Model.Priority"
                               asp-route-FromDate="@fromDateRoute"
                               asp-route-ToDate="@toDateRoute">Previous</a>
                        }
                        else
                        {
                            <span></span>
                        }

                        @if (Model.Report.Page < Model.Report.TotalPages)
                        {
                            <a class="button button-outline"
                               asp-route-PageNumber="@(Model.Report.Page + 1)"
                               asp-route-Search="@Model.Search"
                               asp-route-Status="@Model.Status"
                               asp-route-CountryCode="@Model.CountryCode"
                               asp-route-Category="@Model.Category"
                               asp-route-Priority="@Model.Priority"
                               asp-route-FromDate="@fromDateRoute"
                               asp-route-ToDate="@toDateRoute">Next</a>
                        }
                    </div>
                }
            }
        </section>
    </div>
</section>
