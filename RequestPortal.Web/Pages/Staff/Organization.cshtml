@page
@model RequestPortal.Web.Pages.Staff.OrganizationModel
@using RequestPortal.Application.Administration
@using RequestPortal.Application.Documents
@using RequestPortal.Domain.Documents
@{
    ViewData["Title"] = Model.Organization?.Name ?? "Organization";
}

@if (Model.Organization is not null)
{
    StaffOrganizationDetail organization = Model.Organization;

    <section class="section">
        <div class="shell">
            <div class="section-heading">
                <div class="eyebrow" style="color:#b45b09">FFP internal organization view</div>
                <h1>@organization.Name</h1>
                <p>@organization.CountryCode · @organization.Status</p>
            </div>

            <section class="card" style="margin-bottom:1.5rem">
                <h2>Organization status controls</h2>
                @if (organization.Status == "PendingApproval")
                {
                    <form method="post" asp-page-handler="RejectOrganization" class="action-row">
                        <input type="hidden" name="id" value="@organization.Id" />
                        <input type="text" name="reason" required maxlength="1000" placeholder="Reason for rejection" />
                        <button class="button button-small button-secondary" type="submit">Reject registration</button>
                    </form>
                }
                else if (organization.Status == "Approved")
                {
                    <form method="post" asp-page-handler="SuspendOrganization" class="action-row">
                        <input type="hidden" name="id" value="@organization.Id" />
                        <input type="text" name="reason" required maxlength="1000" placeholder="Reason for suspension" />
                        <button class="button button-small button-secondary" type="submit">Suspend organization</button>
                    </form>
                }
                else if (organization.Status == "Suspended")
                {
                    <form method="post" asp-page-handler="ReactivateOrganization" class="action-row">
                        <input type="hidden" name="id" value="@organization.Id" />
                        <input type="text" name="notes" maxlength="1000" placeholder="Reactivation notes (optional)" />
                        <button class="button button-small" type="submit">Reactivate organization</button>
                    </form>
                }
                else
                {
                    <p class="muted">No status transition is available for this organization.</p>
                }
            </section>

            <div class="grid-2">
                <section class="card">
                    <h2>Organization profile</h2>
                    <dl class="detail-list">
                        <dt>Registration number</dt><dd>@(organization.RegistrationNumber ?? "—")</dd>
                        <dt>Organization type</dt><dd>@(organization.OrganizationType ?? "—")</dd>
                        <dt>Primary contact</dt><dd>@(organization.PrimaryContactName ?? "—")</dd>
                        <dt>Email</dt><dd>@(organization.Email ?? "—")</dd>
                        <dt>Phone</dt><dd>@(organization.Phone ?? "—")</dd>
                        <dt>Address</dt><dd>@(organization.Address ?? "—")</dd>
                        <dt>Registration expires</dt><dd>@(organization.RegistrationExpiryDate?.ToString("yyyy-MM-dd") ?? "—")</dd>
                        <dt>Registered UTC</dt><dd>@organization.CreatedUtc.ToString("u")</dd>
                        <dt>Approved UTC</dt><dd>@(organization.ApprovedUtc?.ToString("u") ?? "—")</dd>
                    </dl>
                </section>

                <section class="card">
                    <h2>Representatives</h2>
                    @if (organization.Members.Count == 0)
                    {
                        <p class="muted">No representatives are registered.</p>
                    }
                    else
                    {
                        <div class="table-wrap">
                            <table>
                                <thead><tr><th>Name</th><th>Email</th><th>Status</th><th>Role</th></tr></thead>
                                <tbody>
                                @foreach (StaffOrganizationMember member in organization.Members)
                                {
                                    <tr>
                                        <td>@member.DisplayName</td>
                                        <td>@member.Email</td>
                                        <td>@member.MembershipStatus</td>
                                        <td>@member.Role</td>
                                    </tr>
                                }
                                </tbody>
                            </table>
                        </div>
                    }
                </section>
            </div>

            <section class="card" style="margin-top:1.5rem">
                <div class="action-row" style="justify-content:space-between;align-items:center">
                    <div>
                        <h2>Verification documents</h2>
                        <p class="muted">Registration certificates and other organization evidence can be reviewed here.</p>
                    </div>
                    <span class="status">@Model.Documents.Count document(s)</span>
                </div>

                @if (Model.Documents.Count == 0)
                {
                    <p class="muted">No organization documents have been uploaded.</p>
                }
                else
                {
                    <div class="table-wrap">
                        <table>
                            <thead>
                                <tr>
                                    <th>Document</th>
                                    <th>Type</th>
                                    <th>Verification</th>
                                    <th>Retention</th>
                                    <th>Uploaded UTC</th>
                                    <th>Actions</th>
                                </tr>
                            </thead>
                            <tbody>
                            @foreach (DocumentSummary document in Model.Documents)
                            {
                                <tr id="document-@document.Id.ToString("N")" class="@(Model.SelectedDocumentId == document.Id ? "selected-document" : "")" tabindex="-1">
                                    <td>
                                        <a asp-page-handler="DownloadDocument"
                                           asp-route-id="@organization.Id"
                                           asp-route-documentId="@document.Id">@document.OriginalFileName</a>
                                        @if (!string.IsNullOrWhiteSpace(document.VerificationNotes))
                                        {
                                            <div class="muted">@document.VerificationNotes</div>
                                        }
                                    </td>
                                    <td>@document.DocumentType</td>
                                    <td>@document.VerificationStatus</td>
                                    <td>@document.RetentionClass</td>
                                    <td>@document.UploadedUtc.ToString("u")</td>
                                    <td>
                                        @if (!document.IsArchived)
                                        {
                                            <div class="action-row">
                                                <form method="post" asp-page-handler="VerifyDocument">
                                                    <input type="hidden" name="id" value="@organization.Id" />
                                                    <input type="hidden" name="documentId" value="@document.Id" />
                                                    <input type="text" name="notes" placeholder="Optional verification note" maxlength="1000" />
                                                    <button class="button button-small" type="submit">Verify</button>
                                                </form>
                                                <form method="post" asp-page-handler="RejectDocument">
                                                    <input type="hidden" name="id" value="@organization.Id" />
                                                    <input type="hidden" name="documentId" value="@document.Id" />
                                                    <input type="text" name="reason" placeholder="Rejection reason" maxlength="1000" required />
                                                    <button class="button button-small button-secondary" type="submit">Reject</button>
                                                </form>
                                                <form method="post" asp-page-handler="ArchiveDocument">
                                                    <input type="hidden" name="id" value="@organization.Id" />
                                                    <input type="hidden" name="documentId" value="@document.Id" />
                                                    <button class="button button-small button-secondary" type="submit">Archive</button>
                                                </form>
                                            </div>
                                        }
                                        else
                                        {
                                            <span class="muted">Archived</span>
                                        }
                                    </td>
                                </tr>
                            }
                            </tbody>
                        </table>
                    </div>
                }
            </section>

            <section class="card" style="margin-top:1.5rem">
                <h2>Requests</h2>
                @if (organization.Requests.Count == 0)
                {
                    <p class="muted">No requests have been submitted for this organization.</p>
                }
                else
                {
                    <div class="table-wrap">
                        <table>
                            <thead><tr><th>Reference</th><th>Status</th><th>Summary</th><th>Created UTC</th></tr></thead>
                            <tbody>
                            @foreach (StaffOrganizationRequest request in organization.Requests)
                            {
                                <tr>
                                    <td><a asp-page="/Staff/Review" asp-route-id="@request.RequestId">@request.PublicReference</a></td>
                                    <td>@request.Status</td>
                                    <td>@request.Summary</td>
                                    <td>@request.CreatedUtc.ToString("u")</td>
                                </tr>
                            }
                            </tbody>
                        </table>
                    </div>
                }
            </section>

            <section class="card" style="margin-top:1.5rem">
                <h2>Business audit</h2>
                @if (organization.Audit.Count == 0)
                {
                    <p class="muted">No business-audit entries have been recorded yet.</p>
                }
                else
                {
                    <div class="table-wrap">
                        <table>
                            <thead><tr><th>UTC</th><th>Action</th><th>Entity</th><th>Detail</th></tr></thead>
                            <tbody>
                            @foreach (StaffAuditEntry entry in organization.Audit)
                            {
                                <tr>
                                    <td>@entry.OccurredUtc.ToString("u")</td>
                                    <td>@entry.Action</td>
                                    <td>@entry.EntityType</td>
                                    <td>@entry.Detail</td>
                                </tr>
                            }
                            </tbody>
                        </table>
                    </div>
                }
            </section>
        </div>
    </section>
}
