@page
@model RequestPortal.Web.Pages.Staff.IntegrationsModel
@{
    ViewData["Title"] = "Integrations";
    ViewData["BodyClass"] = "integrations-page";
}
@section Styles { <link rel="stylesheet" href="~/css/integrations.css" asp-append-version="true" /> }
<partial name="_IntegrationIcons" />
<section class="integration-monitor" aria-labelledby="integrations-title">
    <header class="integration-heading">
        <div class="eyebrow">Administration</div>
        <h1 id="integrations-title">Integrations</h1>
        <p>Administrators can inspect failures, reconciliation issues, and synchronization history to diagnose and recover integration requests.</p>
    </header>
    <partial name="_IntegrationTransfers" model="Model" />
    <partial name="_IntegrationFieldPreview" model="Model" />
</section>
@section Scripts { <script src="~/js/integrations.js" asp-append-version="true"></script> }
