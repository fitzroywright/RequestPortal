@page "{id:guid}"
@model RequestPortal.Web.Pages.Staff.ReviewModel
@using RequestPortal.Application.Documents
@using RequestPortal.Application.Requests
@{
    ViewData["Title"] = "Review Request";
}

<section class="section">
    <div class="shell">
        @if (Model.Request is null)
        {
            <section class="card"><h1>Request not found</h1></section>
        }
        else
        {
            <div class="action-row" style="justify-content:space-between;align-items:end;margin-bottom:24px">
                <div class="section-heading" style="margin-bottom:0">
                    <div class="eyebrow" style="color:#b45b09">FFP request review</div>
                    <h1>@Model.Request.PublicReference</h1>
                    <p><strong>@Model.Request.OrganizationName</strong> · @Model.Request.Summary</p>
                </div>
                <div class="action-row">
                    <a class="button button-outline"
                       asp-page="/Messages/New"
                       asp-route-OrganizationId="@Model.Request.OrganizationId"
                       asp-route-RequestId="@Model.Request.Id">Message representative</a>
                    <span class="status status-@Model.Request.Status">@Model.Request.Status</span>
                </div>
            </div>

            @if (Model.QuickIntake is not null)
            {
                @await Html.PartialAsync("_QuickIntakeCard", Model)
            }

            @await Component.InvokeAsync("RequestConversation", new { requestId = Model.Request.Id, returnUrl = Url.Page("/Staff/Review", new { id = Model.Request.Id }) ?? $"/Staff/Review/{Model.Request.Id}", compact = false })

            <div class="dashboard-grid">
                <div>
                    @if (Model.ProjectProposal is not null)
                    {
                        <section class="card proposal-review">
                            <div class="eyebrow" style="color:#b45b09">Project proposal</div>
                            <div class="action-row" style="justify-content:space-between;align-items:start">
                                <div>
                                    <h2>@Model.ProjectProposal.Title</h2>
                                    <div class="muted" style="margin-bottom:20px">Version @Model.ProjectProposal.Version · last updated @Model.ProjectProposal.UpdatedUtc.ToString("u")</div>
                                </div>
                                <div class="action-row">
                                    <a class="button button-outline" asp-page-handler="ProposalDocx" asp-route-id="@Model.Request.Id">Word (.docx)</a>
                                    <a class="button button-outline" asp-page-handler="ProposalPdf" asp-route-id="@Model.Request.Id">PDF</a>
                                </div>
                            </div>
                            <article class="proposal-document">@Html.Raw(Model.ProjectProposal.RichContentHtml)</article>
                        </section>

                        @if (Model.ProjectPlanning is not null)
                        {
                            <section class="card" style="margin-top:1.5rem">
                                <h2>Project budget</h2>
                                <div class="table-wrap">
                                    <table>
                                        <thead><tr><th>Description</th><th>Qty</th><th>Unit cost</th><th>Total</th><th>FFP requested</th><th>Organization</th><th>Other funding</th></tr></thead>
                                        <tbody>
                                        @foreach (ProjectBudgetItemDetail item in Model.ProjectPlanning.Budget)
                                        {
                                            <tr><td>@item.Description</td><td>@item.Quantity</td><td>@item.UnitCost.ToString("N2")</td><td>@item.TotalCost.ToString("N2")</td><td>@item.FfpRequested.ToString("N2")</td><td>@item.OrganizationContribution.ToString("N2")</td><td>@item.OtherFunding.ToString("N2")</td></tr>
                                        }
                                        </tbody>
                                        <tfoot><tr><th colspan="3">Totals</th><th>@Model.ProjectPlanning.TotalCost.ToString("N2")</th><th>@Model.ProjectPlanning.TotalFfpRequested.ToString("N2")</th><th>@Model.ProjectPlanning.TotalOrganizationContribution.ToString("N2")</th><th>@Model.ProjectPlanning.TotalOtherFunding.ToString("N2")</th></tr></tfoot>
                                    </table>
                                </div>
                            </section>

                            <section class="card" style="margin-top:1.5rem">
                                <h2>Implementation milestones</h2>
                                <div class="table-wrap"><table><thead><tr><th>#</th><th>Milestone</th><th>Expected outcome</th><th>Target date</th></tr></thead><tbody>
                                @foreach (ProjectMilestoneDetail milestone in Model.ProjectPlanning.Milestones)
                                {
                                    <tr><td>@milestone.Sequence</td><td>@milestone.Title</td><td>@milestone.ExpectedOutcome</td><td>@milestone.TargetDate.ToString("yyyy-MM-dd")</td></tr>
                                }
                                </tbody></table></div>
                            </section>
                        }
                    }

                    @if (Model.Request.Items.Count > 0)
                    {
                        <section class="card" style="margin-top:1.5rem">
                            <h2>Requested items</h2>
                            <div class="table-wrap"><table><thead><tr><th>Description</th><th>Quantity</th><th>Unit</th></tr></thead><tbody>
                            @foreach (RequestItemDetail item in Model.Request.Items)
                            {
                                <tr><td>@item.Description</td><td>@item.Quantity</td><td>@Model.UnitName(item.UnitOfMeasureId)</td></tr>
                            }
                            </tbody></table></div>
                        </section>
                    }


                    @if (Model.Deliveries.Count > 0)
                    {
                        <section class="card" style="margin-top:1.5rem">
                            <h2>Delivery / Proof of Delivery</h2>
                            <div class="table-wrap"><table>
                                <thead><tr><th>Reference</th><th>Recipient</th><th>Status</th><th>Acknowledged</th><th>Evidence</th><th>Notes</th></tr></thead>
                                <tbody>
                                @foreach (RequestPortal.Application.Delivery.DeliveryView delivery in Model.Deliveries)
                                {
                                    <tr>
                                        <td>@delivery.DocumentReference</td>
                                        <td>@delivery.RecipientName</td>
                                        <td><strong>@delivery.Status</strong></td>
                                        <td>@(delivery.AcknowledgedUtc?.ToLocalTime().ToString("g") ?? "Awaiting acknowledgement")</td>
                                        <td>@(delivery.EvidenceDocumentId.HasValue ? "Attached" : "—")</td>
                                        <td>@(delivery.Notes ?? "—")</td>
                                    </tr>
                                }
                                </tbody>
                            </table></div>
                        </section>
                    }

                    <section class="card" style="margin-top:1.5rem">
                        <h2>Supporting documents</h2>
                        @if (Model.Documents.Count == 0)
                        {
                            <p class="muted">No supporting documents have been uploaded.</p>
                        }
                        else
                        {
                            <div class="table-wrap"><table><thead><tr><th>File</th><th>Type</th><th>Uploaded UTC</th><th></th></tr></thead><tbody>
                            @foreach (DocumentSummary document in Model.Documents)
                            {
                                <tr><td>@document.OriginalFileName</td><td>@document.DocumentType</td><td>@document.UploadedUtc.ToString("u")</td><td><a asp-page-handler="Download" asp-route-id="@Model.Request.Id" asp-route-documentId="@document.Id">Download</a></td></tr>
                            }
                            </tbody></table></div>
                        }
                    </section>
                </div>

                <aside class="card"><h2>Status history</h2><div class="timeline">
                    @foreach (RequestHistoryDetail history in Model.Request.History)
                    {
                        <div class="timeline-item"><strong>@history.Status</strong>@if (!string.IsNullOrWhiteSpace(history.Reason)){<span>@history.Reason</span>}<small>@history.ChangedUtc.ToLocalTime().ToString("f")</small></div>
                    }
                </div></aside>
            </div>
        }
    </div>
</section>

<style>
.proposal-document{background:#fff;border:1px solid #e0e4e7;padding:36px 42px;font-family:Georgia,'Times New Roman',serif;line-height:1.65;overflow-wrap:anywhere}.proposal-document table{width:100%;border-collapse:collapse;margin:16px 0}.proposal-document th,.proposal-document td{border:1px solid #8b949c;padding:8px}.proposal-document img{max-width:100%;height:auto}
</style>
