@page
@model RequestPortal.Web.Pages.Staff.IndexModel
@using RequestPortal.Application.Administration
@using RequestPortal.Application.Portal
@{
    ViewData["Title"] = "Requests";
}

<section class="section portal-workspace staff-workspace">
    <div class="shell">
        <header class="workspace-titlebar">
            <div>
                <div class="eyebrow request-eyebrow">FFP internal</div>
                <h1>Requests</h1>
                <p>Review work requiring attention, open operational queues, and move directly into the next action.</p>
            </div>
            <div class="workspace-toolbar">
                <form method="get" class="operational-toolbar">
                    <input type="hidden" name="PageSize" value="@Model.PageSize" />
                    <input name="Search" value="@Model.Search" maxlength="200" placeholder="Search by applicant name or request reference..." aria-label="Search by applicant name or request reference" />
                    <button class="button button-small" type="submit">Search</button>
                    @if (Model.SearchResults is not null) { <a asp-page="/Staff/Index">Clear Search</a> }
                </form>
                <a class="button button-secondary" asp-page="/Staff/Organizations">Organizations</a>
                <a class="button button-secondary" asp-page="/Staff/Reports">Reports</a>
                <a class="button button-secondary" asp-page="/Staff/Reviewers">Invite Reviewer</a>
            </div>
        </header>

        @if (Model.SearchResults is not null)
        {
            <partial name="_RequestSearchResults" model="Model" />
        }
        else
        {
        <div class="portal-workspace-grid">
            <aside class="workspace-panel status-panel">
                <div class="panel-titlebar">
                    <div>
                        <strong>Work Status</strong>
                        <small>@Model.TotalAttentionItems items require attention</small>
                    </div>
                </div>

                <div class="status-list" role="list">
                    <a class="status-row" asp-page="/Staff/Index">
                        <span>Requests awaiting review</span>
                        <strong>@Model.Queue.TotalCount</strong>
                    </a>
                    <a class="status-row" asp-page="/Staff/Index">
                        <span>More information</span>
                        <strong>@Model.Operations.ActionRequiredRequests.Count</strong>
                    </a>
                    <a class="status-row" asp-page="/Staff/Organizations">
                        <span>Organizations pending</span>
                        <strong>@Model.Operations.PendingOrganizations.Count</strong>
                    </a>
                    <a class="status-row" asp-page="/Staff/Organizations">
                        <span>Documents awaiting verification</span>
                        <strong>@Model.Operations.DocumentsAwaitingVerification.Count</strong>
                    </a>
                    <a class="status-row" asp-page="/Staff/Organizations">
                        <span>Reverification</span>
                        <strong>@Model.Operations.ReverificationOrganizations.Count</strong>
                    </a>
                    <a class="status-row" asp-page="/Staff/Integrations">
                        <span>Dead letters</span>
                        <strong>@Model.Operations.DeadLetters.Count</strong>
                    </a>
                    <a class="status-row" asp-page="/Staff/Integrations">
                        <span>Messaging failures</span>
                        <strong>@Model.Operations.FailedNotificationDeliveries.Count</strong>
                    </a>
                </div>

                <div class="panel-titlebar panel-titlebar-secondary">
                    <strong>Actions</strong>
                </div>
                <nav class="actions-list" aria-label="Requests actions">
                    <a asp-page="/Staff/Organizations">Organizations <span>›</span></a>
                    <a asp-page="/Staff/Fulfilment">Fulfilment <span>›</span></a>
                    <a asp-page="/Staff/Reports">Reports &amp; search <span>›</span></a>
                    <a asp-page="/Staff/Integrations">Integrations <span>›</span></a>
                    @if (User.HasClaim(RequestPortal.Web.Security.StaffOidcOptions.PermissionClaim, RequestPortal.Infrastructure.Security.RequestPortalPermissions.ViewManagementDashboard))
                    {
                        <a asp-page="/Management/Index">Management dashboard <span>›</span></a>
                    }
                </nav>
            </aside>

            <main class="workspace-panel request-panel">
                <div class="panel-titlebar">
                    <div>
                        <strong>Requests Awaiting Review</strong>
                        <small>@Model.Queue.TotalCount submitted requests in the current queue</small>
                    </div>
                </div>

                @if (Model.SubmittedRequests.Count == 0)
                {
                    <div class="workspace-empty">
                        <strong>No submitted requests are awaiting review.</strong>
                        <p>The review queue is currently clear.</p>
                    </div>
                }
                else
                {
                    <div class="table-wrap workspace-table-wrap">
                        <table class="workspace-table">
                            <thead>
                                <tr>
                                    <th>Reference</th>
                                    <th>Applicant</th>
                                    <th>Organization</th>
                                    <th>Summary</th>
                                    <th class="staff-age-column">Age</th>
                                    <th>Review</th>
                                </tr>
                            </thead>
                            <tbody>
                            @foreach (StaffRequestSearchRow request in Model.SubmittedRequests)
                            {
                                var ageDays = Math.Max(0, (DateTimeOffset.UtcNow - request.CreatedUtc).Days);
                                <tr class="staff-select-row" data-row-href="@Url.Page("/Staff/Review", new { id = request.RequestId })" role="link" tabindex="0">
                                    <td>
                                        <a asp-page="/Staff/Review" asp-route-id="@request.RequestId">
                                            <strong>@request.PublicReference</strong>
                                        </a>
                                    </td>
                                    <td>
                                        <strong>@request.ApplicantName</strong>
                                        @if (request.IsUnverifiedQuickIntake)
                                        {
                                            <span class="muted" style="display:block;font-size:.8rem">Unverified User · Anonymous Quick Intake</span>
                                        }
                                    </td>
                                    <td>@request.OrganizationName</td>
                                    <td>@request.Summary</td>
                                    <td class="staff-age-column">@ageDays d</td>
                                    <td>
                                        <a class="button button-small" asp-page="/Staff/Review" asp-route-id="@request.RequestId">Review</a>
                                    </td>
                                </tr>
                            }
                            </tbody>
                        </table>
                    </div>

                }
                <partial name="_RequestPagination" model="Model" />
            </main>

            <aside class="workspace-panel context-panel">
                <div class="panel-titlebar">
                    <div>
                        <strong>Organizations</strong>
                        <small>@Model.PendingOrganizations.Count pending approval</small>
                    </div>
                    <a asp-page="/Staff/Organizations">Manage</a>
                </div>

                <div class="organization-list">
                    @if (Model.PendingOrganizations.Count == 0)
                    {
                        <div class="workspace-empty compact">
                            <p>No organization registrations are awaiting approval.</p>
                        </div>
                    }
                    else
                    {
                        @foreach (OrganizationSummary organization in Model.PendingOrganizations.Take(8))
                        {
                            <div class="organization-row staff-organization-row staff-select-row" data-row-href="@Url.Page("/Staff/Organization", new { id = organization.Id })" role="link" tabindex="0">
                                <a asp-page="/Staff/Organization" asp-route-id="@organization.Id">
                                    <strong>@organization.Name</strong>
                                    <span>@organization.CountryCode</span>
                                </a>
                                <form method="post" asp-page-handler="ApproveOrganization">
                                    <input type="hidden" name="organizationId" value="@organization.Id" />
                                    <button class="button button-small" type="submit">Approve</button>
                                </form>
                            </div>
                        }
                    }
                </div>

                <div class="panel-titlebar panel-titlebar-secondary">
                    <div>
                        <strong>Attention</strong>
                        <small>Oldest review: @Model.OldestReviewAgeDays day(s)</small>
                    </div>
                </div>
                <div class="attention-list">
                    <a asp-page="/Staff/Organizations">
                        <strong>Documents</strong>
                        <span>@Model.Operations.DocumentsAwaitingVerification.Count awaiting verification</span>
                    </a>
                    <a asp-page="/Staff/Organizations">
                        <strong>Reverification</strong>
                        <span>@Model.Operations.ReverificationOrganizations.Count organizations</span>
                    </a>
                    <a asp-page="/Staff/Integrations">
                        <strong>Messaging</strong>
                        <span>@Model.Operations.FailedNotificationDeliveries.Count failed deliveries</span>
                    </a>
                </div>
            </aside>
        </div>
        }
    </div>
</section>


@if (Model.SearchResults is null)
{
<section class="section section-muted">
    <div class="shell">
        <div class="section-heading">
            <h2>Waiting on requester action</h2>
            <p>Requests that currently require additional information from the applicant remain visible here for follow-up.</p>
        </div>
        @if (Model.Operations.ActionRequiredRequests.Count == 0)
        {
            <div class="card"><p>No requests are currently waiting on additional information.</p></div>
        }
        else
        {
            <div class="table-wrap">
                <table>
                    <thead>
                        <tr>
                            <th>Reference</th>
                            <th>Organization</th>
                            <th>Status</th>
                            <th class="staff-age-column">Age</th>
                            <th></th>
                        </tr>
                    </thead>
                    <tbody>
                    @foreach (RequestWorkItem item in Model.Operations.ActionRequiredRequests)
                    {
                        <tr class="staff-select-row" data-row-href="@Url.Page("/Staff/Review", new { id = item.RequestId })" role="link" tabindex="0">
                            <td><strong>@item.PublicReference</strong></td>
                            <td>@item.OrganizationName</td>
                            <td>@item.Status</td>
                            <td class="staff-age-column">@item.AgeDays day(s)</td>
                            <td><a asp-page="/Staff/Review" asp-route-id="@item.RequestId">Open</a></td>
                        </tr>
                    }
                    </tbody>
                </table>
            </div>
        }
    </div>
</section>

}

<style>
.staff-pagination{display:flex;align-items:center;justify-content:space-between;gap:12px;flex-wrap:wrap;padding:14px}.staff-pagination form{display:flex;align-items:center;gap:8px;flex-wrap:wrap}.staff-pagination nav{display:flex;align-items:center;gap:12px;flex-wrap:wrap}.staff-pagination select{padding:6px}.staff-pagination [aria-disabled="true"]{color:#637083}
.staff-age-column{width:96px;min-width:96px;white-space:nowrap}
</style>
