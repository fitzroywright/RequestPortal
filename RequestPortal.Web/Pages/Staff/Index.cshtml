@page
@model RequestPortal.Web.Pages.Staff.IndexModel
@using RequestPortal.Application.Administration
@using RequestPortal.Application.Portal
@{
    ViewData["Title"] = "Requests";
}

<section class="section portal-workspace staff-workspace">
    <div class="shell">
        <header class="workspace-titlebar">
            <div>
                <div class="eyebrow request-eyebrow">FFP internal</div>
                <h1>Requests</h1>
                <p>Review work requiring attention, open operational queues, and move directly into the next action.</p>
            </div>
        </header>

        @if (Model.SearchResults is not null)
        {
            <partial name="_RequestSearchResults" model="Model" />
        }
        else
        {
        <div class="portal-workspace-grid staff-requests-grid">
            <main class="workspace-panel request-panel">
                <div class="panel-titlebar">
                    <div>
                        <strong>Requests</strong>
                        <small>@Model.Queue.TotalCount requests matching the filters</small>
                    </div>
                </div>

                <form id="requests-grid-filters" method="get" asp-page="/Staff/Index" data-requests-grid-filters><input type="hidden" name="PageSize" value="@Model.PageSize" /></form>
                <div class="table-wrap workspace-table-wrap">
                        <table class="workspace-table">
                            <thead>
                                <tr>
                                    <th>Reference</th>
                                    <th><label for="requests-applicant-filter">Applicant</label><input id="requests-applicant-filter" name="Applicant" form="requests-grid-filters" value="@Model.Applicant" maxlength="200" type="search" placeholder="Search applicant…" autocomplete="off" aria-label="Filter requests by applicant" /></th>
                                    <th><label for="requests-organization-filter">Organization</label><input id="requests-organization-filter" name="Organization" form="requests-grid-filters" value="@Model.Organization" maxlength="200" type="search" placeholder="Search organization…" autocomplete="off" aria-label="Filter requests by organization" /></th>
                                    <th>Summary</th>
                                    <th><label for="requests-status-filter">Work Status</label><select id="requests-status-filter" name="WorkStatus" form="requests-grid-filters" aria-label="Filter requests by work status"><option value="">All statuses</option>@foreach (var status in Enum.GetValues<RequestPortal.Domain.Requests.RequestStatus>()) { <option value="@status" selected="@(Model.WorkStatus == status)">@RequestPortal.Domain.Requests.RequestStatusPresentation.Label(status.ToString())</option> }</select></th>
                                    <th class="staff-age-column">Age</th>
                                    <th>Review</th>
                                </tr>
                            </thead>
                            <tbody>
                            @foreach (StaffRequestSearchRow request in Model.SubmittedRequests)
                            {
                                var ageDays = Math.Max(0, (DateTimeOffset.UtcNow - request.CreatedUtc).Days);
                                <tr class="staff-select-row" data-row-href="@Url.Page("/Staff/Review", new { id = request.RequestId })" role="link" tabindex="0">
                                    <td>
                                        <a asp-page="/Staff/Review" asp-route-id="@request.RequestId">
                                            <strong>@request.PublicReference</strong>
                                        </a>
                                    </td>
                                    <td>
                                        <strong>@request.ApplicantName</strong>
                                        @if (request.IsUnverifiedQuickIntake)
                                        {
                                            <span class="muted" style="display:block;font-size:.8rem">Unverified User · Anonymous Quick Intake</span>
                                        }
                                    </td>
                                    <td>@request.OrganizationName</td>
                                    <td>@request.Summary</td>
                                    <td><span class="status">@RequestPortal.Domain.Requests.RequestStatusPresentation.Label(request.Status.ToString())</span></td>
                                    <td class="staff-age-column">@ageDays d</td>
                                    <td>
                                        <a class="button button-small" asp-page="/Staff/Review" asp-route-id="@request.RequestId">Review</a>
                                    </td>
                                </tr>
                            }
                            @if (Model.SubmittedRequests.Count == 0)
                            {
                                <tr><td colspan="7" class="workspace-empty">No requests match the current filters. Adjust or clear the filters above.</td></tr>
                            }
                            </tbody>
                        </table>
                    </div>
                <partial name="_RequestPagination" model="Model" />
            </main>

            <div class="staff-context-stack">
            <aside class="workspace-panel context-panel">
                <div class="panel-titlebar">
                    <div>
                        <strong>Organizations</strong>
                        <small>@Model.PendingOrganizations.Count pending approval</small>
                    </div>
                    <a asp-page="/Staff/Organizations">Manage</a>
                </div>

                <div class="organization-list">
                    @if (Model.PendingOrganizations.Count == 0)
                    {
                        <div class="workspace-empty compact">
                            <p>No organization registrations are awaiting approval.</p>
                        </div>
                    }
                    else
                    {
                        @foreach (OrganizationSummary organization in Model.PendingOrganizations.Take(8))
                        {
                            <div class="organization-row staff-organization-row staff-select-row" data-row-href="@Url.Page("/Staff/Organization", new { id = organization.Id })" role="link" tabindex="0">
                                <a asp-page="/Staff/Organization" asp-route-id="@organization.Id">
                                    <strong>@organization.Name</strong>
                                    <span>@organization.CountryCode</span>
                                </a>
                                <form method="post" asp-page-handler="ApproveOrganization">
                                    <input type="hidden" name="organizationId" value="@organization.Id" />
                                    <button class="button button-small" type="submit">Approve</button>
                                </form>
                            </div>
                        }
                    }
                </div>

                <div class="panel-titlebar panel-titlebar-secondary">
                    <div>
                        <strong>Attention</strong>
                        <small>Oldest review: @Model.OldestReviewAgeDays day(s)</small>
                    </div>
                </div>
                <div class="attention-list">
                    <a asp-page="/Staff/Organizations">
                        <strong>Documents</strong>
                        <span>@Model.Operations.DocumentsAwaitingVerification.Count awaiting verification</span>
                    </a>
                    <a asp-page="/Staff/Organizations">
                        <strong>Reverification</strong>
                        <span>@Model.Operations.ReverificationOrganizations.Count organizations</span>
                    </a>
                    <a asp-page="/Staff/Integrations">
                        <strong>Messaging</strong>
                        <span>@Model.Operations.FailedNotificationDeliveries.Count failed deliveries</span>
                    </a>
                </div>

            </aside>

                <section class="workspace-panel staff-waiting-action" aria-labelledby="staff-waiting-title">
                    <div class="panel-titlebar panel-titlebar-secondary">
                        <div>
                            <strong id="staff-waiting-title">Waiting for Requestor Action</strong>
                            <small>@Model.Operations.ActionRequiredRequests.Count awaiting additional information</small>
                        </div>
                    </div>
                    @if (Model.Operations.ActionRequiredRequests.Count == 0)
                    {
                        <div class="workspace-empty compact">
                            <p>No requests are currently waiting on additional information.</p>
                        </div>
                    }
                    else
                    {
                        <div class="staff-waiting-list">
                            @foreach (RequestWorkItem item in Model.Operations.ActionRequiredRequests)
                            {
                                <a class="staff-waiting-row" asp-page="/Staff/Review" asp-route-id="@item.RequestId">
                                    <strong>@item.PublicReference</strong>
                                    <span>@item.OrganizationName</span>
                                    <small>@item.Status · @item.AgeDays day(s)</small>
                                </a>
                            }
                        </div>
                    }
                </section>
            </div>
        </div>
        }
    </div>
</section>
<script src="~/js/requests-grid-filters.js" asp-append-version="true" defer></script>



<style>
.staff-requests-grid{grid-template-columns:minmax(0,1fr) minmax(270px,.32fr)}
.staff-requests-grid .request-panel{min-width:0}
.staff-requests-grid .workspace-table{min-width:950px}
.staff-requests-grid .workspace-table thead th{vertical-align:bottom}
.staff-requests-grid .workspace-table th label{display:block;margin-bottom:5px}
.staff-requests-grid .workspace-table th :is(input,select){display:block;width:100%;min-width:125px;margin:0;font-size:.85rem;letter-spacing:normal;text-transform:none;box-sizing:border-box}
.staff-requests-grid .workspace-table th:nth-child(2),.staff-requests-grid .workspace-table th:nth-child(3){min-width:185px}
.staff-requests-grid .workspace-table th:nth-child(5){min-width:170px}
@@media(max-width:1100px){.staff-requests-grid{grid-template-columns:minmax(0,1fr)}}
.staff-context-stack{display:grid;gap:10px;align-content:start;min-width:0}
.staff-waiting-action{min-width:0}
@@media(max-width:1100px){.staff-context-stack{grid-column:1 / -1}}
.staff-waiting-list{display:grid;max-height:360px;overflow-y:auto;overscroll-behavior:contain}
.staff-waiting-row{display:grid;gap:3px;padding:12px 14px;border-bottom:1px solid var(--border,#d8e0e8);text-decoration:none;min-width:0}
.staff-waiting-row:hover,.staff-waiting-row:focus-visible{background:var(--surface-muted,#f1f5f9)}
.staff-waiting-row strong,.staff-waiting-row span{overflow-wrap:anywhere}
.staff-waiting-row small{color:var(--muted,#64748b)}
.staff-pagination{display:flex;align-items:center;justify-content:space-between;gap:12px;flex-wrap:wrap;padding:14px}.staff-pagination form{display:flex;align-items:center;gap:8px;flex-wrap:wrap}.staff-pagination nav{display:flex;align-items:center;gap:12px;flex-wrap:wrap}.staff-pagination select{padding:6px}.staff-pagination [aria-disabled="true"]{color:#637083}
.staff-age-column{width:96px;min-width:96px;white-space:nowrap}
</style>
