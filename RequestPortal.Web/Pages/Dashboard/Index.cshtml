@page
@model RequestPortal.Web.Pages.Dashboard.IndexModel
@using RequestPortal.Application.Portal
@{
    ViewData["Title"] = "My Requests";
}

<section class="section portal-workspace">
    <div class="shell">
        <header class="workspace-titlebar">
            <div>
                <div class="eyebrow request-eyebrow">Representative workspace</div>
                <h1>Hello, @Model.DisplayName</h1>
                <p>Requests, messages, documents and actions for your organizations.</p>
            </div>
            <div class="workspace-toolbar">
                <a class="button" asp-page="/Requests/Create">New request</a>
                <a class="button button-secondary" asp-page="/Messages/Inbox">Messages</a>
            </div>
        </header>

        <div class="portal-workspace-grid">
            <aside class="workspace-panel status-panel">
                <div class="panel-titlebar">
                    <div>
                        <strong>Request Status</strong>
                        <small>@Model.Requests.Count total requests</small>
                    </div>
                </div>
                <div class="status-list" role="list">
                    <button type="button" class="status-row is-active" data-status-filter="all"><span>All requests</span><strong>@Model.Requests.Count</strong></button>
                    <button type="button" class="status-row" data-status-filter="Draft"><span>Draft</span><strong>@Model.DraftCount</strong></button>
                    <button type="button" class="status-row" data-status-filter="Submitted"><span>Awaiting FFP</span><strong>@Model.SubmittedCount</strong></button>
                    <button type="button" class="status-row" data-status-filter="MoreInformationRequired"><span>Information required</span><strong>@Model.MoreInformationCount</strong></button>
                    <button type="button" class="status-row" data-status-filter="approved"><span>Approved / fulfilment</span><strong>@Model.ApprovedCount</strong></button>
                </div>

                <div class="panel-titlebar panel-titlebar-secondary"><strong>Actions</strong></div>
                <nav class="actions-list" aria-label="Workspace actions">
                    <a asp-page="/Requests/Create">Create request <span>›</span></a>
                    <a asp-page="/Messages/New">Send message <span>›</span></a>
                    <a asp-page="/Organizations/Index">Organizations <span>›</span></a>
                    <a asp-page="/Messages/Inbox">Conversation inbox <span>›</span></a>
                </nav>
            </aside>

            <main class="workspace-panel request-panel">
                <div class="panel-titlebar">
                    <div>
                        <strong id="request-panel-title">Recent Requests</strong>
                        <small id="request-panel-subtitle">Select a status to filter this working list.</small>
                    </div>
                    <a asp-page="/Requests/Index">View all</a>
                </div>

                @if (Model.Requests.Count == 0)
                {
                    <div class="workspace-empty">
                        <strong>No requests yet</strong>
                        <p>Create a request once you have an approved organization membership.</p>
                    </div>
                }
                else
                {
                    <div class="table-wrap workspace-table-wrap">
                        <table class="workspace-table">
                            <thead><tr><th>Reference</th><th>Organization</th><th>Status</th><th>Created</th><th></th></tr></thead>
                            <tbody id="request-status-results">
                            @foreach (RequestSummary request in Model.Requests.OrderByDescending(item => item.CreatedUtc))
                            {
                                string statusGroup = request.Status is "Approved" or "PendingFulfilment" or "Fulfilled" or "Closed" ? "approved" : request.Status;
                                <tr data-request-status="@statusGroup">
                                    <td><strong>@request.PublicReference</strong></td>
                                    <td>@request.OrganizationName</td>
                                    <td><span class="status status-@request.Status">@request.Status</span></td>
                                    <td>@request.CreatedUtc.ToLocalTime().ToString("MMM dd yyyy")</td>
                                    <td><a asp-page="/Requests/Details" asp-route-id="@request.Id">Open</a></td>
                                </tr>
                            }
                            </tbody>
                        </table>
                    </div>
                }
            </main>

            <aside class="workspace-panel context-panel">
                <div class="panel-titlebar">
                    <div><strong>Organizations</strong><small>@Model.ApprovedOrganizations approved</small></div>
                    <a asp-page="/Organizations/Index">Manage</a>
                </div>
                <div class="organization-list">
                    @if (Model.Organizations.Count == 0)
                    {
                        <div class="workspace-empty compact"><p>No organization membership yet.</p></div>
                    }
                    else
                    {
                        @foreach (OrganizationSummary organization in Model.Organizations)
                        {
                            <a class="organization-row" asp-page="/Organizations/Profile" asp-route-id="@organization.Id">
                                <strong>@organization.Name</strong>
                                <span>@organization.Role · @organization.MembershipStatus</span>
                            </a>
                        }
                    }
                </div>

                @if (Model.ActionRequired.Count > 0)
                {
                    <div class="panel-titlebar panel-titlebar-secondary">
                        <div><strong>Needs Attention</strong><small>@Model.ActionRequired.Count requests</small></div>
                    </div>
                    <div class="attention-list">
                        @foreach (RequestSummary request in Model.ActionRequired.Take(6))
                        {
                            <a asp-page="/Requests/Details" asp-route-id="@request.Id">
                                <strong>@request.PublicReference</strong>
                                <span>@request.Status</span>
                            </a>
                        }
                    </div>
                }
            </aside>
        </div>
    </div>
</section>

@section Scripts {
<script>
(() => {
    const buttons = document.querySelectorAll("[data-status-filter]");
    const rows = document.querySelectorAll("[data-request-status]");
    const title = document.getElementById("request-panel-title");
    const subtitle = document.getElementById("request-panel-subtitle");

    buttons.forEach(button => button.addEventListener("click", () => {
        const filter = button.dataset.statusFilter;
        buttons.forEach(item => item.classList.toggle("is-active", item === button));
        rows.forEach(row => {
            row.hidden = filter !== "all" && row.dataset.requestStatus !== filter;
        });
        title.textContent = button.querySelector("span")?.textContent || "Requests";
        const visible = Array.from(rows).filter(row => !row.hidden).length;
        subtitle.textContent = visible + (visible === 1 ? " request" : " requests") + " in this view.";
    }));
})();
</script>
}
