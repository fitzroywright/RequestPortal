@page
@model RequestPortal.Web.Pages.Dashboard.IndexModel
@using RequestPortal.Application.Messages
@using RequestPortal.Application.Portal
@{
    ViewData["Title"] = "Request Workspace";

    string Initials(string? name)
    {
        if (string.IsNullOrWhiteSpace(name)) return "?";
        string[] parts = name.Split(' ', StringSplitOptions.RemoveEmptyEntries);
        return parts.Length == 1
            ? parts[0][..Math.Min(2, parts[0].Length)].ToUpperInvariant()
            : string.Concat(parts.Take(2).Select(part => char.ToUpperInvariant(part[0])));
    }

    string FirstName(string? name)
    {
        if (string.IsNullOrWhiteSpace(name)) return "there";
        return name.Split(' ', StringSplitOptions.RemoveEmptyEntries).FirstOrDefault() ?? "there";
    }

    string HumanizeStatus(string? status)
    {
        if (string.IsNullOrWhiteSpace(status)) return string.Empty;

        return string.Concat(status.Select((character, index) =>
            index > 0 && char.IsUpper(character) && !char.IsUpper(status[index - 1])
                ? " " + character
                : character.ToString()));
    }
}

<section class="dashboard-mock-page">
    <div class="dashboard-mock-shell">
        <header class="dashboard-hero">
            <div>
                <div class="dashboard-eyebrow">REQUEST WORKSPACE</div>
                <h1>Hello, @FirstName(Model.DisplayName)</h1>
            </div>
            <div class="dashboard-hero-actions">
                <a class="dashboard-primary-button" asp-page="/Requests/Create"><span>＋</span> New request</a>
            </div>
        </header>

        <div class="dashboard-mock-grid">
            <aside class="dashboard-left-stack">
                <section class="dashboard-card">
                    <div class="dashboard-card-head">
                        <span class="dashboard-card-icon">▥</span>
                        <div>
                            <strong>Request Status</strong>
                            <small>@Model.Requests.Count total requests</small>
                        </div>
                    </div>
                    <div class="dashboard-filter-list">
                        <button type="button" class="dashboard-filter-row is-active" data-status-filter="all">
                            <span class="dashboard-filter-icon">▤</span>
                            <span>All requests</span>
                            <strong>@Model.Requests.Count</strong>
                        </button>
                        <button type="button" class="dashboard-filter-row" data-status-filter="Draft">
                            <span class="dashboard-filter-icon muted">▤</span>
                            <span>Draft</span>
                            <strong>@Model.DraftCount</strong>
                        </button>
                        <button type="button" class="dashboard-filter-row" data-status-filter="Submitted">
                            <span class="dashboard-filter-icon orange">◷</span>
                            <span>Awaiting FFP</span>
                            <strong>@Model.SubmittedCount</strong>
                        </button>
                        <button type="button" class="dashboard-filter-row" data-status-filter="MoreInformationRequired">
                            <span class="dashboard-filter-icon orange">▲</span>
                            <span>Information required</span>
                            <strong>@Model.MoreInformationCount</strong>
                        </button>
                        <button type="button" class="dashboard-filter-row" data-status-filter="approved">
                            <span class="dashboard-filter-icon green">✓</span>
                            <span>Approved / fulfilment</span>
                            <strong>@Model.ApprovedCount</strong>
                        </button>
                    </div>
                </section>

                <section class="dashboard-card">
                    <div class="dashboard-card-head">
                        <span class="dashboard-card-icon gear">◆</span>
                        <div><strong>Actions</strong></div>
                    </div>
                    <nav class="dashboard-actions-list" aria-label="Workspace actions">
                        <a asp-page="/Requests/Create"><span class="dashboard-action-icon">＋</span><span>Create request</span><b>›</b></a>
                        <a asp-page="/Messages/New"><span class="dashboard-action-icon">✉</span><span>Send message</span><b>›</b></a>
                        <a asp-page="/Organizations/Index"><span class="dashboard-action-icon">♟</span><span>Organizations</span><b>›</b></a>
                        <a asp-page="/Messages/Inbox"><span class="dashboard-action-icon">▰</span><span>Conversation inbox</span><b>›</b></a>
                    </nav>
                </section>

                <section class="dashboard-card">
                    <div class="dashboard-card-head">
                        <span class="dashboard-card-icon">↗</span>
                        <div><strong>Quick Links</strong></div>
                    </div>
                    <nav class="dashboard-quick-links">
                        <a asp-page="/Requests/Create"><span>⊕</span> New request <b>›</b></a>
                        <a asp-page="/Account/Profile"><span>♟</span> My profile <b>›</b></a>
                        <a asp-page="/Organizations/Index"><span>♟</span> Organizations <b>›</b></a>
                    </nav>
                </section>
            </aside>

            <main class="dashboard-card dashboard-requests-card">
                <div class="dashboard-card-head dashboard-card-head-wide">
                    <span class="dashboard-card-icon">▤</span>
                    <div class="dashboard-card-head-copy">
                        <strong id="request-panel-title">Recent Requests</strong>
                        <small id="request-panel-subtitle">Select a status to filter this working list.</small>
                    </div>
                    <a class="dashboard-head-link" asp-page="/Requests/Index">View all</a>
                </div>

                @if (Model.Requests.Count == 0)
                {
                    <div class="dashboard-empty">
                        <strong>No requests yet</strong>
                        <p>Create a personal request or submit one for an approved organization.</p>
                    </div>
                }
                else
                {
                    <div class="dashboard-table-wrap">
                        <table class="dashboard-table">
                            <thead>
                                <tr>
                                    <th>Reference</th>
                                    <th>Organization</th>
                                    <th>Status</th>
                                    <th>Created</th>
                                    <th></th>
                                </tr>
                            </thead>
                            <tbody id="request-status-results">
                            @foreach (RequestSummary request in Model.Requests.OrderByDescending(item => item.CreatedUtc))
                            {
                                string statusGroup = request.Status is "Approved" or "PendingFulfilment" or "Fulfilled" or "Closed" ? "approved" : request.Status;
                                string statusClass = request.Status switch
                                {
                                    "Submitted" => "green",
                                    "Approved" => "green",
                                    "PendingFulfilment" => "slate",
                                    "Fulfilled" => "green",
                                    "MoreInformationRequired" => "amber",
                                    "Rejected" => "red",
                                    "Cancelled" => "red",
                                    _ => "neutral"
                                };

                                <tr data-request-status="@statusGroup">
                                    <td><strong>@request.PublicReference</strong></td>
                                    <td>@request.OrganizationName</td>
                                    <td>
                                        <span class="dashboard-status-pill @statusClass">
                                            <i></i>@HumanizeStatus(request.Status)
                                        </span>
                                    </td>
                                    <td>@request.CreatedUtc.ToLocalTime().ToString("MMM dd yyyy")</td>
                                    <td class="dashboard-open-cell">
                                        <a asp-page="/Requests/Details" asp-route-id="@request.Id">Open <span>›</span></a>
                                    </td>
                                </tr>
                            }
                            </tbody>
                        </table>
                    </div>
                }
            </main>

            <aside class="dashboard-right-stack">
                <section class="dashboard-card">
                    <div class="dashboard-card-head dashboard-card-head-wide">
                        <span class="dashboard-card-icon warning">▲</span>
                        <div class="dashboard-card-head-copy">
                            <strong>Needs Attention</strong>
                            <small>@Model.ActionRequired.Count requests</small>
                        </div>
                    </div>
                    <div class="dashboard-attention-list">
                        @if (Model.ActionRequired.Count == 0)
                        {
                            <div class="dashboard-empty compact">Nothing needs your attention.</div>
                        }
                        else
                        {
                            @foreach (RequestSummary request in Model.ActionRequired.Take(4))
                            {
                                <a asp-page="/Requests/Details" asp-route-id="@request.Id">
                                    <strong>@request.PublicReference</strong>
                                    <span>@HumanizeStatus(request.Status)</span>
                                </a>
                            }
                        }
                    </div>
                </section>

                <section class="dashboard-card">
                    <div class="dashboard-card-head dashboard-card-head-wide">
                        <span class="dashboard-card-icon">▰</span>
                        <div class="dashboard-card-head-copy">
                            <strong>Recent Messages</strong>
                        </div>
                        <a class="dashboard-head-link" asp-page="/Messages/Inbox">View all</a>
                    </div>
                    <div class="dashboard-message-list">
                        @if (Model.RecentMessages.Count == 0)
                        {
                            <div class="dashboard-empty compact">No recent messages.</div>
                        }
                        else
                        {
                            @foreach (MailboxMessageView message in Model.RecentMessages)
                            {
                                <a class="dashboard-message-row" asp-page="/Messages/Thread" asp-route-id="@message.ThreadId">
                                    <span class="dashboard-message-avatar @(message.SenderKind == "Staff" ? "staff" : "requester")">@Initials(message.SenderName)</span>
                                    <span class="dashboard-message-copy">
                                        <span class="dashboard-message-meta">
                                            <strong>@message.SenderName</strong>
                                            <time>@message.SentUtc.ToLocalTime().ToString("dd MMM yyyy, h:mm tt")</time>
                                        </span>
                                        <small>@message.Preview</small>
                                    </span>
                                </a>
                            }
                        }
                    </div>
                </section>

                <section class="dashboard-card">
                    <div class="dashboard-card-head dashboard-card-head-wide">
                        <span class="dashboard-card-icon">♟</span>
                        <div class="dashboard-card-head-copy">
                            <strong>Organizations</strong>
                            <small>@Model.ApprovedOrganizations approved</small>
                        </div>
                        <a class="dashboard-head-link" asp-page="/Organizations/Index">Manage</a>
                    </div>
                    <div class="dashboard-organization-list">
                        @if (Model.Organizations.Count == 0)
                        {
                            <div class="dashboard-empty compact">No organization membership yet.</div>
                        }
                        else
                        {
                            @foreach (OrganizationSummary organization in Model.Organizations.Take(3))
                            {
                                <a class="dashboard-organization-row" asp-page="/Organizations/Profile" asp-route-id="@organization.Id">
                                    <span class="dashboard-org-avatar">@Initials(organization.Name)</span>
                                    <span>
                                        <strong>@organization.Name</strong>
                                        <small>@organization.Role · @organization.MembershipStatus</small>
                                    </span>
                                    <b>›</b>
                                </a>
                            }
                        }
                    </div>
                </section>

            </aside>
        </div>
    </div>
</section>

@section Scripts {
<script>
(() => {
    const buttons = document.querySelectorAll("[data-status-filter]");
    const rows = document.querySelectorAll("[data-request-status]");
    const title = document.getElementById("request-panel-title");
    const subtitle = document.getElementById("request-panel-subtitle");

    buttons.forEach(button => button.addEventListener("click", () => {
        const filter = button.dataset.statusFilter;
        buttons.forEach(item => item.classList.toggle("is-active", item === button));

        rows.forEach(row => {
            row.hidden = filter !== "all" && row.dataset.requestStatus !== filter;
        });

        title.textContent = button.querySelector("span:nth-child(2)")?.textContent || "Requests";
        const visible = Array.from(rows).filter(row => !row.hidden).length;
        subtitle.textContent = visible + (visible === 1 ? " request" : " requests") + " in this view.";
    }));
})();
</script>
}
