@page
@model RequestPortal.Web.Pages.Organizations.IndexModel
@using RequestPortal.Application.Countries
@{
    ViewData["Title"] = "Organizations";
}

<section class="operational-page">
    <div class="shell">
        <div class="section-heading">
            <div class="eyebrow" style="color:#b45b09">Organization access</div>
            <h1>My organizations</h1>
            <p>
                Requests are always made on behalf of an organization. New organizations require FFP approval;
                representatives joining an existing organization require approval by that organization's administrator.
            </p>
        </div>

        <section class="operational-panel">
            <div class="panel-titlebar">
                <div>
                    <strong>Current memberships</strong>
                    <small>Membership changes are managed from your profile.</small>
                </div>
                <a class="button button-small" asp-page="/Account/Profile">Manage my profile</a>
            </div>
            @if (Model.Organizations.Count == 0)
            {
                <div class="workspace-empty compact">
                    <p>You do not yet belong to any organizations.</p>
                </div>
            }
            else
            {
                <div class="table-wrap">
                    <table>
                        <thead><tr><th>Organization</th><th>Organization status</th><th>Membership</th><th>Role</th><th></th></tr></thead>
                        <tbody>
                        @foreach (OrganizationSummary organization in Model.Organizations)
                        {
                            <tr>
                                <td><strong>@organization.Name</strong><br /><span class="muted">@organization.CountryCode</span></td>
                                <td><span class="status status-@organization.OrganizationStatus">@organization.OrganizationStatus</span></td>
                                <td><span class="status status-@organization.MembershipStatus">@organization.MembershipStatus</span></td>
                                <td>@organization.Role</td>
                                <td>
                                    @if (organization.Role == "Administrator" && organization.MembershipStatus == "Approved")
                                    {
                                        <a asp-page="/Organizations/Members" asp-route-organizationId="@organization.Id">Representatives</a>
                                    }
                                </td>
                            </tr>
                        }
                        </tbody>
                    </table>
                </div>
            }
        </section>
    </div>
</section>
