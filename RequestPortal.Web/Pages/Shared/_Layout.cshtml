@inject IConfiguration Configuration
@inject Microsoft.AspNetCore.Identity.UserManager<RequestPortal.Infrastructure.Identity.ApplicationUser> LayoutUserManager
@using System.Security.Claims
@{
    bool trainingEnabled = Configuration.GetValue("Training:Enabled", false);
    bool isAuthenticated = User.Identity?.IsAuthenticated == true;
    bool isFfpStaff = isAuthenticated &&
        User.HasClaim(RequestPortal.Web.Security.StaffOidcOptions.StaffSurfaceClaim, RequestPortal.Web.Security.StaffOidcOptions.StaffSurfaceValue);
    bool canViewManagement = User.HasClaim(RequestPortal.Web.Security.StaffOidcOptions.PermissionClaim, RequestPortal.Infrastructure.Security.RequestPortalPermissions.ViewManagementDashboard);
    bool isExternalReviewer = User.HasClaim("requestportal.external-review", "true");
    string? currentPage = ViewContext.RouteData.Values["page"]?.ToString();
    bool isOpeningPage = string.Equals(currentPage, "/Index", StringComparison.OrdinalIgnoreCase);
    bool useApplicationShell = isAuthenticated && !isOpeningPage;

    RequestPortal.Infrastructure.Identity.ApplicationUser? layoutUser =
        isAuthenticated ? await LayoutUserManager.GetUserAsync(User) : null;

    string? profileGivenNameClaim = User.FindFirst(ClaimTypes.GivenName)?.Value;
    string? profileNameClaim = User.FindFirst(ClaimTypes.Name)?.Value;
    string? profileEmailClaim = User.FindFirst(ClaimTypes.Email)?.Value;

    string profileName =
        !string.IsNullOrWhiteSpace(layoutUser?.DisplayName) ? layoutUser.DisplayName :
        !string.IsNullOrWhiteSpace(profileGivenNameClaim) ? profileGivenNameClaim :
        !string.IsNullOrWhiteSpace(profileNameClaim) ? profileNameClaim :
        !string.IsNullOrWhiteSpace(User.Identity?.Name) ? User.Identity.Name! :
        !string.IsNullOrWhiteSpace(profileEmailClaim) ? profileEmailClaim :
        "Account";

    if (profileName.Contains('@'))
    {
        profileName = profileName.Split('@', 2)[0];
    }

    string[] profileParts = profileName.Split(' ', StringSplitOptions.RemoveEmptyEntries);
    string profileFirstName = profileParts.Length > 0 ? profileParts[0] : "Account";
    string profileInitials = profileFirstName[..Math.Min(2, profileFirstName.Length)].ToUpperInvariant();
    string? applicantAvatarUrl =
        !isFfpStaff && !isExternalReviewer && layoutUser is not null
            ? $"/api/users/{layoutUser.Id:D}/avatar?v={layoutUser.ProfilePhotoUpdatedUtc?.ToUnixTimeSeconds() ?? 0}"
            : null;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Request Portal</title>
    <link rel="icon" type="image/png" href="https://foodforthepoor.org/wp-content/uploads/fftp-logo-img-media.png" />
    <link rel="apple-touch-icon" href="https://foodforthepoor.org/wp-content/uploads/fftp-logo-img-media.png" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/ffp-brand.css" asp-append-version="true" />
    @if (trainingEnabled)
    {
        <link rel="stylesheet" href="~/css/contextual-training.css" asp-append-version="true" />
    }
    <link rel="stylesheet" href="~/css/operational-workspace.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/application-shell.css" asp-append-version="true" />
    @await RenderSectionAsync("Styles", required: false)
</head>
<body class="@(useApplicationShell ? "authenticated-app" : "public-site")">
    <header class="site-header @(useApplicationShell ? "app-header" : null)">
        <div class="shell nav-shell @(useApplicationShell ? "app-nav-shell" : null)">
            <a class="brand @(useApplicationShell ? "app-brand" : null)" asp-page="/Index">
                @if (useApplicationShell)
                {
                    <img class="brand-logo" src="https://foodforthepoor.org/wp-content/uploads/fftp-logo-img-media.png" alt="Food For The Poor Jamaica" />
                    <span class="brand-copy"><strong>Request Portal</strong></span>
                }
                else
                {
                    <img class="brand-logo" src="https://foodforthepoor.org/wp-content/uploads/fftp-logo-img-media.png" alt="Food For The Poor" />
                    <span class="brand-copy">
                        <strong>Request Portal</strong>
                        <small>Food For The Poor Jamaica</small>
                    </span>
                }
            </a>
            @if (!isOpeningPage)
            {
                <nav class="main-nav @(useApplicationShell ? "app-main-nav" : null)">

                    @if (isAuthenticated)
                    {
                        if (isExternalReviewer)
                        {
                            <a asp-page="/ExternalReview/Index">External Review</a>
                            <form method="post" asp-page="/ExternalReview/Index" asp-page-handler="SignOut" class="nav-form">
                                <button type="submit" class="nav-link-button">End review session</button>
                            </form>
                        }
                        else if (isFfpStaff)
                        {
                            <a asp-page="/Staff/Index">Requests</a>
                            <a asp-page="/Staff/Organizations">Organizations</a>
                            <a asp-page="/Staff/Reports">Reports</a>
                            @if (canViewManagement)
                            {
                                <a asp-page="/Management/Index">Management</a>
                            }
                            <a asp-page="/Staff/Reviewers">Reviewers</a>
                            <details class="staff-admin-menu">
                                <summary aria-label="Administration menu">Admin <span aria-hidden="true">▾</span></summary>
                                <div class="staff-admin-menu-panel">
                                    @if (User.HasClaim(RequestPortal.Web.Security.StaffOidcOptions.PermissionClaim, RequestPortal.Infrastructure.Security.RequestPortalPermissions.ManageSecurity))
                                    {
                                        <a asp-page="/Administration/Staff">Staff &amp; Roles</a>
                                        <a asp-page="/Administration/ApplicantAccounts">Accounts and Identity</a>
                                    }
                                    <a asp-page="/Staff/Integrations">Integrations</a>
                                </div>
                            </details>
                        }
                        else
                        {
                            <a asp-page="/Dashboard/Index" class="@(string.Equals(currentPage, "/Dashboard/Index", StringComparison.OrdinalIgnoreCase) ? "is-active" : null)"><span class="app-nav-icon" aria-hidden="true">◆</span>Request Workspace</a>
                            <a asp-page="/Requests/Index" class="@(string.Equals(currentPage, "/Requests/Index", StringComparison.OrdinalIgnoreCase) ? "is-active" : null)"><span class="app-nav-icon" aria-hidden="true">▤</span>My Requests</a>
                            <a asp-page="/Requests/Create" class="@(string.Equals(currentPage, "/Requests/Create", StringComparison.OrdinalIgnoreCase) ? "is-active" : null)"><span class="app-nav-icon" aria-hidden="true">✚</span>New Request</a>
                            <a asp-page="/Account/Profile" class="@(string.Equals(currentPage, "/Account/Profile", StringComparison.OrdinalIgnoreCase) ? "is-active" : null)"><span class="app-nav-icon" aria-hidden="true">●</span>My Profile</a>
                            <a asp-page="/Organizations/Index" class="@(string.Equals(currentPage, "/Organizations/Index", StringComparison.OrdinalIgnoreCase) ? "is-active" : null)"><span class="app-nav-icon" aria-hidden="true">♟</span>Organizations</a>
                        }

                        <a asp-page="/Messages/Inbox"
                           class="app-message-link messages-nav-link"
                           aria-label="Messages"
                           title="Messages">
                            <span class="app-message-icon" aria-hidden="true">✉</span>
                            <span id="messageUnreadBadge" class="message-badge" hidden>0</span>
                        </a>
                        <div class="profile-menu">
                            <button type="button"
                                    class="profile-menu-trigger profile-menu-studio"
                                    aria-expanded="false"
                                    aria-controls="profileMenuPanel"
                                    data-profile-menu-trigger>
                                <span class="profile-menu-name">@profileFirstName</span>
                                @if (!string.IsNullOrWhiteSpace(applicantAvatarUrl))
                                {
                                    <img class="profile-avatar profile-avatar-studio profile-avatar-image" src="@applicantAvatarUrl" alt="" />
                                }
                                else
                                {
                                    <span class="profile-avatar profile-avatar-studio" aria-hidden="true">@profileInitials</span>
                                }
                            </button>
                            <div id="profileMenuPanel" class="profile-menu-panel" hidden data-profile-menu-panel>
                                <div class="profile-menu-header">
                                    @if (!string.IsNullOrWhiteSpace(applicantAvatarUrl))
                                    {
                                        <img class="profile-avatar profile-avatar-large profile-avatar-studio profile-avatar-image" src="@applicantAvatarUrl" alt="" />
                                    }
                                    else
                                    {
                                        <span class="profile-avatar profile-avatar-large profile-avatar-studio" aria-hidden="true">@profileInitials</span>
                                    }
                                    <div>
                                        <strong>@profileFirstName</strong>
                                        <small>@(isFfpStaff ? "FFP Staff" : "Applicant / Representative")</small>
                                    </div>
                                </div>
                                @if (!isFfpStaff && !isExternalReviewer)
                                {
                                    <div class="profile-menu-section">
                                        <a asp-page="/Account/Profile">My profile</a>
                                    </div>
                                }
                                <div class="profile-menu-section">
                                    <form method="post" asp-page="/Account/Logout" class="profile-menu-signout">
                                        <button type="submit">Sign out</button>
                                    </form>
                                </div>
                            </div>
                        </div>
                    }
                    else
                    {
                    }
                </nav>
            }
            @if (isOpeningPage)
            {
                <a class="button button-small donate-button" href="https://www.foodforthepoorja.org/hurricane-melissa-relief/" target="_blank" rel="noopener noreferrer">Donate</a>
            }
        </div>
    </header>

    <main class="@(useApplicationShell ? "app-main" : null)">
        @if (string.Equals(Context.Request.Query["navigationError"], "not-found", StringComparison.OrdinalIgnoreCase))
        {
            <div class="shell flash error">We couldn’t find the page you were trying to open. You’ve been returned to the Request Portal home page.</div>
        }
        @if (TempData["Success"] is string success)
        {
            <div class="shell flash success">@success</div>
        }
        @if (TempData["Error"] is string error)
        {
            <div class="shell flash error">@error</div>
        }
        @RenderBody()
    </main>

    @if (!useApplicationShell && ViewData["HideFooter"] as bool? != true)
    {
        <footer class="site-footer">
            <div class="shell footer-grid ffp-footer-grid">
                <div class="ffp-footer-identity">
                    <img class="footer-logo" src="https://foodforthepoor.org/wp-content/uploads/fftp-logo-img-media.png" alt="Food For The Poor" />
                    <div>
                        <strong>Food For The Poor Jamaica</strong>
                        <p class="ffp-scripture">“As often as you did it for one of the least of my brothers and sisters, you did it for me.” <span>Matthew 25:40</span></p>
                    </div>
                </div>
                <address class="footer-meta ffp-contact">
                    P.O. Box 557, Ellerslie Pen<br />
                    Spanish Town, St. Catherine, Jamaica, W.I.<br />
                    <a href="tel:+18769845005">+1-876-984-5005</a> &nbsp;|&nbsp;
                    <a href="tel:+18766180141">+1-876-618-0141</a> &nbsp;|&nbsp;
                    <a href="tel:+18769073656">+1-876-907-3656</a><br />
                    <a href="mailto:ffpinfo@foodforthepoorja.org">ffpinfo@foodforthepoorja.org</a><br />
                    <a href="mailto:customerservice@foodforthepoorja.org">customerservice@foodforthepoorja.org</a>
                </address>
            </div>
        </footer>
    }

    @if (User.Identity?.IsAuthenticated == true)
    {
        <div id="messageToast" class="message-toast" hidden>
            <div>
                <strong id="messageToastTitle">New message</strong>
                <div id="messageToastBody"></div>
            </div>
            <a id="messageToastLink" class="button button-small" href="/Messages/Inbox">View</a>
        </div>
        <script src="https://cdnjs.cloudflare.com/ajax/libs/microsoft-signalr/8.0.7/signalr.min.js"></script>
        <script src="~/js/messages.js" asp-append-version="true"></script>
    }
    <script>
    (() => {
        const trigger = document.querySelector("[data-profile-menu-trigger]");
        const panel = document.querySelector("[data-profile-menu-panel]");
        if (!trigger || !panel) return;

        const close = () => {
            panel.hidden = true;
            trigger.setAttribute("aria-expanded", "false");
        };

        trigger.addEventListener("click", event => {
            event.stopPropagation();
            const open = panel.hidden;
            panel.hidden = !open;
            trigger.setAttribute("aria-expanded", open ? "true" : "false");
        });

        document.addEventListener("click", event => {
            if (!panel.contains(event.target) && !trigger.contains(event.target)) close();
        });

        document.addEventListener("keydown", event => {
            if (event.key === "Escape") close();
        });
    })();
    </script>
    <script>
    (() => {
        const interactiveSelector = "a,button,input,select,textarea,label,form,[role='button']";
        const navigate = row => {
            const href = row.getAttribute("data-row-href");
            if (href) window.location.assign(href);
        };

        document.addEventListener("click", event => {
            const row = event.target.closest("[data-row-href]");
            if (!row || event.target.closest(interactiveSelector)) return;
            navigate(row);
        });

        document.addEventListener("keydown", event => {
            if (event.key !== "Enter" && event.key !== " ") return;
            const row = event.target.closest("[data-row-href]");
            if (!row || event.target.closest(interactiveSelector)) return;
            event.preventDefault();
            navigate(row);
        });
    })();
    </script>
    @if (trainingEnabled)
    {
        <script src="~/js/contextual-training.js" asp-append-version="true"></script>
    }
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
