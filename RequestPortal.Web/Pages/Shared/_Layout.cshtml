@using System.Security.Claims
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Request Portal</title>
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/ffp-brand.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/contextual-training.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/operational-workspace.css" asp-append-version="true" />
</head>
<body>
    <header class="site-header">
        <div class="shell nav-shell">
            <a class="brand" asp-page="/Index">
                <img class="brand-logo" src="https://foodforthepoor.org/wp-content/uploads/fftp-logo-img-media.png" alt="Food For The Poor" />
                <span class="brand-copy">
                    <strong>Request Portal</strong>
                    <small>Food For The Poor Jamaica</small>
                </span>
            </a>
            <nav class="main-nav">
                @{
                    bool isFfpStaff = User.Identity?.IsAuthenticated == true &&
                        User.HasClaim(RequestPortal.Web.Security.StaffOidcOptions.StaffSurfaceClaim, RequestPortal.Web.Security.StaffOidcOptions.StaffSurfaceValue);
                    bool canViewManagement = User.HasClaim(RequestPortal.Web.Security.StaffOidcOptions.PermissionClaim, RequestPortal.Infrastructure.Security.RequestPortalPermissions.ViewManagementDashboard);
                    bool isExternalReviewer = User.HasClaim("requestportal.external-review", "true");
                }
                <a asp-page="/Index">Home</a>
                @if (User.Identity?.IsAuthenticated == true)
                {
                    if (isExternalReviewer)
                    {
                        <a asp-page="/ExternalReview/Index">External Review</a>
                        <form method="post" asp-page="/ExternalReview/Index" asp-page-handler="SignOut" class="nav-form">
                            <button type="submit" class="nav-link-button">End review session</button>
                        </form>
                    }
                    else if (isFfpStaff)
                    {
                        if (canViewManagement)
                        {
                            <a asp-page="/Management/Index">Management</a>
                        }
                        <a asp-page="/Staff/Index">FFP Staff</a>
                        <a asp-page="/Staff/Operations">Operations</a>
                        <a asp-page="/Staff/Reports">Reports</a>
                        <a asp-page="/Staff/Reviewers">External Reviewers</a>
                        <a asp-page="/Messages/Inbox" class="messages-nav-link">Messages <span id="messageUnreadBadge" class="message-badge" hidden>0</span></a>
                    }
                    else
                    {
                        <a asp-page="/Dashboard/Index">Workspace</a>
                        <a asp-page="/Organizations/Index">Organizations</a>
                        <a asp-page="/Requests/Index">Requests</a>
                        <a asp-page="/Account/Notifications">Notifications</a>
                        <a asp-page="/Messages/Inbox" class="messages-nav-link">Messages <span id="messageUnreadBadge" class="message-badge" hidden>0</span></a>
                    }
                    <div class="profile-menu">
                        <button type="button"
                                class="profile-menu-trigger"
                                aria-expanded="false"
                                aria-controls="profileMenuPanel"
                                data-profile-menu-trigger>
                            @{
                                string? profileNameClaim = User.FindFirst(ClaimTypes.Name)?.Value;
                                string? profileGivenName = User.FindFirst(ClaimTypes.GivenName)?.Value;
                                string profileName = !string.IsNullOrWhiteSpace(profileNameClaim) && !profileNameClaim.Contains('@')
                                    ? profileNameClaim
                                    : !string.IsNullOrWhiteSpace(profileGivenName) && !profileGivenName.Contains('@')
                                        ? profileGivenName
                                        : "User";
                                string[] profileParts = profileName.Split(' ', StringSplitOptions.RemoveEmptyEntries);
                                string profileInitials = profileParts.Length switch
                                {
                                    0 => "U",
                                    1 => profileParts[0][..Math.Min(2, profileParts[0].Length)].ToUpperInvariant(),
                                    _ => $"{profileParts[0][0]}{profileParts[^1][0]}".ToUpperInvariant()
                                };
                            }
                            <span class="profile-menu-name">@profileName</span>
                            <span class="profile-avatar profile-avatar-studio" aria-hidden="true">@profileInitials</span>
                        </button>
                        <div id="profileMenuPanel" class="profile-menu-panel" hidden data-profile-menu-panel>
                            <div class="profile-menu-header">
                                <span class="profile-avatar profile-avatar-large profile-avatar-studio" aria-hidden="true">@profileInitials</span>
                                <div>
                                    <strong>@profileName</strong>
                                    <small>@(isFfpStaff ? "FFP Staff" : "Applicant / Representative")</small>
                                </div>
                            </div>
                            <div class="profile-menu-section">
                                <a asp-page="/Organizations/Index">Organizations</a>
                                <a asp-page="/Account/Notifications">Notification preferences</a>
                            </div>
                            <div class="profile-menu-section profile-menu-profile">
                                <span class="profile-menu-label">Profile</span>
                                <strong>@profileName</strong>
                            </div>
                            <div class="profile-menu-section">
                                <form method="post" asp-page="/Account/Logout" class="profile-menu-signout">
                                    <button type="submit">Sign out</button>
                                </form>
                            </div>
                        </div>
                    </div>
                }
                else
                {
                    <a asp-page="/Account/StaffLogin">FFP Staff Sign-In</a>
                    <a class="button button-small" asp-page="/Account/Login">Sign in</a>
                }
                @if (!isFfpStaff && !isExternalReviewer)
                {
                    <a class="button button-small donate-button" href="https://www.foodforthepoorja.org/hurricane-melissa-relief/" target="_blank" rel="noopener noreferrer">Donate</a>
                }
            </nav>
        </div>
    </header>

    <main>
        @if (TempData["Success"] is string success)
        {
            <div class="shell flash success">@success</div>
        }
        @if (TempData["Error"] is string error)
        {
            <div class="shell flash error">@error</div>
        }
        @RenderBody()
    </main>

    <footer class="site-footer">
        <div class="shell footer-grid ffp-footer-grid">
            <div class="ffp-footer-identity">
                <img class="footer-logo" src="https://foodforthepoor.org/wp-content/uploads/fftp-logo-img-media.png" alt="Food For The Poor" />
                <div>
                    <strong>Food For The Poor Jamaica</strong>
                    <p class="ffp-scripture">“As often as you did it for one of the least of my brothers and sisters, you did it for me.” <span>Matthew 25:40</span></p>
                </div>
            </div>
            <address class="footer-meta ffp-contact">
                P.O. Box 557, Ellerslie Pen<br />
                Spanish Town, St. Catherine, Jamaica, W.I.<br />
                <a href="tel:+18769845005">+1-876-984-5005</a> &nbsp;|&nbsp;
                <a href="tel:+18766180141">+1-876-618-0141</a> &nbsp;|&nbsp;
                <a href="tel:+18769073656">+1-876-907-3656</a><br />
                <a href="mailto:ffpinfo@foodforthepoorja.org">ffpinfo@foodforthepoorja.org</a><br />
                <a href="mailto:customerservice@foodforthepoorja.org">customerservice@foodforthepoorja.org</a>
            </address>
        </div>
    </footer>

    @if (User.Identity?.IsAuthenticated == true)
    {
        <div id="messageToast" class="message-toast" hidden>
            <div>
                <strong id="messageToastTitle">New message</strong>
                <div id="messageToastBody"></div>
            </div>
            <a id="messageToastLink" class="button button-small" href="/Messages/Inbox">View</a>
        </div>
        <script src="https://cdnjs.cloudflare.com/ajax/libs/microsoft-signalr/8.0.7/signalr.min.js"></script>
        <script src="~/js/messages.js" asp-append-version="true"></script>
    }
    <script>
    (() => {
        const trigger = document.querySelector("[data-profile-menu-trigger]");
        const panel = document.querySelector("[data-profile-menu-panel]");
        if (!trigger || !panel) return;

        const close = () => {
            panel.hidden = true;
            trigger.setAttribute("aria-expanded", "false");
        };

        trigger.addEventListener("click", event => {
            event.stopPropagation();
            const open = panel.hidden;
            panel.hidden = !open;
            trigger.setAttribute("aria-expanded", open ? "true" : "false");
        });

        document.addEventListener("click", event => {
            if (!panel.contains(event.target) && !trigger.contains(event.target)) close();
        });

        document.addEventListener("keydown", event => {
            if (event.key === "Escape") close();
        });
    })();
    </script>
    <script src="~/js/contextual-training.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
