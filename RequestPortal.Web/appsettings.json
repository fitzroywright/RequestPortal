{
  "Aegis": {
    "Configuration": {
      "Url": "https://config.ffpja.org"
    },
    "Diagnostics": {
      "Url": "https://diagnostics.ffpja.org",
      "RequestCredentialSecretName": "diagnostics/machine/RequestPortal",
      "StorePath": "data/diagnostic-level/requestportal.db"
    },
    "Operations": {
      "Url": "https://operations.ffpja.org"
    }
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Demo": {
    "Enabled": false,
    "EnsureDatabase": false
  },
  "ManagementDashboard": {
    "NewRequestHours": 48,
    "OverdueDays": 14,
    "StalledDays": 7,
    "TrendWeeks": 12
  },
  "FfpManagerIntegration": {
    "Enabled": false,
    "BaseUrl": "https://10.10.0.200/",
    "SharedSecret": "",
    "TimeoutSeconds": 30,
    "PollIntervalSeconds": 60,
    "SystemName": "FFPManager"
  },
  "CommonSecrets": {
    "WorkloadName": "RequestPortal"
  },
  "Storage": {
    "Local": {
      "RootPath": "App_Data/storage"
    }
  },
  "Notifications": {
    "Enabled": false,
    "SmtpHost": "",
    "SmtpPort": 587,
    "EnableSsl": true,
    "FromAddress": "",
    "FromName": "FFP Request Portal",
    "UserName": null,
    "PasswordSecretName": "Notifications:SmtpPassword"
  },
  "Messaging": {
    "MicrosoftGraph": {
      "TenantId": "",
      "ClientId": "",
      "ClientSecretName": "messaging/msgraph/client-secret",
      "Email": {
        "Enabled": false,
        "SenderUpn": ""
      },
      "Teams": {
        "Enabled": false,
        "SenderUpn": "",
        "DelegatedAccessTokenSecretName": "messaging/msgraph/teams/delegated-access-token"
      }
    }
  },
  "Authentication": {
    "StaffOidc": {
      "Enabled": false,
      "Authority": "",
      "ClientId": "request-portal",
      "ClientSecret": "",
      "CallbackPath": "/signin-ffp-staff",
      "RequireHttpsMetadata": true,
      "UserNameClaim": "preferred_username",
      "DisplayNameClaim": "name",
      "EmailClaim": "email",
      "GroupClaimTypes": [
        "groups",
        "group",
        "memberOf"
      ]
    },
    "ActiveDirectory": {
      "Domain": "fftpj.local",
      "ReviewerGroups": [],
      "AdministratorGroups": []
    },
    "Google": {
      "ClientId": ""
    },
    "Facebook": {
      "AppId": ""
    },
    "Microsoft": {
      "ClientId": ""
    },
    "Yahoo": {
      "ClientId": ""
    }
  }
}
