{
  "Aegis": {
    "Configuration": {
      "Url": "https://config.ffpja.org"
    },
    "Diagnostics": {
      "Url": "https://diagnostics.ffpja.org",
      "RequestCredentialSecretName": "diagnostics/machine/RequestPortal",
      "StorePath": "data/diagnostic-level/requestportal.db"
    },
    "Operations": {
      "Url": "https://operations.ffpja.org"
    }
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Demo": {
    "Enabled": false,
    "EnsureDatabase": false
  },
  "ManagementDashboard": {
    "NewRequestHours": 48,
    "OverdueDays": 14,
    "StalledDays": 7,
    "TrendWeeks": 12
  },
  "RequestSubmissionPolicy": {
    "Enabled": true,
    "MaxActiveRequestsPerUser": 3,
    "MaxSubmissionsPer24Hours": 2,
    "MaxSubmissionsPer30Days": 5,
    "MaxCancelledRequestsPer30Days": 3,
    "OrganizationMaxActiveRequests": 25,
    "OrganizationMaxSubmissionsPer24Hours": 10,
    "OrganizationMaxSubmissionsPer30Days": 100,
    "OrganizationMaxCancelledRequestsPer30Days": 20,
    "DuplicateLookbackDays": 90
  },
  "FfpManagerIntegration": {
    "Enabled": false,
    "BaseUrl": "",
    "TimeoutSeconds": 30,
    "PollIntervalSeconds": 60,
    "SystemName": "FFPManager",
    "SharedSecretName": "FfpManagerIntegration:SharedSecret"
  },
  "CommonSecrets": {
    "WorkloadName": "RequestPortal"
  },
  "Storage": {
    "Provider": "LocalFolder",
    "Local": {
      "RootPath": "App_Data/storage"
    },
    "NetworkFolder": {
      "RootPath": ""
    },
    "SharePoint": {
      "TenantId": "",
      "ClientId": "",
      "ClientSecretName": "storage/sharepoint/client-secret",
      "HostName": "",
      "SitePath": "",
      "DriveId": "",
      "DriveName": "Documents",
      "RootFolder": "Aegis/RequestPortal",
      "SiteId": ""
    }
  },
  "Notifications": {
    "QuickIntakeClientRelationsEmail": "clientrelations@foodforthepoorja.org",
    "Enabled": false,
    "SmtpHost": "",
    "SmtpPort": 587,
    "EnableSsl": true,
    "FromAddress": "",
    "FromName": "FFP Request Portal",
    "UserName": null,
    "PasswordSecretName": "Notifications:SmtpPassword"
  },
  "Messaging": {
    "ArchiveAfterDays": 365,
    "MicrosoftGraph": {
      "TenantId": "",
      "ClientId": "",
      "ClientSecretName": "messaging/msgraph/client-secret",
      "Email": {
        "Enabled": false,
        "SenderUpn": ""
      },
      "Teams": {
        "Enabled": false,
        "SenderUpn": "",
        "DelegatedAccessTokenSecretName": "messaging/msgraph/teams/delegated-access-token"
      }
    }
  },
  "Authentication": {
    "StaffOidc": {
      "Enabled": false,
      "Authority": "",
      "ClientId": "request-portal",
      "ClientSecret": "",
      "CallbackPath": "/signin-ffp-staff",
      "UserNameClaim": "preferred_username",
      "DisplayNameClaim": "name",
      "EmailClaim": "email",
      "GroupClaimTypes": [
        "groups",
        "group",
        "memberOf"
      ]
    },
    "StaffDirectory": {
      "Enabled": false,
      "Provider": "",
      "ClientId": "",
      "ClientSecretName": "Authentication:StaffDirectory:ClientSecret",
      "TenantId": "",
      "KeycloakSubjectMappingVerified": false
    },
    "ActiveDirectory": {
      "Domain": "fftpj.local",
      "ReviewerGroups": [],
      "AdministratorGroups": []
    },
    "Google": {
      "ClientId": ""
    },
    "Facebook": {
      "AppId": ""
    },
    "Microsoft": {
      "ClientId": ""
    },
    "Yahoo": {
      "ClientId": ""
    },
    "Apple": {
      "ClientId": ""
    }
  },
  "Training": {
    "Enabled": false
  }
}
