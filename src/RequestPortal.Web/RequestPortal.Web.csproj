<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <RootNamespace>RequestPortal.Web</RootNamespace>
    <UserSecretsId>RequestPortal-Web-Development</UserSecretsId>
    <CommonRoot Condition="'$(CommonRoot)' == ''">$(MSBuildThisFileDirectory)..\..\..\Common</CommonRoot>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Authentication.Facebook" Version="10.0.0" />
    <PackageReference Include="Microsoft.AspNetCore.Authentication.Google" Version="10.0.0" />
    <PackageReference Include="Microsoft.AspNetCore.Authentication.MicrosoftAccount" Version="10.0.0" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.0">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\RequestPortal.Application\RequestPortal.Application.csproj" />
    <ProjectReference Include="..\RequestPortal.Common\RequestPortal.Common.csproj" />
    <ProjectReference Include="..\RequestPortal.Infrastructure\RequestPortal.Infrastructure.csproj" />
    <ProjectReference Include="$(CommonRoot)\Common.Diagnostics\Common.Diagnostics.csproj" />
    <ProjectReference Include="$(CommonRoot)\Common.Security\Common.Security.csproj" />
    <ProjectReference Include="$(CommonRoot)\Common.Secrets\Common.Secrets.csproj" />
    <ProjectReference Include="$(CommonRoot)\Common.Storage\Common.Storage.csproj" />
    <ProjectReference Include="$(CommonRoot)\Common.Messaging\Common.Messaging.csproj" />
    <ProjectReference Include="$(CommonRoot)\Common.Messaging\Common.Messaging.Hosting\Common.Messaging.Hosting.csproj" />
  </ItemGroup>
</Project>
