@page
@model RequestPortal.Web.Pages.ErrorModel
@{
    ViewData["Title"] = "Error";
}

<section class="section">
    <div class="shell">
        <section class="card" style="max-width:760px;margin:0 auto">
            <div class="eyebrow" style="color:#b45b09">Request Portal</div>
            <h1>Something went wrong.</h1>
            <p class="muted">The operation could not be completed. Starfleet Diagnostics has the correlation information needed to trace the failure.</p>
            @if (!string.IsNullOrWhiteSpace(Model.RequestId))
            {
                <p><strong>Correlation:</strong> @Model.RequestId</p>
            }
            <a class="button" asp-page="/Index">Return home</a>
        </section>
    </div>
</section>
