@page
@model RequestPortal.Web.Pages.Staff.OperationsModel
@using RequestPortal.Application.Administration
@{
    ViewData["Title"] = "Operations";
}

<section class="section">
    <div class="shell">
        <div class="section-heading">
            <div class="eyebrow" style="color:#b45b09">FFP operations</div>
            <h1>Action & aging queues</h1>
            <p>Work the oldest items first: organization approvals, submitted requests, requests waiting on additional information, and documents awaiting verification.</p>
        </div>

        <div class="grid-3">
            <article class="card">
                <h2>@Model.Snapshot.PendingOrganizations.Count</h2>
                <p>Organizations awaiting approval</p>
            </article>
            <article class="card">
                <h2>@Model.Snapshot.OpenReviewRequests.Count</h2>
                <p>Requests awaiting FFP review</p>
            </article>
            <article class="card">
                <h2>@Model.Snapshot.DocumentsAwaitingVerification.Count</h2>
                <p>Documents awaiting verification</p>
            </article>
        </div>
    </div>
</section>

<section class="section section-muted">
    <div class="shell">
        <div class="section-heading">
            <h2>Organizations awaiting approval</h2>
        </div>
        @if (Model.Snapshot.PendingOrganizations.Count == 0)
        {
            <div class="card"><p>No pending organizations.</p></div>
        }
        else
        {
            <div class="table-wrap">
                <table>
                    <thead><tr><th>Organization</th><th>Country</th><th>Registered</th><th>Age</th><th></th></tr></thead>
                    <tbody>
                    @foreach (PendingOrganizationWorkItem item in Model.Snapshot.PendingOrganizations)
                    {
                        <tr>
                            <td>@item.OrganizationName</td>
                            <td>@item.CountryCode</td>
                            <td>@item.CreatedUtc.ToString("yyyy-MM-dd")</td>
                            <td>@item.AgeDays day(s)</td>
                            <td><a asp-page="/Staff/Organization" asp-route-id="@item.OrganizationId">Open</a></td>
                        </tr>
                    }
                    </tbody>
                </table>
            </div>
        }
    </div>
</section>

<section class="section">
    <div class="shell">
        <div class="section-heading">
            <h2>Requests awaiting review</h2>
        </div>
        @if (Model.Snapshot.OpenReviewRequests.Count == 0)
        {
            <div class="card"><p>No requests are waiting for review.</p></div>
        }
        else
        {
            <div class="table-wrap">
                <table>
                    <thead><tr><th>Reference</th><th>Organization</th><th>Status</th><th>Age</th><th></th></tr></thead>
                    <tbody>
                    @foreach (RequestWorkItem item in Model.Snapshot.OpenReviewRequests)
                    {
                        <tr>
                            <td>@item.PublicReference</td>
                            <td>@item.OrganizationName</td>
                            <td>@item.Status</td>
                            <td>@item.AgeDays day(s)</td>
                            <td><a asp-page="/Staff/Request" asp-route-id="@item.RequestId">Review</a></td>
                        </tr>
                    }
                    </tbody>
                </table>
            </div>
        }
    </div>
</section>

<section class="section section-muted">
    <div class="shell">
        <div class="section-heading">
            <h2>Waiting on requester action</h2>
            <p>These requests are in More Information Required and remain visible so FFP can follow up on aging cases.</p>
        </div>
        @if (Model.Snapshot.ActionRequiredRequests.Count == 0)
        {
            <div class="card"><p>No requests are currently waiting on additional information.</p></div>
        }
        else
        {
            <div class="table-wrap">
                <table>
                    <thead><tr><th>Reference</th><th>Organization</th><th>Status</th><th>Age</th><th></th></tr></thead>
                    <tbody>
                    @foreach (RequestWorkItem item in Model.Snapshot.ActionRequiredRequests)
                    {
                        <tr>
                            <td>@item.PublicReference</td>
                            <td>@item.OrganizationName</td>
                            <td>@item.Status</td>
                            <td>@item.AgeDays day(s)</td>
                            <td><a asp-page="/Staff/Request" asp-route-id="@item.RequestId">Open</a></td>
                        </tr>
                    }
                    </tbody>
                </table>
            </div>
        }
    </div>
</section>

<section class="section">
    <div class="shell">
        <div class="section-heading">
            <h2>Documents awaiting verification</h2>
        </div>
        @if (Model.Snapshot.DocumentsAwaitingVerification.Count == 0)
        {
            <div class="card"><p>No documents are waiting for verification.</p></div>
        }
        else
        {
            <div class="table-wrap">
                <table>
                    <thead><tr><th>Organization</th><th>Type</th><th>File</th><th>Age</th><th></th></tr></thead>
                    <tbody>
                    @foreach (DocumentWorkItem item in Model.Snapshot.DocumentsAwaitingVerification)
                    {
                        <tr>
                            <td>@item.OrganizationName</td>
                            <td>@item.DocumentType</td>
                            <td>@item.OriginalFileName</td>
                            <td>@item.AgeDays day(s)</td>
                            <td><a asp-page="/Staff/Organization" asp-route-id="@item.OrganizationId">Open organization</a></td>
                        </tr>
                    }
                    </tbody>
                </table>
            </div>
        }
    </div>
</section>
