@page "{id:guid}"
@model RequestPortal.Web.Pages.Staff.ReviewModel
@using RequestPortal.Application.Documents
@{
    ViewData["Title"] = "Review Request";
}

<section class="section">
    <div class="shell">
        @if (Model.Request is null)
        {
            <section class="card"><h1>Request not found</h1></section>
        }
        else
        {
            <div class="action-row" style="justify-content:space-between;align-items:end;margin-bottom:24px">
                <div class="section-heading" style="margin-bottom:0">
                    <div class="eyebrow" style="color:#b45b09">FFP request review</div>
                    <h1>@Model.Request.PublicReference</h1>
                    <p><strong>@Model.Request.OrganizationName</strong> · @Model.Request.Summary</p>
                </div>
                <span class="status status-@Model.Request.Status">@Model.Request.Status</span>
            </div>

            <div class="dashboard-grid">
                <div>
                    <section class="card">
                        <h2>Requested items</h2>
                        <div class="table-wrap">
                            <table>
                                <thead><tr><th>Description</th><th>Quantity</th><th>Unit</th></tr></thead>
                                <tbody>
                                @foreach (RequestItemDetail item in Model.Request.Items)
                                {
                                    <tr><td>@item.Description</td><td>@item.Quantity</td><td>Each</td></tr>
                                }
                                </tbody>
                            </table>
                        </div>
                    </section>

                    <section class="card" style="margin-top:1.5rem">
                        <h2>Supporting documents</h2>
                        @if (Model.Documents.Count == 0)
                        {
                            <p class="muted">No supporting documents have been uploaded.</p>
                        }
                        else
                        {
                            <div class="table-wrap">
                                <table>
                                    <thead><tr><th>File</th><th>Type</th><th>Uploaded UTC</th><th></th></tr></thead>
                                    <tbody>
                                    @foreach (DocumentSummary document in Model.Documents)
                                    {
                                        <tr>
                                            <td>@document.OriginalFileName</td>
                                            <td>@document.DocumentType</td>
                                            <td>@document.UploadedUtc.ToString("u")</td>
                                            <td><a asp-page-handler="Download" asp-route-id="@Model.Request.Id" asp-route-documentId="@document.Id">Download</a></td>
                                        </tr>
                                    }
                                    </tbody>
                                </table>
                            </div>
                        }
                    </section>

                    @if (Model.Request.Status == "Submitted")
                    {
                        <section class="card" style="margin-top:1.5rem">
                            <h2>Decision</h2>
                            <div class="action-row">
                                <form method="post" asp-page-handler="Approve">
                                    <input type="hidden" name="id" value="@Model.Request.Id" />
                                    <button class="button" type="submit">Approve request</button>
                                </form>
                            </div>

                            <form method="post" asp-page-handler="MoreInformation" class="form-grid" style="margin-top:22px">
                                <input type="hidden" name="id" value="@Model.Request.Id" />
                                <div class="field">
                                    <label asp-for="DecisionReason">Request more information</label>
                                    <textarea asp-for="DecisionReason" placeholder="Explain exactly what the organization should provide."></textarea>
                                    <span asp-validation-for="DecisionReason" class="validation"></span>
                                </div>
                                <button class="button button-outline" type="submit">Request more information</button>
                            </form>

                            <form method="post" asp-page-handler="Reject" class="form-grid" style="margin-top:22px">
                                <input type="hidden" name="id" value="@Model.Request.Id" />
                                <div class="field">
                                    <label asp-for="RejectionReason">Rejection reason</label>
                                    <textarea asp-for="RejectionReason" placeholder="Record the reason for rejection."></textarea>
                                    <span asp-validation-for="RejectionReason" class="validation"></span>
                                </div>
                                <button class="button button-danger" type="submit">Reject request</button>
                            </form>

                            <form method="post" asp-page-handler="Duplicate" class="form-grid" style="margin-top:22px">
                                <input type="hidden" name="id" value="@Model.Request.Id" />
                                <div class="field">
                                    <label asp-for="DuplicateReason">Duplicate reason/reference</label>
                                    <textarea asp-for="DuplicateReason" placeholder="Identify the existing request or explain why this is a duplicate."></textarea>
                                    <span asp-validation-for="DuplicateReason" class="validation"></span>
                                </div>
                                <button class="button button-outline" type="submit">Mark as duplicate</button>
                            </form>
                        </section>
                    }
                </div>

                <aside class="card">
                    <h2>Status history</h2>
                    <div class="timeline">
                        @foreach (RequestHistoryDetail history in Model.Request.History)
                        {
                            <div class="timeline-item">
                                <strong>@history.Status</strong>
                                @if (!string.IsNullOrWhiteSpace(history.Reason))
                                {
                                    <span>@history.Reason</span>
                                }
                                <small>@history.ChangedUtc.ToLocalTime().ToString("f")</small>
                            </div>
                        }
                    </div>
                </aside>
            </div>
        }
    </div>
</section>
