@page
@model RequestPortal.Web.Pages.Staff.IntegrationsModel
@using RequestPortal.Application.Integration
@{
    ViewData["Title"] = "Integrations";
}

<section class="section">
    <div class="shell">
        <div class="section-heading">
            <div class="eyebrow" style="color:#b45b09">FFP internal</div>
            <h1>Integration status</h1>
            <p>Track request synchronization with local FFP systems and future FFTP US integrations without coupling portal records to those systems.</p>
        </div>

        <section class="card">
            @if (Model.Items.Count == 0)
            {
                <p class="muted">No integration links have been created yet.</p>
            }
            else
            {
                <div class="table-wrap">
                    <table>
                        <thead><tr><th>Request</th><th>Organization</th><th>System</th><th>Status</th><th>External reference</th><th>Last attempt</th><th>Error</th></tr></thead>
                        <tbody>
                        @foreach (IntegrationStatusSummary item in Model.Items)
                        {
                            <tr>
                                <td>@item.PublicReference</td>
                                <td>@item.OrganizationName</td>
                                <td>@item.SystemName</td>
                                <td>@item.Status</td>
                                <td>@(item.ExternalReference ?? "—")</td>
                                <td>@(item.LastAttemptUtc?.ToString("u") ?? "—")</td>
                                <td>@(item.LastError ?? "—")</td>
                            </tr>
                        }
                        </tbody>
                    </table>
                </div>
            }
        </section>
    </div>
</section>
