@page
@model RequestPortal.Web.Pages.IndexModel
@{
    ViewData["Title"] = "Home";
}

<section class="hero">
    <div class="shell hero-grid">
        <div>
            <div class="eyebrow">Food For The Poor Jamaica</div>
            <h1>Request assistance through your organization.</h1>
            <p>
                The Request Portal gives approved organizations one secure place to register representatives,
                submit requests, provide supporting information and follow each request through FFP review.
            </p>
            <div class="hero-actions">
                @if (User.Identity?.IsAuthenticated == true)
                {
                    <a class="button" asp-page="/Dashboard/Index">Open my dashboard</a>
                    <a class="button button-secondary" asp-page="/Requests/Create">Create a request</a>
                }
                else
                {
                    <a class="button" asp-page="/Account/Login">Representative sign in</a>
                    <a class="button button-secondary" asp-page="/Account/StaffLogin">FFP staff sign in</a>
                }
            </div>
        </div>
        <aside class="hero-card">
            <h2>How it works</h2>
            <ol>
                <li>Register your organization or request membership.</li>
                <li>FFP approves new organizations.</li>
                <li>Organization administrators approve representatives.</li>
                <li>Submit requests on behalf of an approved organization.</li>
                <li>Track review decisions and requests for more information.</li>
            </ol>
        </aside>
    </div>
</section>

<section class="section">
    <div class="shell">
        <div class="section-heading">
            <div class="eyebrow" style="color:#b45b09">One portal, clear ownership</div>
            <h2>Built around organizations, not individual accounts.</h2>
            <p>
                Representatives authenticate as people, but every assistance request belongs to the organization
                they are authorized to represent. A representative may belong to more than one approved organization.
            </p>
        </div>
        <div class="grid-3">
            <article class="card">
                <h3>Organization registration</h3>
                <p>New organizations submit their registration for FFP review before they can make requests.</p>
            </article>
            <article class="card">
                <h3>Representative approval</h3>
                <p>Each organization controls which authenticated representatives may act on its behalf.</p>
            </article>
            <article class="card">
                <h3>Request tracking</h3>
                <p>Requests keep an auditable status history from draft and submission through FFP review.</p>
            </article>
        </div>
    </div>
</section>
