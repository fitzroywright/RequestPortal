@page "{id:guid}"
@model RequestPortal.Web.Pages.Requests.DetailsModel
@using RequestPortal.Application.Documents
@using RequestPortal.Domain.Documents
@{
    ViewData["Title"] = "Request Details";
}

<section class="section">
    <div class="shell">
        @if (Model.Request is null)
        {
            <section class="card"><h1>Request not found</h1></section>
        }
        else
        {
            <div class="action-row" style="justify-content:space-between;align-items:end;margin-bottom:24px">
                <div class="section-heading" style="margin-bottom:0">
                    <div class="eyebrow" style="color:#b45b09">@Model.Request.OrganizationName</div>
                    <h1>@Model.Request.PublicReference</h1>
                    <p>@Model.Request.Summary</p>
                </div>
                <span class="status status-@Model.Request.Status">@Model.Request.Status</span>
            </div>

            <div class="dashboard-grid">
                <div>
                    @if (Model.ProjectProposal is not null)
                    {
                        <section class="card">
                            <div class="action-row" style="justify-content:space-between;align-items:center">
                                <div>
                                    <div class="eyebrow" style="color:#b45b09">Project proposal</div>
                                    <h2>@Model.ProjectProposal.Title</h2>
                                    <p class="muted">Version @Model.ProjectProposal.Version · updated @Model.ProjectProposal.UpdatedUtc.ToString("u")</p>
                                </div>
                                @if (Model.ProjectProposal.CanEdit)
                                {
                                    <a class="button" asp-page="/Requests/Proposal" asp-route-id="@Model.Request.Id">Edit proposal</a>
                                }
                            </div>
                            <article class="proposal-document">@Html.Raw(Model.ProjectProposal.RichContentHtml)</article>
                        </section>
                    }
                    else
                    {
                        <section class="card">
                            <h2>Requested items</h2>
                            @if (Model.Request.Items.Count == 0)
                            {
                                <p class="muted">No items have been added yet.</p>
                            }
                            else
                            {
                                <div class="table-wrap">
                                    <table>
                                        <thead><tr><th>Description</th><th>Quantity</th><th>Unit</th></tr></thead>
                                        <tbody>
                                        @foreach (RequestItemDetail item in Model.Request.Items)
                                        {
                                            <tr>
                                                <td>@item.Description</td>
                                                <td>@item.Quantity</td>
                                                <td>Each</td>
                                            </tr>
                                        }
                                        </tbody>
                                    </table>
                                </div>
                            }

                            @if (Model.Request.Status == "Draft")
                            {
                                <hr style="border:0;border-top:1px solid #dde3e8;margin:26px 0" />
                                <h3>Add line item</h3>
                                <form method="post" asp-page-handler="AddItem" class="form-grid">
                                    <input type="hidden" name="id" value="@Model.Request.Id" />
                                    <div class="field">
                                        <label asp-for="Item.Description">Description</label>
                                        <input asp-for="Item.Description" placeholder="e.g. School bags" />
                                        <span asp-validation-for="Item.Description" class="validation"></span>
                                    </div>
                                    <div class="field">
                                        <label asp-for="Item.Quantity"></label>
                                        <input asp-for="Item.Quantity" type="number" step="0.001" min="0.001" />
                                        <span asp-validation-for="Item.Quantity" class="validation"></span>
                                    </div>
                                    <button class="button button-outline" type="submit">Add item</button>
                                </form>

                                <form method="post" asp-page-handler="Submit" style="margin-top:18px">
                                    <input type="hidden" name="id" value="@Model.Request.Id" />
                                    <button class="button" type="submit" @(Model.Request.Items.Count == 0 ? "disabled" : null)>Submit request to FFP</button>
                                </form>
                            }
                        </section>
                    }

                    @if (Model.Request.Status == "MoreInformationRequired")
                    {
                        <section class="card" style="margin-top:1.5rem">
                            <div class="flash error">
                                FFP requested additional information. Review the status history, update the project proposal or upload the requested evidence, then resubmit.
                            </div>
                            @if (Model.ProjectProposal is not null)
                            {
                                <a class="button button-outline" asp-page="/Requests/Proposal" asp-route-id="@Model.Request.Id">Update project proposal</a>
                            }
                            <form method="post" asp-page-handler="Resubmit" style="margin-top:14px">
                                <input type="hidden" name="id" value="@Model.Request.Id" />
                                <button class="button" type="submit">Resubmit to FFP</button>
                            </form>
                        </section>
                    }

                    <section class="card" style="margin-top:1.5rem">
                        <h2>Supporting documents</h2>
                        @if (Model.Documents.Count == 0)
                        {
                            <p class="muted">No supporting documents have been uploaded.</p>
                        }
                        else
                        {
                            <div class="table-wrap">
                                <table>
                                    <thead><tr><th>File</th><th>Type</th><th>Uploaded UTC</th><th></th></tr></thead>
                                    <tbody>
                                    @foreach (DocumentSummary document in Model.Documents)
                                    {
                                        <tr>
                                            <td>@document.OriginalFileName</td>
                                            <td>@document.DocumentType</td>
                                            <td>@document.UploadedUtc.ToString("u")</td>
                                            <td><a asp-page-handler="Download" asp-route-id="@Model.Request.Id" asp-route-documentId="@document.Id">Download</a></td>
                                        </tr>
                                    }
                                    </tbody>
                                </table>
                            </div>
                        }

                        @if (Model.Request.Status == "Draft" || Model.Request.Status == "MoreInformationRequired")
                        {
                            <form method="post" enctype="multipart/form-data" asp-page-handler="UploadDocument" class="form-grid" style="margin-top:1rem">
                                <input type="hidden" name="id" value="@Model.Request.Id" />
                                <div class="field">
                                    <label asp-for="Document.DocumentType">Document type</label>
                                    <select asp-for="Document.DocumentType" asp-items="Html.GetEnumSelectList<DocumentType>()"></select>
                                </div>
                                <div class="field">
                                    <label asp-for="Document.File">File</label>
                                    <input asp-for="Document.File" type="file" />
                                    <span asp-validation-for="Document.File" class="validation"></span>
                                </div>
                                <button class="button button-outline" type="submit">Upload document</button>
                            </form>
                        }
                    </section>

                    @if (Model.Request.Status == "Draft" || Model.Request.Status == "Submitted" || Model.Request.Status == "MoreInformationRequired")
                    {
                        <section class="card" style="margin-top:1.5rem">
                            <h2>Cancel request</h2>
                            <p class="muted">Cancellation is permanent and is recorded in the request history.</p>
                            <form method="post" asp-page-handler="Cancel" class="form-grid">
                                <input type="hidden" name="id" value="@Model.Request.Id" />
                                <div class="field">
                                    <label asp-for="Cancellation.Reason">Reason</label>
                                    <textarea asp-for="Cancellation.Reason" rows="3"></textarea>
                                    <span asp-validation-for="Cancellation.Reason" class="validation"></span>
                                </div>
                                <button class="button button-outline" type="submit">Cancel request</button>
                            </form>
                        </section>
                    }
                </div>

                <aside class="card">
                    <h2>Status history</h2>
                    <div class="timeline">
                        @foreach (RequestHistoryDetail history in Model.Request.History)
                        {
                            <div class="timeline-item">
                                <strong>@history.Status</strong>
                                @if (!string.IsNullOrWhiteSpace(history.Reason))
                                {
                                    <span>@history.Reason</span>
                                }
                                <small>@history.ChangedUtc.ToLocalTime().ToString("f")</small>
                            </div>
                        }
                    </div>
                </aside>
            </div>
        }
    </div>
</section>

<style>
    .proposal-document {
        margin-top: 18px;
        background: #fff;
        border: 1px solid #e0e4e7;
        padding: 32px 38px;
        font-family: Georgia, 'Times New Roman', serif;
        line-height: 1.65;
        overflow-wrap: anywhere;
    }

    .proposal-document table {
        width: 100%;
        border-collapse: collapse;
        margin: 16px 0;
    }

    .proposal-document th, .proposal-document td {
        border: 1px solid #8b949c;
        padding: 8px;
    }

    .proposal-document img {
        max-width: 100%;
        height: auto;
    }
</style>
