@page
@model RequestPortal.Web.Pages.Requests.CreateModel
@using RequestPortal.Domain.Requests
@{
    ViewData["Title"] = "Create Request";
}

<section class="section">
    <div class="shell">
        <div class="section-heading">
            <div class="eyebrow" style="color:#b45b09">New assistance request</div>
            <h1>Tell FFP what is needed.</h1>
            <p>
                The organization selected here becomes the permanent owner of this request. Choose whether you are
                requesting goods/services or proposing a project that needs a full narrative proposal.
            </p>
        </div>

        <div class="grid-2">
            <section class="card">
                @if (Model.Organizations.Count == 0)
                {
                    <h2>No approved organization membership</h2>
                    <p class="muted">Register an organization or request membership before creating a request.</p>
                    <a class="button" asp-page="/Organizations/Index">Manage organizations</a>
                }
                else
                {
                    <form method="post" class="form-grid">
                        <div asp-validation-summary="ModelOnly" class="validation"></div>

                        <div class="field">
                            <label asp-for="Input.OrganizationId">Acting on behalf of</label>
                            <select asp-for="Input.OrganizationId">
                                <option value="">Select an organization</option>
                                @foreach (OrganizationSummary organization in Model.Organizations)
                                {
                                    <option value="@organization.Id">@organization.Name</option>
                                }
                            </select>
                            <span asp-validation-for="Input.OrganizationId" class="validation"></span>
                        </div>

                        <div class="field">
                            <label asp-for="Input.Kind">Request type</label>
                            <select asp-for="Input.Kind" asp-items="Html.GetEnumSelectList<RequestKind>()"></select>
                            <div class="muted">Choose Project when the organization needs to submit a full proposal with narrative, tables and photos.</div>
                        </div>

                        <div class="field">
                            <label asp-for="Input.Summary">Request summary</label>
                            <textarea asp-for="Input.Summary" placeholder="Briefly describe the need, project or intended beneficiaries."></textarea>
                            <span asp-validation-for="Input.Summary" class="validation"></span>
                        </div>

                        <div class="grid-2">
                            <div class="field">
                                <label asp-for="Input.Category">Category</label>
                                <input asp-for="Input.Category" placeholder="e.g. Education, Housing, Water" />
                            </div>
                            <div class="field">
                                <label asp-for="Input.Subcategory">Subcategory</label>
                                <input asp-for="Input.Subcategory" placeholder="e.g. School supplies, Rehabilitation" />
                            </div>
                        </div>

                        <div class="grid-2">
                            <div class="field">
                                <label asp-for="Input.ProgramCategory">Program category</label>
                                <input asp-for="Input.ProgramCategory" />
                            </div>
                            <div class="field">
                                <label asp-for="Input.Priority">Priority</label>
                                <select asp-for="Input.Priority" asp-items="Html.GetEnumSelectList<RequestPriority>()"></select>
                            </div>
                        </div>

                        <div class="field">
                            <label asp-for="Input.Location">Location</label>
                            <input asp-for="Input.Location" placeholder="Community, parish or address" />
                        </div>

                        <div class="field">
                            <label asp-for="Input.Circumstances">Request circumstances</label>
                            <textarea asp-for="Input.Circumstances" rows="4" placeholder="Provide enough context for FFP to understand the need."></textarea>
                        </div>

                        <hr style="border:0;border-top:1px solid #dde3e8;margin:24px 0" />
                        <h2>Beneficiary</h2>
                        <p class="muted">Optional for organization-wide or community projects.</p>

                        <div class="grid-2">
                            <div class="field">
                                <label asp-for="Input.BeneficiaryFirstName">First name</label>
                                <input asp-for="Input.BeneficiaryFirstName" />
                            </div>
                            <div class="field">
                                <label asp-for="Input.BeneficiaryLastName">Last name</label>
                                <input asp-for="Input.BeneficiaryLastName" />
                            </div>
                        </div>

                        <div class="grid-2">
                            <div class="field">
                                <label asp-for="Input.BeneficiaryDateOfBirth">Date of birth</label>
                                <input asp-for="Input.BeneficiaryDateOfBirth" type="date" />
                            </div>
                            <div class="field">
                                <label asp-for="Input.ParentOrGuardian">Parent or guardian</label>
                                <input asp-for="Input.ParentOrGuardian" />
                            </div>
                        </div>

                        <button class="button" type="submit">Create draft</button>
                    </form>
                }
            </section>

            <aside class="card">
                <h2>Two request paths</h2>
                <p><strong>Goods &amp; Services</strong></p>
                <p class="muted">Use line items for tangible assistance, materials, equipment or services.</p>
                <p><strong>Project</strong></p>
                <p class="muted">Opens a Word-like proposal workspace for a long narrative with formatting, tables and inline photos. Supporting files can still be attached separately.</p>
                <ul>
                    <li>Select the correct organization. It cannot be changed after creation.</li>
                    <li>Add a beneficiary when the request is for a specific person.</li>
                    <li>Use category, location and priority to help FFP triage the request.</li>
                    <li>After submission, FFP can approve, reject, request more information, or mark a duplicate.</li>
                </ul>
            </aside>
        </div>
    </div>
</section>
