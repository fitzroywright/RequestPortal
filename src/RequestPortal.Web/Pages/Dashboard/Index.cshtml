@page
@model RequestPortal.Web.Pages.Dashboard.IndexModel
@{
    ViewData["Title"] = "Dashboard";
}

<section class="section">
    <div class="shell">
        <div class="section-heading">
            <div class="eyebrow" style="color:#b45b09">Representative workspace</div>
            <h1>Hello, @Model.DisplayName</h1>
            <p>Choose the organization you are acting for, create requests, and follow FFP decisions from one dashboard.</p>
        </div>

        <div class="grid-3">
            <article class="card">
                <div class="muted">Approved organizations</div>
                <div class="stat">@Model.ApprovedOrganizations</div>
                <a class="button button-outline" asp-page="/Organizations/Index">Manage organizations</a>
            </article>
            <article class="card">
                <div class="muted">Requests awaiting FFP</div>
                <div class="stat">@Model.SubmittedCount</div>
                <a class="button button-outline" asp-page="/Requests/Index">View requests</a>
            </article>
            <article class="card">
                <div class="muted">Action required</div>
                <div class="stat">@Model.ActionRequired.Count</div>
                <a class="button" asp-page="/Requests/Create">New request</a>
            </article>
        </div>

        <div class="grid-3" style="margin-top:18px">
            <article class="card"><div class="muted">Draft</div><div class="stat">@Model.DraftCount</div></article>
            <article class="card"><div class="muted">More information required</div><div class="stat">@Model.MoreInformationCount</div></article>
            <article class="card"><div class="muted">Approved / fulfilment</div><div class="stat">@Model.ApprovedCount</div></article>
        </div>

        @if (Model.ActionRequired.Count > 0)
        {
            <section class="card" style="margin-top:22px;border-left:4px solid #b45b09">
                <div class="action-row" style="justify-content:space-between;align-items:center">
                    <div>
                        <h2>Action required</h2>
                        <p class="muted">These requests need something from your organization.</p>
                    </div>
                </div>
                <div class="table-wrap">
                    <table>
                        <thead><tr><th>Reference</th><th>Organization</th><th>Status</th><th></th></tr></thead>
                        <tbody>
                        @foreach (RequestSummary request in Model.ActionRequired.Take(8))
                        {
                            <tr>
                                <td><strong>@request.PublicReference</strong></td>
                                <td>@request.OrganizationName</td>
                                <td><span class="status status-@request.Status">@request.Status</span></td>
                                <td><a asp-page="/Requests/Details" asp-route-id="@request.Id">Open</a></td>
                            </tr>
                        }
                        </tbody>
                    </table>
                </div>
            </section>
        }

        <div class="dashboard-grid" style="margin-top:22px">
            <section class="card">
                <div class="action-row" style="justify-content:space-between;align-items:center">
                    <h2>Recent requests</h2>
                    <a asp-page="/Requests/Index">View all</a>
                </div>
                @if (Model.Requests.Count == 0)
                {
                    <p class="muted">No requests yet. Create a request once you have an approved organization membership.</p>
                }
                else
                {
                    <div class="table-wrap">
                        <table>
                            <thead>
                                <tr><th>Reference</th><th>Organization</th><th>Status</th><th></th></tr>
                            </thead>
                            <tbody>
                            @foreach (RequestSummary request in Model.Requests.Take(8))
                            {
                                <tr>
                                    <td><strong>@request.PublicReference</strong></td>
                                    <td>@request.OrganizationName</td>
                                    <td><span class="status status-@request.Status">@request.Status</span></td>
                                    <td><a asp-page="/Requests/Details" asp-route-id="@request.Id">Open</a></td>
                                </tr>
                            }
                            </tbody>
                        </table>
                    </div>
                }
            </section>

            <section class="card">
                <h2>My organizations</h2>
                @if (Model.Organizations.Count == 0)
                {
                    <p class="muted">You are not yet associated with an organization.</p>
                    <a class="button" asp-page="/Organizations/Index">Register or join one</a>
                }
                else
                {
                    @foreach (OrganizationSummary organization in Model.Organizations)
                    {
                        <div style="padding:14px 0;border-bottom:1px solid #e1e6ea">
                            <strong>@organization.Name</strong><br />
                            <span class="muted">@organization.Role · @organization.MembershipStatus</span><br />
                            <a asp-page="/Organizations/Profile" asp-route-id="@organization.Id">Organization profile</a>
                        </div>
                    }
                }
            </section>
        </div>
    </div>
</section>
