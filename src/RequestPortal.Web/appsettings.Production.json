{
  "AllowedHosts": "requestportal.ffpja.org;relief.ffpja.org",
  "Demo": {
    "Enabled": false,
    "EnsureDatabase": false,
    "RecreateOnModelMismatch": false
  },
  "CommonSecrets": {
    "Mode": "Production",
    "WorkloadName": "RequestPortal",
    "EnvironmentName": "Production",
    "ProviderOrder": [
      "OpenBao"
    ],
    "OpenBao": {
      "Enabled": true,
      "Address": "https://openbao.fftpj.local:8200",
      "MountPath": "secret",
      "BasePath": "requestportal",
      "AuthMountPath": "approle",
      "RoleId": "",
      "SecretIdEnvironmentVariable": "REQUESTPORTAL_OPENBAO_SECRET_ID",
      "SecretIdFile": "/run/secrets/requestportal-openbao-secret-id",
      "DeleteSecretIdFileAfterRead": true,
      "ClearSecretIdEnvironmentVariableAfterRead": true,
      "RequireSecretIdFileInProduction": false,
      "RequireHttps": true,
      "RenewTokens": true,
      "RevokeTokenOnDispose": true,
      "SecretCacheTtl": "00:05:00"
    }
  },
  "Storage": {
    "Local": {
      "RootPath": "\\\\fileserver\\RequestPortal\\Documents"
    }
  },
  "Messaging": {
    "DurableQueuePath": "\\\\fileserver\\RequestPortal\\Messaging"
  },
  "Uploads": {
    "MaxBytes": 26214400,
    "MalwareScanning": {
      "Enabled": true,
      "Host": "clamav.fftpj.local",
      "Port": 3310
    }
  },
  "Security": {
    "DataProtectionKeysPath": "\\\\fileserver\\RequestPortal\\DataProtectionKeys"
  },
  "Notifications": {
    "Enabled": true,
    "SmtpHost": "smtp.office365.com",
    "SmtpPort": 587,
    "EnableSsl": true,
    "FromAddress": "requestportal@ffpja.org",
    "FromName": "FFP Request Portal",
    "UserName": "requestportal@ffpja.org",
    "PasswordSecretName": "Notifications:SmtpPassword"
  },
  "Authentication": {
    "ActiveDirectory": {
      "Server": "JMAD01.fftpj.local",
      "Port": 636,
      "Domain": "fftpj.local",
      "SearchBase": "DC=fftpj,DC=local",
      "RequireLdaps": true,
      "TimeoutSeconds": 10,
      "ReviewerGroups": [
        "RequestPortal-Reviewers"
      ],
      "AdministratorGroups": [
        "RequestPortal-Administrators"
      ]
    },
    "Google": {
      "ClientId": ""
    },
    "Microsoft": {
      "ClientId": ""
    },
    "Facebook": {
      "AppId": ""
    }
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
    }
  }
}
