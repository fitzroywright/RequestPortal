@page
@model RequestPortal.Web.Pages.Account.NotificationsModel
@using RequestPortal.Application.Notifications
@using RequestPortal.Domain.Notifications
@{
    ViewData["Title"] = "Notifications";

    NotificationPreferenceView? email = Model.FindPreference(NotificationChannel.Email);
}

<section class="section">
    <div class="shell">
        <div class="section-heading">
            <div class="eyebrow" style="color:#b45b09">Communication preferences</div>
            <h1>Notifications</h1>
            <p>Choose how Request Portal should contact you about organization approvals, membership changes and request status updates.</p>
        </div>

        <div asp-validation-summary="ModelOnly" class="validation"></div>

        <div class="grid-2">
            <article class="card">
                <h2>Email</h2>
                <p class="muted">Email is the active notification channel in the current demo.</p>
                <form method="post" asp-page-handler="Save">
                    <input type="hidden" name="Input.Channel" value="Email" />
                    <label for="emailDestination">Email address</label>
                    <input id="emailDestination" name="Input.Destination" value="@(email?.Destination ?? Model.DefaultEmail)" maxlength="500" required />
                    <label class="check-row">
                        <input type="checkbox" name="Input.Enabled" value="true" @(email?.Enabled != false ? "checked" : null) />
                        <span>Send email notifications</span>
                    </label>
                    <button class="button button-small" type="submit">Save email preference</button>
                </form>
            </article>

            <article class="card">
                <h2>Other channels</h2>
                @if (Model.DemoMode)
                {
                    <p>SMS and WhatsApp are intentionally not exposed as working controls in this demo.</p>
                    <p class="muted">The domain supports those channels, but they will only be enabled when a real delivery provider is configured and verified.</p>
                }
                else
                {
                    <p class="muted">Additional notification channels can be enabled when their delivery providers are configured.</p>
                }
            </article>
        </div>
    </div>
</section>

<section class="section section-muted">
    <div class="shell">
        <div class="section-heading">
            <h2>Recent notification history</h2>
            <p>This history shows what the portal attempted to send and whether delivery succeeded or was intentionally skipped.</p>
        </div>

        @if (Model.History.Count == 0)
        {
            <div class="card">
                <p>No notifications have been recorded for your account yet.</p>
            </div>
        }
        else
        {
            <div class="table-wrap">
                <table>
                    <thead>
                        <tr>
                            <th>Created</th>
                            <th>Channel</th>
                            <th>Subject</th>
                            <th>Status</th>
                            <th>Destination</th>
                        </tr>
                    </thead>
                    <tbody>
                    @foreach (NotificationHistoryView item in Model.History)
                    {
                        <tr>
                            <td>@item.CreatedUtc.ToString("yyyy-MM-dd HH:mm 'UTC'")</td>
                            <td>@item.Channel</td>
                            <td>@item.Subject</td>
                            <td>@item.Status</td>
                            <td>@item.Destination</td>
                        </tr>
                    }
                    </tbody>
                </table>
            </div>
        }
    </div>
</section>
