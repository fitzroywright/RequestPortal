@page "{id:guid}"
@model RequestPortal.Web.Pages.Requests.ProposalModel
@using RequestPortal.Application.Requests
@{
    ViewData["Title"] = "Project Proposal";
    string storedContent = Model.Proposal?.RichContentHtml ?? string.Empty;
    string recoveryKey = $"requestportal:proposal:{RouteData.Values["id"]}:draft";
}
<section class="section"><div class="shell">
<div class="section-heading"><div class="eyebrow" style="color:#b45b09">Project request</div><h1>Build the project proposal</h1><p>Prepare the narrative as a first-class part of the request. The editor is designed to feel familiar without depending on Microsoft Word or Office.</p></div>
<div asp-validation-summary="All" class="validation"></div>

@if (Model.Proposal?.CanEdit == true)
{
    <section class="card proposal-template-panel">
        <div><strong>Start from a template</strong><p class="muted">Templates replace the current narrative, so save anything you need first.</p></div>
        <div class="action-row">
        @foreach (LongFormTemplate template in Model.Templates)
        {
            <form method="post" asp-page-handler="Template"><input type="hidden" name="templateKey" value="@template.Key"/><button type="submit" class="button button-outline">@template.Name</button></form>
        }
        </div>
    </section>
}

<form method="post" class="form-grid" id="proposalForm"><section class="card proposal-document-shell">
<div class="proposal-titlebar">
    <div class="field"><label asp-for="Input.Title">Document title</label><input asp-for="Input.Title" id="proposalTitle" /><span asp-validation-for="Input.Title" class="validation"></span></div>
    <div class="proposal-save-state"><span id="autosaveStatus">Saved</span>@if(Model.Proposal is not null){<span>Version @Model.Proposal.Version</span>}</div>
</div>
<div id="recoveryNotice" class="flash" hidden><strong>Recovered browser draft available.</strong> <button type="button" class="nav-link-button" id="restoreBrowserDraft">Restore it</button> <button type="button" class="nav-link-button" id="discardBrowserDraft">Discard</button></div>
<div class="proposal-toolbar" role="toolbar" aria-label="Document formatting">
    <button type="button" data-command="undo" title="Undo">↶</button><button type="button" data-command="redo" title="Redo">↷</button>
    <select id="stylePicker" aria-label="Paragraph style"><option value="p">Normal</option><option value="h1">Title</option><option value="h2">Heading 1</option><option value="h3">Heading 2</option><option value="h4">Heading 3</option><option value="blockquote">Quote</option></select>
    <span class="toolbar-separator"></span>
    <button type="button" data-command="bold"><strong>B</strong></button><button type="button" data-command="italic"><em>I</em></button><button type="button" data-command="underline"><u>U</u></button><button type="button" data-command="strikeThrough"><s>S</s></button><button type="button" data-command="subscript">X₂</button><button type="button" data-command="superscript">X²</button>
    <span class="toolbar-separator"></span>
    <button type="button" data-command="insertUnorderedList">Bullets</button><button type="button" data-command="insertOrderedList">Numbering</button><button type="button" data-command="outdent">Outdent</button><button type="button" data-command="indent">Indent</button>
    <button type="button" data-command="justifyLeft">Left</button><button type="button" data-command="justifyCenter">Center</button><button type="button" data-command="justifyRight">Right</button>
    <span class="toolbar-separator"></span>
    <button type="button" id="insertTable">Table</button><button type="button" id="insertLink">Link</button><button type="button" id="insertPhoto">Image</button><button type="button" data-command="removeFormat">Clear formatting</button><input id="photoPicker" type="file" accept="image/*" hidden />
</div>
<div id="proposalEditor" class="proposal-editor" contenteditable="@(Model.Proposal?.CanEdit == true ? "true" : "false")" spellcheck="true" aria-label="Project proposal document">@Html.Raw(storedContent)</div>
<textarea asp-for="Input.RichContentHtml" id="proposalHtml" hidden></textarea>
<div class="proposal-footerbar">
    <div class="action-row">
        @if(Model.Proposal?.CanEdit == true){<button class="button button-secondary" type="submit" asp-page-handler="Save">Save document</button><button class="button" type="submit" asp-page-handler="Submit">Save and submit to FFP</button>}
        <a class="button button-outline" asp-page-handler="Docx" asp-route-id="@RouteData.Values["id"]">Export Word (.docx)</a>
        <a class="button button-outline" asp-page-handler="Pdf" asp-route-id="@RouteData.Values["id"]">Export PDF</a>
    </div>
    @if(Model.Proposal is not null){<span class="muted">Last saved @Model.Proposal.UpdatedUtc.ToString("u")</span>}
</div>
</section></form>

@if (Model.Revisions.Count > 0)
{
<section class="card" style="margin-top:1.5rem"><details><summary><strong>Revision history</strong> <span class="muted">(@Model.Revisions.Count recent saves)</span></summary><div class="table-wrap" style="margin-top:1rem"><table><thead><tr><th>Version</th><th>Saved</th><th>Type</th><th></th></tr></thead><tbody>@foreach(ProjectProposalRevisionDetail revision in Model.Revisions){<tr><td>@revision.Version</td><td>@revision.SavedUtc.ToString("u")</td><td>@(revision.Automatic ? "Autosave" : "Saved revision")</td><td>@if(Model.Proposal?.CanEdit == true){<form method="post" asp-page-handler="RestoreRevision"><input type="hidden" name="revisionId" value="@revision.Id"/><button type="submit" class="button button-outline">Restore</button></form>}</td></tr>}</tbody></table></div></details></section>
}

<section class="card" style="margin-top:1.5rem"><h2>Structured project budget</h2>
@if(Model.Planning is not null && Model.Planning.Budget.Count > 0){<div class="table-wrap"><table><thead><tr><th>Description</th><th>Qty</th><th>Unit cost</th><th>Total</th><th>FFP</th><th>Organization</th><th>Other</th><th></th></tr></thead><tbody>@foreach(ProjectBudgetItemDetail item in Model.Planning.Budget){<tr><td>@item.Description</td><td>@item.Quantity</td><td>@item.UnitCost.ToString("N2")</td><td>@item.TotalCost.ToString("N2")</td><td>@item.FfpRequested.ToString("N2")</td><td>@item.OrganizationContribution.ToString("N2")</td><td>@item.OtherFunding.ToString("N2")</td><td><form method="post" asp-page-handler="RemoveBudget"><input type="hidden" name="itemId" value="@item.Id"/><button class="button button-outline" type="submit">Remove</button></form></td></tr>}</tbody><tfoot><tr><th colspan="3">Totals</th><th>@Model.Planning.TotalCost.ToString("N2")</th><th>@Model.Planning.TotalFfpRequested.ToString("N2")</th><th>@Model.Planning.TotalOrganizationContribution.ToString("N2")</th><th>@Model.Planning.TotalOtherFunding.ToString("N2")</th><th></th></tr></tfoot></table></div>}
@if(Model.Proposal?.CanEdit == true){<form method="post" asp-page-handler="AddBudget" class="form-grid"><div class="field"><label asp-for="Budget.Description"></label><input asp-for="Budget.Description"/></div><div class="field"><label asp-for="Budget.Quantity"></label><input asp-for="Budget.Quantity" type="number" step="0.001"/></div><div class="field"><label asp-for="Budget.UnitCost">Unit cost</label><input asp-for="Budget.UnitCost" type="number" step="0.01"/></div><div class="field"><label asp-for="Budget.FfpRequested">Requested from FFP</label><input asp-for="Budget.FfpRequested" type="number" step="0.01"/></div><div class="field"><label asp-for="Budget.OrganizationContribution">Organization contribution</label><input asp-for="Budget.OrganizationContribution" type="number" step="0.01"/></div><div class="field"><label asp-for="Budget.OtherFunding">Other funding</label><input asp-for="Budget.OtherFunding" type="number" step="0.01"/></div><button class="button button-outline" type="submit">Add budget item</button></form>}</section>
<section class="card" style="margin-top:1.5rem"><h2>Implementation milestones & outcomes</h2>
@if(Model.Planning is not null && Model.Planning.Milestones.Count > 0){<div class="table-wrap"><table><thead><tr><th>#</th><th>Milestone</th><th>Expected outcome</th><th>Target date</th><th></th></tr></thead><tbody>@foreach(ProjectMilestoneDetail item in Model.Planning.Milestones){<tr><td>@item.Sequence</td><td>@item.Title</td><td>@item.ExpectedOutcome</td><td>@item.TargetDate</td><td>@if(Model.Proposal?.CanEdit == true){<form method="post" asp-page-handler="RemoveMilestone"><input type="hidden" name="milestoneId" value="@item.Id"/><button class="button button-outline" type="submit">Remove</button></form>}</td></tr>}</tbody></table></div>}
@if(Model.Proposal?.CanEdit == true){<form method="post" asp-page-handler="AddMilestone" class="form-grid"><div class="field"><label asp-for="Milestone.Title"></label><input asp-for="Milestone.Title"/></div><div class="field"><label asp-for="Milestone.ExpectedOutcome">Expected outcome</label><textarea asp-for="Milestone.ExpectedOutcome"></textarea></div><div class="field"><label asp-for="Milestone.TargetDate">Target date</label><input asp-for="Milestone.TargetDate" type="date"/></div><button class="button button-outline" type="submit">Add milestone</button></form>}</section>
<section class="card" style="margin-top:1.5rem"><h2>Proposal guidance</h2><p class="muted">Include executive summary, need, beneficiaries, objectives, activities, implementation approach, sustainability, risks, monitoring and maintenance. Large source files should still be uploaded as supporting documents.</p></section>
</div></section>
<style>
.proposal-document-shell{padding:0;overflow:hidden}.proposal-titlebar,.proposal-footerbar{padding:18px 22px;background:#fafbfc;display:flex;gap:20px;align-items:end;justify-content:space-between}.proposal-titlebar .field{flex:1;margin:0}.proposal-save-state{display:flex;gap:12px;font-size:.85rem;color:#66717b;white-space:nowrap}.proposal-toolbar{display:flex;flex-wrap:wrap;gap:5px;padding:9px 12px;border-top:1px solid #d9dee3;border-bottom:1px solid #d9dee3;background:#f4f6f8;position:sticky;top:0;z-index:2}.proposal-toolbar button,.proposal-toolbar select{border:1px solid #cbd2d8;background:white;border-radius:4px;padding:6px 9px;min-height:34px}.toolbar-separator{width:1px;background:#cbd2d8;margin:3px}.proposal-editor{min-height:720px;padding:52px 64px;background:white;color:#202428;font-family:Aptos,Calibri,Arial,sans-serif;font-size:16px;line-height:1.55;outline:none;max-width:900px;margin:0 auto}.proposal-editor:focus{box-shadow:inset 0 0 0 2px #dbe8f5}.proposal-editor h1{font-size:2rem}.proposal-editor h2{font-size:1.55rem;margin-top:1.5em}.proposal-editor h3{font-size:1.25rem;margin-top:1.3em}.proposal-editor table{width:100%;border-collapse:collapse;margin:18px 0}.proposal-editor th,.proposal-editor td{border:1px solid #87919a;padding:8px 10px;vertical-align:top}.proposal-editor img{max-width:100%;height:auto;margin:14px 0}.proposal-editor blockquote{border-left:4px solid #cbd2d8;padding-left:16px;color:#53606b}.proposal-template-panel{display:flex;justify-content:space-between;gap:20px;align-items:center;margin-bottom:1rem}.proposal-template-panel p{margin:4px 0 0}@media(max-width:760px){.proposal-editor{padding:28px 22px}.proposal-titlebar,.proposal-footerbar,.proposal-template-panel{display:block}.proposal-save-state{margin-top:10px}.proposal-footerbar .muted{display:block;margin-top:12px}}
</style>
<script>
(()=>{
 const editor=document.getElementById('proposalEditor'), field=document.getElementById('proposalHtml'), form=document.getElementById('proposalForm'), title=document.getElementById('proposalTitle'), picker=document.getElementById('photoPicker'), status=document.getElementById('autosaveStatus');
 if(!editor||editor.getAttribute('contenteditable')!=='true') return;
 const recoveryKey=@Html.Raw(System.Text.Json.JsonSerializer.Serialize(recoveryKey)); let dirty=false, saving=false;
 const sync=()=>{field.value=editor.innerHTML;}; const markDirty=()=>{dirty=true;status.textContent='Unsaved changes';saveLocal();};
 const saveLocal=()=>{try{localStorage.setItem(recoveryKey,JSON.stringify({title:title.value,html:editor.innerHTML,savedAt:new Date().toISOString()}));}catch{}};
 const clearLocal=()=>{try{localStorage.removeItem(recoveryKey);}catch{}};
 document.querySelectorAll('[data-command]').forEach(b=>b.addEventListener('click',()=>{editor.focus();document.execCommand(b.dataset.command,false,null);markDirty();}));
 document.getElementById('stylePicker').addEventListener('change',e=>{editor.focus();document.execCommand('formatBlock',false,e.target.value);markDirty();});
 document.getElementById('insertTable').addEventListener('click',()=>{const r=Math.min(Math.max(parseInt(prompt('Rows','3')||'0',10),1),20),c=Math.min(Math.max(parseInt(prompt('Columns','3')||'0',10),1),10);let t='<table><tbody>';for(let i=0;i<r;i++){t+='<tr>';for(let j=0;j<c;j++)t+=i===0?'<th>Heading</th>':'<td>Value</td>';t+='</tr>';}t+='</tbody></table><p><br></p>';editor.focus();document.execCommand('insertHTML',false,t);markDirty();});
 document.getElementById('insertLink').addEventListener('click',()=>{const u=prompt('Link address','https://');if(u){editor.focus();document.execCommand('createLink',false,u);markDirty();}});
 document.getElementById('insertPhoto').addEventListener('click',()=>picker.click());picker.addEventListener('change',()=>{const f=picker.files&&picker.files[0];if(!f)return;if(f.size>2*1024*1024){alert('Inline images must be 2 MB or smaller. Upload larger originals as supporting documents.');return;}const r=new FileReader();r.onload=e=>{editor.focus();document.execCommand('insertImage',false,e.target.result);markDirty();};r.readAsDataURL(f);});
 editor.addEventListener('input',markDirty); title.addEventListener('input',markDirty);
 editor.addEventListener('paste',e=>{const html=e.clipboardData&&e.clipboardData.getData('text/html');if(!html)return;e.preventDefault();const doc=new DOMParser().parseFromString(html,'text/html');doc.querySelectorAll('script,style,meta,link,object,iframe').forEach(x=>x.remove());doc.querySelectorAll('*').forEach(x=>{[...x.attributes].forEach(a=>{if(a.name.startsWith('on')||a.name==='id'||a.name==='lang'||a.name==='dir'||a.name.startsWith('data-')||a.name==='style')x.removeAttribute(a.name);});});editor.focus();document.execCommand('insertHTML',false,doc.body.innerHTML);markDirty();});
 form.addEventListener('submit',()=>{sync();clearLocal();});
 const autoSave=async()=>{if(!dirty||saving)return;saving=true;sync();status.textContent='Saving…';const body=new FormData();body.append('Input.Title',title.value);body.append('Input.RichContentHtml',field.value);const token=form.querySelector('input[name="__RequestVerificationToken"]');if(token)body.append('__RequestVerificationToken',token.value);try{const response=await fetch(location.pathname+'?handler=Autosave',{method:'POST',body,credentials:'same-origin'});if(!response.ok)throw new Error();dirty=false;clearLocal();status.textContent='Autosaved';}catch{status.textContent='Autosave failed — browser draft kept';}finally{saving=false;}};
 setInterval(autoSave,30000); window.addEventListener('beforeunload',()=>{if(dirty)saveLocal();});
 try{const raw=localStorage.getItem(recoveryKey);if(raw){const draft=JSON.parse(raw);if(draft&&draft.html&&draft.html!==editor.innerHTML){const notice=document.getElementById('recoveryNotice');notice.hidden=false;document.getElementById('restoreBrowserDraft').onclick=()=>{editor.innerHTML=draft.html;if(draft.title)title.value=draft.title;notice.hidden=true;markDirty();};document.getElementById('discardBrowserDraft').onclick=()=>{clearLocal();notice.hidden=true;};}}}catch{}
})();
</script>
