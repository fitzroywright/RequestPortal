{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Demo": {
    "Enabled": false,
    "EnsureDatabase": false
  },
  "ManagementDashboard": {
    "NewRequestHours": 48,
    "OverdueDays": 14,
    "StalledDays": 7,
    "TrendWeeks": 12
  },
  "FfpManagerIntegration": {
    "Enabled": false,
    "BaseUrl": "https://10.10.0.200/",
    "SharedSecret": "",
    "TimeoutSeconds": 30,
    "PollIntervalSeconds": 60,
    "SystemName": "FFPManager"
  },
  "CommonSecrets": {
    "Mode": "Development",
    "WorkloadName": "RequestPortal",
    "EnvironmentName": "Development",
    "ProviderOrder": [
      "Environment",
      "Configuration"
    ],
    "OpenBao": {
      "Enabled": false
    }
  },
  "Storage": {
    "Local": {
      "RootPath": "App_Data/storage"
    }
  },
  "Notifications": {
    "Enabled": false,
    "SmtpHost": "",
    "SmtpPort": 587,
    "EnableSsl": true,
    "FromAddress": "",
    "FromName": "FFP Request Portal",
    "UserName": null,
    "PasswordSecretName": "Notifications:SmtpPassword"
  },
  "Authentication": {
    "ActiveDirectory": {
      "Server": "",
      "Port": 636,
      "Domain": "",
      "SearchBase": "",
      "RequireLdaps": true,
      "TimeoutSeconds": 10,
      "ReviewerGroups": [],
      "AdministratorGroups": []
    }
  }
}
